{
  "id": "dashboard",
  "name": "Northwind Ops dashboard",
  "port": 4301,
  "routes": [
    {
      "path": "/",
      "name": "Overview",
      "capture": true
    },
    {
      "path": "/projects",
      "name": "Projects list",
      "capture": true
    },
    {
      "path": "/projects/apollo-migration",
      "name": "Project detail",
      "capture": true
    },
    {
      "path": "/team",
      "name": "Team",
      "capture": true
    }
  ],
  "states": [
    {
      "name": "search-focus",
      "route": "/",
      "steps": [
        {
          "action": "focus",
          "testid": "project-search"
        },
        {
          "action": "fill",
          "testid": "project-search",
          "value": "Apollo"
        }
      ]
    },
    {
      "name": "row-hover",
      "route": "/",
      "steps": [
        {
          "action": "hover",
          "testid": "project-row"
        }
      ]
    },
    {
      "name": "keyboard-focus",
      "route": "/",
      "steps": [
        {
          "action": "press",
          "value": "Tab"
        },
        {
          "action": "press",
          "value": "Tab"
        },
        {
          "action": "press",
          "value": "Tab"
        }
      ]
    },
    {
      "name": "user-menu-open",
      "route": "/",
      "steps": [
        {
          "action": "click",
          "testid": "user-menu-button"
        }
      ]
    },
    {
      "name": "empty-filter",
      "route": "/",
      "steps": [
        {
          "action": "fill",
          "testid": "project-search",
          "value": "zzzz no match"
        }
      ]
    }
  ]
}
