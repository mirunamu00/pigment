{
  "id": "landing",
  "name": "Hourglade landing",
  "port": 4305,
  "holdout": true,
  "routes": [
    {
      "path": "/",
      "name": "Home",
      "capture": true
    },
    {
      "path": "/pricing",
      "name": "Pricing",
      "capture": true
    },
    {
      "path": "/customers",
      "name": "Customers",
      "capture": true
    },
    {
      "path": "/signup",
      "name": "Sign up",
      "capture": true
    }
  ],
  "states": [
    {
      "name": "signup-error",
      "route": "/signup",
      "steps": [
        {
          "action": "fill",
          "testid": "signup-email",
          "value": "nope"
        },
        {
          "action": "click",
          "testid": "signup-submit"
        }
      ]
    },
    {
      "name": "signup-success",
      "route": "/signup",
      "steps": [
        {
          "action": "fill",
          "testid": "signup-name",
          "value": "Robin Example"
        },
        {
          "action": "fill",
          "testid": "signup-email",
          "value": "robin@example.com"
        },
        {
          "action": "focus",
          "testid": "signup-size"
        },
        {
          "action": "press",
          "value": "ArrowDown"
        },
        {
          "action": "fill",
          "testid": "signup-password",
          "value": "calendar42"
        },
        {
          "action": "click",
          "testid": "signup-terms"
        },
        {
          "action": "click",
          "testid": "signup-submit"
        }
      ]
    },
    {
      "name": "pricing-yearly",
      "route": "/pricing",
      "steps": [
        {
          "action": "click",
          "testid": "billing-yearly"
        }
      ]
    },
    {
      "name": "faq-open",
      "route": "/",
      "steps": [
        {
          "action": "click",
          "testid": "faq-toggle"
        }
      ]
    },
    {
      "name": "customers-filtered",
      "route": "/customers",
      "steps": [
        {
          "action": "click",
          "testid": "industry-filter-education"
        }
      ]
    },
    {
      "name": "newsletter-error",
      "route": "/",
      "steps": [
        {
          "action": "fill",
          "testid": "newsletter-email",
          "value": "nope"
        },
        {
          "action": "click",
          "testid": "newsletter-submit"
        }
      ]
    },
    {
      "name": "keyboard-focus",
      "route": "/",
      "steps": [
        {
          "action": "press",
          "value": "Tab"
        },
        {
          "action": "press",
          "value": "Tab"
        },
        {
          "action": "press",
          "value": "Tab"
        }
      ]
    }
  ]
}
