{
  "id": "docs",
  "name": "Ferrule docs",
  "port": 4306,
  "holdout": true,
  "routes": [
    {
      "path": "/",
      "name": "Docs home",
      "capture": true
    },
    {
      "path": "/docs/getting-started/installation",
      "name": "Article (installation)",
      "capture": true
    },
    {
      "path": "/docs/guides/configuration",
      "name": "Reference (configuration)",
      "capture": true
    },
    {
      "path": "/changelog",
      "name": "Changelog",
      "capture": true
    }
  ],
  "states": [
    {
      "name": "search-results",
      "route": "/",
      "steps": [
        {
          "action": "fill",
          "testid": "doc-search",
          "value": "api"
        }
      ]
    },
    {
      "name": "search-empty",
      "route": "/",
      "steps": [
        {
          "action": "fill",
          "testid": "doc-search",
          "value": "zzzz no match"
        }
      ]
    },
    {
      "name": "nav-group-collapsed",
      "route": "/docs/getting-started/installation",
      "steps": [
        {
          "action": "click",
          "testid": "nav-group-toggle-guides"
        }
      ],
      "viewports": [
        "desktop"
      ]
    },
    {
      "name": "copy-code",
      "route": "/docs/getting-started/installation",
      "steps": [
        {
          "action": "click",
          "testid": "copy-button"
        }
      ]
    },
    {
      "name": "keyboard-focus",
      "route": "/",
      "steps": [
        {
          "action": "press",
          "value": "Tab"
        },
        {
          "action": "press",
          "value": "Tab"
        },
        {
          "action": "press",
          "value": "Tab"
        }
      ]
    },
    {
      "name": "mobile-nav-open",
      "route": "/docs/getting-started/installation",
      "steps": [
        {
          "action": "click",
          "testid": "menu-button"
        }
      ],
      "viewports": [
        "mobile"
      ]
    }
  ]
}
