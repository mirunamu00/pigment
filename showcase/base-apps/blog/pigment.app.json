{
  "id": "blog",
  "name": "Field Notes blog",
  "port": 4303,
  "routes": [
    {
      "path": "/",
      "name": "Home",
      "capture": true
    },
    {
      "path": "/posts/shipping-a-design-system",
      "name": "Article (featured)",
      "capture": true
    },
    {
      "path": "/posts/release-notes-people-read",
      "name": "Article",
      "capture": true
    },
    {
      "path": "/about",
      "name": "About",
      "capture": true
    }
  ],
  "states": [
    {
      "name": "newsletter-error",
      "route": "/",
      "steps": [
        {
          "action": "fill",
          "testid": "newsletter-email",
          "value": "nope"
        },
        {
          "action": "click",
          "testid": "newsletter-submit"
        }
      ]
    },
    {
      "name": "newsletter-success",
      "route": "/",
      "steps": [
        {
          "action": "fill",
          "testid": "newsletter-email",
          "value": "reader@example.com"
        },
        {
          "action": "click",
          "testid": "newsletter-submit"
        }
      ]
    },
    {
      "name": "search-empty",
      "route": "/",
      "steps": [
        {
          "action": "fill",
          "testid": "post-search",
          "value": "zzzz no match"
        }
      ]
    },
    {
      "name": "keyboard-focus",
      "route": "/",
      "steps": [
        {
          "action": "press",
          "value": "Tab"
        },
        {
          "action": "press",
          "value": "Tab"
        },
        {
          "action": "press",
          "value": "Tab"
        }
      ]
    }
  ]
}
