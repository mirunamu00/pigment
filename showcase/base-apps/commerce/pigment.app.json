{
  "id": "commerce",
  "name": "Fieldhouse Supply store",
  "port": 4302,
  "routes": [
    {
      "path": "/",
      "name": "Product grid",
      "capture": true
    },
    {
      "path": "/products/canvas-field-tote",
      "name": "Product detail (color)",
      "capture": true
    },
    {
      "path": "/products/merino-crew-sweater",
      "name": "Product detail (size)",
      "capture": true
    },
    {
      "path": "/cart",
      "name": "Cart",
      "capture": true
    }
  ],
  "states": [
    {
      "name": "card-hover",
      "route": "/",
      "steps": [
        {
          "action": "hover",
          "testid": "product-card"
        }
      ]
    },
    {
      "name": "added-to-cart",
      "route": "/products/canvas-field-tote",
      "steps": [
        {
          "action": "click",
          "testid": "add-to-cart"
        }
      ]
    },
    {
      "name": "checkout-errors",
      "route": "/products/canvas-field-tote",
      "steps": [
        {
          "action": "click",
          "testid": "add-to-cart"
        },
        {
          "action": "click",
          "testid": "cart-button"
        },
        {
          "action": "click",
          "testid": "place-order"
        }
      ]
    },
    {
      "name": "keyboard-focus",
      "route": "/",
      "steps": [
        {
          "action": "press",
          "value": "Tab"
        },
        {
          "action": "press",
          "value": "Tab"
        },
        {
          "action": "press",
          "value": "Tab"
        },
        {
          "action": "press",
          "value": "Tab"
        }
      ]
    }
  ]
}
