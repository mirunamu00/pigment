{
  "id": "settings",
  "name": "Account settings",
  "port": 4304,
  "routes": [
    {
      "path": "/settings/profile",
      "name": "Profile",
      "capture": true
    },
    {
      "path": "/settings/notifications",
      "name": "Notifications",
      "capture": true
    },
    {
      "path": "/settings/security",
      "name": "Security",
      "capture": true
    },
    {
      "path": "/settings/billing",
      "name": "Billing",
      "capture": true
    }
  ],
  "states": [
    {
      "name": "profile-errors",
      "route": "/settings/profile",
      "steps": [
        {
          "action": "fill",
          "testid": "profile-name",
          "value": ""
        },
        {
          "action": "fill",
          "testid": "profile-email",
          "value": "not-an-email"
        },
        {
          "action": "click",
          "testid": "profile-save"
        }
      ]
    },
    {
      "name": "profile-saved",
      "route": "/settings/profile",
      "steps": [
        {
          "action": "click",
          "testid": "profile-save"
        }
      ]
    },
    {
      "name": "plan-dialog",
      "route": "/settings/billing",
      "steps": [
        {
          "action": "click",
          "testid": "choose-plan-business"
        }
      ]
    },
    {
      "name": "password-mismatch",
      "route": "/settings/security",
      "steps": [
        {
          "action": "fill",
          "testid": "password-current",
          "value": "old-password-1"
        },
        {
          "action": "fill",
          "testid": "password-new",
          "value": "Correct-horse-9"
        },
        {
          "action": "fill",
          "testid": "password-confirm",
          "value": "different"
        },
        {
          "action": "click",
          "testid": "password-submit"
        }
      ]
    },
    {
      "name": "keyboard-focus",
      "route": "/settings/notifications",
      "steps": [
        {
          "action": "press",
          "value": "Tab"
        },
        {
          "action": "press",
          "value": "Tab"
        },
        {
          "action": "press",
          "value": "Tab"
        },
        {
          "action": "press",
          "value": "Tab"
        }
      ]
    }
  ]
}
