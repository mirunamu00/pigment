+/* Drawn vignette: the art ground cycles lemon, periwinkle, teal, marigold by item order. */
+const GROUNDS = ['lemon', 'periwinkle', 'teal', 'marigold'] as const;
+const FILLS: Record<(typeof GROUNDS)[number], string[]> = {
+  lemon: ['var(--color-art-white)', 'var(--color-band-periwinkle)'],
+  periwinkle: ['var(--color-band-marigold)', 'var(--color-art-white)'],
+  teal: ['var(--color-band-lemon)', 'var(--color-art-white)', 'var(--color-band-marigold)'],
+  marigold: ['var(--color-band-periwinkle)', 'var(--color-band-teal)'],
+};
