+  const index = Math.max(0, products.findIndex((item) => item.slug === product.slug));
+  const ground = GROUNDS[index % GROUNDS.length];
+  const fills = FILLS[ground];
+  const fill = fills[Math.floor(index / GROUNDS.length) % fills.length];
+  const art = productArt[product.slug];
