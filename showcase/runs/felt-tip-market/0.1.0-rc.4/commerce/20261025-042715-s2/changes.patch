+  top: 12%;
+  left: calc(var(--ft-lg) * -0.3);
+}
+
+.ft-error__st2 {
+  bottom: 12%;
+  right: calc(var(--ft-md) * -0.25);
+}
+
+@media (max-width: 767px) {
+  .ft-error {
+    padding-block: calc(var(--size-sticker-sm) + var(--space-8));
+  }
+
+  .ft-error__title {
+    font-size: var(--font-size-display-mobile);
+  }
+
+  .ft-error__lead {
+    font-size: var(--font-size-card-title);
+  }
+
+  .ft-error__st1 {
+    top: var(--space-4);
+  }
+
+  .ft-error__st2 {
+    bottom: var(--space-4);
+  }
+}
+
+/* =====================================================================
+ * Reduced motion: everything is still, lifted states swap instantly.
+ * ===================================================================== */
+@media (prefers-reduced-motion: reduce) {
+  .ft-lift,
+  .ft-plate,
+  .ft-plates > .ft-btn,
+  .cart-button,
+  .menu-button-lines::before,
+  .menu-button-lines::after {
+    transition: none;
+  }
+
+  .ft-sticker--loading {
+    animation: none;
   }
