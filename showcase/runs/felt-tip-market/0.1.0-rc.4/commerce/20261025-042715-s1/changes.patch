+ * ========================================================================= */
+.ft-hero {
+  --ft-lg: clamp(var(--size-sticker-sm), 18vw, var(--size-sticker-hero));
+  --ft-md: clamp(var(--size-sticker-sm), 11vw, var(--size-sticker-md));
