+.site-footer-inner {
+  display: grid;
+  grid-template-columns: 3fr 2fr;
+  gap: var(--space-12);
+  max-width: var(--size-content-app);
+  margin: 0 auto;
+}
+
+.site-footer-headline {
+  margin: 0 0 var(--space-8);
+  font-size: var(--font-size-section);
+  font-weight: var(--font-weight-medium);
+  letter-spacing: var(--font-tracking-display);
+  line-height: var(--font-line-height-heading);
+}
+
+.footer-signup {
+  max-width: 480px;
+}
+
+.footer-signup-label {
+  display: block;
+  margin-bottom: var(--space-2);
+}
+
+.ft-inline-action {
+  display: flex;
+}
+
+.ft-inline-action .input {
+  flex: 1;
+  background: var(--color-surface-on-band);
+  color: var(--color-text-on-band);
+  border-color: var(--color-art-ink);
+  border-start-end-radius: 0;
+  border-end-end-radius: 0;
+}
+
+.ft-inline-action .input::placeholder {
+  color: var(--color-grey-muted);
+}
+
+.ft-inline-action .ft-btn {
+  border-start-start-radius: 0;
+  border-end-start-radius: 0;
+  font-size: var(--font-size-card-title);
+}
+
+.footer-signup-status {
+  min-height: calc(var(--font-size-meta) * var(--font-line-height-lead));
+  margin: var(--space-2) 0 0;
+  font-size: var(--font-size-meta);
+}
+
+.site-footer-links {
+  display: flex;
+  gap: var(--space-16);
+}
+
+.site-footer-heading {
+  margin: 0 0 var(--space-3);
+  font-size: var(--font-size-card-title);
+}
+
+.site-footer-links ul {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.site-footer-links li {
+  margin-bottom: var(--space-2);
+}
+
+.site-footer a {
+  color: var(--color-text-inverse);
+}
+
+.site-footer-meta {
+  max-width: var(--size-content-app);
+  margin: var(--space-16) auto 0;
+  font-size: var(--font-size-meta);
+}
+
+@media (max-width: 767px) {
+  .site-footer {
+    padding: var(--space-12) var(--space-4) var(--space-8);
+  }
+
+  .site-footer-inner {
+    grid-template-columns: 1fr;
+    gap: var(--space-8);
+  }
+
+  .site-footer-headline {
+    font-size: var(--font-size-section-mobile);
+  }
+
+  .site-footer-links {
+    gap: var(--space-12);
+  }
+
+  .site-footer-meta {
+    margin-top: var(--space-12);
   }
 }
