-.article-body h2,
-.article-body h3 {
-  margin-top: var(--space-6);
-}
-
-.body-quote {
-  margin: var(--space-4) 0;
-}
-
-.body-quote blockquote {
-  margin: 0;
-  padding-left: var(--space-4);
-  border-left: 3px solid var(--color-quote-border);
-  font-style: italic;
-}
-
-.code-block {
-  background: var(--color-code-bg);
-  color: var(--color-code-text);
-  font-family: var(--font-mono);
-  font-size: var(--font-size-code);
-  border-radius: var(--radius);
-  padding: var(--space-3) var(--space-4);
-  overflow-x: auto;
-  margin: 0 0 var(--space-4);
-}
-
-.body-list {
-  margin: 0 0 var(--space-4);
-  padding-left: var(--space-6);
-}
-
-.body-list li + li {
-  margin-top: var(--space-1);
-}
-
-.body-figure {
-  margin: var(--space-4) 0;
-}
-
-.image-placeholder {
-  display: block;
-  width: 100%;
-  height: auto;
-  border-radius: var(--radius);
-}
-
-.image-placeholder-bg {
-  fill: var(--color-placeholder-bg);
-}
-
-.image-placeholder-shape {
-  fill: var(--color-placeholder-shape);
-}
-
-.body-figure figcaption {
-  margin-top: var(--space-2);
-}
-
-.article-aside {
-  position: sticky;
-  top: var(--space-4);
-}
-
-.toc {
-  border-left: var(--border-width) solid var(--color-border);
-  padding-left: var(--space-4);
-}
-
-.toc-heading {
-  font-size: var(--font-size-small);
-  text-transform: uppercase;
-  color: var(--color-text-muted);
-}
-
-.toc-list {
-  list-style: none;
-  margin: 0;
-  padding: 0;
-  font-size: var(--font-size-small);
-}
-
-.toc-item + .toc-item {
-  margin-top: var(--space-1);
-}
-
-.toc-item-nested {
-  padding-left: var(--space-3);
-}
-
-.related {
-  margin-top: var(--space-12);
-  border-top: var(--border-width) solid var(--color-border);
-  padding-top: var(--space-6);
-}
-
-/* About */
-.prose {
-  max-width: var(--measure);
-  margin-bottom: var(--space-8);
-}
-
-.author-list {
-  list-style: none;
-  margin: 0;
-  padding: 0;
-  display: flex;
-  flex-direction: column;
-  gap: var(--space-4);
-  max-width: var(--measure);
-}
-
-.author-card {
-  display: flex;
-  gap: var(--space-4);
-  align-items: flex-start;
-}
-
-.avatar {
-  display: inline-flex;
-  align-items: center;
-  justify-content: center;
-  flex-shrink: 0;
-  width: 44px;
-  height: 44px;
-  border-radius: var(--radius-pill);
-  background: var(--color-tag-bg);
-  color: var(--color-tag-text);
-  font-weight: 700;
-  font-size: var(--font-size-small);
-}
-
-@media (max-width: 760px) {
-  .article-layout {
-    grid-template-columns: minmax(0, 1fr);
-  }
-
-  .article-aside {
-    position: static;
-    grid-row: 1;
-  }
+  font-size: var(--font-size-meta);
+  line-height: var(--font-line-height-lead);
 }
