+  }
+
+  .featured-post .ft-media {
+    aspect-ratio: 4 / 3;
+    min-height: 0;
+    border-inline-end: 0;
+    border-block-end: var(--border-width-hair) solid var(--color-border-default);
+  }
+
+  /* tag pills become one scrolling row, cropped at the padding */
+  .tag-filter {
+    flex-wrap: nowrap;
+    overflow-x: auto;
+    width: calc(100% + var(--space-4) * 2);
+    margin-inline: calc(var(--space-4) * -1);
+    padding-inline: var(--space-4);
+  }
+
+  .filter-bar .field {
+    max-width: none;
+  }
+
   .article-layout {
     grid-template-columns: minmax(0, 1fr);
+    gap: var(--space-8);
+    padding-top: var(--space-8);
   }
 
   .article-aside {
     position: static;
     grid-row: 1;
   }
+
+  .body-quote blockquote p {
+    font-size: var(--font-size-card-title);
+  }
+
+  .footer-links {
+    gap: var(--space-8);
+  }
+}
+
+@media (max-width: 639px) {
+  .container {
+    padding-inline: var(--space-4);
+  }
+
+  .ft-band > .ft-band__inner {
+    padding-inline: var(--space-4);
+  }
+
+  .post-list,
+  .post-list-grid {
+    gap: var(--space-4);
+  }
+
+  .post-list-grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .post-card-body,
+  .featured-body,
+  .author-list > li {
+    padding: var(--space-4);
+  }
+
+  .home-body {
+    padding-top: var(--space-12);
+  }
+
+  .field-row-joined .ft-btn {
+    padding: 0 var(--space-4);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .menu-button {
+    transition: none;
+  }
 }
