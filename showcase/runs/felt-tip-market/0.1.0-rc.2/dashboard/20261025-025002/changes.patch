+          Deployments
+        </li>
+        <li>
+          <span className="ft-dot ft-dot--line" aria-hidden="true" />
+          {AVERAGE_WINDOW}-month average
+        </li>
+      </ul>
+      <div className="chart-frame" ref={frameRef}>
+        <svg
