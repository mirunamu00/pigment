+/** The line series is the trailing average over this many months (derived from the bars). */
+const AVERAGE_WINDOW = 3;
+
+function trailingAverage(data: MonthlyValue[]): number[] {
+  return data.map((_, index) => {
+    const window = data.slice(Math.max(0, index - AVERAGE_WINDOW + 1), index + 1);
+    return window.reduce((sum, point) => sum + point.value, 0) / window.length;
+  });
+}
 
