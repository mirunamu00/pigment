+  const average = trailingAverage(data);
+  const linePoints = average.map((value, index) => ({
+    x: PADDING_X + index * slot + slot / 2,
+    y: baseline - (value / max) * plotHeight,
+  }));
 
   return (
     <figure className="chart" data-testid="bar-chart">
       <figcaption className="chart-title">{title}</figcaption>
