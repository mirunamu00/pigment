+}
+
+/* ---------------------------------------------------------------------------
+ * Responsive
+ * ------------------------------------------------------------------------- */
+@media (max-width: 1023px) {
+  .topbar {
+    height: var(--ft-topbar-h-compact);
+  }
+
+  .ft-error {
+    min-height: calc(100vh - var(--ft-topbar-h-compact));
+  }
+
+  .plan-grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+@media (max-width: 767px) {
+  h1 {
+    font-size: var(--font-size-section-mobile);
+  }
+
+  .settings-layout {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  /* Sidebar collapses to a scrolling pill row, cropped at the padding. */
+  .sidebar {
+    border-inline-end: none;
+    border-block-end: var(--border-width-hair) solid var(--color-border-default);
+    padding: var(--space-3) 0;
+    overflow-x: auto;
+  }
+
+  .nav-list {
+    flex-direction: row;
+    padding-inline: var(--ft-gutter);
+    width: max-content;
+  }
+
+  .form-grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .ft-footer__inner {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .ft-footer__headline {
+    font-size: var(--font-size-section-mobile);
+  }
+
+  /* Tables scroll inside their frame with the first column sticky. */
+  .table th:first-child,
+  .table td:first-child {
+    position: sticky;
+    left: 0;
+    z-index: 1;
+    background: var(--color-surface-raised);
+    border-inline-end: var(--border-width-hair) solid var(--color-border-default);
+  }
+
+  .table thead th:first-child {
+    background: var(--color-surface-default);
+  }
+
+  .cell-device {
+    flex-direction: column;
+    align-items: flex-start;
+    gap: var(--space-1);
+    padding-block: var(--space-2);
+  }
+
+  .ft-error h1 {
+    font-size: var(--font-size-display-mobile);
+  }
+
+  .ft-error p {
+    font-size: var(--font-size-card-title);
+  }
+
+  .ft-error {
+    padding-block: calc(var(--size-sticker-band) + var(--space-8));
+  }
+
+  .ft-error .ft-sticker--lg {
+    width: var(--size-sticker-band);
+  }
+
+  .ft-error__key {
+    top: var(--space-4);
+    right: calc(var(--size-sticker-band) * -0.2);
+  }
+
+  .ft-error__receipt {
+    bottom: var(--space-4);
+    left: calc(var(--size-sticker-band) * -0.2);
+  }
+}
+
+@media (max-width: 639px) {
+  .brand {
+    font-size: var(--font-size-card-title);
+  }
+
+  .person {
+    padding-inline: var(--space-4);
+  }
+
+  .page-body {
+    padding-block: var(--space-8) var(--space-12);
+    gap: var(--space-8);
+  }
+
+  .avatar-row {
+    align-items: flex-start;
+  }
+
+  .form-actions > .ft-btn,
+  .dialog-actions > .ft-btn {
+    width: 100%;
+  }
+
+  .dialog-actions {
+    flex-direction: column-reverse;
+  }
+
+  /* Dialog becomes a bottom sheet with square bottom corners. */
+  .dialog {
+    width: 100%;
+    max-width: 100%;
+    margin: auto 0 0;
+    border-end-start-radius: 0;
+    border-end-end-radius: 0;
+  }
+
+  .ft-footer__columns {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+/* ---------------------------------------------------------------------------
+ * Reduced motion: lifts swap instantly, nothing drifts or rocks
+ * ------------------------------------------------------------------------- */
+@media (prefers-reduced-motion: reduce) {
+  .ft-lift,
+  .ft-plate,
+  .ft-plates > .ft-btn,
+  .switch::after {
+    transition: none;
+  }
+
+  .ft-sticker--loading,
+  .ft-sticker-layer > svg,
+  .dialog[open] {
+    animation: none;
   }
 }
