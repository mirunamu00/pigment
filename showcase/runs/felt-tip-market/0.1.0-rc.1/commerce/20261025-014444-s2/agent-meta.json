        "command": "node -e \"\nconst fs=require('fs');const p='src/pages/ProductsPage.tsx';let s=fs.readFileSync(p,'utf8');\nconst i=s.indexOf('  return (\\n    <>\\n      <div className=\\\"page-header\\\">');\ns=s.slice(0,i)+fs.readFileSync(process.argv[1],'utf8');fs.writeFileSync(p,s);\n\" /dev/stdin <<'EOF'\n  return (\n    <>\n      <HeaderBand\n        band={AREA_BAND.shop}\n        art={\n          <StickerLayer className=\"ft-sticker-layer--band\">\n            <Sticker kind=\"tote\" fill=\"white\" accent=\"marigold\" rotate={18} className=\"shop-band-sticker\" />\n          </StickerLayer>\n        }\n      >\n        <h1>Shop all goods</h1>\n        <p className=\"band-lead\">Durable bags, clothing and kitchen goods made to be used every day.</p>\n        <div className=\"chip-group\" role=\"group\" aria-label=\"Filter by category\">\n          {FILTERS.map((filter) => (\n            <button\n              key={filter.value}\n              type=\"button\"\n              className=\"chip\"\n              aria-pressed={category === filter.value}\n              onClick={() => selectCategory(filter.value)}\n              data-testid={`category-filter-${filter.value}`}\n            >\n              {filter.label}\n            </button>\n          ))}\n        </div>\n      </HeaderBand>\n\n      <section className=\"page-body\" aria-labelledby=\"catalog-heading\">\n        <h2 id=\"catalog-heading\" className=\"visually-hidden\">\n          Products\n        </h2>\n        <div className=\"toolbar\">\n          <p className=\"toolbar-count\" role=\"status\" data-testid=\"result-count\">\n            Showing {countLabel}\n          </p>\n\n          <div className=\"toolbar-controls\">\n            <label className=\"field-inline check\">\n              <input\n                type=\"checkbox\"\n                className=\"checkbox\"\n                checked={inStockOnly}\n                onChange={(event) => toggleInStock(event.target.checked)}\n                data-testid=\"in-stock-toggle\"\n              />\n              In stock only\n            </label>\n            <div className=\"field-inline\">\n              <label htmlFor=\"sort-select\">Sort by</label>\n              <span className=\"select-wrap\">\n                <select\n                  id=\"sort-select\"\n                  className=\"select\"\n                  value={sort}\n                  onChange={(event) => selectSort(parseSort(event.target.value))}\n                  data-testid=\"sort-select\"\n                >\n                  {SORT_OPTIONS.map((option) => (\n                    <option key={option.value} value={option.value}>\n                      {option.label}\n                    </option>\n                  ))}\n                </select>\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {visible.length === 0 ? (\n          <div className=\"ft-empty empty-state\" data-testid=\"products-empty\">\n            <Sticker kind=\"parcel\" fill=\"lemon\" accent=\"white\" rotate={-14} className=\"empty-sticker\" />\n            <h3>No products match these filters</h3>\n            <p className=\"muted\">Try another category or include items that are out of stock.</p>\n            <PlateStack>\n              <button type=\"button\" className=\"button button-primary\" onClick={clearFilters} data-testid=\"clear-filters\">\n                Clear filters\n              </button>\n            </PlateStack>\n          </div>\n        ) : (\n          <ul className=\"product-grid\" data-testid=\"product-grid\">\n            {visible.map((product) => (\n              <li key={product.slug} className=\"product-card\" data-testid=\"product-card\">\n                <ProductImage product={product} />\n                <div className=\"product-card-body\">\n                  <p className=\"product-card-eyebrow\">{categoryLabel(product.category)}</p>\n                  <h3 className=\"product-card-title\">\n                    <Link to={`/products/${product.slug}`} className=\"product-link\" data-testid=\"product-link\">\n                      {product.name}\n                    </Link>\n                  </h3>\n                  <p className=\"product-card-summary\">{product.summary}</p>\n                  <p className=\"product-card-meta\">\n                    <PriceFlag testId=\"product-price\">{formatPrice(product.price)}</PriceFlag>\n                    {!product.inStock && (\n                      <span className=\"status-pill\" data-testid=\"sold-out-tag\">\n                        <span className=\"status-dot status-dot--danger\" aria-hidden=\"true\" />\n                        Sold out\n                      </span>\n                    )}\n                  </p>\n                </div>\n              </li>\n            ))}\n          </ul>\n        )}\n      </section>\n    </>\n  );\n}\nEOF",
