    "findings": [
      {
        "severity": "major",
        "area": "signature",
        "summary": "The stickers are thinner, smaller and flatter than the reference's. The reference's coins are big die-cut objects about 200px across, with a deep extruded rim, and they dominate the band corners. Here the blog hero's objects are mid-size line drawings with thin rims. Each product app's header sticker is about 70px and pushed so far into the corner that it reads as a fragment, and on phones only a sliver shows. Several stickers (tote, bell) have no extruded side at all. The commerce empty state reuses the header sticker at a larger size instead of drawing its own object.",
        "samples": 1,
        "of": 1,
        "specCaused": false,
        "evidence": [
          "showcase/runs/felt-tip-market/0.1.0-rc.1/review-1/crops/blog--page--home--desktop-light--s1.png",
          "showcase/runs/felt-tip-market/0.1.0-rc.1/review-1/crops/commerce--page--home--desktop-light--s1.png",
          "showcase/runs/felt-tip-market/0.1.0-rc.1/review-1/crops/dashboard--page--home--desktop-light--s1.png",
          "showcase/runs/felt-tip-market/0.1.0-rc.1/commerce/20261025-011739/drawings/cart-d1.png",
          "showcase/runs/felt-tip-market/0.1.0-rc.1/settings/20261025-011739/drawings/settings-notifications-d1.png",
          "pipeline/gumroad-study/reference/set/01-desktop.png"
        ],
        "promptFix": "Every sticker shows its thickness. Under the face sits a back face or side band at least 8% of the object's height, in the same fill and outlined in ink, plus 1–3 inner strokes (rim, fold, seam). A single flat outline is not a sticker. Hero stickers are 160–240px; a header-band sticker is at least as tall as the band's title block, sits vertically centred at the band's trailing edge, and shows at least 60% of itself on every viewport. When the band is too short for that, shrink the sticker rather than pushing it out of frame. An empty state draws the missing thing in its own pose and silhouette, never a resized copy of another sticker on the page.",
        "items": [
          "blog--page--home--desktop-light",
          "blog--drawings--home",
          "commerce--drawings--home",
          "commerce--drawings--cart",
          "dashboard--drawings--home",
          "dashboard--page--home--desktop-light",
          "dashboard--page--home--mobile-light",
          "settings--drawings--settings-notifications"
        ],
        "kind": "gap",
        "specRule": ""
      },
      {
        "severity": "minor",
        "area": "referenceFidelity",
        "summary": "In dark mode the page ground is dark grey and the panels are pure black, the reverse of the reference, where the ground is black and the boxes are a step lighter. Ground and panels lose separation, and the black top bar and footer no longer read as their own fields. The spec's dark tokens set it up this way: surface.default is #242423 and surface.raised is #000000.",
        "samples": 1,
        "of": 1,
        "specCaused": true,
        "evidence": [
          "showcase/runs/felt-tip-market/0.1.0-rc.1/review-1/crops/dashboard--page--home--desktop-dark--s1.png",
          "showcase/runs/felt-tip-market/0.1.0-rc.1/review-1/crops/blog--page--home--desktop-dark--s1.png",
          "pipeline/gumroad-study/reference/set/11-desktop.png"
        ],
        "promptFix": "Dark mode: the page ground (`color.surface.default`) is black (#000000), and raised boxes (`color.surface.raised`) are one step lighter (#242423), edged with the 35% white hairline. Depth then reads the same way as paper under white in light mode.",
        "items": [
