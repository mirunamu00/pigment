+    height: 1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+  }
+
+  .table--list tr,
+  .table--list td {
+    display: flex;
+  }
+
+  .table--list tr {
+    flex-direction: column;
+  }
+
+  .table--list td,
+  .table--list td:first-child {
+    position: static;
+    height: auto;
+    min-height: var(--size-control);
+    justify-content: space-between;
+    align-items: center;
+    gap: var(--space-4);
+    border-right: 0;
+    border-bottom: var(--border-width-hair) solid var(--color-border-default);
+    text-align: right;
+  }
+
+  .table--list td::before {
+    content: attr(data-label);
+    font-family: var(--font-family-sans);
+    font-size: var(--font-size-body);
+    font-weight: var(--font-weight-bold);
+    text-align: left;
+  }
+
+  .table--list tbody tr:last-child td:last-child {
+    border-bottom: 0;
+  }
+}
+
+@media (max-width: 639px) {
+  .panel,
+  .card {
+    padding: var(--space-4);
+  }
+
+  .panel-flush {
+    padding: 0;
+  }
+
+  .panel-flush > .panel-title,
+  .activity-item,
+  .progress-row,
+  .task,
+  .details > div {
+    padding-inline: var(--space-4);
+  }
+
+  .details {
+    margin: var(--space-4) calc(var(--space-4) * -1) calc(var(--space-4) * -1);
+  }
+
+  .user-menu-button {
+    padding: 0 var(--space-4);
+  }
+
+  .user-menu-name {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+  }
+
+  .ft-empty {
+    padding: var(--space-8) var(--space-4);
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Reduced motion: lifts swap instantly, drift and rocking stop.      */
+/* ------------------------------------------------------------------ */
+@media (prefers-reduced-motion: reduce) {
+  .ft-lift,
+  .button,
+  .user-menu-button,
+  .ft-plate,
+  .ft-plates > .ft-btn {
+    transition: none;
+  }
+
+  .ft-sticker--loading,
+  .ft-rock-glyph,
+  .user-menu-panel {
+    animation: none;
   }
 }
