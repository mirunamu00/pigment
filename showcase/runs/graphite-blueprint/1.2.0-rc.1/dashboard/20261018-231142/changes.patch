+
+.avatar--profile {
+  width: 32px;
+  height: 32px;
+}
+
+/* ---------- Cards, panels ---------- */
+.card {
+  background: var(--color-surface-card);
+  border: var(--border-width-hairline) solid var(--color-border-default);
+  border-radius: var(--radius-md);
+  padding: var(--space-20);
+  min-width: 0;
+}
+
+.panel-title {
+  margin-bottom: var(--space-12);
+  font-size: var(--font-size-body);
+  line-height: var(--font-line-height-ui);
+  font-weight: var(--font-weight-semibold);
+}
+
+/* A panel that is mainly a quiet stage drops its border and fill, title above */
+.panel-stage {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+}
+
+.panel-stage > .stage {
+  flex: 1;
+  min-height: calc(var(--size-stage-mini) + 2 * var(--space-24));
+}
+
+/* KPI metric cards */
+.kpi-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: var(--space-16);
+}
+
+.kpi-card {
+  display: grid;
+  align-content: start;
+  gap: var(--space-12);
+}
+
+.kpi-label {
+  margin: 0;
+  overflow: hidden;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+}
+
+.kpi-value {
+  font-size: var(--font-size-h3);
+  line-height: var(--font-line-height-heading);
+  font-weight: var(--font-weight-medium);
+  letter-spacing: var(--font-tracking-display);
+  color: var(--color-text-primary);
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+}
+
+.kpi-change .status-dot {
+  margin-top: calc((1.5em - var(--space-6)) / 2);
+}
+
+.kpi-change {
+  display: flex;
+  align-items: flex-start;
+  gap: var(--space-6);
+  font-size: var(--font-size-small);
+  line-height: var(--font-line-height-ui);
+  color: var(--color-text-body);
+  font-variant-numeric: tabular-nums;
+}
+
+.status-dot {
+  flex: none;
+  width: var(--space-6);
+  height: var(--space-6);
+  border-radius: var(--radius-full);
+  background: var(--color-icon-idle);
+}
+
+.kpi-change-up .status-dot {
+  background: var(--color-status-success);
+}
+
+.kpi-change-down .status-dot {
+  background: var(--color-status-danger);
+}
+
+/* Loading: static bars on surface.hover, no pulse */
+.skeleton {
+  display: block;
+  background: var(--color-surface-hover);
+  border-radius: var(--radius-xs);
+}
+
+.skeleton-label {
+  width: 60%;
+  height: 12px;
+  margin-block: 2px;
+}
+
+.skeleton-value {
+  width: 40%;
+  height: 32px;
+  margin-block: 2px;
+}
+
+.skeleton-change {
+  width: 50%;
+  height: 12px;
+  margin-block: 4px;
+}
+
+.two-column {
+  display: grid;
+  grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
+  gap: var(--space-16);
+  align-items: stretch;
+}
+
+/* ---------- Chart (dot columns) ---------- */
+.chart {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  margin: 0;
+  padding: var(--space-16) var(--space-20) var(--space-12);
+}
+
+.chart-title {
+  font-size: var(--font-size-small);
+  color: var(--color-text-secondary);
+}
+
+.chart-plot {
+  position: relative;
+  flex: 1;
+  min-height: 200px;
+  margin-top: var(--space-8);
+}
+
+.chart-svg {
+  position: absolute;
+  inset: 0;
+  display: block;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+}
+
+.chart-col {
+  transform-box: fill-box;
+  transform-origin: 50% 100%;
+  animation: chart-in var(--motion-duration-chart) var(--motion-easing-standard) both;
+  animation-delay: calc(var(--col) * 8ms);
+}
+
+@keyframes chart-in {
+  from {
+    opacity: 0;
+    transform: scale(0.4);
+  }
+}
+
+.chart-dot {
+  fill: var(--color-chart-mark);
+}
+
+.chart-col--highlight .chart-dot {
+  fill: var(--color-chart-highlight);
+}
+
+.chart-dot--track {
+  opacity: var(--opacity-dot-track);
+}
+
+.chart-value {
+  font: var(--font-weight-medium) var(--font-size-caption) var(--font-family-sans);
+  fill: var(--color-text-primary);
+  font-variant-numeric: tabular-nums;
+}
+
+.chart-label {
+  font: var(--font-weight-regular) var(--font-size-caption) var(--font-family-mono);
+  text-transform: uppercase;
+  fill: var(--color-text-tertiary);
+}
+
+/* ---------- Activity ---------- */
+.activity-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.activity-item {
+  display: grid;
+  gap: var(--space-2);
+  padding: var(--space-12) 0;
+  font-size: var(--font-size-small);
+  line-height: var(--font-line-height-ui);
+}
+
+.activity-item:first-child {
+  padding-top: 0;
+}
+
+.activity-item:last-child {
+  padding-bottom: 0;
+}
+
+.activity-item + .activity-item {
+  border-top: var(--border-width-hairline) solid var(--color-border-subtle);
+}
+
+.activity-item strong {
+  font-weight: var(--font-weight-medium);
+  color: var(--color-text-primary);
+}
+
+/* ---------- Table section ---------- */
+.table-section {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  margin-top: var(--space-32);
+}
+
+.table-section-head {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--space-16);
+}
+
+.table-section-head h2 {
+  font-size: var(--font-size-body);
+  line-height: var(--font-line-height-ui);
+  font-weight: var(--font-weight-semibold);
+}
+
+.toolbar {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: var(--space-12) var(--space-16);
+  margin: var(--space-12) 0 var(--space-16);
+}
+
+/* Segmented pills: track surface.card, padding space.2, items controlSm; selected press + ring */
+.segmented {
+  display: inline-flex;
+  gap: var(--space-2);
+  padding: var(--space-2);
+  border-radius: var(--radius-full);
+  background: var(--color-surface-card);
+  box-shadow: inset 0 0 0 var(--border-width-hairline) var(--color-border-subtle);
+}
+
+.segmented-button {
+  height: var(--size-control-sm);
+  padding: 0 var(--space-12);
+  border: 0;
+  border-radius: var(--radius-full);
+  background: transparent;
+  color: var(--color-text-secondary);
+  font: var(--font-weight-medium) var(--font-size-small) / 1 var(--font-family-sans);
+  letter-spacing: var(--font-tracking-body);
+  cursor: pointer;
+  transition:
+    background-color var(--motion-duration-hover) var(--motion-easing-ease),
+    color var(--motion-duration-hover) var(--motion-easing-ease),
+    transform var(--motion-duration-hover) var(--motion-easing-standard);
+}
+
+.segmented-button:active {
+  transform: scale(0.971);
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .segmented-button:hover {
+    color: var(--color-text-body);
+  }
+}
+
+.segmented-button[aria-pressed='true'] {
+  background: var(--color-surface-press);
+  box-shadow: var(--elevation-ring);
+  color: var(--color-text-primary);
+}
+
+/* ---------- Table ---------- */
+.tbl-wrap {
+  min-width: 0;
+}
+
+.tbl {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: var(--font-size-small);
+  line-height: var(--font-line-height-ui);
+  color: var(--color-text-body);
+}
+
+.tbl th,
+.tbl td {
+  padding: 0 var(--space-12);
+  text-align: left;
+  vertical-align: middle;
+  border-bottom: var(--border-width-hairline) solid var(--color-border-subtle);
+}
+
+.tbl th {
+  height: var(--size-row-dense);
+  border-top: var(--border-width-hairline) solid var(--color-border-subtle);
+  font: var(--font-weight-regular) var(--font-size-caption) / var(--font-line-height-caption) var(--font-family-mono);
+  letter-spacing: 0;
+  text-transform: uppercase;
+  color: var(--color-text-tertiary);
+  white-space: nowrap;
+}
+
+.tbl th[aria-sort='ascending'],
+.tbl th[aria-sort='descending'] {
+  color: var(--color-text-secondary);
+}
+
+.tbl td {
+  height: var(--size-row);
+  padding-block: var(--space-6);
+}
+
+.tbl td:first-child {
+  color: var(--color-text-primary);
+  font-weight: var(--font-weight-medium);
+}
+
+.tbl .num {
+  text-align: right;
+  font-variant-numeric: tabular-nums;
+}
+
+.tbl .mono {
+  font: var(--font-weight-regular) var(--font-size-caption) / var(--font-line-height-caption) var(--font-family-mono);
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+}
+
+.tbl tbody tr {
+  transition: background-color var(--motion-duration-hover) var(--motion-easing-ease);
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .tbl tbody tr:hover {
+    background: var(--color-surface-tint);
+  }
+}
+
+.tbl :is(th, td):first-child {
+  padding-left: 0;
+}
+
+.tbl :is(th, td):last-child {
+  padding-right: 0;
+}
+
+.tbl .pin {
+  position: sticky;
+  right: 0;
+  z-index: 1;
+  text-align: right;
+  background: var(--pin-bg, var(--color-surface-default));
+  white-space: nowrap;
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .tbl tr:hover .pin {
+    background: linear-gradient(var(--color-surface-tint), var(--color-surface-tint)), var(--pin-bg, var(--color-surface-default));
+  }
+}
+
+.tbl .sort-button {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-4);
+  height: var(--size-row-dense);
+  padding-inline: 0;
+  border: 0;
+  background: none;
+  font: inherit;
+  letter-spacing: inherit;
+  text-transform: inherit;
+  color: inherit;
+  cursor: pointer;
+  transition: color var(--motion-duration-hover) var(--motion-easing-ease);
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .tbl .sort-button:hover {
+    color: var(--color-text-primary);
+  }
+}
+
+.tbl :is(.num, .pin) .sort-button {
+  flex-direction: row-reverse;
+}
+
+.sort-indicator {
+  display: inline-flex;
+}
+
+.sort-indicator .icon {
+  width: 12px;
+  height: 12px;
+}
+
+.sort-indicator--ascending .icon {
+  rotate: 180deg;
+}
+
+.cell-first {
+  display: flex;
+  align-items: center;
+  gap: var(--space-12);
+  min-width: 0;
+}
+
+.cell-lines {
+  display: grid;
+  min-width: 0;
+}
+
+.cell-lines > a {
+  color: var(--color-text-primary);
+  text-decoration-color: transparent;
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .cell-lines > a:hover {
+    text-decoration-color: var(--color-text-primary);
+  }
+}
+
+.cell-sub {
+  font-weight: var(--font-weight-regular);
+  color: var(--color-text-secondary);
+}
+
+.cell-sub a,
+a.cell-sub {
+  color: var(--color-text-secondary);
+}
+
+/* Status: 14px icon plus word in body color */
+.status {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-6);
+  color: var(--color-text-body);
+  white-space: nowrap;
+}
+
+.status-icon {
+  flex: none;
+}
+
+.status-icon--todo,
+.status-icon--paused,
+.status-icon--canceled {
+  color: var(--color-icon-idle);
+}
+
+.status-icon--progress {
+  color: var(--color-status-warning);
+}
+
+.status-icon--done {
+  color: var(--color-status-success);
+}
+
+.status-icon--urgent {
+  color: var(--color-status-urgent);
+}
+
+/* Badge */
+.badge {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-6);
+  height: 20px;
+  padding: 0 var(--space-8);
+  border: var(--border-width-hairline) solid var(--color-border-default);
+  border-radius: var(--radius-full);
+  background: transparent;
+  font: var(--font-weight-medium) var(--font-size-caption) / 1 var(--font-family-sans);
+  color: var(--color-text-body);
+  white-space: nowrap;
+}
+
+.badge .status-icon {
+  width: 12px;
+  height: 12px;
+}
+
+/* Table sm–md: scroll in its wrapper, first column nowrap */
+@media (min-width: 640px) and (max-width: 767.98px) {
+  .tbl-wrap {
+    overflow-x: auto;
+  }
+
+  .tbl :is(th, td):first-child {
+    white-space: nowrap;
+    min-width: 160px;
+  }
+
+  .tbl .pin {
+    box-shadow: inset 1px 0 0 var(--color-border-subtle);
+  }
+
+  .pin::before {
+    content: '';
+    position: absolute;
+    inset-block: 0;
+    right: 100%;
+    width: var(--space-16);
+    pointer-events: none;
+    background: linear-gradient(90deg, transparent, var(--pin-bg, var(--color-surface-default)));
+  }
+}
+
+@media (max-width: 639.98px) {
+  /* breakpoint.sm */
+  .tbl-wrap {
+    overflow-x: visible;
+  }
+
+  .tbl {
+    width: 100%;
+  }
+
+  .tbl :is(th, td):not(:first-child):not(.pin) {
+    display: none;
+  }
+
+  .tbl :is(th, td):first-child {
+    width: 100%;
+    max-width: 0;
+    overflow: hidden;
+  }
+
+  .tbl .pin {
+    width: 1%;
+    white-space: nowrap;
+    padding-left: var(--space-12);
+  }
+
+  .cell-lines {
+    flex: 1;
+    min-width: 0;
+  }
+
+  .cell-lines > *,
+  .cell-lines[data-sub]::after {
+    display: block;
+    line-height: var(--font-line-height-ui);
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+  }
+
+  .cell-lines[data-sub]::after {
+    content: attr(data-sub) '\00a0';
+    color: var(--color-text-tertiary);
+    font-weight: var(--font-weight-regular);
+  }
+
+  .cell-lines .badge {
+    padding: 0;
+    border: 0;
+  }
+
+  .cell-lines .badge-label {
+    position: absolute;
+    clip: rect(0 0 0 0);
+  }
+
+  .hide-sm {
+    display: none;
+  }
+}
