+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const RAIL_QUERY = '(min-width: 1024px)';
+
+// One contents list: a side rail from breakpoint.lg (always open, summary hidden), a closed
+// disclosure after the lead plate below it. The current heading gets the bar on the track.
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const [open, setOpen] = useState(() => window.matchMedia(RAIL_QUERY).matches);
+  const [current, setCurrent] = useState<string | null>(null);
+
+  useEffect(() => {
+    const query = window.matchMedia(RAIL_QUERY);
+    const sync = () => setOpen(query.matches);
+    query.addEventListener('change', sync);
+    return () => query.removeEventListener('change', sync);
+  }, []);
+
+  const ids = headings.map((heading) => heading.id).join(' ');
+  useEffect(() => {
+    const targets = ids
+      .split(' ')
+      .map((id) => document.getElementById(id))
+      .filter((el): el is HTMLElement => el !== null);
+    if (targets.length === 0) return;
+    const update = () => {
+      // The last heading that has passed the reading line under the sticky header.
+      const line = 140;
+      let active: string | null = null;
+      for (const el of targets) if (el.getBoundingClientRect().top <= line) active = el.id;
+      setCurrent(active ?? targets[0].id);
+    };
+    update();
+    window.addEventListener('scroll', update, { passive: true });
+    window.addEventListener('hashchange', update);
+    return () => {
+      window.removeEventListener('scroll', update);
+      window.removeEventListener('hashchange', update);
+    };
+  }, [ids]);
+
   if (headings.length === 0) return null;
 
   return (
-    <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
+    <details className="toc-details" open={open} onToggle={(event) => setOpen(event.currentTarget.open)}>
+      <summary>
         On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
-    </nav>
+        <svg className="toc-chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
+          <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" strokeWidth="1.5" />
+        </svg>
+      </summary>
+      <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
+        <h2 id="toc-heading" className="toc-heading mono-label">
+          On this page
+        </h2>
+        <ol className="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a
+                href={`#${heading.id}`}
+                className="toc-link"
+                data-testid="toc-link"
+                aria-current={current === heading.id ? 'location' : undefined}
+              >
+                {heading.text}
+              </a>
+            </li>
+          ))}
+        </ol>
+      </nav>
+    </details>
   );
 }
