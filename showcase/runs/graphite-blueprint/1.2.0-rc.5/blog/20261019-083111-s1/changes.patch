-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
-    </nav>
+    <details className="toc-details">
+      <summary className="toc-summary">
+        <span>Contents</span>
+        <svg className="toc-chevron" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
+          <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" strokeWidth="1.5" />
+        </svg>
+      </summary>
+      <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
+        <h2 id="toc-heading" className="toc-heading mono-label">
+          On this page
+        </h2>
+        <ol className="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a
+                href={`#${heading.id}`}
+                className={`toc-link${current === heading.id ? ' is-current' : ''}`}
+                data-testid="toc-link"
