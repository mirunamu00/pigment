+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+/**
+ * Contents list. A side rail from breakpoint.lg; below it a closed <details> after the lead plate.
+ * One DOM for both: CSS shows the details content and hides the summary on wide screens.
+ */
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const [current, setCurrent] = useState<string | null>(headings[0]?.id ?? null);
+  const ids = headings.map((heading) => heading.id).join(' ');
+
+  // Marks the heading nearest the top of the viewport as the current entry.
+  useEffect(() => {
+    const targets = ids
+      .split(' ')
+      .map((id) => document.getElementById(id))
+      .filter((el): el is HTMLElement => el !== null);
+    if (targets.length === 0) return;
+    function update() {
+      let active = targets[0].id;
+      for (const target of targets) if (target.getBoundingClientRect().top < 120) active = target.id;
+      setCurrent(active);
+    }
+    update();
+    window.addEventListener('scroll', update, { passive: true });
+    return () => window.removeEventListener('scroll', update);
+  }, [ids]);
+
   if (headings.length === 0) return null;
 
   return (
-    <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
