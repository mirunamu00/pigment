@@ -1,25 +1,92 @@
+import { useEffect, useState, type MouseEvent } from 'react';
 import type { Block } from '../data/posts';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+// From breakpoint.lg the contents list is a side rail (always open); below it, a closed disclosure after the
+// lead plate.
+const RAIL_QUERY = '(min-width: 1024px)';
+
+function useRail() {
+  const [rail, setRail] = useState(() => window.matchMedia(RAIL_QUERY).matches);
+  useEffect(() => {
+    const query = window.matchMedia(RAIL_QUERY);
+    const update = () => setRail(query.matches);
+    query.addEventListener('change', update);
+    return () => query.removeEventListener('change', update);
+  }, []);
+  return rail;
+}
+
+/** The heading the reader is in: the last one whose top has passed the upper third of the viewport. */
+function useCurrentHeading(ids: string[]) {
+  const [current, setCurrent] = useState<string | null>(ids[0] ?? null);
+  const key = ids.join(' ');
+  useEffect(() => {
+    let frame = 0;
+    const update = () => {
+      frame = 0;
+      let next = ids[0] ?? null;
+      for (const id of ids) {
+        const element = document.getElementById(id);
+        if (element && element.getBoundingClientRect().top <= window.innerHeight / 3) next = id;
+      }
+      setCurrent(next);
+    };
+    const schedule = () => {
+      if (!frame) frame = requestAnimationFrame(update);
+    };
+    update();
+    window.addEventListener('scroll', schedule, { passive: true });
+    window.addEventListener('hashchange', schedule);
+    return () => {
+      window.removeEventListener('scroll', schedule);
+      window.removeEventListener('hashchange', schedule);
+      cancelAnimationFrame(frame);
+    };
+  }, [key]);
+  return current;
+}
+
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
+  const rail = useRail();
+  const [open, setOpen] = useState(false);
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const current = useCurrentHeading(headings.map((heading) => heading.id));
   if (headings.length === 0) return null;
 
+  function toggle(event: MouseEvent) {
+    event.preventDefault();
+    if (!rail) setOpen((value) => !value);
+  }
+
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      <details className="toc-details" open={rail || open}>
+        <summary className="toc-summary" onClick={toggle} tabIndex={rail ? -1 : undefined}>
+          <h2 id="toc-heading" className="toc-heading">
+            On this page
+          </h2>
+          <svg className="toc-chevron" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
+            <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" strokeWidth="1.5" />
+          </svg>
+        </summary>
+        <div className="toc-panel">
+          <ol className="toc-list">
+            {headings.map((heading) => (
+              <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+                <a
+                  href={`#${heading.id}`}
+                  className={heading.id === current ? 'toc-link is-current' : 'toc-link'}
+                  data-testid="toc-link"
+                >
+                  {heading.text}
+                </a>
+              </li>
+            ))}
+          </ol>
+        </div>
+      </details>
     </nav>
   );
 }
