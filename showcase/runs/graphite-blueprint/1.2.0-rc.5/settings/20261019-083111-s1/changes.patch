+    --page-pad: var(--space-20);
+  }
+
+  .settings-group {
+    grid-template-columns: minmax(0, 1fr);
+    gap: var(--space-16);
+  }
+
+  .section-description {
+    max-width: none;
+  }
+
+  .form-actions {
+    flex-direction: column;
+    align-items: stretch;
+  }
+
+  .form-actions .button {
+    display: flex;
+    width: 100%;
+  }
+
+  .form-actions .status-message:not(:empty) {
+    justify-content: center;
+  }
+}
+
+@media (max-width: 639.98px) {
+  .card-grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .tbl-wrap {
+    overflow-x: visible;
+  }
+
+  .tbl {
+    width: 100%;
+  }
+
+  .tbl :is(th, td):not(:first-child):not(.pin) {
+    display: none;
+  }
+
+  .tbl :is(th, td):first-child {
+    width: 100%;
+    max-width: 0;
+    min-width: 0;
+    overflow: hidden;
+  }
+
+  .tbl .pin {
+    width: 1%;
