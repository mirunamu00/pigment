+.switch-text .switch-description {
+  font-size: var(--font-size-small);
+  line-height: var(--font-line-height-ui);
+  color: var(--color-text-secondary);
+}
+
+/* The native checkbox is the hit area: padded to 44px, the 28x16 track drawn inside it. */
+.switch {
+  appearance: none;
+  position: relative;
+  flex-shrink: 0;
+  width: var(--switch-width);
+  height: var(--switch-height);
+  margin: 0;
+  border: var(--border-width-hairline) solid var(--color-border-check);
+  border-radius: var(--radius-full);
+  background: var(--color-surface-press);
+  cursor: pointer;
+  transition:
+    background-color var(--motion-duration-hover) var(--motion-easing-standard),
+    border-color var(--motion-duration-hover) var(--motion-easing-standard);
+}
+
+.switch::before {
+  content: '';
+  position: absolute;
+  inset: -14px -8px;
+}
+
+.switch::after {
+  content: '';
+  position: absolute;
+  top: 1px;
+  left: 1px;
+  width: 12px;
+  height: 12px;
+  border-radius: var(--radius-full);
+  background: var(--color-text-secondary);
+  transition:
+    transform var(--motion-duration-hover) var(--motion-easing-standard),
+    background-color var(--motion-duration-hover) var(--motion-easing-standard);
+}
+
+.switch:checked {
+  background: var(--color-accent-default);
+  border-color: var(--color-accent-default);
+}
+
+.switch:checked::after {
+  transform: translateX(12px);
+  background: var(--color-text-on-accent);
+}
+
+.switch:disabled {
+  opacity: var(--opacity-disabled);
+  cursor: not-allowed;
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .switch:hover:not(:disabled):not(:checked) {
+    border-color: var(--color-text-secondary);
+  }
+}
