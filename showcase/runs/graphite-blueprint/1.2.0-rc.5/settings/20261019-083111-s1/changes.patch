+  }
+
+  .dialog-actions {
+    flex-direction: column-reverse;
+  }
+
+  .dialog-actions .button {
+    display: flex;
+    width: 100%;
+  }
+}
+
+/* Table pin and sort helpers from the Table recipe. */
+.tbl :is(th, td):first-child {
+  padding-left: 0;
+}
+
+.tbl :is(th, td):last-child {
+  padding-right: 0;
+}
+
+.tbl .pin {
+  position: sticky;
+  right: 0;
+  z-index: 1;
+  background: var(--pin-bg, var(--color-surface-default));
+  box-shadow: inset 1px 0 0 var(--color-border-subtle);
+}
+
+.pin::before {
+  content: '';
+  position: absolute;
+  inset-block: 0;
+  right: 100%;
+  width: var(--space-16);
+  pointer-events: none;
+  background: linear-gradient(90deg, transparent, var(--pin-bg, var(--color-surface-default)));
+}
+
+@media (hover: hover) and (pointer: fine) {
+  tr:hover .pin {
+    background: linear-gradient(var(--color-surface-tint), var(--color-surface-tint)), var(--pin-bg, var(--color-surface-default));
+  }
+}
+
+.tbl :is(.num, .pin) .sort-button {
+  flex-direction: row-reverse;
 }
