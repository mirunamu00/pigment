+        viewBox="0 0 160 120"
+        aria-hidden="true"
+        focusable="false"
+        dangerouslySetInnerHTML={{ __html: specFigure(product.slug, KINDS.get(product.slug)) }}
+      />
+      <span className="mono-label" aria-hidden="true">
+        {plateCaption(product)}
+      </span>
     </div>
   );
 }
