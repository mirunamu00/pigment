+/** One fact per product for its spec plate caption, at most 18 characters. */
+const SPEC_FACTS: Record<string, string> = {
+  'canvas-field-tote': '18 oz canvas',
+  'waxed-day-pack': '22 litre pack',
+  'weekender-duffel': '45 litre duffel',
+  'merino-crew-sweater': '100% merino',
+  'heavyweight-pocket-tee': '240 gsm jersey',
+  'cotton-chore-coat': 'Cotton twill',
+  'enamel-camp-mug': '350 ml steel',
+  'cast-iron-skillet': 'Pre-seasoned iron',
+  'linen-tea-towels': '100% linen',
+  'leather-key-ring': 'Veg-tanned leather',
+  'ribbed-wool-beanie': 'Wool blend',
+};
+
+export function specFact(product: Product): string {
+  return SPEC_FACTS[product.slug] ?? categoryLabel(product.category);
+}
+
 export function findProduct(slug: string | undefined): Product | undefined {
   return products.find((product) => product.slug === slug);
 }
