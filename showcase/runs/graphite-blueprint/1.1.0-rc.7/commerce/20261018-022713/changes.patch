index dddcb4d..4e4725b 100644
--- a/src/data/products.ts
+++ b/src/data/products.ts
@@ -183,6 +183,27 @@ export const products: Product[] = [
   },
 ];
 
+/** One fact per product for its spec plate caption, at most 18 characters. */
+const PLATE_FACTS: Record<string, string> = {
+  'canvas-field-tote': '18 oz canvas',
+  'waxed-day-pack': '22 L capacity',
+  'weekender-duffel': '45 L capacity',
+  'merino-crew-sweater': '100% merino',
+  'heavyweight-pocket-tee': '240 gsm jersey',
+  'cotton-chore-coat': 'Cotton twill',
+  'enamel-camp-mug': '350 ml steel',
+  'cast-iron-skillet': 'Pre-seasoned iron',
+  'linen-tea-towels': '100% linen',
+  'leather-key-ring': 'Veg-tanned leather',
+  'ribbed-wool-beanie': 'Wool blend',
+};
+
+/** Spec plate caption, e.g. "FIG 01 · 18 oz canvas" (shown uppercase). Numbered by catalog order. */
+export function plateCaption(product: Product): string {
+  const number = String(products.indexOf(product) + 1).padStart(2, '0');
+  return `FIG ${number} · ${PLATE_FACTS[product.slug] ?? categoryLabel(product.category)}`;
+}
+
 export function findProduct(slug: string | undefined): Product | undefined {
   return products.find((product) => product.slug === slug);
 }
