+/* ---------- Hover (fine pointers only) ---------- */
+@media (hover: hover) and (pointer: fine) {
+  a:hover {
+    text-decoration-color: var(--color-text-primary);
+  }
+
+  .nav-link:hover {
+    color: var(--color-text-primary);
+    background: var(--color-action-ghost-hover);
+  }
+
+  .icon-button:hover {
+    color: var(--color-icon-active);
+    background: var(--color-action-ghost-hover);
+  }
+
+  .button-primary:hover:not(:disabled) {
+    background: var(--color-action-primary-hover);
+  }
+
+  .button-secondary:hover:not(:disabled) {
+    background: var(--color-action-secondary-hover);
+    color: var(--color-text-primary);
+  }
+
+  .button-bordered:hover:not(:disabled) {
+    border-color: var(--color-border-strong);
+    color: var(--color-text-primary);
+  }
+
+  .chip:hover {
+    color: var(--color-text-primary);
+    border-color: var(--color-border-strong);
+  }
+
+  .input:hover:not(:disabled):not(:focus-visible):not([aria-invalid='true']),
+  .select:hover:not(:disabled):not(:focus-visible),
+  .stepper-controls:hover:not(:has(:focus-visible)) {
+    border-color: var(--color-border-strong);
+  }
+
+  .checkbox:hover input:not(:checked) {
+    border-color: var(--color-text-secondary);
+  }
+
+  .stepper-button:hover:not(:disabled) {
+    color: var(--color-icon-active);
+    background: var(--color-action-ghost-hover);
+  }
+
+  .segment:hover:not(:has(:checked)) {
+    color: var(--color-text-body);
+  }
+
+  .product-card:hover {
+    --cell-line: var(--color-border-strong);
+    background: var(--color-surface-hover);
+  }
+
+  :is(.opener-link, .breadcrumb a, .footer-column a, .cart-line-name):hover {
+    color: var(--color-text-primary);
+  }
+
+  .cart-line-name:hover {
+    text-decoration: underline;
+    text-decoration-color: var(--color-text-primary);
+  }
