+/** The rail shows from this width; below it the list sits after the lead plate in a closed disclosure. */
+const RAIL_QUERY = '(min-width: 1280px)';
+
+function useRail() {
+  const [rail, setRail] = useState(() => typeof window !== 'undefined' && window.matchMedia(RAIL_QUERY).matches);
+  useEffect(() => {
+    const query = window.matchMedia(RAIL_QUERY);
+    const update = () => setRail(query.matches);
+    query.addEventListener('change', update);
+    return () => query.removeEventListener('change', update);
+  }, []);
+  return rail;
+}
+
+/** The heading nearest above the reading line is the current one. */
+function useCurrentHeading(ids: string[]) {
+  const [current, setCurrent] = useState<string | undefined>(ids[0]);
+  useEffect(() => {
+    let frame = 0;
+    function update() {
+      frame = 0;
+      const line = 120;
+      let active = ids[0];
+      for (const id of ids) {
+        const element = document.getElementById(id);
+        if (element && element.getBoundingClientRect().top <= line) active = id;
+      }
+      setCurrent(active);
+    }
+    function schedule() {
+      if (!frame) frame = requestAnimationFrame(update);
+    }
+    update();
+    window.addEventListener('scroll', schedule, { passive: true });
+    window.addEventListener('hashchange', schedule);
+    return () => {
+      window.removeEventListener('scroll', schedule);
+      window.removeEventListener('hashchange', schedule);
+      cancelAnimationFrame(frame);
+    };
+  }, [ids.join('|')]);
+  return current;
+}
+
 export default function TableOfContents({ entries }: { entries: TocEntry[] }) {
+  const rail = useRail();
+  const detailsRef = useRef<HTMLDetailsElement>(null);
+  const current = useCurrentHeading(entries.map((entry) => entry.id));
+
+  // On the rail the list is always open; below it the disclosure starts closed.
+  useEffect(() => {
+    if (detailsRef.current) detailsRef.current.open = rail;
+  }, [rail]);
+
   if (entries.length === 0) return null;
 
+  function handleSummaryClick(event: MouseEvent) {
+    if (rail) event.preventDefault();
+  }
+
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ul className="toc-list">
-        {entries.map((entry) => (
-          <li key={entry.id} className={entry.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${entry.id}`} className="toc-link" data-testid="toc-link">
-              <Inline text={entry.text} />
-            </a>
-          </li>
-        ))}
-      </ul>
+      <details ref={detailsRef} className="toc-details" open={rail}>
+        <summary className="toc-summary" onClick={handleSummaryClick} tabIndex={rail ? -1 : undefined}>
+          <h2 id="toc-heading" className="toc-heading">
+            On this page
+          </h2>
+          <ChevronIcon className="toc-chevron" />
+        </summary>
+        <ul className="toc-list">
+          {entries.map((entry) => (
+            <li key={entry.id} className={entry.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a
+                href={`#${entry.id}`}
