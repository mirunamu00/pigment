+  padding-top: var(--space-96);
+  text-align: center;
+}
+
+.error-stage {
+  width: 100%;
+  height: 280px;
+  margin-bottom: var(--space-32);
+}
+
+.error-stage .stage-window {
+  display: grid;
+  place-items: center;
+  padding: var(--space-24);
+}
+
+.error-state h1 {
+  margin: var(--space-8) 0 var(--space-12);
+  font: var(--font-weight-semibold) var(--font-size-lead) / var(--font-line-height-heading) var(--font-family-sans);
+  letter-spacing: var(--font-tracking-lead);
+}
+
+.error-state .two-tone {
+  max-width: 44ch;
+}
+
+.error-actions {
   justify-content: center;
-  flex-shrink: 0;
-  width: 44px;
-  height: 44px;
-  border-radius: var(--radius-pill);
-  background: var(--color-tag-bg);
-  color: var(--color-tag-text);
-  font-weight: 700;
+}
+
+/* ---------- Footer and closing ---------- */
+.site-footer {
+  border-top: var(--border-width-hairline) solid var(--color-border-subtle);
+}
+
+.closing {
+  position: relative;
+  isolation: isolate;
+  display: grid;
+  justify-items: center;
+  padding-block: var(--space-128);
+  text-align: center;
+}
+
+.closing-label {
+  margin-bottom: var(--space-24);
+}
+
+.closing-statement {
+  margin-bottom: var(--space-48);
+  font: var(--font-weight-medium) clamp(var(--font-size-h2), 6vw, var(--font-size-display)) / var(--font-line-height-display)
+    var(--font-family-sans);
+  letter-spacing: var(--font-tracking-display);
+  text-wrap: wrap;
+}
+
+.closing-statement > * {
+  white-space: nowrap;
+}
+
+.newsletter-form {
+  width: 100%;
+  max-width: var(--size-form);
+  text-align: left;
+}
+
+.site-footer-inner {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  gap: var(--space-32);
+  padding-block: var(--space-48);
+  border-top: var(--border-width-hairline) solid var(--color-border-subtle);
+}
+
+.footer-about {
+  display: grid;
+  gap: var(--space-8);
+  max-width: 44ch;
+}
+
+.footer-note {
+  font-size: var(--font-size-small);
+  line-height: var(--font-line-height-ui);
+  color: var(--color-text-secondary);
+}
+
+.footer-title {
+  margin-bottom: var(--space-8);
+  font-size: var(--font-size-small);
+  font-weight: var(--font-weight-medium);
+  color: var(--color-text-primary);
+}
+
+.footer-links ul {
+  list-style: none;
+  display: grid;
+  gap: var(--space-4);
+  margin: 0;
+  padding: 0;
+  font-size: var(--font-size-small);
+}
+
+.footer-links a {
+  color: var(--color-text-secondary);
+  text-decoration: none;
+  transition: color var(--motion-duration-hover) var(--motion-easing-ease);
+}
+
+.opener-side {
+  display: grid;
+  gap: var(--space-16);
+  align-content: start;
+}
+
+.opener-link {
+  justify-self: start;
   font-size: var(--font-size-small);
+  font-weight: var(--font-weight-medium);
+  color: var(--color-text-secondary);
+  text-decoration: none;
+  border-radius: var(--radius-xs);
+  transition: color var(--motion-duration-hover) var(--motion-easing-ease);
+}
+
+/* ---------- Hover (fine pointers only) ---------- */
+@media (hover: hover) and (pointer: fine) {
+  .nav-link:hover {
+    color: var(--color-text-primary);
+    background: var(--color-action-ghost-hover);
+  }
+
+  .btn--primary:hover {
+    background: var(--color-action-primary-hover);
+  }
+
+  .btn--secondary:hover {
+    background: var(--color-action-secondary-hover);
+    color: var(--color-text-primary);
+  }
+
+  .btn--bordered:hover {
+    border-color: var(--color-border-strong);
+    color: var(--color-text-primary);
+  }
+
+  .btn--ghost:hover {
+    background: var(--color-action-ghost-hover);
+    color: var(--color-text-primary);
+  }
+
+  .chip:hover {
+    color: var(--color-text-primary);
+    border-color: var(--color-border-strong);
+  }
+
+  .input:hover:not(:focus-visible):not([aria-invalid='true']) {
+    border-color: var(--color-border-strong);
+  }
+
+  .prose a:hover,
+  .article-body a:hover {
+    text-decoration-color: var(--color-text-primary);
+  }
+
+  .breadcrumb a:hover,
+  .footer-links a:hover,
+  .opener-link:hover,
+  .toc-link:hover {
+    color: var(--color-text-primary);
+  }
+
+  .post-card:hover {
+    background: var(--color-surface-hover);
+  }
+
+  .post-card:hover .plate,
+  .featured-post:hover .plate {
+    border-color: var(--color-border-strong);
+  }
+
+  .featured-post:hover .plate {
+    background: var(--color-surface-hover);
+  }
+
+  .toc-summary:hover {
+    background: var(--color-surface-hover);
+  }
+
+  .btn:disabled:hover,
+  .chip:disabled:hover {
+    transform: none;
+  }
+}
+
+/* ---------- Breakpoints ---------- */
+@media (max-width: 1023.98px) {
+  .card-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 767px) {
+  .site-header-inner {
+    gap: var(--space-8);
+  }
+
+  .nav-link {
+    padding: 0 var(--space-8);
+  }
+
+  .masthead {
+    grid-template-columns: 1fr;
+    gap: var(--space-16);
+    padding-block: var(--space-48) var(--space-32);
+  }
+
+  .masthead-lead {
+    font-size: var(--font-size-prose);
+    line-height: var(--font-line-height-lead);
+  }
+
+  .featured {
+    padding-top: var(--space-32);
+  }
+
+  .featured-post {
+    grid-template-columns: minmax(0, 1fr);
+    gap: var(--space-24);
+  }
+
+  .search-field {
+    flex-basis: 100%;
+  }
+
+  .closing {
+    padding-block: var(--space-96);
+  }
+
+  .form-actions {
+    flex-direction: column;
+  }
+
+  .form-actions .btn {
+    width: 100%;
+  }
+
+  .error-state {
+    padding-top: var(--space-48);
+  }
+
+  .error-actions {
+    width: 100%;
+  }
+
+  /* The form spans the column here, so the dot field would sit under its text. */
+  .closing .dot-field {
+    display: none;
+  }
+
+  .error-stage {
+    height: 240px;
+  }
 }
 
