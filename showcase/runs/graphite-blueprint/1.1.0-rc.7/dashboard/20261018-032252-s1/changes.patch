-    grid-template-columns: repeat(2, 1fr);
+    grid-template-columns: repeat(2, minmax(0, 1fr));
   }
 
   .two-column {
-    grid-template-columns: 1fr;
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .chart-stage {
+    min-height: 300px;
+  }
+}
+
+@media (max-width: 767.98px) {
+  .section-head,
+  .settings-row {
+    grid-template-columns: minmax(0, 1fr);
+    gap: var(--space-16);
+  }
+
+  .field-inline {
+    flex: 1 1 100%;
+  }
+
+  .field-inline .search-field {
+    width: auto;
+  }
+
+  .empty-state-actions {
+    flex-direction: column;
+    align-self: stretch;
+  }
+
+  .empty-state-actions .button {
+    width: 100%;
+  }
+}
+
+@media (max-width: 639.98px) {
+  .kpi-grid,
+  .details {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .topbar {
+    gap: var(--space-8);
+  }
+
+  .user-menu-name,
+  .user-menu-chevron {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    white-space: nowrap;
+  }
+
+  .user-menu-button {
+    padding: 0 var(--space-4);
+  }
+
+  .task {
+    flex-wrap: wrap;
+    padding-block: var(--space-4);
+  }
+
+  .task-assignee {
+    flex-basis: 100%;
+    padding-left: 22px;
+    margin-top: calc(-1 * var(--space-8));
+    padding-bottom: var(--space-4);
+  }
+}
+
+/* ---------- Reduced motion: loops end on their base frame ---------- */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: var(--motion-duration-instant) !important;
+    animation-iteration-count: 1 !important;
+    animation-delay: 0s !important;
+    transition-duration: var(--motion-duration-instant) !important;
+    transition-delay: 0s !important;
+  }
+
+  .button:active,
+  .segmented-button:active {
+    transform: none;
+  }
+
+  /* Glyphs rest on their rest frame; chevrons sit evenly spaced; the dashes hold still. */
+  .dm--run .dm-strip,
+  .bp-chev,
+  .bp .bp-link,
+  .shimmer,
+  .live-edge,
+  .pulse::after,
+  .caret {
+    animation: none !important;
+  }
+
+  .shimmer {
+    color: var(--color-text-secondary);
+    background: none;
+  }
+
+  .bp-chev {
+    opacity: 1;
   }
 }
