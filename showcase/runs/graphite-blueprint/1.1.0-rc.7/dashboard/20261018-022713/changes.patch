+  background: radial-gradient(120% 70% at 50% var(--at), var(--color-stage-light) 0%, var(--color-stage-mid) 22%, var(--color-stage-ground) 62%);
+}
+.stage--below {
+  --at: 100%;
+}
+.stage-window {
+  position: relative;
+  min-height: 240px;
+  background: var(--color-stage-window);
+  box-shadow: var(--elevation-raised);
+  border-radius: var(--radius-md) var(--radius-md) 0 0;
+  -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent);
+  mask-image: linear-gradient(to bottom, #000 70%, transparent);
+}
+.stage-ghost {
+  position: absolute;
+  inset: var(--space-56) var(--space-56) 0;
+  translate: 32px 24px;
+  z-index: -1;
+  opacity: var(--opacity-ghost);
+  filter: blur(2px);
+}
+.stage--quiet {
+  display: flex;
+  flex-direction: column;
+  padding: var(--space-24);
+  background: radial-gradient(120% 90% at 50% 0%, var(--color-stage-mid), var(--color-stage-ground) 70%);
+}
+.stage--quiet .stage-window {
+  flex: 1;
+  min-height: 0;
+  border-radius: var(--radius-md);
+  -webkit-mask-image: none;
+  mask-image: none;
+}
+.stage.is-armed .stage-window {
+  transform: translateY(var(--motion-distance-settle-from)) scale(1.05);
+  filter: blur(2px);
+  transition: transform var(--motion-duration-settle) var(--motion-easing-settle), filter var(--motion-duration-settle) var(--motion-easing-settle);
+}
+.stage.is-armed.is-in .stage-window {
+  transform: none;
+  filter: none;
+}
+.fig {
+  display: grid;
+  gap: var(--space-4);
+  margin-top: var(--space-16);
+  font-size: var(--font-size-body);
+  color: var(--color-text-secondary);
+}
+.fig b {
+  font-weight: var(--font-weight-medium);
+  color: var(--color-text-primary);
+}
+@media (max-width: 767px) {
+  .stage {
+    padding: var(--space-24) var(--space-24) 0;
+  }
+  .stage-ghost {
+    display: none;
+  }
+  .stage--quiet {
+    padding: var(--space-16);
+  }
+}
+
+/* ---------- Signature 2: dot-matrix glyph, dot meter, dot field ---------- */
+.dm {
+  display: inline-block;
+  flex: none;
+  width: var(--size-glyph-sm);
+  height: var(--size-glyph-sm);
+  overflow: hidden;
+  vertical-align: middle;
+  color: var(--color-glyph-dot);
+}
+.dm circle {
+  fill: currentColor;
+  opacity: var(--opacity-dot-off);
+}
+.dm circle.on {
+  opacity: 1;
+}
+.dm--error {
+  color: var(--color-status-danger);
+}
+.dm-strip {
+  transform: translateX(calc(var(--dm-rest) * -15px));
+}
+.dm--run .dm-strip {
+  animation: dm-step var(--dm-dur) steps(var(--dm-n)) infinite;
+}
+@keyframes dm-step {
+  from {
+    transform: translateX(0);
+  }
+  to {
+    transform: translateX(calc(var(--dm-n) * -15px));
+  }
+}
+.dot-field {
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  pointer-events: none;
+  opacity: var(--opacity-dot-field);
+  background: radial-gradient(circle, var(--color-glyph-dot) 1px, transparent 1.5px) 0 0/12px 12px;
+  -webkit-mask-image: linear-gradient(90deg, #000, transparent 30% 70%, #000);
+  mask-image: linear-gradient(90deg, #000, transparent 30% 70%, #000);
+}
+.dot-meter {
+  display: inline-flex;
+  gap: var(--space-4);
+}
+.dot-meter i {
+  width: var(--space-6);
+  height: var(--space-6);
+  border-radius: var(--radius-full);
+  background: var(--color-glyph-dot);
+  opacity: var(--opacity-dot-off);
+}
+.dot-meter i.on {
+  opacity: 1;
+  background: var(--meter, var(--color-glyph-dot));
+}
+
+/* ---------- Signature 3: isometric hairline blueprint ---------- */
+.bp-host {
+  display: contents;
+}
+.bp {
+  display: block;
+  overflow: visible;
+  fill: none;
+}
+.bp path {
+  vector-effect: non-scaling-stroke;
+  stroke-width: var(--border-width-drawing);
+}
+.bp-shadow {
+  fill: var(--color-blueprint-face);
+  stroke: none;
+  color-interpolation-filters: sRGB;
+  filter: drop-shadow(0 8px 12px var(--color-blueprint-shadow));
+}
+.bp-body {
+  fill: var(--color-blueprint-face);
+  stroke: var(--color-blueprint-front);
+}
+.bp-seam {
+  stroke: var(--color-blueprint-back);
+  stroke-linecap: round;
+}
+.bp-edge {
+  stroke: var(--color-blueprint-front);
+}
+.bp-mark {
+  fill: var(--color-blueprint-mark);
+}
+.bp .bp-link {
+  stroke: var(--color-blueprint-mark);
+  stroke-width: var(--border-width-hairline);
+  stroke-dasharray: 2 4;
+  animation: bp-dash var(--motion-duration-dash) linear infinite;
+}
+.bp .bp-link--stopped {
+  animation: none;
+}
+.bp-fault {
+  fill: var(--color-status-danger);
+  stroke: none;
+}
+.bp-chev {
+  stroke: var(--color-blueprint-front);
+  offset-distance: calc(var(--k) * 33% + 16%);
+  animation: bp-flow var(--motion-duration-flow) linear calc(var(--k) * var(--motion-duration-flow) / -3) infinite;
+}
+.bp-slab {
+  transition: transform var(--motion-duration-settle) var(--motion-easing-settle) calc(var(--i) * 60ms);
+}
+.bp.is-lifted .bp-slab {
+  transform: translateY(calc(var(--i) * -1 * var(--motion-distance-lift)));
+}
+@keyframes bp-dash {
+  to {
+    stroke-dashoffset: var(--motion-distance-dash);
+  }
+}
+@keyframes bp-flow {
+  from {
+    offset-distance: 0%;
+    opacity: 0;
+  }
+  20%,
+  80% {
+    opacity: 1;
+  }
+  to {
+    offset-distance: 100%;
+    opacity: 0;
+  }
+}
+.bp-row {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--size-blueprint-lg)), 1fr));
+  gap: var(--space-32);
+  align-items: start;
+}
+.bp-row > figure {
+  display: grid;
+  grid-row: span 3;
+  grid-template-rows: subgrid;
+  row-gap: var(--space-12);
+  margin: 0;
+}
+.bp-row > figure > .bp {
+  align-self: end;
+}
+.bp--lg {
+  width: min(100%, var(--size-blueprint-lg));
+  height: auto;
+  flex: none;
+}
+.bp--md {
+  width: var(--size-blueprint-md);
+  height: auto;
+}
+.bp--sm {
+  width: var(--size-blueprint-sm);
+  height: auto;
+}
+@media (max-width: 639.98px) {
+  .bp--lg {
+    width: 100%;
+  }
+}
+
+/* ---------- Signature 4: spec plate ---------- */
+.plate {
+  position: relative;
+  display: grid;
+  place-items: center;
+  aspect-ratio: 4 / 3;
+  overflow: hidden;
+  background: var(--color-surface-subtle);
+  border: var(--border-width-hairline) solid var(--color-border-subtle);
+  border-radius: var(--radius-md);
+}
+.plate--wide {
+  aspect-ratio: 16 / 9;
+}
+.plate svg {
+  width: 78%;
+  height: 78%;
+}
+:is(.plate, .spec-figure) :is(ellipse, line, rect:not(.pf-on)) {
+  fill: none;
+  stroke-width: var(--border-width-drawing);
+  vector-effect: non-scaling-stroke;
+}
+.pf-f {
+  stroke: var(--color-blueprint-front);
+}
+.pf-b {
+  stroke: var(--color-blueprint-mark);
+}
+.pf-on {
+  fill: var(--color-blueprint-front);
+}
+.pf-off {
+  fill: var(--color-blueprint-mark);
+  opacity: var(--opacity-dot-off);
+}
+.plate .mono-label {
+  position: absolute;
+  left: var(--space-12);
+  right: var(--space-12);
+  bottom: var(--space-8);
+  overflow: visible;
+  text-overflow: clip;
+}
+
+/* ---------- Signature 5: working shimmer and live edges ---------- */
+.shimmer {
+  background: linear-gradient(90deg, var(--color-text-secondary) 40%, var(--color-text-primary) 50%, var(--color-text-secondary) 60%) 100% 0/300% 100%;
+  color: transparent;
+  -webkit-background-clip: text;
+  background-clip: text;
+  animation: shimmer var(--motion-duration-shimmer) linear infinite;
+}
+.shimmer-done {
+  color: var(--color-text-secondary);
+}
+@keyframes shimmer {
+  0% {
+    background-position: 100% 0;
+  }
+  75%,
+  100% {
+    background-position: 0 0;
+  }
+}
+.live-edge {
+  border: var(--border-width-hairline) solid transparent;
+  animation: edge var(--motion-duration-pulse) ease infinite;
+  background: linear-gradient(var(--color-surface-raised), var(--color-surface-raised)) padding-box,
+    linear-gradient(90deg, var(--color-border-strong), var(--color-text-secondary), var(--color-border-strong)) 0 0/120px 100% border-box;
+}
+.live-edge-done {
+  border: var(--border-width-hairline) solid var(--color-border-strong);
+}
+@keyframes edge {
+  to {
+    background-position: 0 0, 120px 0;
+  }
+}
+.pulse {
+  position: relative;
+  display: inline-block;
+  width: var(--space-6);
+  height: var(--space-6);
+  border-radius: var(--radius-full);
+  background: var(--color-status-success);
+}
+.pulse::after {
+  content: '';
+  position: absolute;
+  inset: -5px;
+  border-radius: inherit;
+  background: inherit;
+  opacity: 0;
+  animation: pulse var(--motion-duration-pulse) ease-out infinite;
+}
+.pulse--stale {
+  background: var(--color-icon-idle);
+}
+.pulse--incident {
+  background: var(--color-status-urgent);
+}
+.pulse--stale::after,
+.pulse--incident::after {
+  content: none;
+}
+@keyframes pulse {
+  0% {
+    transform: scale(0.375);
+    opacity: 0.7;
+  }
+  60%,
+  100% {
+    transform: scale(1);
+    opacity: 0;
+  }
+}
+.caret {
+  display: inline-block;
+  width: 1px;
+  height: 1em;
+  vertical-align: text-bottom;
+  background: var(--color-text-primary);
+  animation: caret var(--motion-duration-caret) steps(1) infinite;
+}
+@keyframes caret {
+  50% {
+    opacity: 0;
+  }
+}
+.turn-in {
+  animation: turn-in var(--motion-duration-enter) var(--motion-easing-enter) both;
+}
+@keyframes turn-in {
+  from {
+    opacity: 0;
+  }
+}
+
+/* ---------- Signature 6: openers, screen heads, two-tone, mono figures ---------- */
+.opener {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: var(--space-32);
+  margin-bottom: var(--space-96);
+  padding-top: var(--space-160);
+  border-top: var(--border-width-hairline) solid var(--color-border-subtle);
+}
+.opener:has(+ .prose) {
+  margin-bottom: var(--space-32);
+}
+.opener h2 {
+  margin: 0;
+  font: var(--font-weight-medium) var(--font-size-h2) / var(--font-line-height-display) var(--font-family-sans);
+  letter-spacing: var(--font-tracking-display);
+  color: var(--color-text-primary);
+  text-wrap: balance;
+}
+.opener p {
+  margin: 0;
+  max-width: 30ch;
+  font-size: var(--font-size-lead);
+  line-height: var(--font-line-height-lead);
+  letter-spacing: var(--font-tracking-lead);
+  color: var(--color-text-body);
+}
+.two-tone {
+  color: var(--color-text-secondary);
+}
+.two-tone b {
+  font-weight: inherit;
+  color: var(--color-text-primary);
+}
+.mono-label {
+  font: var(--font-weight-regular) var(--font-size-caption) / var(--font-line-height-caption) var(--font-family-mono);
+  letter-spacing: 0;
+  text-transform: uppercase;
+  color: var(--color-text-tertiary);
+  font-variant-numeric: tabular-nums;
+}
+.screen-head {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: var(--space-32);
+  align-items: end;
+  padding-block: var(--space-32) var(--space-24);
+}
+.screen-head,
+.masthead {
+  border-bottom: var(--border-width-hairline) solid var(--color-border-subtle);
+}
+:is(.screen-head, .masthead) + *,
+:is(.screen-head, .masthead) + * :is(thead th, .tbl, .opener:first-child) {
+  border-top: 0;
+}
+:is(.masthead + .opener, .masthead + * > .opener:first-child) {
+  padding-top: var(--space-96);
+}
+@media (max-width: 767px) {
+  .opener,
+  .screen-head {
+    grid-template-columns: 1fr;
+    gap: var(--space-16);
+  }
+  .opener {
+    padding-top: var(--space-96);
+    margin-bottom: var(--space-48);
+  }
+  .opener h2 {
+    font-size: var(--font-size-h3);
+  }
+  .opener p {
+    font-size: var(--font-size-prose);
+  }
+}
+
+.screen-head-main {
+  display: grid;
+  gap: var(--space-8);
+  min-width: 0;
+}
+.screen-head h1 {
+  font-size: var(--font-size-lead);
+  line-height: var(--font-line-height-heading);
+  letter-spacing: var(--font-tracking-lead);
+  font-weight: var(--font-weight-semibold);
+}
+.screen-head-aside {
+  display: grid;
+  justify-items: start;
+  gap: var(--space-8);
+  min-width: 0;
+}
+.screen-head-aside .two-tone {
+  font-size: var(--font-size-body);
+  line-height: var(--font-line-height-ui);
+}
+
+.section-head {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--space-8) var(--space-16);
+  margin-bottom: var(--space-12);
+}
+.section-head-title {
+  display: flex;
+  align-items: baseline;
+  gap: var(--space-12);
+  min-width: 0;
+}
+.section-head h2 {
+  font-size: var(--font-size-body);
+  line-height: var(--font-line-height-ui);
+  font-weight: var(--font-weight-semibold);
+}
+
+/* Settings groups (gap built in). */
+.settings-group {
+  padding-bottom: var(--space-48);
+}
+.settings-group + .settings-group {
+  margin-top: 0;
+  padding-top: var(--space-48);
+  border-top: var(--border-width-hairline) solid var(--color-border-subtle);
+}
+.settings-group > :last-child,
+.settings-group :is(.card-grid, .form-actions, form):last-child {
+  margin-bottom: 0;
+}
+:is(.settings-group, .stack) [role='status']:empty {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+}
+
+/* ---------- Buttons ---------- */
+.button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: var(--space-6);
+  height: var(--size-control);
+  padding: 0 var(--space-12);
+  border: var(--border-width-hairline) solid transparent;
+  border-radius: var(--radius-full);
+  background: var(--color-action-secondary);
+  color: var(--color-text-body);
+  font: var(--font-weight-medium) var(--font-size-small) / 1 var(--font-family-sans);
+  letter-spacing: var(--font-tracking-body);
+  text-decoration: none;
+  white-space: nowrap;
+  cursor: pointer;
+  transition: background-color var(--motion-duration-hover) var(--motion-easing-ease), color var(--motion-duration-hover) var(--motion-easing-ease),
+    border-color var(--motion-duration-hover) var(--motion-easing-ease), transform var(--motion-duration-hover) var(--motion-easing-standard);
+}
+.button:active {
+  transform: scale(0.971);
+}
+.button--lg {
+  height: var(--size-control-lg);
+  padding: 0 var(--space-16);
+}
+.button--primary {
+  background: var(--color-action-primary);
+  color: var(--color-text-on-action);
+}
+.button--secondary {
+  background: var(--color-action-secondary);
+  color: var(--color-text-body);
+}
+.button--bordered {
+  background: transparent;
+  color: var(--color-text-secondary);
+  border-color: var(--color-border-default);
+}
+.button--ghost {
+  background: transparent;
+  color: var(--color-text-secondary);
+}
+.button:disabled,
+.button[aria-disabled='true'] {
+  opacity: var(--opacity-disabled);
+  cursor: not-allowed;
+  transform: none;
+}
+.link-button {
+  font: inherit;
+  background: none;
+  border: none;
+  padding: 0;
+  color: var(--color-text-primary);
+  cursor: pointer;
+}
+@media (hover: hover) and (pointer: fine) {
+  .button--primary:not(:disabled):hover {
+    background: var(--color-action-primary-hover);
+  }
+  .button--secondary:not(:disabled):hover,
+  .button:not([class*='button--']):not(:disabled):hover {
+    background: var(--color-action-secondary-hover);
+    color: var(--color-text-primary);
+  }
+  .button--bordered:not(:disabled):hover {
+    background: var(--color-action-ghost-hover);
+    color: var(--color-text-primary);
+  }
+  .button--ghost:not(:disabled):hover {
+    background: var(--color-action-ghost-hover);
+    color: var(--color-text-primary);
+  }
+  a:hover {
+    text-decoration-color: var(--color-text-primary);
+  }
+}
+
+/* ---------- Fields ---------- */
+.input {
+  height: var(--size-field);
+  min-width: 0;
+  padding: 0 var(--space-12);
+  border: var(--border-width-hairline) solid var(--color-border-default);
+  border-radius: var(--radius-sm);
+  background: var(--color-surface-card);
+  color: var(--color-text-primary);
+  font: var(--font-weight-regular) var(--font-size-dense) / var(--font-line-height-ui) var(--font-family-sans);
+  letter-spacing: var(--font-tracking-body);
+  transition: border-color var(--motion-duration-hover) var(--motion-easing-ease);
+}
+.input::placeholder {
+  color: var(--color-text-tertiary);
+}
+.input:focus-visible {
+  border-color: var(--color-accent-default);
+}
+.search-field {
+  position: relative;
+  display: flex;
+  align-items: center;
+  flex: 1;
+  min-width: 0;
+}
+.search-icon {
+  position: absolute;
+  left: var(--space-12);
+  color: var(--color-icon-idle);
+  pointer-events: none;
+}
+.input--search {
+  width: 100%;
+  height: var(--size-control);
+  padding-left: 36px;
+  border-radius: var(--radius-full);
+}
+.input--search::-webkit-search-cancel-button {
+  filter: grayscale(1);
+  opacity: 0.6;
+}
+@media (hover: hover) and (pointer: fine) {
+  .input:hover {
+    border-color: var(--color-border-strong);
+  }
+  .input:focus-visible:hover {
+    border-color: var(--color-accent-default);
+  }
+}
+.field-inline {
+  display: flex;
+  align-items: center;
+  gap: var(--space-12);
+  min-width: 0;
+}
+.field-inline label {
+  flex: none;
+  font-size: var(--font-size-small);
+  font-weight: var(--font-weight-medium);
+  color: var(--color-text-body);
+}
+.field-inline .search-field {
+  width: 260px;
+  flex: 0 1 260px;
+}
+
+/* Checkbox */
+.checkbox {
+  appearance: none;
+  display: inline-grid;
+  place-content: center;
+  flex: none;
+  width: 14px;
+  height: 14px;
+  margin: 0;
+  border: var(--border-width-hairline) solid var(--color-border-check);
+  border-radius: var(--radius-xs);
+  background: transparent;
+  cursor: pointer;
+  transition: background-color var(--motion-duration-hover) var(--motion-easing-ease), border-color var(--motion-duration-hover) var(--motion-easing-ease);
+}
+.checkbox::after {
+  content: '';
+  width: 8px;
+  height: 4px;
+  border-left: 1.5px solid var(--color-text-on-accent);
+  border-bottom: 1.5px solid var(--color-text-on-accent);
+  transform: translateY(-1px) rotate(-45deg);
+  opacity: 0;
+}
+.checkbox:checked {
+  background: var(--color-accent-default);
+  border-color: var(--color-accent-default);
+}
+.checkbox:checked::after {
+  opacity: 1;
+}
+.checkbox:disabled {
+  opacity: var(--opacity-disabled);
+  cursor: not-allowed;
+}
+@media (hover: hover) and (pointer: fine) {
+  .checkbox:not(:checked):not(:disabled):hover {
+    border-color: var(--color-text-secondary);
+  }
+}
+
+/* ---------- Badges and status ---------- */
+.badge {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-6);
+  height: 20px;
+  padding: 0 var(--space-8);
+  border: var(--border-width-hairline) solid var(--color-border-default);
+  border-radius: var(--radius-full);
+  background: transparent;
+  color: var(--color-text-body);
+  font: var(--font-weight-medium) var(--font-size-caption) / 1 var(--font-family-sans);
+  white-space: nowrap;
+}
+.status {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-6);
+  color: var(--color-text-body);
+  white-space: nowrap;
+}
+.status-icon {
+  flex: none;
+}
+.status-icon--active {
+  color: var(--color-status-warning);
+}
+.status-icon--paused {
+  color: var(--color-icon-idle);
+}
+.status-icon--done {
+  color: var(--color-status-success);
+}
+.status-dot {
+  display: inline-block;
+  flex: none;
+  width: var(--space-6);
