+import { useEffect, useState, useSyncExternalStore } from 'react';
 import type { Block } from '../data/posts';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const RAIL_QUERY = '(min-width: 1024px)'; // breakpoint.lg
+
+function subscribe(callback: () => void) {
+  const query = window.matchMedia(RAIL_QUERY);
+  query.addEventListener('change', callback);
+  return () => query.removeEventListener('change', callback);
+}
+
+const getRail = () => window.matchMedia(RAIL_QUERY).matches;
+
+/** Contents list: a side rail from breakpoint.lg, else a closed disclosure after the lead plate. */
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const rail = useSyncExternalStore(subscribe, getRail, () => true);
+  const [current, setCurrent] = useState<string | null>(headings[0]?.id ?? null);
+
+  // Mark the heading being read: the last one whose top has passed the upper third of the viewport.
+  useEffect(() => {
+    if (!rail || headings.length === 0) return;
+    const update = () => {
+      let active = headings[0].id;
+      for (const heading of headings) {
+        const element = document.getElementById(heading.id);
+        if (element && element.getBoundingClientRect().top <= window.innerHeight / 3) active = heading.id;
+      }
+      setCurrent(active);
+    };
+    update();
+    window.addEventListener('scroll', update, { passive: true });
+    return () => window.removeEventListener('scroll', update);
+  }, [rail, blocks]);
+
   if (headings.length === 0) return null;
 
+  const list = (
+    <ol className="toc-list">
+      {headings.map((heading) => (
+        <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+          <a
+            href={`#${heading.id}`}
+            className={rail && current === heading.id ? 'toc-link is-current' : 'toc-link'}
+            data-testid="toc-link"
+          >
+            {heading.text}
+          </a>
+        </li>
+      ))}
+    </ol>
+  );
+
   return (
-    <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+    <nav className={rail ? 'toc toc--rail' : 'toc toc--inline'} aria-labelledby="toc-heading" data-testid="toc">
+      {rail ? (
+        <>
+          <h2 id="toc-heading" className="toc-heading mono-label">
+            On this page
+          </h2>
+          {list}
+        </>
+      ) : (
+        <details className="disclosure">
+          <summary>
+            <h2 id="toc-heading" className="toc-heading">
+              On this page
+            </h2>
+            <svg className="disclosure-chevron" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
+              <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" strokeWidth="1.5" />
+            </svg>
+          </summary>
+          <div className="disclosure-body">
+            <div>{list}</div>
+          </div>
+        </details>
+      )}
     </nav>
   );
 }
