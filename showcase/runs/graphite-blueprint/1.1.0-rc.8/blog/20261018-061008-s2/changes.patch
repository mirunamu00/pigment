+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const RAIL_QUERY = '(min-width: 1024px)'; // breakpoint.lg
+
+function useMediaQuery(query: string) {
+  const [matches, setMatches] = useState(() => window.matchMedia(query).matches);
+  useEffect(() => {
+    const list = window.matchMedia(query);
+    const onChange = () => setMatches(list.matches);
+    onChange();
+    list.addEventListener('change', onChange);
+    return () => list.removeEventListener('change', onChange);
+  }, [query]);
+  return matches;
+}
+
+/** The heading whose top has passed the sticky header, for the rail's current marker. */
+function useCurrentHeading(ids: string[]) {
+  const [current, setCurrent] = useState<string | null>(null);
+  useEffect(() => {
+    function update() {
+      const offset = 96;
+      let found: string | null = null;
+      for (const id of ids) {
+        const el = document.getElementById(id);
+        if (el && el.getBoundingClientRect().top - offset <= 0) found = id;
+      }
+      setCurrent(found ?? ids[0] ?? null);
+    }
+    update();
+    window.addEventListener('scroll', update, { passive: true });
+    window.addEventListener('hashchange', update);
+    return () => {
+      window.removeEventListener('scroll', update);
+      window.removeEventListener('hashchange', update);
+    };
+  }, [ids.join('|')]);
+  return current;
+}
+
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const isRail = useMediaQuery(RAIL_QUERY);
+  const current = useCurrentHeading(headings.map((heading) => heading.id));
   if (headings.length === 0) return null;
 
+  const list = (
+    <ol className="toc-list">
+      {headings.map((heading) => (
+        <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+          <a
+            href={`#${heading.id}`}
+            className={current === heading.id ? 'toc-link is-current' : 'toc-link'}
+            aria-current={isRail && current === heading.id ? 'location' : undefined}
+            data-testid="toc-link"
+          >
+            {heading.text}
+          </a>
+        </li>
+      ))}
+    </ol>
+  );
+
+  // From breakpoint.lg the contents list is a side rail; below it, a closed <details> after the lead plate.
+  if (isRail) {
+    return (
+      <nav className="toc toc--rail" aria-labelledby="toc-heading" data-testid="toc">
+        <h2 id="toc-heading" className="toc-heading mono-label">
+          On this page
+        </h2>
+        {list}
+      </nav>
+    );
+  }
+
   return (
-    <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
-    </nav>
+    <details className="toc-details">
+      <summary>
+        <h2 id="toc-heading" className="toc-heading">
+          On this page
+        </h2>
+        <svg className="toc-chevron" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
