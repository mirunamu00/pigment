+    background-position: 100% 0;
+  }
+  75%,
+  100% {
+    background-position: 0 0;
+  }
+}
+
+.live-edge {
+  border: var(--border-width-hairline) solid transparent;
+  animation: edge var(--motion-duration-pulse) ease infinite;
+  background:
+    linear-gradient(var(--color-surface-raised), var(--color-surface-raised)) padding-box,
+    linear-gradient(90deg, var(--color-border-strong), var(--color-text-secondary), var(--color-border-strong)) 0 0 / 120px 100%
+      border-box;
+}
+
+@keyframes edge {
+  to {
+    background-position:
+      0 0,
+      120px 0;
+  }
+}
+
+.pulse {
+  position: relative;
+  display: inline-block;
+  width: var(--space-6);
+  height: var(--space-6);
+  border-radius: var(--radius-full);
+  background: var(--color-status-success);
+}
+
+.pulse::after {
+  content: '';
+  position: absolute;
+  inset: -5px;
+  border-radius: inherit;
+  background: inherit;
+  opacity: 0;
+  animation: pulse var(--motion-duration-pulse) ease-out infinite;
+}
+
+.pulse--stale {
+  background: var(--color-icon-idle);
+}
+
+.pulse--stale::after {
+  content: none;
+}
+
+@keyframes pulse {
+  0% {
+    transform: scale(0.375);
+    opacity: 0.7;
+  }
+  60%,
+  100% {
+    transform: scale(1);
+    opacity: 0;
+  }
+}
+
+.caret {
+  display: inline-block;
+  width: 1px;
+  height: 1em;
+  vertical-align: text-bottom;
+  background: var(--color-text-primary);
+  animation: caret var(--motion-duration-caret) steps(1) infinite;
+}
+
+@keyframes caret {
+  50% {
+    opacity: 0;
+  }
+}
+
+.turn-in {
+  animation: turn-in var(--motion-duration-enter) var(--motion-easing-enter) both;
+}
+
+@keyframes turn-in {
+  from {
+    opacity: 0;
+  }
+}
+
+.live {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-6);
+  font-size: var(--font-size-small);
+  color: var(--color-text-body);
+}
+
+/* Route loading: centered, shown only after 300ms. */
+.loading {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: var(--space-8);
+  min-height: 240px;
+  font-size: var(--font-size-small);
+  animation: turn-in var(--motion-duration-enter) var(--motion-easing-enter) 300ms both;
+}
+
+/* ---------------------------------------------------------------------------------------------
+ * Buttons
+ * ------------------------------------------------------------------------------------------- */
+.btn {
+  position: relative;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: var(--space-6);
+  height: var(--size-control);
+  padding: 0 var(--space-12);
+  border: var(--border-width-hairline) solid transparent;
+  border-radius: var(--radius-full);
+  background: transparent;
+  color: var(--color-text-secondary);
+  font: var(--font-weight-medium) var(--font-size-small) / 1 var(--font-family-sans);
+  letter-spacing: var(--font-tracking-body);
+  white-space: nowrap;
+  text-decoration: none;
+  cursor: pointer;
+  transition:
+    background-color var(--motion-duration-hover) var(--motion-easing-ease),
+    color var(--motion-duration-hover) var(--motion-easing-ease),
+    border-color var(--motion-duration-hover) var(--motion-easing-ease),
+    transform var(--motion-duration-hover) var(--motion-easing-standard);
+}
+
+.btn:active {
+  transform: scale(0.971);
+}
+
+.btn--primary {
+  background: var(--color-action-primary);
+  color: var(--color-text-on-action);
+}
+
+.btn--secondary {
+  background: var(--color-action-secondary);
+  color: var(--color-text-body);
+}
+
+.btn--bordered {
+  border-color: var(--color-border-default);
+  color: var(--color-text-secondary);
+}
+
+.btn--ghost {
+  color: var(--color-text-secondary);
+}
+
+.btn--lg {
+  height: var(--size-control-lg);
+  padding: 0 var(--space-16);
+}
+
+.btn--icon {
+  width: var(--size-control-sm);
+  height: var(--size-control-sm);
+  padding: 0;
+  color: var(--color-icon-idle);
+}
+
+.btn:disabled,
+.btn[aria-disabled='true'] {
+  opacity: var(--opacity-disabled);
+  cursor: not-allowed;
+  transform: none;
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .btn--primary:hover:not(:disabled) {
+    background: var(--color-action-primary-hover);
+  }
+
+  .btn--secondary:hover:not(:disabled) {
+    background: var(--color-action-secondary-hover);
+    color: var(--color-text-primary);
+  }
+
+  .btn--bordered:hover:not(:disabled) {
+    border-color: var(--color-border-strong);
+    color: var(--color-text-primary);
+  }
+
+  .btn--ghost:hover:not(:disabled) {
+    background: var(--color-action-ghost-hover);
+    color: var(--color-text-primary);
+  }
+
+  .btn--icon:hover:not(:disabled) {
+    background: var(--color-action-ghost-hover);
+    color: var(--color-icon-active);
+  }
+
+  a:hover {
+    text-decoration-color: var(--color-text-primary);
+  }
+}
+
+.btn--secondary:active {
+  background: var(--color-surface-press);
+}
+
+/* Touch targets reach 44px through an invisible extension of the control itself. */
+@media (pointer: coarse) {
+  :is(.btn, .nav-link, .tab, .segmented-button)::before {
+    content: '';
+    position: absolute;
+    inset: -6px 0;
+  }
+}
+
+/* ---------------------------------------------------------------------------------------------
+ * Fields
+ * ------------------------------------------------------------------------------------------- */
+.field {
+  display: grid;
+  gap: var(--space-6);
+}
+
+.field-label {
+  font-size: var(--font-size-small);
+  font-weight: var(--font-weight-medium);
+  color: var(--color-text-body);
+}
+
+.input {
+  appearance: none;
+  height: var(--size-field);
+  min-width: 0;
+  padding: 0 var(--space-12);
+  border: var(--border-width-hairline) solid var(--color-border-default);
+  border-radius: var(--radius-sm);
+  background: var(--color-surface-card);
+  color: var(--color-text-primary);
+  font: var(--font-weight-regular) var(--font-size-dense) / var(--font-line-height-ui) var(--font-family-sans);
+  letter-spacing: var(--font-tracking-body);
+  transition: border-color var(--motion-duration-hover) var(--motion-easing-ease);
+}
+
+.input::placeholder {
+  color: var(--color-text-tertiary);
+}
+
+.input:focus-visible {
+  border-color: var(--color-accent-default);
+}
+
+.input::-webkit-search-cancel-button {
+  appearance: none;
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .input:hover:not(:focus-visible) {
+    border-color: var(--color-border-strong);
+  }
+}
+
+.search-field {
+  position: relative;
+  display: flex;
+  flex: 1;
+  min-width: 0;
+}
+
+.search-field .icon {
+  position: absolute;
+  left: var(--space-12);
+  top: 50%;
+  translate: 0 -50%;
+  color: var(--color-icon-idle);
+  pointer-events: none;
+}
+
+.search-field .input {
+  flex: 1;
+  width: 100%;
+  height: var(--size-control);
+  padding-left: 36px;
+  border-radius: var(--radius-full);
+}
+
+.checkbox {
+  appearance: none;
+  display: inline-grid;
+  place-content: center;
+  flex: none;
+  width: 14px;
+  height: 14px;
+  margin: 0;
+  border: var(--border-width-hairline) solid var(--color-border-check);
+  border-radius: var(--radius-xs);
+  background: transparent;
+  cursor: pointer;
+  transition:
+    background-color var(--motion-duration-hover) var(--motion-easing-standard),
+    border-color var(--motion-duration-hover) var(--motion-easing-standard);
+}
+
+.checkbox::after {
+  content: '';
+  width: 7px;
+  height: 4px;
+  border-left: 1.5px solid var(--color-text-on-accent);
+  border-bottom: 1.5px solid var(--color-text-on-accent);
+  transform: translateY(-1px) rotate(-45deg);
+  opacity: 0;
+}
+
+.checkbox:checked {
+  border-color: var(--color-accent-default);
+  background: var(--color-accent-default);
+}
+
+.checkbox:checked::after {
+  opacity: 1;
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .checkbox:not(:checked):hover {
+    border-color: var(--color-text-secondary);
+  }
+}
+
+/* ---------------------------------------------------------------------------------------------
+ * Badge, status, avatar
+ * ------------------------------------------------------------------------------------------- */
+.badge {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-6);
+  height: 20px;
+  padding: 0 var(--space-8);
+  border: var(--border-width-hairline) solid var(--color-border-default);
+  border-radius: var(--radius-full);
+  font: var(--font-weight-medium) var(--font-size-caption) / 1 var(--font-family-sans);
+  color: var(--color-text-body);
+  white-space: nowrap;
+}
+
+.badge .status-icon {
+  width: var(--size-glyph-xs);
+  height: var(--size-glyph-xs);
+}
+
+.status {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-6);
+  color: var(--color-text-body);
+  white-space: nowrap;
+}
+
+.status-icon {
+  flex: none;
+}
+
+.status-icon--todo,
+.status-icon--canceled,
+.status-icon--paused {
+  color: var(--color-icon-idle);
+}
+
+.status-icon--progress {
+  color: var(--color-status-warning);
+}
+
+.status-icon--done {
+  color: var(--color-status-success);
+}
+
+.status-icon--urgent {
+  color: var(--color-status-urgent);
+}
+
+.dot {
+  flex: none;
+  width: var(--space-6);
+  height: var(--space-6);
+  border-radius: var(--radius-full);
+  background: var(--color-icon-idle);
+}
+
+.dot--success {
+  background: var(--color-status-success);
+}
+
+.dot--danger {
+  background: var(--color-status-danger);
+}
+
+.avatar {
+  display: inline-grid;
+  place-items: center;
+  flex: none;
+  width: 20px;
+  height: 20px;
+  border-radius: var(--radius-full);
+  background: var(--color-surface-press);
+  color: var(--color-text-primary);
+  font: var(--font-weight-semibold) var(--font-size-micro) / 1 var(--font-family-sans);
+  letter-spacing: -0.04em;
+}
+
+.avatar--lg {
+  width: 32px;
+  height: 32px;
+}
+
+/* ---------------------------------------------------------------------------------------------
+ * App shell: sidebar, sticky header
+ * ------------------------------------------------------------------------------------------- */
+.app-shell {
+  display: flex;
+  min-height: 100vh;
+}
+
+.sidebar {
+  flex: none;
+  width: var(--size-sidebar);
+  padding: var(--space-12) var(--space-8);
+  background: var(--color-surface-subtle);
+  border-right: var(--border-width-hairline) solid var(--color-border-subtle);
+}
+
+.sidebar-inner {
+  position: sticky;
+  top: var(--space-12);
+}
+
+.brand {
+  display: flex;
+  align-items: center;
+  height: calc(var(--size-header) - 2 * var(--space-12));
+  padding: 0 var(--space-8);
+  color: var(--color-text-primary);
+  font-size: var(--font-size-body);
+  font-weight: var(--font-weight-semibold);
+}
+
+.nav-group-label {
+  margin: var(--space-16) 0 var(--space-4);
+  padding: 0 var(--space-8);
+}
+
+.nav-list {
+  display: grid;
+  gap: var(--space-2);
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.nav-link {
+  position: relative;
+  display: flex;
+  align-items: center;
+  gap: var(--space-8);
+  height: var(--size-row-dense);
+  padding: 0 var(--space-8);
+  border-radius: var(--radius-sm);
+  color: var(--color-text-secondary);
+  font-size: var(--font-size-dense);
+  font-weight: var(--font-weight-medium);
+  text-decoration: none;
+  transition:
+    background-color var(--motion-duration-hover) var(--motion-easing-ease),
+    color var(--motion-duration-hover) var(--motion-easing-ease);
+}
+
+.nav-link .icon {
+  color: var(--color-icon-idle);
+  transition: color var(--motion-duration-hover) var(--motion-easing-ease);
+}
+
+.nav-link:focus-visible {
+  outline-offset: -2px;
+}
+
+.nav-link.active,
+.nav-link[aria-current='page'],
+.nav-link.is-section {
+  background: var(--color-surface-tint);
+  color: var(--color-text-primary);
+}
+
+.nav-link:is(.active, [aria-current='page'], .is-section) .icon {
+  color: var(--color-icon-active);
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .nav-link:not(.active):hover {
+    background: var(--color-action-ghost-hover);
+    color: var(--color-text-primary);
+  }
+}
+
+.main-column {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  min-width: 0;
+}
+
+.topbar {
+  position: sticky;
+  top: 0;
+  z-index: 20;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-16);
+  height: var(--size-header);
+  padding: 0 var(--space-32);
+  background: color-mix(in srgb, var(--color-surface-default) 80%, transparent);
+  -webkit-backdrop-filter: blur(20px);
+  backdrop-filter: blur(20px);
+  border-bottom: var(--border-width-hairline) solid var(--color-border-subtle);
+}
+
+.topbar-search {
+  display: flex;
+  flex: 1;
+  gap: var(--space-8);
+  min-width: 0;
+  max-width: 420px;
+}
+
+.content {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-16);
+  width: 100%;
+  max-width: var(--size-container);
+  padding: 0 var(--space-32) var(--space-48);
+}
+
+.content > .screen-head {
+  margin-bottom: var(--space-8);
+}
+
+/* User menu: a popover. */
+.user-menu {
+  position: relative;
+  flex: none;
+}
+
+.user-menu-button {
+  gap: var(--space-8);
+  padding-left: var(--space-8);
+  color: var(--color-text-body);
+}
+
+.user-menu-button[aria-expanded='true'] {
+  background: var(--color-surface-press);
+  color: var(--color-text-primary);
+}
+
+.user-menu-panel {
+  position: absolute;
+  right: 0;
+  top: calc(100% + var(--space-6));
+  z-index: 30;
+  min-width: 240px;
+  padding: var(--space-4);
+  border-radius: var(--radius-md);
+  background: var(--color-surface-raised);
+  box-shadow: var(--elevation-popover);
+  transform-origin: top right;
+  animation: pop-in var(--motion-duration-ui) var(--motion-easing-standard);
+}
+
+@keyframes pop-in {
+  from {
+    opacity: 0;
+    transform: scale(0.98);
+  }
+}
+
+.user-menu-email {
+  padding: var(--space-8) var(--space-8) var(--space-8);
+  margin-bottom: var(--space-4);
+  border-bottom: var(--border-width-hairline) solid var(--color-border-subtle);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-size: var(--font-size-small);
+  color: var(--color-text-secondary);
+}
+
+.user-menu-list {
+  display: grid;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.user-menu-link,
+.link-button {
+  display: flex;
+  align-items: center;
+  width: 100%;
+  height: var(--size-row-dense);
+  padding: 0 var(--space-8);
+  border: 0;
+  border-radius: var(--radius-sm);
+  background: none;
+  color: var(--color-text-body);
+  font: var(--font-weight-regular) var(--font-size-dense) / 1 var(--font-family-sans);
+  letter-spacing: var(--font-tracking-body);
+  text-align: left;
+  text-decoration: none;
+  cursor: pointer;
+}
+
+.user-menu-link:focus-visible,
+.link-button:focus-visible {
+  outline-offset: -2px;
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .user-menu-link:hover,
+  .link-button:hover {
+    background: var(--color-surface-hover);
+    color: var(--color-text-primary);
+  }
+}
+
+/* ---------------------------------------------------------------------------------------------
+ * Cards, KPI
+ * ------------------------------------------------------------------------------------------- */
+.card {
+  min-width: 0;
+  padding: var(--space-20);
+  border: var(--border-width-hairline) solid var(--color-border-default);
+  border-radius: var(--radius-md);
+  background: var(--color-surface-card);
+}
+
+.panel-title {
+  margin-bottom: var(--space-12);
+}
+
+.kpi-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: var(--space-16);
+}
+
+.kpi-label {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.kpi-value {
+  margin: var(--space-8) 0 var(--space-6);
+  color: var(--color-text-primary);
+  font-size: var(--font-size-h3);
+  font-weight: var(--font-weight-medium);
+  line-height: var(--font-line-height-heading);
+  letter-spacing: var(--font-tracking-display);
+  font-variant-numeric: tabular-nums;
+}
+
+.kpi-change {
+  display: flex;
+  align-items: center;
+  gap: var(--space-6);
+  font-size: var(--font-size-small);
+  line-height: var(--font-line-height-ui);
+  color: var(--color-text-body);
+}
+
+/* ---------------------------------------------------------------------------------------------
+ * Dashboard row: dot-column chart on a quiet stage, level with the activity list
+ * ------------------------------------------------------------------------------------------- */
+.two-column {
+  display: grid;
+  grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
+  gap: var(--space-16);
+  align-items: stretch;
+}
+
+.stage-panel {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+}
+
+.stage-panel > .stage {
+  flex: 1;
+}
+
+.chart {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-12);
+  height: 100%;
+  margin: 0;
+  padding: var(--space-20);
+}
+
+.chart-title {
+  font-size: var(--font-size-small);
+  color: var(--color-text-secondary);
+}
+
+.chart-plot {
+  position: relative;
+  flex: 1;
+  min-height: 180px;
+}
+
+.chart-svg {
+  position: absolute;
+  inset: 0;
+  display: block;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+}
+
+.chart-dot {
+  fill: var(--color-chart-mark);
+}
+
+.chart-dot--track {
+  opacity: var(--opacity-dot-track);
+}
+
+.chart-bar--highlight .chart-dot {
+  fill: var(--color-chart-highlight);
+}
+
+.chart-col {
+  transform-box: fill-box;
+  transform-origin: 50% 100%;
+  animation: chart-in var(--motion-duration-chart) var(--motion-easing-standard) both;
+  animation-delay: calc(var(--c) * 8ms);
+}
+
+@keyframes chart-in {
+  from {
+    opacity: 0;
+    transform: scale(0.4);
+  }
+}
+
+.chart-value,
+.chart-label {
+  font: var(--font-weight-regular) var(--font-size-caption) var(--font-family-mono);
+  font-variant-numeric: tabular-nums;
+  text-transform: uppercase;
+}
+
+.chart-value {
+  fill: var(--color-text-body);
+}
+
+.chart-label {
+  fill: var(--color-text-tertiary);
+}
+
+.activity-list {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.activity-item {
+  display: flex;
+  gap: var(--space-12);
+  padding: var(--space-12) 0;
+  border-top: var(--border-width-hairline) solid var(--color-border-subtle);
+}
+
+.activity-item:last-child {
+  padding-bottom: 0;
+}
+
+.activity-item .avatar {
+  margin-top: 2px;
+}
+
+.activity-body {
+  display: grid;
+  gap: var(--space-2);
+  min-width: 0;
+}
+
+.activity-body strong {
+  font-weight: var(--font-weight-medium);
+  color: var(--color-text-primary);
+}
+
+/* ---------------------------------------------------------------------------------------------
+ * Toolbar, segmented pills
+ * ------------------------------------------------------------------------------------------- */
+.table-section {
+  min-width: 0;
+  margin-top: var(--space-16);
+}
+
+.panel-header {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  align-items: baseline;
+  gap: var(--space-8) var(--space-16);
+}
+
+.toolbar {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  align-items: center;
+  gap: var(--space-12) var(--space-16);
+  margin: var(--space-12) 0 var(--space-16);
+}
+
+.segmented {
+  display: inline-flex;
+  padding: var(--space-2);
+  border-radius: var(--radius-full);
+  background: var(--color-surface-card);
+}
+
+.segmented-button {
+  position: relative;
+  height: var(--size-control-sm);
+  padding: 0 var(--space-12);
+  border: 0;
+  border-radius: var(--radius-full);
+  background: transparent;
+  color: var(--color-text-secondary);
+  font: var(--font-weight-medium) var(--font-size-small) / 1 var(--font-family-sans);
+  letter-spacing: var(--font-tracking-body);
