+  .nav-link .icon {
+    display: none;
+  }
+}
+
+/* Hover, only for fine pointers */
+@media (hover: hover) and (pointer: fine) {
+  a:hover {
+    text-decoration-color: var(--color-text-primary);
+  }
+
+  .nav-link:hover {
+    background: var(--color-action-ghost-hover);
+    color: var(--color-text-primary);
+  }
+
+  .nav-link[aria-current='page']:hover {
+    background: var(--color-surface-tint);
+  }
+
+  .button:hover {
+    background: var(--color-action-secondary-hover);
+    color: var(--color-text-primary);
+  }
+
+  .button-primary:hover {
+    background: var(--color-action-primary-hover);
+    color: var(--color-text-on-action);
+  }
+
+  .button-bordered:hover,
+  .button-ghost:hover {
+    background: var(--color-action-ghost-hover);
+    color: var(--color-text-primary);
+  }
+
+  .button-bordered:hover {
+    border-color: var(--color-border-strong);
+  }
+
+  .button-danger:hover {
+    background: var(--color-action-danger);
+    color: var(--color-text-on-danger);
+  }
+
+  .button:disabled:hover {
+    background: var(--color-action-secondary);
+  }
+
+  .input:hover:not(:focus-visible):not([aria-invalid='true']) {
+    border-color: var(--color-border-strong);
+  }
+
+  .switch:hover:not(:checked)::before {
+    border-color: var(--color-text-secondary);
   }
+
+  .tbl tbody tr:hover {
+    background: var(--color-surface-tint);
+  }
+}
+
+.button:active:not(:disabled) {
+  background-color: var(--color-surface-press);
 }
+
+.button-primary:active:not(:disabled) {
+  background-color: var(--color-action-primary-hover);
+}
+
+/* Reduced motion: loops end on their base frame */
+@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:var(--motion-duration-instant)!important;
+  animation-iteration-count:1!important;animation-delay:0s!important;transition-duration:var(--motion-duration-instant)!important;transition-delay:0s!important;}
+  .btn:active,.button:active{transform:none;}}
