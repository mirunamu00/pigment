 interface ProductImageProps {
   product: Product;
   size?: 'card' | 'large';
 }
 
-/** Image placeholder: a tinted CSS box with an icon. No network images. */
+/** Kinds keyed over the full catalog in featured order: same id, same figure everywhere. */
+const KINDS = specKinds(products.map((product) => product.slug));
+
+/** One fact per product for the plate caption (at most 18 characters, absent from the card). */
+const PLATE_FACTS: Record<string, string> = {
+  'canvas-field-tote': '18 oz canvas',
+  'waxed-day-pack': '22 L capacity',
+  'weekender-duffel': '45 L capacity',
+  'merino-crew-sweater': 'Fine-gauge knit',
+  'heavyweight-pocket-tee': '240 gsm jersey',
+  'cotton-chore-coat': 'Corduroy collar',
+  'enamel-camp-mug': '350 ml capacity',
+  'cast-iron-skillet': 'Pre-seasoned',
+  'linen-tea-towels': '50 × 70 cm',
+  'leather-key-ring': 'Solid brass',
+  'ribbed-wool-beanie': 'One size',
+};
+
+function figureNumber(product: Product): string {
+  return `FIG ${String(products.indexOf(product) + 1).padStart(2, '0')}`;
+}
+
+/** Spec plate stand-in for the product photo. Large: the figure on a quiet stage. */
 export default function ProductImage({ product, size = 'card' }: ProductImageProps) {
+  const kind = KINDS.get(product.slug);
+  const label = `${product.name} product photo placeholder`;
+
+  if (size === 'large') {
+    // The detail screen lists the product's facts, so the caption names the figure's kind instead.
+    return (
+      <Stage
+        quiet
+        className="product-stage"
+        windowProps={{ role: 'img', 'aria-label': label, 'data-testid': 'product-image', className: 'product-stage-window' }}
+      >
+        <SpecFigure id={product.slug} kind={kind} />
+        <span className="mono-label plate-caption">
+          {figureNumber(product)} · {KIND_NAMES[kind ?? 0]}
+        </span>
+      </Stage>
+    );
+  }
+
   return (
-    <div
-      className={`product-image product-image-${size} tone-${product.tone}`}
-      role="img"
-      aria-label={`${product.name} product photo placeholder`}
-      data-testid="product-image"
-    >
-      <ImageIcon className="product-image-icon" />
+    <div className="plate" role="img" aria-label={label} data-testid="product-image">
+      <SpecFigure id={product.slug} kind={kind} />
+      <span className="mono-label">
+        {figureNumber(product)} · {PLATE_FACTS[product.slug] ?? KIND_NAMES[kind ?? 0]}
+      </span>
     </div>
   );
 }
