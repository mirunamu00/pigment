+/** The glyph's done still: all dots lit for motion.duration.done, then the 16px check. */
+function DoneMark() {
+  const [settled, setSettled] = useState(false);
+  useEffect(() => {
+    const ms = Number.parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--motion-duration-done')) || 400;
