+/* ---------- Hover (fine pointers only) ---------- */
+@media (hover: hover) and (pointer: fine) {
+  a:hover {
+    text-decoration-color: var(--color-text-primary);
+  }
+  .nav-link:hover {
+    color: var(--color-text-primary);
+    background: var(--color-action-ghost-hover);
+  }
+  .nav-link.active:hover,
+  .nav-link.is-section:hover {
+    background: var(--color-surface-tint);
+  }
+  .icon-button:hover {
+    color: var(--color-icon-active);
+  }
+  .icon-button:hover::before {
+    background: var(--color-action-ghost-hover);
+  }
+  .btn-primary:hover:not(:disabled) {
+    background: var(--color-action-primary-hover);
+  }
+  .btn-secondary:hover:not(:disabled) {
+    background: var(--color-action-secondary-hover);
+    color: var(--color-text-primary);
+  }
+  .btn-bordered:hover:not(:disabled) {
+    color: var(--color-text-primary);
+    border-color: var(--color-border-strong);
+  }
+  .chip:hover {
+    color: var(--color-text-primary);
+    border-color: var(--color-border-strong);
+  }
+  .input:hover:not(:focus-visible):not([aria-invalid='true']),
+  .select:hover:not(:focus-visible),
+  .stepper-controls:hover:not(:has(:focus-visible)) {
+    border-color: var(--color-border-strong);
+  }
+  .checkbox-row:hover .checkbox:not(:checked) {
+    border-color: var(--color-text-secondary);
+  }
+  .stepper-button:hover:not(:disabled) {
+    color: var(--color-icon-active);
+    background: var(--color-action-ghost-hover);
+  }
+  .segmented label:hover:not(:has(:checked)) {
+    color: var(--color-text-body);
+  }
+  .product-card:hover {
+    background: var(--color-surface-hover);
+  }
+  .footer-links a:hover,
+  .breadcrumb a:hover,
+  .opener-link:hover {
+    color: var(--color-text-primary);
+  }
+  .product-link:hover,
+  .cart-line-name:hover {
+    text-decoration: underline;
+    text-decoration-color: var(--color-text-primary);
+  }
