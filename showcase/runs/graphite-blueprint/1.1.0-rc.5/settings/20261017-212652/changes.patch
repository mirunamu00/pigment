+/* ---------- Hover (fine pointers only) ---------- */
+
+@media (hover: hover) and (pointer: fine) {
+  a:hover {
+    text-decoration-color: var(--color-text-primary);
+  }
+
+  .nav-link:hover {
+    background: var(--color-action-ghost-hover);
+    color: var(--color-text-primary);
+  }
+
+  .nav-link[aria-current='page']:hover {
+    background: var(--color-surface-tint);
+  }
+
+  .button:hover:not(:disabled) {
+    background: var(--color-action-secondary-hover);
+    color: var(--color-text-primary);
+  }
+
+  .button-primary:hover:not(:disabled) {
+    background: var(--color-action-primary-hover);
+    color: var(--color-text-on-action);
+  }
+
+  .button-bordered:hover:not(:disabled) {
+    background: var(--color-action-ghost-hover);
+    border-color: var(--color-border-strong);
+  }
+
+  .input:hover:not(:disabled):not(:focus-visible):not([aria-invalid='true']) {
+    border-color: var(--color-border-strong);
+  }
+
+  .switch:hover:not(:disabled):not(:checked)::before {
+    border-color: var(--color-text-secondary);
+  }
+
+  .tbl tbody tr:hover td {
+    background: var(--color-surface-tint);
+  }
+
+  .tbl tbody tr:hover .pin {
+    background: linear-gradient(var(--color-surface-tint), var(--color-surface-tint)), var(--pin-bg, var(--color-surface-default));
+  }
