+  opacity: 0;
+  transition:
+    opacity calc(var(--motion-duration-ui) * 0.6) var(--motion-easing-standard),
+    overlay calc(var(--motion-duration-ui) * 0.6) allow-discrete,
+    display calc(var(--motion-duration-ui) * 0.6) allow-discrete;
+}
+
+.dialog[open]::backdrop {
+  opacity: 1;
+}
+
+@starting-style {
