+@media (max-width: 767px) {
+  :root {
+    --page-pad: var(--space-20);
+  }
+
+  /* 44px touch target through padding around the 32px pill. */
+  .nav-link {
+    position: relative;
+  }
+
+  .nav-link::after {
+    content: '';
+    position: absolute;
+    inset: calc((var(--size-control) - var(--size-touch)) / 2) 0;
+  }
+
+  .nav-link .icon {
+    display: none;
+  }
+}
+
+/* ---------- Reduced motion: loops end on their readable base frame ---------- */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: var(--motion-duration-instant) !important;
+    animation-iteration-count: 1 !important;
+    animation-delay: 0s !important;
+    transition-duration: var(--motion-duration-instant) !important;
+    transition-delay: 0s !important;
+  }
+
+  .btn:active,
+  .button:active:not(:disabled) {
+    transform: none;
   }
 }
