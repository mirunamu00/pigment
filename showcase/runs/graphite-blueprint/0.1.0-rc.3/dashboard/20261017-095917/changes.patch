-          x2={WIDTH - PADDING_X}
-          y1={HEIGHT - PADDING_BOTTOM}
-          y2={HEIGHT - PADDING_BOTTOM}
-        />
-        {data.map((point, index) => {
-          const barHeight = (point.value / max) * plotHeight;
-          const x = PADDING_X + index * slot + (slot - barWidth) / 2;
-          const y = HEIGHT - PADDING_BOTTOM - barHeight;
-          return (
-            <g key={point.month} data-testid="chart-bar">
-              <rect className="chart-bar" x={x} y={y} width={barWidth} height={barHeight} />
-              <text className="chart-value" x={x + barWidth / 2} y={y - 6} textAnchor="middle">
-                {point.value}
-              </text>
-              <text className="chart-label" x={x + barWidth / 2} y={HEIGHT - 8} textAnchor="middle">
-                {point.month}
-              </text>
-            </g>
-          );
-        })}
-      </svg>
+      <figcaption className="chart-title">
+        {figure && <span className="mono-label">{figure}</span>}
+        {title}
+      </figcaption>
+      <div className="chart-plot" ref={plotRef}>
+        <svg
+          className="chart-svg"
+          viewBox={`0 0 ${width} ${height}`}
+          width={width}
+          height={height}
+          role="img"
+          aria-label={`${title}. ${summary}`}
+        >
+          {data.map((point, index) => {
+            const lit = Math.max(1, Math.round((point.value / scaleMax) * rows));
+            const x0 = index * slot + (slot - columnWidth) / 2;
+            const centerX = x0 + columnWidth / 2;
+            const topLitY = baseY - (lit - 1) * PITCH;
+            const dots = [];
+            for (let row = 0; row < rows; row++) {
+              const y = baseY - row * PITCH;
+              const on = row < lit;
+              // Leave the track clear where the value label sits.
+              if (!on && row < lit + 3) continue;
+              for (let col = 0; col < DOTS_WIDE; col++) {
+                dots.push(
+                  <circle
+                    key={`${row}-${col}`}
+                    className={on ? 'chart-dot' : 'chart-dot chart-dot--track'}
+                    cx={x0 + col * PITCH}
+                    cy={y}
+                    r={RADIUS}
+                  />,
+                );
+              }
+            }
+            const highlight = index === data.length - 1;
+            return (
+              <g key={point.month} data-testid="chart-bar">
+                <g
+                  className={`chart-column${highlight ? ' chart-column--highlight' : ''}`}
+                  style={{ '--col': index } as CSSProperties}
+                >
+                  {dots}
+                </g>
+                <text className="chart-value" x={centerX} y={Math.max(12, topLitY - 10)} textAnchor="middle">
+                  {point.value}
+                </text>
+                <text className="chart-label" x={centerX} y={height - 6} textAnchor="middle">
+                  {point.month}
+                </text>
+              </g>
+            );
+          })}
+        </svg>
+      </div>
     </figure>
   );
 }
