+    observer.observe(node);
+    return () => observer.disconnect();
+  }, []);
+
+  const { width, height } = size;
+  const peak = Math.max(...data.map((point) => point.value), 1);
+  const scaleMax = Math.ceil((peak * 1.15) / 10) * 10;
+  const rows = Math.max(4, Math.floor((height - LABEL_TOP - LABEL_BOTTOM) / PITCH));
+  const baseY = LABEL_TOP + rows * PITCH - PITCH / 2;
+  const slot = width / data.length;
+  const columnWidth = (DOTS_WIDE - 1) * PITCH;
   const summary = data.map((point) => `${point.month}: ${point.value}`).join(', ');
 
