+    <div className="plate" role="img" aria-label={label} data-testid="product-image">
+      <SpecFigure id={product.slug} kind={kind} />
+      <span className="mono-label">
+        FIG {figureNumber(product)} · {product.details[0]}
+      </span>
     </div>
   );
 }
