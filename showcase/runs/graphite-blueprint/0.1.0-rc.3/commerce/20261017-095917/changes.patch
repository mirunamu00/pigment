+
+  .site-header {
+    gap: var(--space-12);
+  }
+
+  .content {
+    padding-top: var(--space-20);
+  }
+
+  .product-detail {
+    gap: var(--space-32);
+  }
+
+  .confirmation-body {
+    gap: var(--space-32);
+    padding-top: var(--space-32);
+  }
+
+  .confirmation-statement {
+    font-size: var(--font-size-prose);
+  }
+
+  .toolbar-controls {
+    gap: var(--space-16);
   }
 
   .cart-line {
-    grid-template-columns: 1fr auto;
+    grid-template-columns: minmax(0, 1fr) auto;
+    grid-template-areas:
+      'info total'
+      'stepper remove';
