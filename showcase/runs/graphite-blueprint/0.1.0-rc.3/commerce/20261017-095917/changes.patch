+
+.closing-statement {
+  max-width: 14em;
+  font: var(--font-weight-medium) clamp(var(--font-size-h3), 5vw, var(--font-size-h2)) / var(--font-line-height-display)
+    var(--font-family-sans);
+  letter-spacing: var(--font-tracking-display);
+  text-wrap: balance;
+}
+
+/* One sentence per line: the statement never runs past two lines. */
+.closing-statement b {
+  display: block;
+}
+
+.closing-actions {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: var(--space-8);
+}
+
+/* ---------------------------------------------------------------- Product detail */
+
+.breadcrumb ol {
+  list-style: none;
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-8);
+  margin: 0;
+  padding: 0;
+  font-size: var(--font-size-small);
+  color: var(--color-text-primary);
+}
+
+.breadcrumb li + li::before {
+  content: '/';
+  margin-right: var(--space-8);
+  color: var(--color-text-tertiary);
+}
+
+.breadcrumb a {
+  color: var(--color-text-secondary);
+  text-decoration: none;
+  transition: color var(--motion-duration-hover) var(--motion-easing-ease);
+}
+
+.product-detail {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+  gap: var(--space-48);
+  align-items: start;
+  padding-top: var(--space-24);
+  margin-top: var(--space-16);
+  border-top: var(--border-width-hairline) solid var(--color-border-subtle);
+}
+
+.product-media {
+  min-width: 0;
+}
+
+.product-stage-window {
+  display: grid;
+  place-items: center;
+  aspect-ratio: 4 / 3;
+}
+
+.product-stage-caption {
+  position: absolute;
+  left: var(--space-12);
+  bottom: var(--space-8);
+}
+
+.product-detail-info {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  min-width: 0;
+}
+
+.product-title {
+  margin-top: var(--space-8);
+  font-size: var(--font-size-h3);
+  font-weight: var(--font-weight-medium);
+  line-height: var(--font-line-height-heading);
+  letter-spacing: var(--font-tracking-display);
+}
+
+.price-large {
+  margin-top: var(--space-12);
+  font-size: var(--font-size-title);
+  letter-spacing: var(--font-tracking-lead);
+}
+
+.product-description {
+  max-width: var(--size-measure);
+  margin-top: var(--space-16);
+}
+
+.purchase-form {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: var(--space-20);
+  margin-block: var(--space-32) var(--space-24);
+}
+
+.variant-fieldset {
+  display: grid;
+  gap: var(--space-6);
+  min-width: 0;
+  border: none;
+  margin: 0;
+  padding: 0;
+}
+
+.variant-fieldset legend {
+  padding: 0;
+  margin-bottom: var(--space-6);
+}
+
+.added-message {
+  align-self: stretch;
+}
+
+.detail-group {
+  align-self: stretch;
+  margin-top: var(--space-32);
+  padding-top: var(--space-24);
+  border-top: var(--border-width-hairline) solid var(--color-border-subtle);
+}
+
+.detail-group h2 {
+  margin-bottom: var(--space-12);
+  font-size: var(--font-size-body);
+  font-weight: var(--font-weight-medium);
+}
+
+.detail-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.detail-list li {
+  display: flex;
+  align-items: baseline;
+  gap: var(--space-16);
+  padding-block: var(--space-8);
+  border-bottom: var(--border-width-hairline) solid var(--color-border-subtle);
+}
+
+/* ---------------------------------------------------------------- Cart */
+
+.cart-layout {
+  display: grid;
+  grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
+  gap: var(--space-48);
+  align-items: start;
+  padding-top: var(--space-32);
+}
+
+.cart-section {
+  min-width: 0;
+}
+
+/* The screen head's hairline already opens the first row of sections. */
+.cart-layout > .cart-section:first-child .section-head {
+  padding-top: 0;
+  border-top: 0;
+}
+
+@media (min-width: 1024px) {
+  .cart-layout .section-head {
+    padding-top: 0;
+    border-top: 0;
+  }
+}
+
+.cart-lines {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  border-top: var(--border-width-hairline) solid var(--color-border-subtle);
+}
+
+.cart-line {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto auto auto;
+  align-items: center;
+  gap: var(--space-16);
+  padding-block: var(--space-16);
+  border-bottom: var(--border-width-hairline) solid var(--color-border-subtle);
+}
+
+.cart-line-info {
+  min-width: 0;
+}
+
+.cart-line-name {
+  font-weight: var(--font-weight-medium);
+  text-decoration: none;
+}
+
+.cart-line-meta {
+  font-size: var(--font-size-small);
+  color: var(--color-text-secondary);
+}
+
+.cart-line-total {
+  min-width: 80px;
+  text-align: right;
+}
+
+.summary {
+  margin-top: var(--space-24);
+  margin-left: auto;
+  max-width: 360px;
+}
+
+.summary-row {
+  display: flex;
+  justify-content: space-between;
+  align-items: baseline;
+  padding-block: var(--space-8);
+  font-size: var(--font-size-small);
+}
+
+.summary-row dt {
+  color: var(--color-text-secondary);
+}
+
+.summary-row dd {
+  color: var(--color-text-body);
+  font-variant-numeric: tabular-nums;
+}
+
+.summary-total {
+  margin-top: var(--space-4);
+  padding-top: var(--space-12);
+  border-top: var(--border-width-hairline) solid var(--color-border-subtle);
+  font-size: var(--font-size-body);
+  font-weight: var(--font-weight-semibold);
+}
+
+.summary-total dt,
+.summary-total dd {
+  color: var(--color-text-primary);
+}
+
+.checkout-form {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-20);
+  max-width: var(--size-form);
+}
+
+.checkout-form .banner {
+  margin-top: var(--space-12);
+}
+
+.form-actions {
+  display: flex;
+  gap: var(--space-8);
+  margin-top: var(--space-12);
+}
+
+.confirmation-body {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+  gap: var(--space-48);
+  align-items: center;
+  padding-top: var(--space-48);
+}
+
+.confirmation-text {
+  display: grid;
+  justify-items: start;
+  gap: var(--space-24);
+}
+
+.confirmation-statement {
+  display: grid;
+  gap: var(--space-8);
+  max-width: 36ch;
+  font-size: var(--font-size-title);
+  line-height: var(--font-line-height-lead);
+  letter-spacing: var(--font-tracking-lead);
+}
+
+/* ---------------------------------------------------------------- Hover (fine pointers only) */
+
+@media (hover: hover) and (pointer: fine) {
+  a:hover {
+    text-decoration-color: var(--color-text-primary);
+  }
+
+  .opener-link:hover,
+  .breadcrumb a:hover {
+    color: var(--color-text-primary);
+  }
+
+  .nav-link:hover {
+    background: var(--color-action-ghost-hover);
+    color: var(--color-text-primary);
+  }
+
+  .nav-link[aria-current='page']:hover {
+    background: var(--color-surface-tint);
+  }
+
+  .icon-button:hover {
+    background: var(--color-action-ghost-hover);
+    color: var(--color-icon-active);
+  }
+
+  .button:hover:not(:disabled) {
+    background: var(--color-action-secondary-hover);
+    color: var(--color-text-primary);
+  }
+
+  .button-primary:hover:not(:disabled) {
+    background: var(--color-action-primary-hover);
+    color: var(--color-text-on-action);
+  }
+
+  .button-ghost:hover:not(:disabled) {
+    background: var(--color-action-ghost-hover);
+    color: var(--color-text-primary);
+  }
+
+  .input:hover:not(:focus-visible):not([aria-invalid='true']),
+  .select:hover:not(:focus-visible) {
+    border-color: var(--color-border-strong);
+  }
+
+  .check:hover .checkbox:not(:checked) {
+    border-color: var(--color-text-secondary);
+  }
+
+  .chip:hover {
+    color: var(--color-text-primary);
+    border-color: var(--color-border-strong);
+  }
+
+  .variant-option:hover {
+    color: var(--color-text-body);
+  }
+
+  .product-card:hover {
+    background: var(--color-surface-hover);
+    box-shadow:
+      inset 0 0 0 1px var(--color-border-strong),
+      1px 0 0 var(--color-border-subtle),
+      0 1px 0 var(--color-border-subtle);
+  }
+
+  .cart-line-name:hover {
+    text-decoration: underline;
+    text-decoration-color: var(--color-text-primary);
+  }
+}
+
+/* Touch: icon buttons keep a 44px target through padding. */
+@media (pointer: coarse) {
+  .icon-button::before {
+    content: '';
+    position: absolute;
+    inset: calc((var(--size-touch) - var(--size-control)) / -2);
+  }
+}
+
+/* ---------------------------------------------------------------- Breakpoints */
+
+@media (max-width: 1279px) {
+  .product-grid {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 1023px) {
+  .product-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
   }
 
-  .product-detail,
   .cart-layout {
-    grid-template-columns: 1fr;
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+@media (max-width: 767px) {
