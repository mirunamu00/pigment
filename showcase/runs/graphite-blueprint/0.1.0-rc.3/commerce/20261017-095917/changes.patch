+          <SpecFigure id={product.slug} kind={kind} />
+          <span className="mono-label product-stage-caption">{categoryLabel(product.category)}</span>
+        </Stage>
+        <Fig label={`FIG 0.${Number(figureNumber(product))}`} name={product.name}>
+          {product.details[0]}.
+        </Fig>
+      </div>
+    );
+  }
+
   return (
