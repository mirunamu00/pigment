+
+/* Badge (static) */
+.badge {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-6);
+  height: 20px;
+  padding: 0 var(--space-8);
+  border: var(--border-width-hairline) solid var(--color-border-default);
+  border-radius: var(--radius-full);
+  background: transparent;
+  font: var(--font-weight-medium) var(--font-size-caption) / 1 var(--font-family-sans);
+  color: var(--color-text-body);
+  white-space: nowrap;
+}
+
+.badge::before {
+  content: '';
+  width: var(--space-6);
+  height: var(--space-6);
+  border-radius: var(--radius-full);
+  background: var(--color-icon-idle);
+}
+
+/* Banners and status dots */
+.status-dot {
+  display: inline-block;
+  flex: none;
+  width: var(--space-6);
+  height: var(--space-6);
+  border-radius: var(--radius-full);
+  background: var(--color-icon-idle);
+}
+
+.banner {
+  display: flex;
+  align-items: baseline;
+  gap: var(--space-8);
+  padding: var(--space-12) var(--space-16);
+  border: var(--border-width-hairline) solid var(--color-border-default);
+  border-radius: var(--radius-md);
+  font-size: var(--font-size-small);
+  color: var(--color-text-body);
+}
+
+.banner .status-dot {
+  transform: translateY(-1px);
+}
+
+.banner-success {
+  background: var(--color-status-success-tint);
+}
+
+.banner-success .status-dot {
+  background: var(--color-status-success);
+}
+
+.banner-danger {
+  background: var(--color-status-danger-tint);
+}
+
+.banner-danger .status-dot {
+  background: var(--color-status-danger);
+}
+
+/* ---------------------------------------------------------------- Empty and error states */
+
+.empty-state {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 360px;
+  margin: 0 auto;
+  padding: var(--space-48) var(--space-24);
+  text-align: center;
+}
+
+.empty-state > .dm,
+.empty-state > .bp {
+  margin-bottom: var(--space-16);
+}
+
+.empty-state > .mono-label {
+  margin-bottom: var(--space-8);
+}
+
+.empty-state-title {
+  font-size: var(--font-size-body);
+  font-weight: var(--font-weight-semibold);
+  line-height: var(--font-line-height-body);
+}
+
+.empty-state-text {
+  margin-bottom: var(--space-20);
+  font-size: var(--font-size-body);
+  color: var(--color-text-secondary);
+}
+
+.empty-state-text h2 {
+  font-size: inherit;
+  font-weight: var(--font-weight-semibold);
+  line-height: var(--font-line-height-body);
+}
+
+.empty-state--screen {
+  padding-top: var(--space-96);
+}
+
+.error-state {
+  display: grid;
+  justify-items: center;
+  gap: var(--space-32);
+  padding-block: var(--space-48);
+}
+
+.error-stage {
+  width: min(100%, var(--size-form));
+}
+
+.error-stage .stage-window {
+  display: grid;
+  place-items: center;
+  padding: var(--space-32) var(--space-24);
+}
+
+.error-state-text {
+  display: grid;
+  justify-items: center;
+  gap: var(--space-8);
+  max-width: 360px;
+  text-align: center;
+}
+
+.error-state-text h1 {
+  font-size: var(--font-size-lead);
+  letter-spacing: var(--font-tracking-lead);
+}
+
+.error-state-text p {
+  color: var(--color-text-secondary);
+}
+
+.error-state-actions {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: var(--space-8);
+  margin-top: var(--space-12);
+}
+
+/* ---------------------------------------------------------------- Product grid */
+
+.opener--page {
+  padding-block: var(--space-48);
+}
+
+.opener-text {
+  display: grid;
+  align-content: start;
+  justify-items: start;
+}
+
+.catalog {
+  display: flex;
+  flex-direction: column;
+}
+
+.toolbar {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  align-items: center;
+  gap: var(--space-16);
+}
+
+.toolbar-controls {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--space-24);
+}
+
+.result-count {
+  padding-block: var(--space-24) var(--space-16);
+  font-size: var(--font-size-small);
+  color: var(--color-text-secondary);
+}
+
+.product-grid {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  border-top: var(--border-width-hairline) solid var(--color-border-subtle);
+  border-left: var(--border-width-hairline) solid var(--color-border-subtle);
+}
+
+.product-card {
+  position: relative;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  padding: var(--space-24);
+  box-shadow:
+    1px 0 0 var(--color-border-subtle),
+    0 1px 0 var(--color-border-subtle);
+  transition:
+    background-color var(--motion-duration-ui) var(--motion-easing-ease),
+    box-shadow var(--motion-duration-ui) var(--motion-easing-ease);
+}
+
+.product-card:has(.product-link:focus-visible) {
+  outline: var(--border-width-hairline) solid var(--color-focus-ring);
+  outline-offset: -2px;
+}
+
+.product-card-body {
+  display: grid;
+  gap: var(--space-4);
+  padding-top: var(--space-20);
+}
+
+.product-card-title {
+  font-size: var(--font-size-body);
+  font-weight: var(--font-weight-medium);
+  line-height: var(--font-line-height-ui);
+}
+
+.product-link {
+  color: inherit;
+  text-decoration: none;
+}
+
+.product-link:focus-visible {
+  outline: none;
+}
+
+/* The whole card is one link. */
+.product-link::after {
+  content: '';
