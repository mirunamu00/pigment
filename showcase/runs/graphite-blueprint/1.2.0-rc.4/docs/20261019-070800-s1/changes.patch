+/** breakpoint.lg: the contents list is a side rail from here, a closed disclosure below it. */
+const RAIL_QUERY = '(min-width: 1024px)';
+
+function useMediaQuery(query: string) {
+  const [matches, setMatches] = useState(() => window.matchMedia(query).matches);
+  useEffect(() => {
+    const list = window.matchMedia(query);
+    const update = () => setMatches(list.matches);
+    update();
+    list.addEventListener('change', update);
+    return () => list.removeEventListener('change', update);
+  }, [query]);
+  return matches;
+}
+
+/** The heading the reader is in: the last one whose top has passed the line under the sticky header. */
+function useCurrentHeading(entries: TocEntry[]) {
+  const [current, setCurrent] = useState(entries[0]?.id);
+  useEffect(() => {
+    let frame = 0;
+    function update() {
+      frame = 0;
+      const line = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
+      let id = entries[0]?.id;
+      for (const entry of entries) {
+        const element = document.getElementById(entry.id);
+        if (element && element.getBoundingClientRect().top <= line + 1) id = entry.id;
+      }
+      setCurrent(id);
+    }
+    function schedule() {
+      if (!frame) frame = requestAnimationFrame(update);
+    }
+    update();
+    window.addEventListener('scroll', schedule, { passive: true });
+    window.addEventListener('resize', schedule);
+    return () => {
+      cancelAnimationFrame(frame);
+      window.removeEventListener('scroll', schedule);
+      window.removeEventListener('resize', schedule);
+    };
+  }, [entries]);
+  return current;
+}
