@@ -1,25 +1,79 @@
+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const RAIL_QUERY = '(min-width: 1024px)';
+const railMatches = () => typeof window !== 'undefined' && window.matchMedia(RAIL_QUERY).matches;
+
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  // A side rail (always open) from breakpoint.lg; below it a closed disclosure after the lead plate.
+  const [isRail, setIsRail] = useState(railMatches);
+  const [open, setOpen] = useState(railMatches);
+  const [current, setCurrent] = useState<string | null>(null);
+
+  useEffect(() => {
+    const query = window.matchMedia(RAIL_QUERY);
+    const sync = () => {
+      setIsRail(query.matches);
+      setOpen(query.matches);
+    };
+    query.addEventListener('change', sync);
+    return () => query.removeEventListener('change', sync);
+  }, []);
+
+  // The current section: the last heading that has scrolled past the top third of the viewport.
+  useEffect(() => {
+    const elements = headings.map((heading) => document.getElementById(heading.id)).filter(Boolean) as HTMLElement[];
+    if (elements.length === 0) return;
+    const update = () => {
+      const line = window.innerHeight / 3;
+      let active: string | null = null;
+      for (const el of elements) if (el.getBoundingClientRect().top <= line) active = el.id;
+      setCurrent(active);
+    };
+    update();
+    window.addEventListener('scroll', update, { passive: true });
+    window.addEventListener('resize', update);
+    return () => {
+      window.removeEventListener('scroll', update);
+      window.removeEventListener('resize', update);
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [blocks]);
+
   if (headings.length === 0) return null;
 
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      <details
+        className="toc-details"
+        open={open}
+        onToggle={(event) => {
+          if (!isRail) setOpen(event.currentTarget.open);
+        }}
+      >
+        <summary tabIndex={isRail ? -1 : undefined}>
+          <h2 id="toc-heading" className="toc-heading mono-label">
+            On this page
+          </h2>
+        </summary>
+        <ol className="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a
+                href={`#${heading.id}`}
+                className="toc-link"
+                data-testid="toc-link"
+                aria-current={current === heading.id ? 'location' : undefined}
+              >
+                {heading.text}
+              </a>
+            </li>
+          ))}
+        </ol>
+      </details>
     </nav>
   );
 }
