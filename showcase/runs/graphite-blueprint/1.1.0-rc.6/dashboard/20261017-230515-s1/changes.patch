+@media (max-width: 767.98px) {
+  .topbar { gap: var(--space-8); }
+  .user-menu-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+  .user-menu-button { padding: 0 var(--space-4); }
+  .user-menu-button .chevron { display: none; }
+  .toolbar { flex-direction: column; align-items: stretch; }
+  .toolbar .field-inline { flex: 1 1 auto; }
+  .settings-split { grid-template-columns: minmax(0, 1fr); }
+  .tab { height: var(--size-touch); }
+  .tbl-wrap .tbl td:first-child,
+  .tbl-wrap .tbl th:first-child { white-space: nowrap; min-width: 160px; }
+}
+
+@media (max-width: 639.98px) {
+  .kpi-grid { grid-template-columns: minmax(0, 1fr); }
+  .task-assignee .small,
+  .head-long { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+  .tbl-wrap { overflow-x: visible; }
+  .tbl { width: 100%; }
+  .tbl :is(th, td):not(:first-child):not(.pin) { display: none; }
+  .tbl :is(th, td):first-child { width: 100%; max-width: 0; overflow: hidden; }
+  .tbl .pin { width: 1%; white-space: nowrap; }
+  .tbl .pin::before { display: none; }
+  .cell-lines { flex: 1; min-width: 0; }
+  .cell-lines > *,
+  .cell-lines[data-sub]::after { display: block; line-height: var(--font-line-height-ui); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+  .cell-lines[data-sub]::after { content: attr(data-sub) "\00a0"; color: var(--color-text-tertiary); }
+  .cell-lines .badge { padding: 0; border: 0; }
+  .cell-lines .badge-label { position: absolute; clip: rect(0 0 0 0); }
+}
+
+/* Reduced motion: loops end on their base frame */
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation-duration: var(--motion-duration-instant) !important;
+    animation-iteration-count: 1 !important;
+    animation-delay: 0s !important;
+    transition-duration: var(--motion-duration-instant) !important;
+    transition-delay: 0s !important;
   }
+  .btn:active, .button:active, .segmented-button:active { transform: none; }
+  .bp.is-lifted .bp-slab { transform: none; }
 }
