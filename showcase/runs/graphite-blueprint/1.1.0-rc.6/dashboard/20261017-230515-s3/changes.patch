+@media (max-width: 767.98px) {
+  :root {
+    --page-pad: var(--space-20);
+  }
+
+  .tbl-wrap {
+    overflow-x: auto;
+  }
+
+  .tbl :is(th, td):first-child {
+    white-space: nowrap;
+    min-width: 160px;
+  }
+
+  .tbl .pin {
+    position: sticky;
+    right: 0;
+    z-index: 1;
+    text-align: right;
+    background: var(--pin-bg, var(--color-surface-default));
+    box-shadow: inset 1px 0 0 var(--color-border-subtle);
+  }
+
+  .pin::before {
+    content: '';
+    position: absolute;
+    inset-block: 0;
+    right: 100%;
+    width: var(--space-16);
+    pointer-events: none;
+    background: linear-gradient(90deg, transparent, var(--pin-bg, var(--color-surface-default)));
+  }
+
+  tr:hover .pin {
+    background:
+      linear-gradient(var(--color-surface-tint), var(--color-surface-tint)),
+      var(--pin-bg, var(--color-surface-default));
+  }
+
+  .empty-state-actions {
+    flex-direction: column;
+    align-self: stretch;
+  }
+
+  .empty-state-actions .button {
+    display: flex;
+    width: 100%;
+  }
+
+  .user-menu-name {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    white-space: nowrap;
+  }
+
+  .user-menu-button {
+    width: var(--size-control);
+    padding: 0;
+  }
+
+  .screen-head-summary {
+    justify-content: flex-start;
+  }
+}
+
+@media (max-width: 639.98px) {
+  .kpi-grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .toolbar {
+    flex-direction: column;
+    align-items: stretch;
+  }
+
+  .field-inline {
+    flex-direction: column;
+    align-items: stretch;
+    gap: var(--space-6);
+  }
+
+  .field-inline .search-field {
+    width: 100%;
+  }
+
+  .segmented {
+    align-self: flex-start;
+  }
+
+  .th-short {
+    display: inline;
+  }
+
+  .th-full {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    white-space: nowrap;
+  }
+
+  .task-assignee-name {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    white-space: nowrap;
+  }
+
+  /* Table recipe under breakpoint.sm: only the first and the pinned column. */
+  .tbl-wrap {
+    overflow-x: visible;
+  }
+  .tbl {
+    width: 100%;
+  }
+  .tbl :is(th, td):not(:first-child):not(.pin) {
+    display: none;
+  }
+  .tbl :is(th, td):first-child {
+    width: 100%;
+    max-width: 0;
+    min-width: 0;
+    overflow: hidden;
+  }
+  .tbl .pin {
+    width: 1%;
+    white-space: nowrap;
+  }
+  .tbl .pin::before {
+    display: none;
+  }
+  .cell-lines {
+    flex: 1;
+    min-width: 0;
+  }
+  .cell-lines > *,
+  .cell-lines[data-sub]::after {
+    display: block;
+    line-height: var(--font-line-height-ui);
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+  }
+  .cell-lines[data-sub]::after {
+    content: attr(data-sub) '\00a0';
+    color: var(--color-text-tertiary);
+    font-weight: var(--font-weight-regular);
+  }
+  .cell-lines .badge {
+    padding: 0;
+    border: 0;
+  }
+  .cell-lines .badge-label {
+    position: absolute;
+    clip: rect(0 0 0 0);
   }
 }
