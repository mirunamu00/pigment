index 8c45cab..c02da94 100644
--- a/src/components/TableOfContents.tsx
+++ b/src/components/TableOfContents.tsx
@@ -1,25 +1,79 @@
+import { useEffect, useState, type SyntheticEvent } from 'react';
 import type { Block } from '../data/posts';
+import { ChevronIcon } from '../design/signature';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const RAIL_QUERY = '(min-width: 1024px)';
+const isRail = () => typeof window !== 'undefined' && window.matchMedia(RAIL_QUERY).matches;
+
+// A side rail from breakpoint.lg (always open); below it a closed disclosure after the lead plate.
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const [open, setOpen] = useState(isRail);
+  const [current, setCurrent] = useState<string | null>(null);
+
+  useEffect(() => {
+    const query = window.matchMedia(RAIL_QUERY);
+    const sync = () => setOpen(query.matches);
+    query.addEventListener('change', sync);
+    return () => query.removeEventListener('change', sync);
+  }, []);
+
+  // The current section: the last heading that has scrolled past the header.
+  useEffect(() => {
+    if (headings.length === 0) return;
+    const ids = headings.map((heading) => heading.id);
+    const update = () => {
+      const line = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
+      let active: string | null = null;
+      for (const id of ids) {
+        const node = document.getElementById(id);
+        if (node && node.getBoundingClientRect().top <= line + 1) active = id;
+      }
+      setCurrent(active ?? ids[0]);
+    };
+    update();
+    window.addEventListener('scroll', update, { passive: true });
+    window.addEventListener('hashchange', update);
+    return () => {
+      window.removeEventListener('scroll', update);
+      window.removeEventListener('hashchange', update);
+    };
+  }, [blocks]);
+
   if (headings.length === 0) return null;
 
+  function handleToggle(event: SyntheticEvent<HTMLDetailsElement>) {
+    const details = event.currentTarget;
+    if (isRail() && !details.open) details.open = true;
+    else setOpen(details.open);
+  }
+
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      <details open={open} onToggle={handleToggle}>
+        <summary>
+          <h2 id="toc-heading" className="toc-heading">
+            On this page
+          </h2>
+          <ChevronIcon />
+        </summary>
+        <ol className="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a
+                href={`#${heading.id}`}
+                className="toc-link"
+                data-testid="toc-link"
+                aria-current={current === heading.id ? 'location' : undefined}
+              >
+                {heading.text}
+              </a>
+            </li>
+          ))}
+        </ol>
+      </details>
     </nav>
   );
 }
