+/* Tables from breakpoint.sm to breakpoint.md: scroll in the wrapper, first column held, pinned column sticky. */
+@media (max-width: 767px) {
+  .tbl :is(th, td):first-child {
+    white-space: nowrap;
+    min-width: 160px;
+  }
+  .pin {
+    box-shadow: inset 1px 0 0 var(--color-border-subtle);
+    padding-left: var(--space-12);
+  }
+  .pin::before {
+    opacity: 1;
+  }
+}
+
+/* Under breakpoint.sm: only the first and the pinned column. */
+@media (max-width: 639.98px) {
+  .tbl-wrap {
+    overflow-x: visible;
+  }
+  .tbl {
+    width: 100%;
+    table-layout: auto;
+  }
+  .tbl :is(th, td):not(:first-child):not(.pin) {
+    display: none;
+  }
+  .tbl :is(th, td):first-child {
+    width: 100%;
+    max-width: 0;
+    min-width: 0;
+    overflow: hidden;
+  }
+  .tbl .pin {
+    width: 1%;
+    white-space: nowrap;
+    box-shadow: none;
+  }
+  .tbl .pin::before {
+    display: none;
+  }
+  .cell-lines {
+    flex: 1;
+    min-width: 0;
+  }
+  .cell-lines > *,
+  .cell-lines[data-sub]::after {
