+export function figNumber(product: Product): string {
+  return `FIG ${String(products.indexOf(product) + 1).padStart(2, '0')}`;
+}
+
+/**
+ * Image placeholder: the product's spec plate (no network images). The card shows it as a 4:3 plate;
+ * the detail page shows the same figure larger on a quiet stage with its caption.
+ */
 export default function ProductImage({ product, size = 'card' }: ProductImageProps) {
+  const imageProps = {
+    role: 'img',
