+  };
+  const figure = <SpecFigure id={product.slug} kind={KINDS.get(product.slug)} />;
+
+  if (size === 'large') {
+    return (
+      <div className="product-figure">
+        <Stage quiet className="product-stage" windowProps={{ ...imageProps, className: 'product-stage-window' }}>
+          {figure}
+        </Stage>
+        <Fig number={figNumber(product)} name={product.name} fact={product.details[0]} />
+      </div>
+    );
+  }
+
   return (
