+  .button:hover:not(:disabled) {
+    background: var(--color-action-secondary-hover);
+    color: var(--color-text-primary);
+  }
+  .button-primary:hover:not(:disabled) {
+    background: var(--color-action-primary-hover);
+    color: var(--color-text-on-action);
+  }
+  .button-bordered:hover:not(:disabled),
+  .tag-filter-button:hover:not(:disabled) {
+    background: transparent;
+    color: var(--color-text-primary);
+    box-shadow: inset 0 0 0 var(--border-width-hairline) var(--color-border-strong);
+  }
+  .tag-filter-button[aria-pressed='true']:hover {
+    background: var(--color-surface-press);
+  }
+  .input:hover:not(:focus-visible):not([aria-invalid='true']) {
+    border-color: var(--color-border-strong);
+  }
+  .post-card:hover {
+    background: var(--color-surface-hover);
+  }
+  .breadcrumb a:hover,
+  .toc-link:hover,
+  .opener p a:hover {
+    color: var(--color-text-primary);
+  }
+}
+
+/* Responsive */
+@media (max-width: 1279.98px) {
+  .page-close {
+    padding-block: var(--space-128);
+  }
+}
+
+@media (max-width: 1023.98px) {
+  .post-list,
+  .card-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .featured-post > .plate,
+  .featured-text {
+    grid-column: 1 / -1;
+  }
+
+  .article-header,
+  .article-body,
+  .article-aside {
+    grid-column: 1 / -1;
   }
 
   .article-aside {
     position: static;
-    grid-row: 1;
+    grid-row: auto;
+    margin-bottom: var(--space-32);
+    padding-block: var(--space-4);
+    border-block: var(--border-width-hairline) solid var(--color-border-subtle);
+  }
+
+  .article-header {
+    margin-bottom: var(--space-24);
+  }
+
+  .toc-details > summary {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    min-height: var(--size-touch);
+    cursor: pointer;
+  }
+
+  .toc-details > summary::after {
+    content: '';
+    width: 6px;
+    height: 6px;
+    margin-right: var(--space-4);
+    border-right: 1.5px solid var(--color-icon-idle);
+    border-bottom: 1.5px solid var(--color-icon-idle);
+    rotate: 45deg;
+    translate: 0 -2px;
+    transition: rotate var(--motion-duration-open) var(--motion-easing-standard);
+  }
+
+  .toc-details[open] > summary::after {
+    rotate: 225deg;
+    translate: 0 2px;
+  }
+
+  .toc-details .toc-list {
+    margin-bottom: var(--space-12);
+  }
+}
+
+@media (max-width: 767px) {
+  .content {
+    padding-bottom: var(--space-32);
+  }
+
+  .site-header-inner {
+    gap: var(--space-12);
+  }
+
+  .filter-bar .field {
+    flex: 1 1 100%;
+  }
+
+  .page-close {
+    padding-block: var(--space-96);
+  }
+
+  .closing-line {
+    font-size: var(--font-size-prose);
+    margin-top: var(--space-16);
+  }
+
+  .newsletter-form,
+  .newsletter-done {
+    margin-top: var(--space-32);
+  }
+
+  .article-body {
+    font-size: var(--font-size-prose);
+  }
+}
+
+@media (max-width: 639.98px) {
+  .post-list,
+  .card-grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .post-card,
+  .author-card {
+    padding: var(--space-24) var(--space-20);
+  }
+}
+
+/* Reduced motion: loops end on their base frame. */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: var(--motion-duration-instant) !important;
+    animation-iteration-count: 1 !important;
+    animation-delay: 0s !important;
+    transition-duration: var(--motion-duration-instant) !important;
+    transition-delay: 0s !important;
+  }
+  .btn:active,
+  .button:active {
+    transform: none;
   }
 }
