index 8c45cab..33b059b 100644
--- a/src/components/TableOfContents.tsx
+++ b/src/components/TableOfContents.tsx
@@ -1,25 +1,80 @@
+import { useEffect, useState, type MouseEvent } from 'react';
 import type { Block } from '../data/posts';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const RAIL_QUERY = '(min-width: 1024px)';
+
+/** True from breakpoint.lg, where the contents list is a side rail rather than a closed disclosure. */
+function useRail() {
+  const [rail, setRail] = useState(() => window.matchMedia(RAIL_QUERY).matches);
+  useEffect(() => {
+    const query = window.matchMedia(RAIL_QUERY);
+    const update = () => setRail(query.matches);
+    query.addEventListener('change', update);
+    return () => query.removeEventListener('change', update);
+  }, []);
+  return rail;
+}
+
+/** The heading nearest above the top of the viewport. */
+function useCurrentHeading(ids: string[]) {
+  const [current, setCurrent] = useState<string | null>(ids[0] ?? null);
+  useEffect(() => {
+    const update = () => {
+      const line = 120;
+      let found = ids[0] ?? null;
+      for (const id of ids) {
+        const el = document.getElementById(id);
+        if (el && el.getBoundingClientRect().top <= line) found = id;
+      }
+      setCurrent(found);
+    };
+    update();
+    window.addEventListener('scroll', update, { passive: true });
+    window.addEventListener('hashchange', update);
+    return () => {
+      window.removeEventListener('scroll', update);
+      window.removeEventListener('hashchange', update);
+    };
+  }, [ids.join('|')]);
+  return current;
+}
+
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const rail = useRail();
+  const current = useCurrentHeading(headings.map((heading) => heading.id));
   if (headings.length === 0) return null;
 
+  // On the rail the list is always open; the summary is only its label.
+  const keepOpen = (event: MouseEvent) => {
+    if (rail) event.preventDefault();
+  };
+
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      <details className="toc-details" open={rail}>
+        <summary onClick={keepOpen} tabIndex={rail ? -1 : undefined}>
+          <h2 id="toc-heading" className="toc-heading mono-label">
+            On this page
+          </h2>
+        </summary>
+        <ol className="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a
+                href={`#${heading.id}`}
+                className="toc-link"
+                data-testid="toc-link"
+                aria-current={current === heading.id ? 'true' : undefined}
+              >
+                {heading.text}
+              </a>
+            </li>
+          ))}
+        </ol>
+      </details>
     </nav>
   );
 }
