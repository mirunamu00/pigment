+
+  .kpi-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
   }
 
   .two-column {
-    grid-template-columns: 1fr;
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+@media (max-width: 767.98px) {
+  :root {
+    --page-pad: var(--space-20);
+  }
+
+  .screen-head-actions {
+    margin-left: 0;
+  }
+
+  .detail-grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .field-inline {
+    flex: 1;
+  }
+
+  .field-inline .search-field {
+    flex: 1;
+    width: auto;
+  }
+
+  /* From breakpoint.sm to breakpoint.md the table scrolls with the pinned column held. */
+  .tbl td:first-child {
+    white-space: nowrap;
+    min-width: 160px;
+  }
+
+  .tbl .pin {
+    position: sticky;
+    right: 0;
+    z-index: 1;
+    text-align: right;
+    background: var(--pin-bg, var(--color-surface-default));
+    box-shadow: inset 1px 0 0 var(--color-border-subtle);
+    padding-left: var(--space-12);
+  }
+
+  .tbl .pin::before {
+    content: '';
+    position: absolute;
+    inset-block: 0;
+    right: 100%;
+    width: var(--space-16);
+    pointer-events: none;
+    background: linear-gradient(90deg, transparent, var(--pin-bg, var(--color-surface-default)));
+  }
+
+  .tbl tr:hover .pin {
+    background: linear-gradient(var(--color-surface-tint), var(--color-surface-tint)), var(--pin-bg, var(--color-surface-default));
+  }
+}
+
+@media (max-width: 639.98px) {
+  /* breakpoint.sm */
+  .kpi-grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .user-menu-name {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    white-space: nowrap;
+  }
+
+  .user-menu-button {
+    padding: 0 var(--space-8);
+  }
+
+  .toolbar {
+    flex-direction: column;
+    align-items: stretch;
+  }
+
+  .segmented {
+    align-self: flex-start;
+  }
+
+  .task-assignee-name {
+    display: none;
+  }
+
+  .tbl-wrap {
+    overflow-x: visible;
+  }
+
+  .tbl {
+    width: 100%;
+    table-layout: auto;
+  }
+
+  .tbl :is(th, td):not(:first-child):not(.pin) {
+    display: none;
+  }
+
+  .tbl :is(th, td):first-child {
+    width: 100%;
+    max-width: 0;
+    min-width: 0;
+    overflow: hidden;
+  }
+
+  .tbl .pin {
+    width: 1%;
+    white-space: nowrap;
+    box-shadow: none;
+  }
+
+  .tbl .pin::before {
+    display: none;
+  }
+
+  .cell-lines {
+    flex: 1;
+    min-width: 0;
+  }
+
+  .cell-lines > *,
+  .cell-lines[data-sub]::after {
+    display: block;
+    line-height: var(--font-line-height-ui);
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+  }
+
+  .cell-lines[data-sub]::after {
+    content: attr(data-sub) '\00a0';
+    color: var(--color-text-tertiary);
+    font-size: var(--font-size-caption);
+    font-weight: var(--font-weight-regular);
+  }
+
+  .cell-lines .badge {
+    padding: 0;
+    border: 0;
+  }
+
+  .cell-lines .badge-label {
+    position: absolute;
+    clip: rect(0 0 0 0);
+  }
+
+  .pin--unit-head {
+    font-size: 0;
+  }
+
+  .pin-unit {
+    display: inline;
+  }
+}
+
+/* Reduced motion: loops end on their base frame. */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: var(--motion-duration-instant) !important;
+    animation-iteration-count: 1 !important;
+    animation-delay: 0s !important;
+    transition-duration: var(--motion-duration-instant) !important;
+    transition-delay: 0s !important;
+  }
+  .btn:active,
+  .button:active,
+  .segmented-button:active {
+    transform: none;
   }
 }
