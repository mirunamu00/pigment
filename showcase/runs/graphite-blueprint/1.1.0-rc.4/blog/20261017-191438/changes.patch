+import { useEffect, useState, type MouseEvent } from 'react';
 import type { Block } from '../data/posts';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+/* A side rail from breakpoint.lg; below it, a closed disclosure after the lead plate. */
+const RAIL_QUERY = '(min-width: 1024px)';
+const isRail = () => typeof window !== 'undefined' && window.matchMedia(RAIL_QUERY).matches;
+
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const [rail, setRail] = useState(isRail);
+  const [open, setOpen] = useState(isRail);
+  const [current, setCurrent] = useState<string | null>(null);
+
+  useEffect(() => {
+    const query = window.matchMedia(RAIL_QUERY);
+    const update = () => {
+      setRail(query.matches);
+      setOpen(query.matches);
+    };
+    query.addEventListener('change', update);
+    return () => query.removeEventListener('change', update);
+  }, []);
+
+  // The current section: the last heading scrolled past the top of the reading area.
+  useEffect(() => {
+    const ids = headings.map((heading) => heading.id);
+    const onScroll = () => {
+      let active: string | null = null;
+      for (const id of ids) {
+        const element = document.getElementById(id);
+        if (element && element.getBoundingClientRect().top < 120) active = id;
+      }
+      setCurrent(active);
+    };
+    onScroll();
+    window.addEventListener('scroll', onScroll, { passive: true });
+    return () => window.removeEventListener('scroll', onScroll);
+  }, [blocks]);
+
   if (headings.length === 0) return null;
 
+  function keepRailOpen(event: MouseEvent) {
+    if (rail) event.preventDefault();
+  }
+
   return (
-    <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
-    </nav>
+    <details
+      className="toc-details"
+      open={open}
+      onToggle={(event) => setOpen(event.currentTarget.open)}
+    >
+      <summary className="toc-summary" onClick={keepRailOpen} tabIndex={rail ? -1 : undefined}>
+        <h2 id="toc-heading" className="toc-heading">
+          On this page
+        </h2>
+        <svg className="toc-chevron" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
+          <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" strokeWidth="1.5" />
+        </svg>
+      </summary>
+      <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
+        <ol className="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a
+                href={`#${heading.id}`}
+                className="toc-link"
+                data-testid="toc-link"
+                aria-current={current === heading.id ? 'location' : undefined}
+              >
+                {heading.text}
+              </a>
+            </li>
+          ))}
+        </ol>
+      </nav>
+    </details>
   );
 }
