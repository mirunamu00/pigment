 }
 
-/** Image placeholder: a tinted CSS box with an icon. No network images. */
+/** Kinds over the full catalog order, so the same product shows the same figure on every screen. */
+const KINDS = specKinds(products.map((product) => product.slug));
+
+/** "FIG 01 · 18 OZ CANVAS": the catalog number and one fact about the item. */
+export function plateCaption(product: Product): string {
+  const number = String(products.indexOf(product) + 1).padStart(2, '0');
+  return `FIG ${number} · ${product.details[0]}`.toUpperCase();
+}
+
+/**
+ * Image placeholder: a spec plate (signature 4). On the detail page the same figure sits larger on a
+ * quiet stage (signature 1), its caption the only FIG. No network images.
+ */
 export default function ProductImage({ product, size = 'card' }: ProductImageProps) {
-  return (
-    <div
-      className={`product-image product-image-${size} tone-${product.tone}`}
+  const plate = (
+    <SpecPlate
+      id={product.slug}
+      kind={KINDS.get(product.slug) ?? 0}
+      caption={plateCaption(product)}
+      className={`product-image product-image-${size}`}
       role="img"
       aria-label={`${product.name} product photo placeholder`}
       data-testid="product-image"
-    >
-      <ImageIcon className="product-image-icon" />
-    </div>
+    />
+  );
+
+  if (size === 'card') return plate;
+  return (
+    <Stage quiet className="product-stage">
+      {plate}
+    </Stage>
   );
 }
