+  border-color: var(--color-accent-default);
+}
+
+.input[aria-invalid='true'] {
+  border-color: var(--color-status-danger);
+}
+
+.select-wrap {
+  position: relative;
+  display: inline-flex;
+}
+
+.select {
+  appearance: none;
+  width: auto;
+  padding-right: var(--space-32);
+  cursor: pointer;
+}
+
+.select-chevron {
+  position: absolute;
+  right: var(--space-12);
+  top: 50%;
+  translate: 0 -50%;
+  color: var(--color-icon-idle);
+  pointer-events: none;
+}
+
+.field-inline {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-8);
+}
+
+.field-inline-label {
+  font-size: var(--font-size-small);
+  color: var(--color-text-secondary);
+  white-space: nowrap;
+}
+
+/* Checkbox: 14px box, accent when checked. The label row is the hit area. */
+.check {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-8);
+  min-height: var(--size-row-dense);
+  font-size: var(--font-size-small);
+  color: var(--color-text-body);
+  cursor: pointer;
+  white-space: nowrap;
+}
+
+.checkbox {
+  appearance: none;
+  display: inline-grid;
+  place-items: center;
+  flex: none;
+  width: 14px;
+  height: 14px;
+  margin: 0;
+  border: var(--border-width-hairline) solid var(--color-border-check);
+  border-radius: var(--radius-xs);
+  background: transparent;
+  cursor: pointer;
+  transition:
+    background-color var(--motion-duration-hover) var(--motion-easing-ease),
+    border-color var(--motion-duration-hover) var(--motion-easing-ease);
+}
+
+.checkbox::after {
+  content: '';
+  width: 8px;
+  height: 4px;
+  margin-top: -2px;
+  border-left: 1.5px solid var(--color-text-on-accent);
+  border-bottom: 1.5px solid var(--color-text-on-accent);
+  rotate: -45deg;
+  opacity: 0;
+}
+
+.checkbox:checked {
+  background: var(--color-accent-default);
+  border-color: var(--color-accent-default);
+}
+
+.checkbox:checked::after {
+  opacity: 1;
+}
+
+/* Banner: hairline box with a 7% status wash and a 6px dot. */
+.banner {
+  display: flex;
+  align-items: baseline;
+  gap: var(--space-8);
+  padding: var(--space-12) var(--space-16);
+  border: var(--border-width-hairline) solid var(--color-border-default);
+  border-radius: var(--radius-md);
+  font-size: var(--font-size-small);
+  line-height: var(--font-line-height-ui);
+  color: var(--color-text-body);
+}
+
+.banner--danger {
+  background: var(--color-status-danger-tint);
+}
+
+.banner--success {
+  background: var(--color-status-success-tint);
+}
+
+.banner-dot {
+  flex: none;
+  width: var(--space-6);
+  height: var(--space-6);
+  border-radius: var(--radius-full);
+  translate: 0 -1px;
+  background: var(--color-status-success);
+}
+
+.banner--danger .banner-dot {
+  background: var(--color-status-danger);
+}
+
+/* Badge: 20px pill, hairline, 6px dot. */
+.badge {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-6);
+  height: 20px;
+  padding: 0 var(--space-8);
+  border: var(--border-width-hairline) solid var(--color-border-default);
+  border-radius: var(--radius-full);
+  background: transparent;
+  font-size: var(--font-size-caption);
+  font-weight: var(--font-weight-medium);
+  line-height: 1;
+  color: var(--color-text-body);
+  white-space: nowrap;
+}
+
+.badge-dot {
+  width: var(--space-6);
+  height: var(--space-6);
+  border-radius: var(--radius-full);
+  background: var(--color-icon-idle);
+}
+
+/* Segmented pills (option pickers): native radios in labels, the input visually hidden. */
+.segmented {
+  display: inline-flex;
+  flex-wrap: wrap;
+  gap: var(--space-2);
+  padding: var(--space-2);
+  border: var(--border-width-hairline) solid var(--color-border-subtle);
+  border-radius: var(--radius-full);
+  background: var(--color-surface-card);
+}
+
+.segment {
+  position: relative;
+  display: inline-flex;
+  align-items: center;
+  height: var(--size-control-sm);
+  padding: 0 var(--space-12);
+  border-radius: var(--radius-full);
+  font-size: var(--font-size-small);
+  font-weight: var(--font-weight-medium);
+  color: var(--color-text-secondary);
+  cursor: pointer;
+  white-space: nowrap;
+  transition:
+    background-color var(--motion-duration-hover) var(--motion-easing-ease),
+    color var(--motion-duration-hover) var(--motion-easing-ease);
+}
+
+.segment input {
+  position: absolute;
+  opacity: 0;
+  width: 1px;
+  height: 1px;
+  margin: 0;
+}
+
+.segment:has(:checked) {
+  background: var(--color-surface-press);
+  box-shadow: var(--elevation-ring);
+  color: var(--color-text-primary);
+}
+
+.segment:has(:focus-visible) {
+  outline: var(--border-width-hairline) solid var(--color-focus-ring);
+  outline-offset: 2px;
+}
+
+/* Quantity stepper: a pill group of two icon buttons around a numeric field. */
+.stepper {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: var(--space-6);
+}
+
+.stepper-controls {
+  display: inline-flex;
+  align-items: center;
+  height: var(--size-field);
+  padding: 0 var(--space-4);
+  border: var(--border-width-hairline) solid var(--color-border-default);
+  border-radius: var(--radius-full);
+  background: var(--color-surface-card);
+  transition: border-color var(--motion-duration-hover) var(--motion-easing-ease);
+}
+
+.stepper-input {
+  width: 40px;
+  height: 100%;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--color-text-primary);
+  font-size: var(--font-size-dense);
+  font-weight: var(--font-weight-medium);
+  font-variant-numeric: tabular-nums;
+  text-align: center;
+  appearance: textfield;
+  -moz-appearance: textfield;
+}
+
+.stepper-input::-webkit-outer-spin-button,
+.stepper-input::-webkit-inner-spin-button {
+  -webkit-appearance: none;
+  margin: 0;
+}
+
+.stepper-input:focus-visible {
+  outline-offset: -2px;
+  border-radius: var(--radius-xs);
+}
+
+.form-actions {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--space-12);
+}
+
+/* --------------------------------------------------------- Hover (fine) */
+@media (hover: hover) and (pointer: fine) {
+  a:hover {
+    text-decoration-color: var(--color-text-primary);
+  }
+
+  .nav-link:hover {
+    color: var(--color-text-primary);
+    background: var(--color-action-ghost-hover);
+  }
+
+  .button-primary:not(:disabled):hover {
+    background: var(--color-action-primary-hover);
+  }
+
+  .button-secondary:not(:disabled):hover {
+    background: var(--color-action-secondary-hover);
+    color: var(--color-text-primary);
+  }
+
+  .button-bordered:not(:disabled):hover {
+    color: var(--color-text-primary);
+    border-color: var(--color-border-strong);
+  }
+
+  .icon-button:not(:disabled):hover {
+    color: var(--color-icon-active);
+    background: var(--color-action-ghost-hover);
+  }
+
+  .chip:hover {
+    color: var(--color-text-primary);
+    border-color: var(--color-border-strong);
+  }
+
+  .input:hover,
+  .select:hover,
+  .stepper-controls:hover {
+    border-color: var(--color-border-strong);
+  }
+
+  .input[aria-invalid='true']:hover {
+    border-color: var(--color-status-danger);
+  }
+
+  .check:hover .checkbox:not(:checked) {
+    border-color: var(--color-text-secondary);
+  }
+
+  .segment:hover:not(:has(:checked)) {
+    color: var(--color-text-body);
+  }
+
+  .product-card:hover {
+    background: var(--color-surface-hover);
+  }
+
+  .opener-link:hover,
+  .breadcrumb a:hover {
+    color: var(--color-text-primary);
+  }
 }
 
