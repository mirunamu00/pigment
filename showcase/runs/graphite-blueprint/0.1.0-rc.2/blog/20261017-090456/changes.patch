+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const [currentId, setCurrentId] = useState<string | null>(null);
+  const idKey = headings.map((heading) => heading.id).join(' ');
+
+  // Mark the section being read: the last heading that has passed the top band of the viewport.
+  useEffect(() => {
+    const ids = idKey ? idKey.split(' ') : [];
+    const targets = ids.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => el !== null);
+    if (targets.length === 0) return;
+    const update = () => {
+      let current: string | null = null;
+      for (const target of targets) if (target.getBoundingClientRect().top < window.innerHeight * 0.3) current = target.id;
+      setCurrentId(current);
+    };
+    window.addEventListener('scroll', update, { passive: true });
+    update();
+    return () => window.removeEventListener('scroll', update);
+  }, [idKey]);
+
   if (headings.length === 0) return null;
 
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
+      <h2 id="toc-heading" className="toc-heading mono-label">
         On this page
       </h2>
       <ol className="toc-list">
         {headings.map((heading) => (
           <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
+            <a
+              href={`#${heading.id}`}
+              className="toc-link"
+              aria-current={currentId === heading.id ? 'location' : undefined}
+              data-testid="toc-link"
+            >
               {heading.text}
             </a>
           </li>
