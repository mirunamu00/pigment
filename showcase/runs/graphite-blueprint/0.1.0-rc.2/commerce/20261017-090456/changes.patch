+  letter-spacing: var(--font-tracking-lead);
+}
+
+.confirmation-statement strong {
+  font-weight: inherit;
+  font-variant-numeric: tabular-nums;
+}
+
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-8);
+  margin-top: var(--space-16);
+}
+
+/* Hover only where it exists */
+@media (hover: hover) and (pointer: fine) {
+  a:hover {
+    text-decoration-color: var(--color-text-primary);
+  }
+  .nav-link:hover {
+    color: var(--color-text-primary);
+    background: var(--color-action-ghost-hover);
+  }
+  .nav-link[aria-current='page']:hover {
+    background: var(--color-surface-tint);
+  }
+  .icon-button:hover {
+    color: var(--color-icon-active);
+    background: var(--color-action-ghost-hover);
+  }
+  .button-primary:hover:not(:disabled) {
+    background: var(--color-action-primary-hover);
+  }
+  .button-secondary:hover:not(:disabled),
+  .stepper-button:hover:not(:disabled) {
+    background: var(--color-action-secondary-hover);
+    color: var(--color-text-primary);
+  }
+  .button-ghost:hover:not(:disabled) {
+    background: var(--color-action-ghost-hover);
+    color: var(--color-text-primary);
+  }
+  .chip:hover {
+    color: var(--color-text-primary);
+    border-color: var(--color-border-strong);
+  }
+  .input:hover:not(:focus-visible):not([aria-invalid='true']),
+  .select:hover:not(:focus-visible) {
+    border-color: var(--color-border-strong);
+  }
+  .checkbox:hover:not(:checked),
+  .radio:hover:not(:checked) {
+    border-color: var(--color-text-secondary);
+  }
+  .variant-option:hover:not(:has(:checked)) {
+    color: var(--color-text-body);
+  }
+  .product-card:hover {
+    background: var(--color-surface-hover);
+  }
+  .opener-link:hover,
+  .breadcrumb a:hover {
+    color: var(--color-text-primary);
+  }
 }
 
