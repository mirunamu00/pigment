-.confirmation {
-  background: var(--color-success-bg);
-  color: var(--color-success-text);
+/* Hover rules: fine pointers only */
+@media (hover: hover) and (pointer: fine) {
+  a:hover {
+    text-decoration-color: var(--color-text-primary);
+  }
+  .nav-link:hover,
+  .opener-link:hover,
+  .breadcrumb a:hover {
+    color: var(--color-text-primary);
+  }
+  .nav-link:hover {
+    background: var(--color-action-ghost-hover);
+  }
+  .nav-link[aria-current='page']:hover {
+    background: var(--color-surface-tint);
+  }
+  .icon-button:hover {
+    color: var(--color-icon-active);
+    background: var(--color-action-ghost-hover);
+  }
+  .button-primary:hover:not(:disabled) {
+    background: var(--color-action-primary-hover);
+  }
+  .button-secondary:hover:not(:disabled) {
+    background: var(--color-action-secondary-hover);
+    color: var(--color-text-primary);
+  }
+  .button-bordered:hover:not(:disabled) {
+    border-color: var(--color-border-strong);
+    color: var(--color-text-primary);
+  }
+  .chip:hover {
+    border-color: var(--color-border-strong);
+  }
+  .input:hover:not(:disabled):not([aria-invalid='true']),
+  .select:hover:not(:disabled) {
+    border-color: var(--color-border-strong);
+  }
+  .checkbox:hover:not(:checked) {
+    border-color: var(--color-text-secondary);
+  }
+  .segmented label:hover {
+    color: var(--color-text-body);
+  }
+  .segmented label:has(:checked):hover {
+    color: var(--color-text-primary);
+  }
+  .product-card:hover {
+    background: var(--color-surface-hover);
+    box-shadow:
+      1px 0 0 var(--color-border-strong),
+      0 1px 0 var(--color-border-strong);
+  }
+  .cart-line-name:hover {
+    text-decoration: underline;
+    text-decoration-color: var(--color-text-primary);
+  }
 }
 
