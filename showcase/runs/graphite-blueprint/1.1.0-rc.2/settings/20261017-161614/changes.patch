+  border-radius: var(--radius-md) var(--radius-md) 0 0;
+  -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent);
+  mask-image: linear-gradient(to bottom, #000 70%, transparent);
+}
+
+.stage-ghost {
+  position: absolute;
+  inset: var(--space-56) var(--space-56) 0;
+  translate: 32px 24px;
+  z-index: -1;
+  opacity: var(--opacity-ghost);
+  filter: blur(2px);
+}
+
+.stage--quiet {
+  display: flex;
+  flex-direction: column;
+  padding: var(--space-24);
+  background: radial-gradient(120% 90% at 50% 0%, var(--color-stage-mid), var(--color-stage-ground) 70%);
+}
+
+.stage--quiet .stage-window {
+  flex: 1;
+  min-height: 0;
+  border-radius: var(--radius-md);
+  -webkit-mask-image: none;
+  mask-image: none;
+}
+
+.stage.is-armed .stage-window {
+  transform: translateY(var(--motion-distance-settle-from)) scale(1.05);
+  filter: blur(2px);
+  transition:
+    transform var(--motion-duration-settle) var(--motion-easing-settle),
+    filter var(--motion-duration-settle) var(--motion-easing-settle);
+}
+
+.stage.is-armed.is-in .stage-window {
+  transform: none;
+  filter: none;
+}
+
+.fig {
+  display: grid;
+  gap: var(--space-4);
+  margin-top: var(--space-16);
+  font-size: var(--font-size-body);
+  color: var(--color-text-secondary);
+}
+
+.fig b {
+  font-weight: var(--font-weight-medium);
+  color: var(--color-text-primary);
+}
+
+/* ---------- Signature 2: dot-matrix glyph ---------- */
+.dm {
+  display: inline-block;
+  flex: none;
+  width: var(--size-glyph-sm);
+  height: var(--size-glyph-sm);
+  overflow: hidden;
+  vertical-align: middle;
+  color: var(--color-glyph-dot);
+}
+
+.dm--xs {
+  width: var(--size-glyph-xs);
+  height: var(--size-glyph-xs);
+}
+
+.dm--md {
+  width: var(--size-glyph-md);
+  height: var(--size-glyph-md);
+}
+
+.dm--lg {
+  width: var(--size-glyph-lg);
+  height: var(--size-glyph-lg);
+}
+
+.dm--xl {
+  width: var(--size-glyph-xl);
+  height: var(--size-glyph-xl);
+}
+
+.dm--error {
+  color: var(--color-status-danger);
+}
+
+.dm circle {
+  fill: currentColor;
+  opacity: var(--opacity-dot-off);
+}
+
+.dm circle.on {
+  opacity: 1;
+}
+
+.dm-strip {
+  transform: translateX(calc(var(--dm-rest) * -15px));
+}
+
+.dm--run .dm-strip {
+  animation: dm-step var(--dm-dur) steps(var(--dm-n)) infinite;
+}
+
+@keyframes dm-step {
+  from {
+    transform: translateX(0);
+  }
+  to {
+    transform: translateX(calc(var(--dm-n) * -15px));
+  }
+}
+
+.dot-field {
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  pointer-events: none;
+  opacity: var(--opacity-dot-field);
+  background: radial-gradient(circle, var(--color-glyph-dot) 1px, transparent 1.5px) 0 0 / 12px 12px;
+  -webkit-mask-image: linear-gradient(90deg, #000, transparent 30% 70%, #000);
+  mask-image: linear-gradient(90deg, #000, transparent 30% 70%, #000);
+}
+
+.dot-meter {
+  display: inline-flex;
+  gap: var(--space-4);
+}
+
+.dot-meter i {
+  width: var(--space-6);
+  height: var(--space-6);
+  border-radius: var(--radius-full);
+  background: var(--color-glyph-dot);
+  opacity: var(--opacity-dot-off);
+}
+
+.dot-meter i.on {
+  opacity: 1;
+  background: var(--meter, var(--color-glyph-dot));
+}
+
+.dot-meter--danger {
+  --meter: var(--color-status-danger);
+}
+
+.dot-meter--warning {
+  --meter: var(--color-status-warning);
+}
+
+.dot-meter--success {
+  --meter: var(--color-status-success);
+}
+
+/* ---------- Signature 3: blueprint ---------- */
+.bp {
+  display: block;
+  overflow: visible;
+  fill: none;
+}
+
+.bp path {
+  vector-effect: non-scaling-stroke;
+  stroke-width: var(--border-width-drawing);
+}
+
+.bp-shadow {
+  fill: var(--color-blueprint-face);
+  stroke: none;
+  color-interpolation-filters: sRGB;
+  filter: drop-shadow(0 8px 12px var(--color-blueprint-shadow));
+}
+
+.bp-body {
+  fill: var(--color-blueprint-face);
+  stroke: var(--color-blueprint-front);
+}
+
+.bp-seam {
+  stroke: var(--color-blueprint-back);
+  stroke-linecap: round;
+}
+
+.bp-mark {
+  fill: var(--color-blueprint-mark);
+}
+
+.bp .bp-link {
+  stroke: var(--color-blueprint-mark);
+  stroke-width: var(--border-width-hairline);
+  stroke-dasharray: 2 4;
+  animation: bp-dash var(--motion-duration-dash) linear infinite;
+}
+
+.bp .bp-link--stopped {
+  animation: none;
+}
+
+.bp-point {
+  fill: var(--color-status-danger);
+}
+
+.bp-chev {
+  stroke: var(--color-blueprint-front);
+  offset-distance: calc(var(--k) * 33% + 16%);
+  animation: bp-flow var(--motion-duration-flow) linear calc(var(--k) * var(--motion-duration-flow) / -3) infinite;
+}
+
+.bp-slab {
+  transition: transform var(--motion-duration-settle) var(--motion-easing-settle) calc(var(--i) * 60ms);
+}
+
+.bp.is-lifted .bp-slab {
+  transform: translateY(calc(var(--i) * -1 * var(--motion-distance-lift)));
+}
+
+@keyframes bp-dash {
+  to {
+    stroke-dashoffset: var(--motion-distance-dash);
+  }
+}
+
+@keyframes bp-flow {
+  from {
+    offset-distance: 0%;
+    opacity: 0;
+  }
+  20%,
+  80% {
+    opacity: 1;
   }
+  to {
+    offset-distance: 100%;
+    opacity: 0;
+  }
+}
+
+.bp-row {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--size-blueprint-lg)), 1fr));
+  gap: var(--space-32);
+}
+
+.bp--lg {
+  width: min(100%, var(--size-blueprint-lg));
+  height: auto;
+  flex: none;
+}
+
+.bp--md {
+  width: var(--size-blueprint-md);
+  height: auto;
+}
+
+.bp--sm {
+  width: var(--size-blueprint-sm);
+  height: auto;
+}
+
+/* Plan cards lift their tier slabs on hover (signature 3 motion); slabs rest under reduced motion. */
+@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
+  .plan-card:hover .bp-slab {
+    transform: translateY(calc(var(--i) * -1 * var(--motion-distance-lift)));
+  }
+}
+
+/* ---------- Signature 4: spec plate ---------- */
+.plate {
+  position: relative;
+  display: grid;
+  place-items: center;
+  aspect-ratio: 4 / 3;
+  overflow: hidden;
+  background: var(--color-surface-subtle);
+  border: var(--border-width-hairline) solid var(--color-border-subtle);
+  border-radius: var(--radius-md);
+}
+
+.plate--wide {
+  aspect-ratio: 16 / 9;
+}
+
+.plate svg {
+  width: 78%;
+  height: 78%;
+}
+
+.plate :is(ellipse, line, rect:not(.pf-on)) {
+  fill: none;
+  stroke-width: var(--border-width-drawing);
+  vector-effect: non-scaling-stroke;
+}
+
+.pf-f {
+  stroke: var(--color-blueprint-front);
+}
+
+.pf-b {
+  stroke: var(--color-blueprint-mark);
+}
+
+.pf-on {
+  fill: var(--color-blueprint-front);
+}
+
+.pf-off {
+  fill: var(--color-blueprint-mark);
+  opacity: var(--opacity-dot-off);
+}
+
+.plate .mono-label {
+  position: absolute;
+  left: var(--space-12);
+  bottom: var(--space-8);
+}
+
+/* ---------- Signature 5: shimmer and live edges ---------- */
+.shimmer {
+  background: linear-gradient(
+      90deg,
+      var(--color-text-secondary) 40%,
+      var(--color-text-primary) 50%,
+      var(--color-text-secondary) 60%
+    )
+    100% 0 / 300% 100%;
+  color: transparent;
+  -webkit-background-clip: text;
+  background-clip: text;
+  animation: shimmer var(--motion-duration-shimmer) linear infinite;
+}
+
+@keyframes shimmer {
+  0% {
+    background-position: 100% 0;
+  }
+  75%,
+  100% {
+    background-position: 0 0;
+  }
+}
+
+.live-edge {
+  border: var(--border-width-hairline) solid transparent;
+  animation: edge var(--motion-duration-pulse) ease infinite;
+  background:
+    linear-gradient(var(--color-surface-raised), var(--color-surface-raised)) padding-box,
+    linear-gradient(90deg, var(--color-border-strong), var(--color-text-secondary), var(--color-border-strong)) 0 0 / 120px 100%
+      border-box;
+}
+
+@keyframes edge {
+  to {
+    background-position:
+      0 0,
+      120px 0;
+  }
+}
+
+.pulse {
+  position: relative;
+  display: inline-block;
+  flex: none;
+  width: var(--space-6);
+  height: var(--space-6);
+  border-radius: var(--radius-full);
+  background: var(--color-status-success);
+}
+
+.pulse::after {
+  content: '';
+  position: absolute;
+  inset: -5px;
+  border-radius: inherit;
+  background: inherit;
+  opacity: 0;
+  animation: pulse var(--motion-duration-pulse) ease-out infinite;
+}
+
+.pulse--stale {
+  background: var(--color-icon-idle);
+}
+
+.pulse--stale::after {
+  content: none;
+}
+
+@keyframes pulse {
+  0% {
+    transform: scale(0.375);
+    opacity: 0.7;
+  }
+  60%,
+  100% {
+    transform: scale(1);
+    opacity: 0;
+  }
+}
+
+.caret {
+  display: inline-block;
+  width: 1px;
+  height: 1em;
+  vertical-align: text-bottom;
+  background: var(--color-text-primary);
+  animation: caret var(--motion-duration-caret) steps(1) infinite;
+}
+
+@keyframes caret {
+  50% {
+    opacity: 0;
+  }
+}
+
+.turn-in {
+  animation: turn-in var(--motion-duration-enter) var(--motion-easing-enter) both;
+}
 
+@keyframes turn-in {
+  from {
+    opacity: 0;
+  }
+}
+
+/* ---------- Responsive ---------- */
+@media (max-width: 1023.98px) {
+  .settings-layout {
+    flex-direction: column;
+  }
+  .sidebar {
+    width: auto;
+    padding: var(--space-12) var(--page-pad);
+    background: var(--color-surface-default);
+    border-right: 0;
+    border-bottom: var(--border-width-hairline) solid var(--color-border-subtle);
+  }
+  .sidebar nav {
+    position: static;
+  }
+  .nav-group-label,
+  .nav-icon {
+    display: none;
+  }
   .nav-list {
     display: flex;
     flex-wrap: wrap;
-    gap: var(--space-2);
+    gap: var(--space-4);
+  }
+  .nav-link {
+    height: var(--size-control);
+    border-radius: var(--radius-full);
+    font-size: var(--font-size-small);
+  }
+  .nav-link:focus-visible {
+    outline-offset: 2px;
   }
-
-  .form-grid,
   .plan-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 767.98px) {
+  :root {
+    --page-pad: var(--space-20);
+  }
+  .opener,
+  .screen-head {
     grid-template-columns: 1fr;
+    gap: var(--space-16);
+  }
+  .opener {
+    padding-top: var(--space-96);
+  }
+  .opener h2 {
+    font-size: var(--font-size-h3);
+  }
+  .opener p {
+    font-size: var(--font-size-prose);
+  }
+  .stage {
+    padding: var(--space-24) var(--space-24) 0;
+  }
+  .stage--quiet {
+    padding: var(--space-16);
+  }
+  .stage-ghost {
+    display: none;
+  }
+  .group--split,
+  .group--stack > .group-head {
+    grid-template-columns: minmax(0, 1fr);
+    gap: var(--space-16);
+  }
+  .group--stack > .group-head {
+    row-gap: var(--space-4);
+  }
+  .group--stack > .group-head > :is(.mono-label, .group-title, .group-desc, .group-count) {
+    grid-column: 1;
+    grid-row: auto;
+  }
+  .group--stack > .group-head > .group-count {
+    order: 3;
+  }
+  .fieldset {
+    grid-template-rows: none;
+    row-gap: var(--space-4);
+  }
+  .fieldset :is(.legend, .group-counter, .group-desc, .group-count, .switch-list) {
+    grid-column: 1;
+    grid-row: auto;
+  }
+  .fieldset .group-counter {
+    order: -1;
+  }
+  .fieldset .group-count {
+    margin-top: var(--space-4);
+  }
+  .fieldset .switch-list {
+    margin-top: var(--space-12);
+  }
+  .form-actions {
+    flex-direction: column;
+    align-items: stretch;
+  }
+  .form-actions .button {
+    display: flex;
+    width: 100%;
+  }
+  .status-line {
+    margin-left: 0;
+  }
+  .member-facts > div {
+    grid-template-columns: var(--space-96) minmax(0, 1fr);
+  }
+}
+
+@media (max-width: 639.98px) {
+  .plan-grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+  .dialog {
+    width: 100%;
+    max-width: none;
+    margin: auto 0 0;
+    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
+  }
+  .dialog-actions {
+    flex-direction: column-reverse;
+  }
+  .dialog-actions .button {
+    display: flex;
+    width: 100%;
+  }
+  .empty-actions {
+    flex-direction: column;
+    align-self: stretch;
+    width: 100%;
+  }
+  .empty-actions .button {
+    display: flex;
+    width: 100%;
+  }
+}
+
+/* ---------- Reduced motion: loops end on their base frame ---------- */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: var(--motion-duration-instant) !important;
+    animation-iteration-count: 1 !important;
+    animation-delay: 0s !important;
+    transition-duration: var(--motion-duration-instant) !important;
+    transition-delay: 0s !important;
+  }
+  .button:active {
+    transform: none;
+  }
+  .dm--run .dm-strip {
+    animation: none;
+  }
+  .bp-chev {
+    animation: none;
+    opacity: 1;
+  }
+  .bp .bp-link,
+  .shimmer,
+  .live-edge,
+  .caret {
+    animation: none;
+  }
+  .shimmer {
+    color: var(--color-text-secondary);
+    background: none;
+  }
+  .live-edge {
+    background:
+      linear-gradient(var(--color-surface-raised), var(--color-surface-raised)) padding-box,
+      linear-gradient(var(--color-border-strong), var(--color-border-strong)) border-box;
   }
 }
