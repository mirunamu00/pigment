+  color: var(--color-text-primary);
+  cursor: pointer;
+}
+
+.switch-desc {
+  font-size: var(--font-size-small);
+  color: var(--color-text-secondary);
+}
+
+.switch {
+  appearance: none;
+  position: relative;
+  flex: none;
+  width: var(--size-control-sm);
+  height: var(--size-icon);
+  margin: 0;
+  border: var(--border-width-hairline) solid var(--color-border-check);
+  border-radius: var(--radius-full);
+  background: var(--color-surface-press);
+  cursor: pointer;
+  transition:
+    background-color var(--motion-duration-hover) var(--motion-easing-standard),
+    border-color var(--motion-duration-hover) var(--motion-easing-standard);
+}
+
+.switch::after {
+  content: '';
+  position: absolute;
+  top: 1px;
+  left: 1px;
+  width: var(--size-glyph-xs);
+  height: var(--size-glyph-xs);
+  border-radius: var(--radius-full);
+  background: var(--color-text-secondary);
+  transition:
+    translate var(--motion-duration-hover) var(--motion-easing-standard),
+    background-color var(--motion-duration-hover) var(--motion-easing-standard);
+}
+
+.switch:checked {
+  background: var(--color-accent-default);
+  border-color: var(--color-accent-default);
+}
+
+.switch:checked::after {
+  translate: var(--space-12) 0;
+  background: var(--color-text-on-accent);
+}
+
+.switch:disabled {
+  opacity: var(--opacity-disabled);
+  cursor: not-allowed;
+}
+
+@media (hover: hover) and (pointer: fine) {
