+
+function SiteFooter({ theme, onToggleTheme }: { theme: Theme; onToggleTheme: () => void }) {
+  const [email, setEmail] = useState('');
+  const [status, setStatus] = useState<'idle' | 'error' | 'done'>('idle');
+
+  function handleSignup(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (!EMAIL_PATTERN.test(email.trim())) {
+      setStatus('error');
+      return;
+    }
+    setStatus('done');
+    setEmail('');
+  }
+
+  return (
+    <footer className="site-footer">
+      <Band hue="cream" edge="rise" className="footer-band">
+        <div className="footer-grid">
+          <div className="footer-brand">
+            <p className="footer-wordmark">Fieldhouse Supply</p>
+            <p className="footer-note">Fieldhouse Supply · Free shipping on orders over $100 · Returns within 30 days</p>
+          </div>
+          <nav aria-label="Footer" className="footer-links">
+            <div>
+              <h2 className="footer-heading">Shop</h2>
+              <ul>
+                <li>
+                  <Link to="/">All goods</Link>
+                </li>
+                {categories.map((category) => (
+                  <li key={category.id}>
+                    <Link to={`/?category=${category.id}`}>{category.label}</Link>
+                  </li>
+                ))}
+              </ul>
+            </div>
+            <div>
+              <h2 className="footer-heading">Orders</h2>
+              <ul>
+                <li>
+                  <Link to="/cart">Your cart</Link>
+                </li>
+              </ul>
+            </div>
+          </nav>
+          <form className="footer-signup" noValidate onSubmit={handleSignup}>
+            <label htmlFor="footer-email" className="field-label">
+              Get news from the shop
+            </label>
+            <div className="field-with-action">
+              <input
+                id="footer-email"
+                type="email"
+                className="input"
+                autoComplete="email"
+                value={email}
+                onChange={(event) => {
+                  setEmail(event.target.value);
+                  if (status !== 'idle') setStatus('idle');
+                }}
+                aria-invalid={status === 'error' ? true : undefined}
+                aria-describedby="footer-email-status"
+              />
+              <button type="submit" className="ms-pill">
+                Sign up
+              </button>
+            </div>
+            <p id="footer-email-status" className={status === 'error' ? 'field-error' : 'field-success'} role="status">
+              {status === 'error' && 'Enter an email address like name@example.com.'}
+              {status === 'done' && 'Thanks, you are on the list.'}
+            </p>
+          </form>
+        </div>
+      </Band>
+      <div className="footer-bar">
+        <p className="footer-bar-text">© Fieldhouse Supply</p>
+        <div className="footer-bar-actions">
+          <button
+            type="button"
+            className="ms-pill ms-pill--cream ms-circle"
+            onClick={onToggleTheme}
+            aria-label={theme === 'dark' ? 'Use light appearance' : 'Use dark appearance'}
+          >
+            {theme === 'dark' ? <SunIcon className="icon" /> : <MoonIcon className="icon" />}
+          </button>
+          <button
+            type="button"
+            className="ms-pill ms-pill--cream ms-circle"
+            onClick={() => window.scrollTo({ top: 0 })}
+            aria-label="Back to top"
+          >
+            <ArrowUpIcon className="icon" />
+          </button>
+        </div>
+      </div>
+    </footer>
+  );
+}
