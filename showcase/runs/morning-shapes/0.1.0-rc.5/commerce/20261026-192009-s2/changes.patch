+  );
+
+  if (size === 'thumb') {
+    return <div className={`product-cover product-cover-thumb ${hueClass(CATEGORY_HUE[product.category])}`}>{cover}</div>;
+  }
+
   return (
     <div
-      className={`product-image product-image-${size} tone-${product.tone}`}
+      className={`product-cover product-image product-image-${size} ${hueClass(CATEGORY_HUE[product.category])}`}
       role="img"
       aria-label={`${product.name} product photo placeholder`}
       data-testid="product-image"
     >
-      <ImageIcon className="product-image-icon" />
+      {cover}
     </div>
   );
 }
