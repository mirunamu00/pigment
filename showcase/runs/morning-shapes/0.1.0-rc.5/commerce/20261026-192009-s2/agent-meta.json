        "command": "python - <<'EOF'\nimport re\np='src/pages/ProductsPage.tsx'\ns=open(p,encoding='utf8').read()\nstart=s.index('  return (\\n    <>\\n      <div className=\"page-header\">')\ns=s[:start]+'''  return (\n    <>\n      <HeaderBand hue={AREA_HUE.shop} art={<ShopCluster />}>\n        <h1>Shop all goods</h1>\n        <p className=\"band-lead\">Durable bags, clothing and kitchen goods made to be used every day.</p>\n        <div className=\"band-actions\">\n          <Link to=\"/cart\" className=\"ms-pill ms-pill--on-field\">\n            View cart\n          </Link>\n        </div>\n      </HeaderBand>\n\n      <div className=\"page-body\">\n        <section className=\"catalog\" aria-labelledby=\"catalog-heading\">\n          <h2 id=\"catalog-heading\" className=\"visually-hidden\">\n            Products\n          </h2>\n          <div className=\"toolbar\">\n            <div className=\"chip-group\" role=\"group\" aria-label=\"Filter by category\">\n              {FILTERS.map((filter) => (\n                <button\n                  key={filter.value}\n                  type=\"button\"\n                  className=\"ms-pill ms-pill--cream ms-pill--sm ms-tab chip\"\n                  aria-pressed={category === filter.value}\n                  onClick={() => selectCategory(filter.value)}\n                  data-testid={`category-filter-${filter.value}`}\n                >\n                  {filter.value !== 'all' && (\n                    <span className={`ms-dot chip-dot ${hueClass(CATEGORY_HUE[filter.value])}`} aria-hidden=\"true\" />\n                  )}\n                  {filter.label}\n                </button>\n              ))}\n            </div>\n\n            <div className=\"toolbar-controls\">\n              <label className=\"check-row\">\n                <input\n                  type=\"checkbox\"\n                  className=\"checkbox\"\n                  checked={inStockOnly}\n                  onChange={(event) => toggleInStock(event.target.checked)}\n                  data-testid=\"in-stock-toggle\"\n                />\n                In stock only\n              </label>\n              <div className=\"field-inline\">\n                <label htmlFor=\"sort-select\">Sort by</label>\n                <span className=\"select-wrap select-wrap--pill\">\n                  <select\n                    id=\"sort-select\"\n                    className=\"select select-pill\"\n                    value={sort}\n                    onChange={(event) => selectSort(parseSort(event.target.value))}\n                    data-testid=\"sort-select\"\n                  >\n                    {SORT_OPTIONS.map((option) => (\n                      <option key={option.value} value={option.value}>\n                        {option.label}\n                      </option>\n                    ))}\n                  </select>\n                  <ChevronDownIcon className=\"icon icon-sm select-chevron\" />\n                </span>\n              </div>\n            </div>\n          </div>\n\n          <p className=\"result-count\" role=\"status\" data-testid=\"result-count\">\n            Showing {countLabel}\n          </p>\n\n          {visible.length === 0 ? (\n            <div className=\"ms-panel ms-hue--cream empty-state\" data-testid=\"products-empty\">\n              <NoResultsArt />\n              <h3>No products match these filters</h3>\n              <p>Try another category or include items that are out of stock.</p>\n              <button type=\"button\" className=\"ms-pill\" onClick={clearFilters} data-testid=\"clear-filters\">\n                Clear filters\n              </button>\n            </div>\n          ) : (\n            <ul className=\"product-grid\" data-testid=\"product-grid\">\n              {visible.map((product) => (\n                <li key={product.slug} className=\"product-card\" data-testid=\"product-card\">\n                  <ProductImage product={product} />\n                  <div className=\"product-card-body\">\n                    <p>\n                      <span className={`tag ${hueClass(CATEGORY_HUE[product.category])}`}>{categoryLabel(product.category)}</span>\n                    </p>\n                    <h3 className=\"product-card-title\">\n                      <Link to={`/products/${product.slug}`} className=\"product-link\" data-testid=\"product-link\">\n                        {product.name}\n                      </Link>\n                    </h3>\n                    <p className=\"product-card-summary\">{product.summary}</p>\n                    <p className=\"product-card-meta\">\n                      <span className=\"price\" data-testid=\"product-price\">\n                        {formatPrice(product.price)}\n                      </span>\n                      {!product.inStock && (\n                        <span className=\"status-badge\" data-testid=\"sold-out-tag\">\n                          <span className=\"status-dot status-dot--danger\" aria-hidden=\"true\" />\n                          Sold out\n                        </span>\n                      )}\n                    </p>\n                  </div>\n                </li>\n              ))}\n            </ul>\n          )}\n        </section>\n      </div>\n    </>\n  );\n}\n'''\ns=s.replace(\"\"\"import ProductImage from '../components/ProductImage';\n\"\"\",\"\"\"import { HeaderBand } from '../components/art/Field';\nimport { NoResultsArt, ShopCluster } from '../components/art/Scenes';\nimport { ChevronDownIcon } from '../components/Icons';\nimport ProductImage from '../components/ProductImage';\n\"\"\")\ns=s.replace(\"\"\"import { categories, categoryLabel, formatPrice, products, type CategoryId, type Product } from '../data/products';\n\"\"\",\"\"\"import { categories, categoryLabel, formatPrice, products, type CategoryId, type Product } from '../data/products';\nimport { AREA_HUE, CATEGORY_HUE, hueClass } from '../design/hues';\n\"\"\")\nopen(p,'w',en