+
+/**
+ * Body figures have no real image yet, so each is drawn from the shape kit on a field in the post's
+ * category hue — never a grey box. The drawing follows the figure's subject.
+ */
+function PillBoard() {
+  // Six clusters of pills: forty-one buttons, six jobs.
+  const clusters = [
+    [60, 56],
+    [250, 40],
+    [440, 60],
+    [80, 190],
+    [270, 176],
+    [450, 196],
+  ];
   return (
