+    <g>
+      {clusters.map(([x, y], i) => (
+        <g key={i} transform={`translate(${x} ${y})`}>
+          <rect width="120" height="34" rx="17" style={{ fill: i % 2 ? WHITE : ART.yellow.base }} />
+          <rect x="16" y="44" width="96" height="30" rx="15" style={{ fill: WHITE }} />
+          <rect x="-4" y="84" width="72" height="26" rx="13" style={{ fill: i % 3 ? ART.yellow.base : WHITE }} />
+        </g>
+      ))}
+      <Sparkle x={600} y={40} size={32} color={ART.pink.base} rotate={10} />
+    </g>
+  );
+}
+
+/** A white page with a stone crescent at its lower right. */
+function Page({ x }: { x: number }) {
+  const id = useSvgId('clip');
+  return (
+    <g>
+      <clipPath id={id}>
+        <rect x={x} y="44" width="220" height="236" rx="18" />
+      </clipPath>
+      <g clipPath={`url(#${id})`}>
+        <rect x={x} y="44" width="220" height="236" style={{ fill: ART.stone.shade }} />
+        <rect x={x - 10} y="34" width="220" height="236" rx="18" style={{ fill: WHITE }} />
+      </g>
+    </g>
+  );
+}
+
+function TwoNotes() {
+  const lines = (x: number, top: number, widths: number[]) =>
+    widths.map((w, i) => (
+      <rect key={i} x={x} y={top + i * 30} width={w} height="14" rx="7" style={{ fill: ART.stone.base }} />
+    ));
+  return (
+    <g>
+      <Page x={80} />
+      {lines(104, 70, [150, 170, 130, 164, 120, 150])}
+      <Page x={340} />
+      <rect x="364" y="68" width="120" height="24" rx="12" style={{ fill: ART.yellow.base }} />
+      {lines(364, 112, [160, 120])}
+      <Sparkle x={540} y={236} size={40} color={ART.yellow.base} rotate={10} />
+    </g>
+  );
+}
+
+function FlagTimeline() {
+  return (
+    <g>
+      <rect x="60" y="214" width="520" height="24" rx="12" style={{ fill: WHITE }} />
+      <Shaded hue="yellow" shift={3}>
+        <circle cx="120" cy="226" r="22" />
+      </Shaded>
+      <Shaded hue="pink" shift={3}>
+        <circle cx="320" cy="226" r="22" />
+      </Shaded>
+      <Shaded hue="yellow" shift={3}>
+        <circle cx="520" cy="226" r="22" />
+      </Shaded>
+      <path d="M320 200V70" fill="none" strokeWidth="12" strokeLinecap="round" style={{ stroke: STROKE }} />
+      <Shaded hue="yellow" shift={6}>
+        <path d="M328 70H410Q422 70 415 80L398 104L415 128Q422 138 410 138H328Z" />
+      </Shaded>
+      <Sparkle x={520} y={120} size={36} color={WHITE} rotate={12} />
+    </g>
+  );
+}
+
+export default function ImagePlaceholder({ alt, hue = 'green' }: { alt: string; hue?: FieldHue }) {
+  const text = alt.toLowerCase();
+  const Drawing = text.includes('flag') ? FlagTimeline : text.includes('release note') ? TwoNotes : PillBoard;
+  return (
+    <svg className={`image-placeholder ms-hue--${hue}`} viewBox="0 0 640 320" role="img" aria-label={alt}>
       <rect className="image-placeholder-bg" x="0" y="0" width="640" height="320" />
-      <circle className="image-placeholder-shape" cx="220" cy="120" r="36" />
-      <path className="image-placeholder-shape" d="M120 260 L260 150 L360 230 L440 170 L540 260 Z" />
+      <Drawing />
     </svg>
   );
 }
