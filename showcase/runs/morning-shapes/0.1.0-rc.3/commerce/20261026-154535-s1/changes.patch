-.button-primary {
-  background: var(--color-primary);
-  border-color: var(--color-primary);
-  color: var(--color-primary-text);
-  padding: var(--space-2) var(--space-4);
-}
-
-.link-button {
-  font: inherit;
-  background: none;
-  border: none;
-  padding: 0;
-  color: var(--color-link);
-  text-decoration: underline;
-  cursor: pointer;
-}
-
-.field-inline {
-  display: flex;
-  align-items: center;
-  gap: var(--space-2);
-}
-
-.field {
-  display: flex;
-  flex-direction: column;
-  gap: var(--space-1);
-}
-
-.field-label {
-  font-weight: bold;
-  font-size: var(--font-size-small);
-}
-
-.field-error {
-  color: var(--color-error);
-  font-size: var(--font-size-small);
-  margin: 0;
-}
-
-/* Cart button */
-.cart-button {
-  position: relative;
-}
-
-.badge {
-  display: inline-block;
-  min-width: 20px;
-  padding: 0 var(--space-1);
-  border-radius: var(--radius-pill);
-  background: var(--color-badge-bg);
-  color: var(--color-badge-text);
-  font-size: var(--font-size-small);
-  font-weight: bold;
-  text-align: center;
-}
-
-/* Panels */
-.panel {
-  border: var(--border-width) solid var(--color-border);
-  border-radius: var(--radius);
-  background: var(--color-surface);
-  padding: var(--space-4);
-}
-
-.empty-state {
-  text-align: center;
-  padding: var(--space-8) var(--space-4);
-}
-
-/* Catalog toolbar */
-.toolbar {
-  display: flex;
-  flex-wrap: wrap;
-  justify-content: space-between;
-  align-items: center;
-  gap: var(--space-3);
-  margin-bottom: var(--space-3);
-}
-
-.toolbar-controls {
-  display: flex;
-  flex-wrap: wrap;
-  align-items: center;
-  gap: var(--space-4);
-}
-
-.chip-group {
-  display: flex;
-  flex-wrap: wrap;
-  gap: var(--space-2);
-}
-
-.chip {
-  font: inherit;
-  padding: var(--space-1) var(--space-3);
-  border: var(--border-width) solid var(--color-border);
-  border-radius: var(--radius-pill);
-  background: var(--color-surface);
-  color: var(--color-text);
-  cursor: pointer;
-}
-
-.chip[aria-pressed='true'] {
-  background: var(--color-primary);
-  border-color: var(--color-primary);
-  color: var(--color-primary-text);
-}
-
-/* Product grid */
-.product-grid {
-  list-style: none;
-  margin: 0;
-  padding: 0;
-  display: grid;
-  grid-template-columns: repeat(auto-fill, minmax(var(--product-card-min), 1fr));
-  gap: var(--space-4);
-}
-
-.product-card {
-  border: var(--border-width) solid var(--color-border);
-  border-radius: var(--radius);
-  background: var(--color-surface);
-  overflow: hidden;
-  display: flex;
-  flex-direction: column;
-}
-
-.product-card-body {
-  padding: var(--space-3);
-}
-
-.product-card-body p {
-  margin-bottom: var(--space-1);
-}
-
-.product-card-title {
-  margin-bottom: var(--space-1);
-}
-
-.product-card-meta {
-  display: flex;
-  align-items: center;
-  gap: var(--space-2);
-}
-
-.price {
-  font-weight: bold;
-  font-variant-numeric: tabular-nums;
-}
-
-.price-large {
-  font-size: var(--font-size-price-large);
-}
-
-.tag {
-  display: inline-block;
-  padding: 0 var(--space-2);
-  border-radius: var(--radius-pill);
-  font-size: var(--font-size-small);
-}
-
-.tag-muted {
-  background: var(--color-tag-bg);
-  color: var(--color-tag-text);
-}
-
-/* Image placeholder */
-.product-image {
-  display: flex;
-  align-items: center;
-  justify-content: center;
-  color: var(--color-image-icon);
-  aspect-ratio: 4 / 3;
-  width: 100%;
-}
-
-.product-image-large {
-  aspect-ratio: 1 / 1;
-  border-radius: var(--radius);
-}
-
-.tone-sand {
-  background: var(--color-tone-sand);
-}
-
-.tone-olive {
-  background: var(--color-tone-olive);
-}
-
-.tone-slate {
-  background: var(--color-tone-slate);
-}
-
-.tone-clay {
-  background: var(--color-tone-clay);
-}
-
-.tone-stone {
-  background: var(--color-tone-stone);
-}
-
-/* Product detail */
-.breadcrumb ol {
-  list-style: none;
-  display: flex;
-  flex-wrap: wrap;
-  gap: var(--space-2);
-  margin: 0;
-  padding: 0;
-  font-size: var(--font-size-small);
-}
-
-.breadcrumb li + li::before {
-  content: '/';
-  margin-right: var(--space-2);
-  color: var(--color-text-muted);
-}
-
-.product-detail {
-  display: grid;
-  grid-template-columns: 1fr 1fr;
-  gap: var(--space-8);
-  align-items: start;
-}
-
-.purchase-form {
-  display: flex;
-  flex-direction: column;
-  align-items: flex-start;
-  gap: var(--space-4);
-  margin: var(--space-4) 0;
-}
-
-.variant-fieldset {
-  border: none;
-  margin: 0;
-  padding: 0;
-}
-
-.variant-options {
-  display: flex;
-  flex-wrap: wrap;
-  gap: var(--space-2);
-  margin-top: var(--space-1);
-}
-
-.variant-option {
-  display: inline-flex;
-  align-items: center;
-  gap: var(--space-1);
-  padding: var(--space-1) var(--space-3);
-  border: var(--border-width) solid var(--color-border);
-  border-radius: var(--radius);
-  cursor: pointer;
-}
-
-.stepper {
-  display: flex;
-  flex-direction: column;
-  gap: var(--space-1);
-}
-
-.stepper-controls {
-  display: flex;
-  align-items: center;
-  gap: var(--space-1);
-}
-
-.stepper-button {
-  width: 32px;
-  height: 32px;
-  padding: 0;
-}
-
-.stepper-input {
-  width: 56px;
-  height: 32px;
-  text-align: center;
-}
-
-.added-message p {
-  background: var(--color-success-bg);
-  color: var(--color-success-text);
-  padding: var(--space-2) var(--space-3);
-  border-radius: var(--radius);
-}
-
-.detail-list {
-  margin: 0;
-  padding-left: var(--space-6);
-}
-
-/* Cart */
-.cart-layout {
-  display: grid;
-  grid-template-columns: 3fr 2fr;
-  gap: var(--space-6);
-  align-items: start;
-}
-
-.cart-lines {
-  list-style: none;
-  margin: 0;
-  padding: 0;
-}
-
-.cart-line {
-  display: grid;
-  grid-template-columns: 1fr auto auto auto;
-  align-items: center;
-  gap: var(--space-4);
-  padding: var(--space-3) 0;
-  border-bottom: var(--border-width) solid var(--color-border);
-}
-
-.cart-line-info p {
-  margin: 0;
-}
-
-.cart-line-name {
-  font-weight: bold;
-}
-
-.cart-line-total {
-  margin: 0;
-  min-width: 80px;
-  text-align: right;
-}
-
-.summary {
-  margin: var(--space-4) 0 0;
-}
-
-.summary-row {
-  display: flex;
-  justify-content: space-between;
-  padding: var(--space-1) 0;
-}
-
-.summary-row dd {
-  margin: 0;
-  font-variant-numeric: tabular-nums;
-}
-
-.summary-total {
-  border-top: var(--border-width) solid var(--color-border);
-  margin-top: var(--space-2);
-  padding-top: var(--space-2);
-  font-weight: bold;
-}
-
-.checkout-form {
-  display: flex;
-  flex-direction: column;
-  gap: var(--space-4);
-}
-
-.checkout-form .button-primary {
-  align-self: flex-start;
-}
-
-.confirmation {
-  background: var(--color-success-bg);
-  color: var(--color-success-text);
-}
-
-@media (max-width: 900px) {
-  .site-header {
-    flex-wrap: wrap;
-    gap: var(--space-3);
-    padding: var(--space-3) var(--space-4);
-  }
-
-  .content {
-    padding: var(--space-4);
-  }
-
-  .product-detail,
-  .cart-layout {
-    grid-template-columns: 1fr;
-  }
-
-  .cart-line {
-    grid-template-columns: 1fr auto;
-  }
+.icon-sm {
+  width: var(--size-icon-sm);
+  height: var(--size-icon-sm);
 }
