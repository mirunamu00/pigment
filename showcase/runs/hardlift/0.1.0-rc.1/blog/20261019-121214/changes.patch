+  display: block;
+  width: 100%;
+  height: auto;
+  border: var(--border-width-thin) solid var(--color-border-default);
+  border-radius: var(--radius-md);
+}
+
+.image-placeholder-bg {
+  fill: var(--section-band);
+}
+
+.image-placeholder-shape {
+  fill: var(--sticker-paper);
+  stroke: var(--color-text-on-action);
+  stroke-width: 4;
+  stroke-linejoin: round;
+}
+
+.image-placeholder-pink {
+  fill: var(--color-action-primary);
+}
+
+.body-figure figcaption {
+  margin-top: var(--space-12);
+}
+
+.article-aside {
+  position: sticky;
+  top: var(--space-24);
+}
+
+.toc {
+  border-left: var(--border-width-thin) solid var(--color-border-default);
+  padding-left: var(--space-16);
+}
+
+.toc-heading {
+  font-size: var(--font-size-sm);
+  line-height: var(--font-line-height-caption);
+  letter-spacing: var(--font-tracking-body);
+  color: var(--color-text-secondary);
+  margin-bottom: var(--space-12);
+}
+
+.toc-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  font-size: var(--font-size-sm);
+  line-height: var(--font-line-height-caption);
+}
+
+.toc-item + .toc-item {
+  margin-top: var(--space-8);
+}
+
+.toc-item-nested {
+  padding-left: var(--space-12);
+}
+
+.toc-link {
+  display: inline-block;
+  padding-block: var(--space-4);
+}
+
+.related {
+  margin-top: var(--space-64);
+  border-top: var(--border-width-thin) solid var(--color-border-default);
+  padding-top: var(--space-48);
+}
+
+/* ------------------------------------------------------------------ */
+/* About                                                               */
+/* ------------------------------------------------------------------ */
+.prose {
+  max-width: 60ch;
+}
+
+.prose p {
+  margin-bottom: var(--space-16);
+}
+
+.author-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--space-24);
+}
+
+.author-list > li {
+  display: flex;
+}
+
+.author-card {
+  flex: 1;
+  gap: var(--space-12);
+}
+
+.author-card h3 {
+  font-size: var(--font-size-lg);
+  line-height: var(--font-line-height-ui);
+  margin: 0;
+}
+
+.author-card .author-role {
+  margin: 0 0 var(--space-8);
+}
+
+.avatar {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+  width: var(--size-control);
+  height: var(--size-control);
+  border: var(--border-width-thin) solid var(--color-border-default);
+  border-radius: var(--radius-md);
+  background: var(--section-band);
+  color: var(--color-text-on-action);
+  font-size: var(--font-size-md);
+}
+
+/* ------------------------------------------------------------------ */
+/* Error / not found                                                   */
+/* ------------------------------------------------------------------ */
+.error-body {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  text-align: center;
+  gap: var(--space-24);
+  padding-top: var(--space-64);
+}
+
+.error-body p {
+  margin: 0;
+  max-width: 60ch;
+}
+
+.error-body .sticker {
+  rotate: 10deg;
+}
+
+/* ------------------------------------------------------------------ */
+/* Responsive                                                          */
+/* ------------------------------------------------------------------ */
+@media (max-width: 1023px) {
+  .post-list,
+  .author-list {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .hero h1 {
+    font-size: var(--font-size-4xl);
+  }
+
+  .article-layout {
+    grid-template-columns: minmax(0, 1fr);
+    gap: var(--space-32);
+  }
+
+  .article-aside {
+    position: static;
     grid-row: 1;
   }
 }
+
+@media (max-width: 767px) {
+  .container {
+    padding: 0 var(--space-16);
+  }
+
+  .band {
+    padding: var(--space-24) var(--space-16);
+  }
+
+  .band h1,
+  h1 {
+    font-size: var(--font-size-2xl);
+    line-height: var(--font-line-height-heading);
+  }
+
+  h2 {
+    font-size: var(--font-size-xl);
+    line-height: var(--font-line-height-title);
+  }
+
+  .hero {
+    padding: var(--space-48) var(--space-16) var(--space-96);
+  }
+
+  .hero h1 {
+    font-size: var(--font-size-3xl);
+    line-height: var(--font-line-height-display);
+  }
+
+  .hero .band-lead {
+    font-size: var(--font-size-md);
+  }
+
+  .hero-shape .sticker {
+    width: 120px;
+    height: 120px;
+  }
+
+  .hero-shape-1 {
+    left: -64px;
+    top: 16px;
+  }
+
+  .hero-shape-2,
+  .hero-shape-4 {
+    display: none;
+  }
+
+  .hero-shape-3 {
+    right: -56px;
+    top: auto;
+    bottom: -40px;
+  }
+
+  .nav-secondary {
+    display: none;
+  }
+
+  .page-section {
+    padding-top: var(--space-48);
+  }
+
+  .content {
+    padding-bottom: var(--space-48);
+  }
+
+  .featured-post {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .featured-media {
+    min-height: 160px;
+    border-right: 0;
+    border-bottom: var(--border-width-thin) solid var(--color-border-default);
+    border-radius: var(--radius-md) var(--radius-md) 0 0;
+  }
+
+  .featured-media .sticker {
+    width: 96px;
+    height: 96px;
+  }
+
+  .featured-body {
+    padding: var(--space-16);
+  }
+
+  .featured-title {
+    font-size: var(--font-size-xl);
+    line-height: var(--font-line-height-title);
+  }
+
+  .featured-excerpt {
+    font-size: var(--font-size-md);
+  }
+
+  .card:not(.featured-post) {
+    padding: var(--space-16);
+  }
+
+  .filter-bar .field {
+    flex-basis: 100%;
+  }
+
+  /* Pill strip scrolls inside itself; padding keeps outlines and focus rings visible. */
+  .tag-filter {
+    flex-wrap: nowrap;
+    overflow-x: auto;
+    width: calc(100% + 2 * var(--space-16));
+    margin-inline: calc(var(--space-16) * -1);
+    padding: var(--space-8) var(--space-16);
+    scrollbar-width: none;
+  }
+
+  .newsletter {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .site-footer-inner {
+    padding-top: var(--space-48);
+  }
+
+  .field-row {
+    flex-direction: column;
+  }
+
+  .field-row .input {
+    flex: none;
+  }
+
+  .tagwall-list li {
+    font-size: var(--font-size-lg);
+  }
+
+  .article-layout {
+    padding-top: var(--space-32);
+  }
+
+  .article-band .post-meta {
+    font-size: var(--font-size-sm);
+  }
+}
+
+@media (max-width: 639px) {
+  .post-list,
+  .author-list {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Reduced motion: no translate, no shadow growth, no loops or drift.  */
+/* ------------------------------------------------------------------ */
+@media (prefers-reduced-motion: reduce) {
+  .lift {
+    transition: background-color var(--motion-duration-fast) linear;
+  }
+
+  .lift:hover,
+  .lift:active,
+  .lift-hero > .lift:hover,
+  .lift--icon:hover {
+    translate: none;
+    box-shadow: none;
+  }
+
+  .lift:hover {
+    background: var(--color-action-primary-hover);
+    color: var(--color-text-on-action);
+  }
+
+  .card-linked {
+    transition: none;
+  }
+
+  .card-linked:hover,
+  .card-linked:active {
+    translate: none;
+    box-shadow: none;
+  }
+
+  .parallax,
+  .tagwall,
+  .coin-load {
+    animation: none;
+  }
+
+  .draw path {
+    animation: none;
+    stroke-dashoffset: 0;
+  }
+}
+
+@media (forced-colors: active) {
+  .lift,
+  .pill,
+  .card,
+  .tag-chip,
+  .input {
+    border-color: CanvasText;
+  }
+
+  .pill[aria-pressed='true'],
+  .pill[aria-current='page'] {
+    background: Highlight;
+    color: HighlightText;
+  }
+}
