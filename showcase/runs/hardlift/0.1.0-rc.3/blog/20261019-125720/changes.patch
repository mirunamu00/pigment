@@ -1,9 +1,90 @@
+/*
+ * Article figure art. Each figure is an original sticker scene that shows its own subject
+ * (never a generic image glyph); the scene is picked from the figure's description.
+ */
+type Scene = 'board' | 'notes' | 'flag' | 'coins';
+
+function pickScene(alt: string): Scene {
+  if (/button/i.test(alt)) return 'board';
+  if (/release note|side by side/i.test(alt)) return 'notes';
+  if (/flag|timeline/i.test(alt)) return 'flag';
+  return 'coins';
+}
+
+const s = { stroke: 'currentColor', strokeWidth: 3, strokeLinejoin: 'round', vectorEffect: 'non-scaling-stroke' } as const;
+const line = { ...s, strokeWidth: 6, strokeLinecap: 'round', fill: 'none' } as const;
+
+function SceneShapes({ scene }: { scene: Scene }) {
+  switch (scene) {
+    case 'board':
+      // Inventory board: six button jobs pinned in a grid, plus a price-style tag counting them.
+      return (
+        <>
+          <rect x="64" y="44" width="352" height="232" rx="12" className="st-band" {...s} />
+          {[0, 1, 2].map((col) =>
+            [0, 1].map((row) => (
+              <rect
+                key={`${col}-${row}`}
+                x={92 + col * 104}
+                y={84 + row * 88}
+                width="88"
+                height="44"
+                rx="6"
+                className={(col + row) % 2 === 0 ? 'st-pink' : 'st-paper'}
+                {...s}
+              />
+            )),
+          )}
+          <g transform="rotate(12 520 150)">
+            <path d="M474 104h92a8 8 0 0 1 8 8v76a8 8 0 0 1-8 8h-92l-34-46z" className="st-paper" {...s} />
+            <circle cx="474" cy="150" r="9" className="st-band" {...s} />
+            <path d="M506 132h44M506 168h28" {...line} />
+          </g>
+        </>
+      );
+    case 'notes':
+      // The same note twice: a long draft, an arrow, and the short edited version.
+      return (
+        <>
+          <rect x="84" y="36" width="180" height="248" rx="8" className="st-paper" {...s} />
+          {[0, 1, 2, 3, 4, 5, 6].map((i) => (
+            <path key={i} d={`M108 ${72 + i * 28}h${i % 3 === 2 ? 92 : 132}`} {...line} strokeWidth={4} />
+          ))}
+          <polygon points="290,140 330,140 330,118 368,160 330,202 330,180 290,180" className="st-pink" {...s} />
+          <g transform="rotate(-6 474 160)">
+            <rect x="392" y="76" width="168" height="168" rx="8" className="st-band" {...s} />
+            <path d="M420 120h112M420 156h84M420 192h100" {...line} />
+          </g>
+        </>
+      );
+    case 'flag':
+      // A flag's life: raised internally, rolled out, then removed at the end of the track.
+      return (
+        <>
+          <path d="M56 236H584" {...line} />
+          <path d="M150 236V64" {...line} />
+          <path d="M150 64h132l-28 36 28 36H150z" className="st-pink" {...s} />
+          <circle cx="150" cy="236" r="16" className="st-paper" {...s} />
+          <circle cx="330" cy="236" r="16" className="st-band" {...s} />
+          <rect x="474" y="210" width="52" height="52" rx="6" className="st-paper" {...s} />
+          <path d="M488 224l24 24M512 224l-24 24" {...line} strokeWidth={5} />
+        </>
+      );
+    case 'coins':
+      return (
+        <>
+          <circle cx="300" cy="168" r="84" className="st-paper" {...s} />
+          <circle cx="284" cy="152" r="84" className="st-pink" {...s} />
+          <polygon points="470,70 484,104 520,106 492,128 502,162 470,142 438,162 448,128 420,106 456,104" className="st-band" {...s} />
+        </>
+      );
+  }
+}
+
 export default function ImagePlaceholder({ alt }: { alt: string }) {
   return (
-    <svg className="image-placeholder" viewBox="0 0 640 320" role="img" aria-label={alt}>
-      <rect className="image-placeholder-bg" x="0" y="0" width="640" height="320" />
-      <circle className="image-placeholder-shape" cx="220" cy="120" r="36" />
-      <path className="image-placeholder-shape" d="M120 260 L260 150 L360 230 L440 170 L540 260 Z" />
+    <svg className="image-placeholder sticker" viewBox="0 0 640 320" role="img" aria-label={alt}>
+      <SceneShapes scene={pickScene(alt)} />
     </svg>
   );
 }
