+  font-size: var(--font-size-sm);
+}
+
+/* ============ Card ============ */
+
+.card {
+  background: var(--color-surface-raised);
+  border: var(--border-width-thin) solid var(--color-border-default);
+  border-radius: var(--radius-md);
+  padding: var(--space-16);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-16);
+}
+
+.card-title {
+  font-size: var(--font-size-xl);
+  line-height: var(--font-line-height-title);
+}
+
+/* ============ Empty and error states ============ */
+
+.empty-state {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: var(--space-16);
+  padding: var(--space-48) var(--space-16);
+  text-align: center;
+}
+
+.empty-state p {
+  max-width: 60ch;
+}
+
+.empty-state .lift {
+  margin-top: var(--space-8);
+}
+
+/* ============ Toast ============ */
+
+.toast-region {
+  position: fixed;
+  left: var(--space-24);
+  bottom: var(--space-24);
+  z-index: 30;
+  width: min(420px, calc(100vw - 2 * var(--space-24)));
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-8);
+  pointer-events: none;
+}
+
+.toast {
+  pointer-events: auto;
+  display: flex;
+  align-items: flex-start;
+  gap: var(--space-12);
+  min-height: var(--size-control);
+  padding: var(--space-12) var(--space-16);
+  background: var(--color-surface-raised);
+  color: var(--color-text-primary);
+  border: var(--border-width-thin) solid var(--color-border-default);
+  border-radius: var(--radius-sm);
+  box-shadow: var(--shadow-md) var(--color-shadow-hard);
+  animation: toast-in var(--motion-duration-base) var(--motion-easing-out);
+}
+
+@keyframes toast-in {
+  from {
+    translate: 0 16px;
   }
+  to {
+    translate: 0 0;
+  }
+}
 
-  .content {
-    padding: var(--space-4);
+.toast-message {
+  flex: 1;
+  padding-block: 1px;
+}
+
+.toast-message a {
+  color: var(--color-text-primary);
+  white-space: nowrap;
+}
+
+.check-dot {
+  display: grid;
+  place-items: center;
+  width: var(--size-icon);
+  height: var(--size-icon);
+  flex-shrink: 0;
+  border: var(--border-width-thin) solid var(--color-border-default);
+  border-radius: var(--radius-full);
+  background: var(--color-action-primary);
+  color: var(--color-text-on-action);
+}
+
+.toast-close {
+  margin: calc(-1 * var(--space-4)) calc(-1 * var(--space-8)) 0 0;
+}
+
+/* ============ Product grid ============ */
+
+.toolbar {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  align-items: center;
+  gap: var(--space-16) var(--space-24);
+  padding-bottom: var(--space-16);
+  border-bottom: var(--border-width-thin) solid var(--color-border-default);
+}
+
+.toolbar-controls {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--space-16) var(--space-24);
+}
+
+.product-grid {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  grid-template-columns: 1fr;
+  gap: var(--space-24);
+}
+
+@media (min-width: 640px) {
+  .product-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (min-width: 1024px) {
+  .product-grid {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+@media (min-width: 1280px) {
+  .product-grid {
+    grid-template-columns: repeat(4, minmax(0, 1fr));
   }
+}
+
+.product-card {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  background: var(--color-surface-raised);
+  overflow: hidden;
+}
 
+.product-card:has(.product-link:focus-visible) {
+  outline: var(--border-width-thick) solid var(--color-focus-ring);
+  outline-offset: 2px;
+}
+
+.product-card-body {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-8);
+  padding: var(--space-16);
+}
+
+.product-card-title {
+  font-size: var(--font-size-lg);
+  line-height: var(--font-line-height-ui);
+}
+
+/* one stretched link: the whole card is the target, the title is its name */
+.product-link,
+.product-link:hover {
+  color: var(--color-text-primary);
+  text-decoration: none;
+}
+
+.product-link::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  z-index: 1;
+}
+
+.product-link:focus-visible {
+  outline: none;
+}
+
+.product-card-meta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--space-8);
+  margin-top: auto;
+  padding-top: var(--space-4);
+}
+
+.price {
+  font-variant-numeric: tabular-nums;
+}
+
+/* photo placeholder: a band-color square with the item's own sticker */
+.product-image {
+  display: grid;
+  place-items: center;
+  aspect-ratio: 1 / 1;
+  width: 100%;
+  background: var(--placeholder-color, var(--color-band-yellow));
+  border-bottom: var(--border-width-thin) solid var(--color-border-default);
+}
+
+.product-image .sticker {
+  color: var(--color-text-on-band);
+  width: 62%;
+  height: 62%;
+}
+
+.product-image-large {
+  border: var(--border-width-thin) solid var(--color-border-default);
+  border-radius: var(--radius-md);
+  overflow: hidden;
+}
+
+.placeholder-teal {
+  --placeholder-color: var(--color-band-teal);
+}
+
+.placeholder-yellow {
+  --placeholder-color: var(--color-band-yellow);
+}
+
+.placeholder-periwinkle {
+  --placeholder-color: var(--color-band-periwinkle);
+}
+
+.placeholder-lime {
+  --placeholder-color: var(--color-band-lime);
+}
+
+/* ============ Product detail ============ */
+
+.breadcrumb ol {
+  list-style: none;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--space-4);
+  margin: 0;
+  padding: 0;
+  font-size: var(--font-size-sm);
+  line-height: var(--font-line-height-caption);
+}
+
+.breadcrumb li {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-4);
+}
+
+.product-detail {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+  gap: var(--space-48);
+  align-items: start;
+}
+
+.product-detail-info {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: var(--space-24);
+}
+
+.product-detail-info > p {
+  max-width: 60ch;
+}
+
+.price-large {
+  font-size: var(--font-size-lg);
+  padding: var(--space-8) var(--space-16);
+  min-height: 0;
+  letter-spacing: var(--font-tracking-display);
+}
+
+.purchase-form {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: var(--space-24);
+  width: 100%;
+  padding-block: var(--space-24);
+  border-block: var(--border-width-thin) solid var(--color-border-default);
+}
+
+.variant-fieldset {
+  border: none;
+  margin: 0;
+  padding: 0;
+  min-width: 0;
+}
+
+.variant-fieldset legend {
+  padding: 0;
+  margin-bottom: var(--space-8);
+}
+
+.variant-options {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-4);
+}
+
+.detail-section {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-12);
+}
+
+.detail-list {
+  margin: 0;
+  padding-left: var(--space-24);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+}
+
+/* ============ Cart ============ */
+
+.cart-layout {
+  display: grid;
+  grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
+  gap: var(--space-24);
+  align-items: start;
+}
+
+.cart-lines {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.cart-line {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto auto auto;
+  align-items: center;
+  gap: var(--space-16);
+  padding: var(--space-16) 0;
+  border-bottom: var(--border-width-thin) solid var(--color-border-hairline);
+}
+
+.cart-line:first-child {
+  padding-top: 0;
+}
+
+.cart-line-info {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+}
+
+.cart-line-name,
+.cart-line-name:hover {
+  font-size: var(--font-size-lg);
+  color: var(--color-text-primary);
+}
+
+.cart-line-total {
+  min-width: 80px;
+  text-align: right;
+  font-variant-numeric: tabular-nums;
+}
+
+.summary {
+  margin: 0;
+}
+
+.summary-row {
+  display: flex;
+  justify-content: space-between;
+  padding: var(--space-4) 0;
+}
+
+.summary-row dd {
+  margin: 0;
+  font-variant-numeric: tabular-nums;
+}
+
+.summary-total {
+  border-top: var(--border-width-thin) solid var(--color-border-default);
+  margin-top: var(--space-8);
+  padding-top: var(--space-12);
+  font-weight: var(--font-weight-bold);
+}
+
+.checkout-form {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-16);
+}
+
+.checkout-form .lift {
+  align-self: flex-start;
+  margin-top: var(--space-8);
+}
+
+.confirmation-card {
+  align-items: center;
+  text-align: center;
+  padding: var(--space-48) var(--space-24);
+  box-shadow: var(--shadow-md) var(--color-shadow-hard);
+  max-width: 720px;
+  width: 100%;
+  margin-inline: auto;
+}
+
+.confirmation-card p {
+  max-width: 60ch;
+}
+
+/* ============ Responsive ============ */
+
+@media (max-width: 1023px) {
   .product-detail,
   .cart-layout {
-    grid-template-columns: 1fr;
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+@media (max-width: 767px) {
+  h1,
+  .band-title {
+    font-size: var(--font-size-2xl);
+    line-height: var(--font-line-height-heading);
+  }
+
+  h2 {
+    font-size: var(--font-size-xl);
+    line-height: var(--font-line-height-title);
+  }
+
+  .site-header {
+    flex-wrap: wrap;
+    gap: var(--space-8) var(--space-16);
+    padding: var(--space-16);
+  }
+
+  .brand {
+    flex: 1;
+    font-size: var(--font-size-lg);
+  }
+
+  .site-nav {
+    order: 3;
+    flex-basis: 100%;
+  }
+
+  .header-rule {
+    display: none;
+  }
+
+  .band {
+    padding: var(--space-24) var(--space-16);
+  }
+
+  /* collapsed band: title, then a sideways-scrolling pill strip */
+  .band-pills {
+    margin-inline: calc(-1 * var(--space-16));
+  }
+
+  .pill-strip {
+    flex-wrap: nowrap;
+    overflow-x: auto;
+    padding: var(--space-4) var(--space-16);
+    scrollbar-width: none;
+  }
+
+  .page-body {
+    padding: var(--space-24) var(--space-16) var(--space-48);
+  }
+
+  .site-footer {
+    padding: var(--space-24) var(--space-16);
+  }
+
+  .toolbar,
+  .toolbar-controls {
+    align-items: flex-start;
+    flex-direction: column;
   }
 
   .cart-line {
-    grid-template-columns: 1fr auto;
+    grid-template-columns: auto minmax(0, 1fr) auto;
+    gap: var(--space-12) var(--space-16);
+  }
+
+  .cart-line-info {
+    grid-column: 1 / -1;
+  }
+
+  .toast-region {
+    left: var(--space-16);
+    bottom: var(--space-16);
+    width: calc(100vw - 2 * var(--space-16));
+  }
+}
+
+/* ============ Reduced motion ============ */
+
+@media (prefers-reduced-motion: reduce) {
+  .lift {
+    transition: background-color var(--motion-duration-fast) linear;
+  }
+
+  .lift:hover,
+  .lift:active,
+  .lift-card:hover,
+  .lift-card:active,
+  .lift--icon:hover,
+  .lift--row:hover,
+  .lift-hero > .lift:hover {
+    translate: none;
+    box-shadow: none;
+  }
+
+  .lift:hover:not(:disabled) {
+    background: var(--color-action-primary-hover);
+    color: var(--color-text-on-action);
+  }
+
+  .lift-card {
+    transition: none;
+  }
+
+  .parallax,
+  .tagwall,
+  .coin-load {
+    animation: none;
+  }
+
+  .draw path {
+    animation: none;
+    stroke-dashoffset: 0;
+  }
+
+  .toast {
+    animation: none;
+  }
+}
+
+/* ============ Forced colors ============ */
+
+@media (forced-colors: active) {
+  .lift,
+  .lift-card,
+  .pill,
+  .badge,
+  .card,
+  .input,
+  .select,
+  .checkbox-box,
+  .toast,
+  .band {
+    border-color: CanvasText;
+  }
+
+  .lift,
+  .badge-accent,
+  .checkbox input:checked + .checkbox-box {
+    background: ButtonFace;
+    color: ButtonText;
+  }
+
+  .pill[aria-pressed='true'],
+  .pill[aria-current='page'],
+  .option-pill:has(input:checked) {
+    background: Highlight;
+    color: HighlightText;
   }
 }
