+import type { CSSProperties, ReactNode } from 'react';
+
+/*
+ * Article figure stand-in: an original sticker scene that shows the figure's subject
+ * (never a generic image glyph). Each figure gets its own drawing, picked from its alt text.
+ */
+
+const PINK: CSSProperties = { fill: 'var(--color-action-primary)' };
+const BAND: CSSProperties = { fill: 'var(--sticker-band, var(--color-band-yellow))' };
+const INK: CSSProperties = { fill: 'currentColor' };
+const NONE: CSSProperties = { fill: 'none' };
+
+/** Forty-one buttons, six jobs: a tilted stack of button shapes beside a checked coin. */
+const buttonInventory = (
+  <>
+    <g transform="rotate(-6 250 170)">
+      <rect x="130" y="70" width="220" height="56" rx="8" style={PINK} />
+      <rect x="160" y="142" width="220" height="56" rx="8" style={BAND} />
+      <rect x="120" y="214" width="220" height="56" rx="8" style={PINK} />
+      <path style={NONE} strokeWidth="8" d="M170 98h80M200 170h100M160 242h60" />
+    </g>
+    <circle cx="482" cy="172" r="72" style={INK} />
+    <circle cx="470" cy="160" r="72" style={BAND} />
+    <path style={NONE} strokeWidth="14" d="M436 160l24 24 44-48" />
+  </>
+);
+
+/** A release note before and after editing: a crowded page, an arrow, a clean page. */
+const beforeAfterNotes = (
+  <>
+    <g transform="rotate(-5 190 160)">
+      <rect x="110" y="40" width="160" height="240" rx="8" style={BAND} />
+      <path style={NONE} strokeWidth="6" d="M134 80h112M134 100h96M134 120h112M134 140h80M134 160h112M134 180h104M134 200h112M134 220h72M134 240h96" />
+    </g>
+    <path style={PINK} d="M290 140h30v-22l40 42-40 42v-22h-30Z" />
+    <g transform="rotate(4 450 160)">
+      <rect x="370" y="40" width="160" height="240" rx="8" style={PINK} />
+      <path style={NONE} strokeWidth="10" d="M396 84h88M396 128h108M396 160h72M396 204h96" />
+    </g>
+  </>
+);
+
+/** A flag's life: a timeline track, three milestones and the flag planted at full release. */
+const flagTimeline = (
+  <>
+    <path style={NONE} strokeWidth="6" d="M60 250h520" />
+    <circle cx="140" cy="250" r="16" style={BAND} />
+    <circle cx="320" cy="250" r="16" style={PINK} />
+    <circle cx="500" cy="250" r="16" style={BAND} />
+    <path style={NONE} strokeWidth="8" d="M490 240l20 20M510 240l-20 20" />
+    <path style={NONE} strokeWidth="8" d="M320 234V64" />
+    <path style={PINK} d="M320 64h140l-30 40 30 40H320Z" />
+  </>
+);
+
+/** Fallback for any future figure: a note card pinned with a pink tack. */
+const pinnedNote = (
+  <>
+    <rect x="220" y="70" width="200" height="200" rx="8" style={BAND} transform="rotate(-4 320 170)" />
+    <path style={NONE} strokeWidth="8" d="M256 150h128M256 186h96M256 222h112" />
+    <circle cx="320" cy="96" r="18" style={PINK} />
+  </>
+);
+
+function pickScene(alt: string): ReactNode {
+  const text = alt.toLowerCase();
+  if (text.includes('button')) return buttonInventory;
+  if (text.includes('release note')) return beforeAfterNotes;
+  if (text.includes('flag') || text.includes('timeline')) return flagTimeline;
+  return pinnedNote;
+}
+
 export default function ImagePlaceholder({ alt }: { alt: string }) {
   return (
     <svg className="image-placeholder" viewBox="0 0 640 320" role="img" aria-label={alt}>
       <rect className="image-placeholder-bg" x="0" y="0" width="640" height="320" />
-      <circle className="image-placeholder-shape" cx="220" cy="120" r="36" />
-      <path className="image-placeholder-shape" d="M120 260 L260 150 L360 230 L440 170 L540 260 Z" />
+      <g stroke="currentColor" strokeWidth="4" strokeLinejoin="round" strokeLinecap="round">
+        {pickScene(alt)}
+      </g>
     </svg>
   );
 }
