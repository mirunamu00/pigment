+  .chart-value,
+  .chart-label {
+    font-size: 22px;
+  }
+
+  /* Phone width: table rows reflow into stacked blocks inside the same box */
+  .table--reflow,
+  .table--reflow tbody,
+  .table--reflow tr,
+  .table--reflow td {
+    display: block;
+  }
+
+  .table--reflow thead {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+  }
+
+  .table--reflow tbody tr {
+    padding: var(--space-12);
+    border-top: var(--border-width-thin) solid var(--color-border-hairline);
+  }
+
+  .table--reflow tbody tr:first-child {
+    border-top: 0;
+  }
+
+  .table--reflow td,
+  .table--reflow tbody tr:first-child td {
+    height: auto;
+    padding: var(--space-4) 0;
+    border: 0;
+  }
+
+  .table--reflow td[data-label] {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    gap: var(--space-16);
+    text-align: right;
+    color: var(--color-text-primary);
+  }
+
+  .table--reflow td[data-label]::before {
+    content: attr(data-label);
+    color: var(--color-text-secondary);
+    text-align: left;
+  }
+
+  .table--reflow .cell-primary {
+    padding-bottom: var(--space-8);
+    font-weight: var(--font-weight-bold);
+    font-size: var(--font-size-md);
+  }
+
+  .table--reflow .cell-primary .small,
+  .table--reflow .cell-primary a.small {
+    font-weight: var(--font-weight-regular);
+  }
+
+  .table--reflow tbody tr:hover td {
+    background: transparent;
+  }
+
+  .table--reflow tbody tr:hover {
+    background: var(--color-surface-subtle);
+  }
+
+  /* Sortable tables keep their sort controls as a strip of pills above the blocks */
+  .table--sortable thead {
+    position: static;
+    display: block;
+    width: auto;
+    height: auto;
+    overflow: visible;
+    clip: auto;
+  }
+
+  .table--sortable thead tr {
+    display: flex;
+    flex-wrap: wrap;
+    gap: var(--space-4);
+    padding: var(--space-8) var(--space-12);
+    background: var(--color-surface-subtle);
+    border-bottom: var(--border-width-thin) solid var(--color-border-default);
+  }
+
+  .table--sortable th,
+  .table--sortable th.numeric {
+    display: block;
+    height: auto;
+    padding: 0;
+    border: 0;
+    background: none;
+  }
+
+  .table--sortable .sort-button {
+    min-height: var(--size-hit);
+    padding: var(--space-8) var(--space-12);
+    border: var(--border-width-thin) solid transparent;
+    border-radius: var(--radius-full);
+    transition: border-color var(--motion-duration-fast) linear;
+  }
+
+  .table--sortable .sort-button:hover {
+    border-color: var(--color-border-default);
+  }
+
+  .table--sortable th[aria-sort='ascending'] .sort-button,
+  .table--sortable th[aria-sort='descending'] .sort-button {
+    background: var(--color-surface-raised);
+    border-color: var(--color-border-default);
+  }
+
+  .table--sortable :focus-visible {
+    outline-offset: 2px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .user-menu-chevron {
+    transition: none;
   }
 }
