+// Article figures are original sticker scenes that show the figure's subject (never a generic image
+// glyph). The scene is picked from the figure's alt text so each figure gets its own drawing.
+type Scene = 'buttons' | 'notes' | 'timeline';
+
+function pickScene(alt: string): Scene {
+  const text = alt.toLowerCase();
+  if (text.includes('button')) return 'buttons';
+  if (text.includes('timeline') || text.includes('flag')) return 'timeline';
+  return 'notes';
+}
+
+function ButtonsScene() {
+  return (
+    <>
+      <g>
+        <rect className="st-band" x="44" y="56" width="120" height="40" rx="8" transform="rotate(-8 104 76)" />
+        <rect className="st-raised" x="150" y="96" width="76" height="30" rx="15" transform="rotate(12 188 111)" />
+        <rect className="st-raised" x="66" y="124" width="92" height="34" rx="4" transform="rotate(6 112 141)" />
+        <rect className="st-pink" x="40" y="184" width="140" height="44" rx="10" transform="rotate(-4 110 206)" />
+        <rect className="st-raised" x="190" y="164" width="60" height="28" rx="2" transform="rotate(-10 220 178)" />
+        <rect className="st-band" x="112" y="246" width="104" height="36" rx="18" transform="rotate(5 164 264)" />
+      </g>
+      <path className="st-raised" d="M284 140h52v-24l44 44-44 44v-24h-52z" />
+      <g>
+        <rect className="st-pink" x="420" y="88" width="84" height="36" rx="4" />
+        <rect className="st-raised" x="520" y="88" width="84" height="36" rx="4" />
+        <rect className="st-band" x="420" y="142" width="84" height="36" rx="4" />
+        <rect className="st-raised" x="520" y="142" width="84" height="36" rx="4" />
+        <rect className="st-raised" x="420" y="196" width="84" height="36" rx="4" />
+        <rect className="st-pink" x="520" y="196" width="84" height="36" rx="4" />
+      </g>
+    </>
+  );
+}
+
+function NotesScene() {
+  return (
+    <>
+      <g transform="rotate(-6 200 160)">
+        <path className="st-raised" d="M120 44h132l28 28v208H120z" />
+        <path className="st-glyph" d="M144 92c18-8 36 8 54 0s36 8 54 0M144 124c22 8 40-8 62 0s30-6 46 2M144 156c16-6 34 6 50-2M144 188c24 8 44-8 70 0s20-4 38 0M144 220c14-6 30 6 46 0" />
+      </g>
+      <path className="st-band" d="M296 148h28v-18l32 30-32 30v-18h-28z" />
+      <g transform="rotate(4 456 160)">
+        <path className="st-raised" d="M384 44h132l28 28v208H384z" />
+        <path className="st-glyph" d="M410 104h108M410 144h84M410 184h96" />
+      </g>
+      <path
+        className="st-pink"
+        d="M532 30l10 26 28 2-22 18 7 27-23-15-23 15 7-27-22-18 28-2z"
+      />
+    </>
+  );
+}
+
+function TimelineScene() {
+  return (
+    <>
+      <path className="st-glyph" d="M60 238h520" />
+      <circle className="st-raised" cx="120" cy="238" r="22" />
+      <circle className="st-band" cx="320" cy="238" r="22" />
+      <circle className="st-raised" cx="520" cy="238" r="22" />
+      <path className="st-glyph" d="M508 226l24 24M532 226l-24 24" />
+      <path className="st-glyph" d="M320 216V64" />
+      <path className="st-pink" d="M320 64h132l-30 36 30 36H320z" />
+    </>
+  );
+}
+
 export default function ImagePlaceholder({ alt }: { alt: string }) {
+  const scene = pickScene(alt);
   return (
-    <svg className="image-placeholder" viewBox="0 0 640 320" role="img" aria-label={alt}>
-      <rect className="image-placeholder-bg" x="0" y="0" width="640" height="320" />
-      <circle className="image-placeholder-shape" cx="220" cy="120" r="36" />
-      <path className="image-placeholder-shape" d="M120 260 L260 150 L360 230 L440 170 L540 260 Z" />
+    <svg className="image-placeholder sticker sticker--scene" viewBox="0 0 640 320" role="img" aria-label={alt}>
+      {scene === 'buttons' && <ButtonsScene />}
+      {scene === 'notes' && <NotesScene />}
+      {scene === 'timeline' && <TimelineScene />}
     </svg>
   );
 }
