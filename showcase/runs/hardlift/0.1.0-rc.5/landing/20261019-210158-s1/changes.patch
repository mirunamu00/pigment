+  }
+  .lift:hover,
+  .lift:active,
+  .lift-card:hover,
+  .lift-card:active,
+  .lift-hero > .lift:hover,
+  .lift--icon:hover {
+    translate: none;
+    box-shadow: none;
+  }
+  .lift:hover:not([aria-haspopup], [aria-expanded], [aria-pressed], :disabled) {
+    background: var(--color-action-primary-hover);
+    color: var(--color-text-on-action);
+  }
+  .parallax,
+  .tagwall,
+  .coin-load,
+  .confirmation,
+  .faq-panel {
+    animation: none;
+  }
+  .draw path {
+    animation: none;
+    stroke-dashoffset: 0;
+  }
+  .faq-indicator {
+    transition: none;
