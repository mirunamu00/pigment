+/*
+ * Article figure: an original flat sticker scene of the figure's own subject (never a generic image glyph).
+ * The scene is picked from the figure's description so two figures never share a drawing.
+ * The svg keeps role="img" + aria-label because it stands in for the described figure.
+ */
+type Scene = 'buttons' | 'notes' | 'timeline' | 'idea';
+
+function pickScene(alt: string): Scene {
+  const text = alt.toLowerCase();
+  if (text.includes('button')) return 'buttons';
+  if (text.includes('release note') || text.includes('side by side')) return 'notes';
+  if (text.includes('timeline') || text.includes('flag')) return 'timeline';
+  return 'idea';
+}
+
+const PINK = 'var(--color-action-primary)';
+const YELLOW = 'var(--color-band-yellow)';
+const TEAL = 'var(--color-band-teal)';
+const LIME = 'var(--color-band-lime)';
+const PERI = 'var(--color-band-periwinkle)';
+const RAISED = 'var(--color-surface-raised)';
+const SUBTLE = 'var(--color-surface-subtle)';
+
+const ink = {
+  stroke: 'currentColor',
+  strokeWidth: 3,
+  strokeLinejoin: 'round' as const,
+  strokeLinecap: 'round' as const,
+};
+
 export default function ImagePlaceholder({ alt }: { alt: string }) {
+  const scene = pickScene(alt);
   return (
     <svg className="image-placeholder" viewBox="0 0 640 320" role="img" aria-label={alt}>
-      <rect className="image-placeholder-bg" x="0" y="0" width="640" height="320" />
-      <circle className="image-placeholder-shape" cx="220" cy="120" r="36" />
-      <path className="image-placeholder-shape" d="M120 260 L260 150 L360 230 L440 170 L540 260 Z" />
+      {scene === 'buttons' && <ButtonsScene />}
+      {scene === 'notes' && <NotesScene />}
+      {scene === 'timeline' && <TimelineScene />}
+      {scene === 'idea' && <IdeaScene />}
     </svg>
   );
 }
+
+/* Mismatched buttons sorted into labelled clusters. */
+function ButtonsScene() {
+  const clusters = [
+    { x: 40, fill: PINK, rows: [96, 64, 112] },
+    { x: 232, fill: YELLOW, rows: [80, 120] },
+    { x: 424, fill: TEAL, rows: [104, 72, 88] },
+  ];
+  return (
+    <g>
+      {clusters.map((cluster, index) => (
+        <g key={cluster.x} transform={`rotate(${index === 1 ? 3 : -3} ${cluster.x + 88} 160)`}>
+          <rect x={cluster.x} y="56" width="176" height="208" rx="8" fill={SUBTLE} {...ink} />
+          <rect x={cluster.x + 16} y="72" width="56" height="16" rx="8" fill={RAISED} {...ink} />
+          {cluster.rows.map((width, row) => (
+            <rect
+              key={row}
+              x={cluster.x + 24}
+              y={112 + row * 48}
+              width={width}
+              height="32"
+              rx="4"
+              fill={cluster.fill}
+              {...ink}
+            />
+          ))}
+        </g>
+      ))}
+      <path d="M600 40l8 18 20 2-15 13 5 20-18-11-18 11 5-20-15-13 20-2z" fill={LIME} {...ink} />
+    </g>
+  );
+}
+
+/* The same release note twice: a crossed-out draft, then the edited version with a star. */
+function NotesScene() {
+  return (
+    <g>
+      <g transform="rotate(-5 170 160)">
+        <rect x="72" y="56" width="196" height="216" rx="8" fill={RAISED} {...ink} />
+        <path d="M100 100h140M100 132h120M100 164h132M100 196h96" {...ink} strokeWidth={6} />
+        <path d="M96 236l148-156" stroke={PINK} strokeWidth={10} strokeLinecap="round" />
+      </g>
+      <path d="M296 160h56v-24l40 40-40 40v-24h-56z" fill={YELLOW} {...ink} />
+      <g transform="rotate(4 500 160)">
+        <rect x="404" y="48" width="196" height="216" rx="8" fill={PERI} {...ink} />
+        <path d="M432 96h96M432 132h136M432 164h112" {...ink} strokeWidth={6} />
+        <path d="M528 188l9 20 22 2-16 15 5 22-20-12-20 12 5-22-16-15 22-2z" fill={PINK} {...ink} />
+      </g>
+    </g>
+  );
+}
+
+/* A flag that travels from internal rollout to full release, then removal. */
+function TimelineScene() {
+  return (
+    <g>
+      <path d="M48 240h544" {...ink} strokeWidth={6} />
+      <circle cx="120" cy="240" r="18" fill={YELLOW} {...ink} />
+      <circle cx="320" cy="240" r="18" fill={TEAL} {...ink} />
+      <circle cx="520" cy="240" r="18" fill={RAISED} {...ink} />
+      <path d="M509 229l22 22M531 229l-22 22" {...ink} strokeWidth={4} />
+      <g transform="rotate(-6 320 140)">
+        <path d="M300 222V56" {...ink} strokeWidth={6} />
+        <path d="M300 60h120l-28 36 28 36H300z" fill={PINK} {...ink} />
+      </g>
+      <path d="M148 168c40-48 96-60 132-44" fill="none" {...ink} strokeDasharray="2 14" strokeWidth={5} />
+      <path d="M392 176c44 4 80 20 104 40" fill="none" {...ink} strokeDasharray="2 14" strokeWidth={5} />
+    </g>
+  );
+}
+
+/* Fallback: a speech-shaped note next to a pencil. */
+function IdeaScene() {
+  return (
+    <g>
+      <path
+        d="M168 72h224a12 12 0 0 1 12 12v112a12 12 0 0 1-12 12H264l-56 48v-48h-40a12 12 0 0 1-12-12V84a12 12 0 0 1 12-12z"
+        fill={PERI}
+        {...ink}
+      />
+      <path d="M200 120h160M200 160h104" {...ink} strokeWidth={8} />
+      <g transform="rotate(-30 500 170)">
+        <rect x="430" y="150" width="120" height="40" fill={YELLOW} {...ink} />
+        <path d="M550 150l40 20-40 20z" fill={RAISED} {...ink} />
+      </g>
+    </g>
+  );
+}
