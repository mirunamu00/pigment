+/*
+ * Article figure: an original sticker scene (2-4 flat shapes, heavy ink outline) that shows the
+ * figure's own subject, picked from its alt text so no two figures share a drawing.
+ * Never a generic image glyph. Keeps role="img" + aria-label so the figure stays announced.
+ */
+type Scene = 'buttons' | 'notes' | 'flag' | 'idea';
+
+function pickScene(alt: string): Scene {
+  const text = alt.toLowerCase();
+  if (text.includes('button')) return 'buttons';
+  if (text.includes('release note') || text.includes('versions')) return 'notes';
+  if (text.includes('flag') || text.includes('timeline')) return 'flag';
+  return 'idea';
+}
+
+function SceneShapes({ scene }: { scene: Scene }) {
+  switch (scene) {
+    case 'buttons':
+      // forty-one buttons grouped into jobs: three button stacks, one labelled tag
+      return (
+        <>
+          <g transform="rotate(-8 170 170)">
+            <rect className="s f-raised" x="80" y="96" width="180" height="56" rx="8" />
+            <rect className="s f-pink" x="96" y="164" width="180" height="56" rx="8" />
+            <rect className="s f-ink" x="112" y="232" width="180" height="56" rx="8" />
+          </g>
+          <g transform="rotate(6 470 160)">
+            <rect className="s f-raised" x="350" y="70" width="230" height="180" rx="12" />
+            <path className="g" d="M384 120h96M384 160h150M384 200h120" />
+          </g>
+          <path className="s f-pink" d="M520 236l14 30 33 4-24 22 7 33-30-17-30 17 7-33-24-22 33-4z" />
+        </>
+      );
+    case 'notes':
+      // the same release note, before and after editing
+      return (
+        <>
+          <g transform="rotate(-6 190 160)">
+            <rect className="s f-raised" x="100" y="48" width="180" height="230" rx="10" />
+            <path className="g" d="M128 96h124M128 126h124M128 156h124M128 186h124M128 216h90" />
+          </g>
+          <g transform="rotate(5 450 160)">
+            <rect className="s f-raised" x="360" y="48" width="180" height="230" rx="10" />
+            <rect className="s f-pink" x="384" y="84" width="132" height="36" rx="6" />
+            <path className="g" d="M388 156h100M388 192h64" />
+          </g>
+          <path className="g" d="M292 160h52M326 142l18 18-18 18" />
+        </>
+      );
+    case 'flag':
+      // a flag travels from internal rollout to full release, then is removed
+      return (
+        <>
+          <path className="s f-raised" d="M60 236h470v-22l50 38-50 38v-22H60z" />
+          <path className="g" d="M200 236V70" />
+          <path className="s f-pink" d="M200 70h150l-30 40 30 40H200z" />
+          <circle className="s f-ink" cx="480" cy="250" r="20" />
+        </>
+      );
+    case 'idea':
+      return (
+        <>
+          <path
+            className="s f-raised"
+            d="M330 50c90 4 160 52 150 120-8 60-60 100-150 104-90 4-170-36-170-110 0-70 80-118 170-114z"
+          />
+          <path className="s f-pink" d="M320 110l18 40 44 5-32 30 9 43-39-22-39 22 9-43-32-30 44-5z" />
+        </>
+      );
+  }
+}
+
 export default function ImagePlaceholder({ alt }: { alt: string }) {
+  const scene = pickScene(alt);
   return (
-    <svg className="image-placeholder" viewBox="0 0 640 320" role="img" aria-label={alt}>
-      <rect className="image-placeholder-bg" x="0" y="0" width="640" height="320" />
-      <circle className="image-placeholder-shape" cx="220" cy="120" r="36" />
-      <path className="image-placeholder-shape" d="M120 260 L260 150 L360 230 L440 170 L540 260 Z" />
+    <svg className="image-placeholder sticker sticker--hero" viewBox="0 0 640 320" role="img" aria-label={alt}>
+      <rect className="f-band" x="0" y="0" width="640" height="320" />
+      <SceneShapes scene={scene} />
     </svg>
   );
 }
