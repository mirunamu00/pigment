+    gap: var(--space-4) var(--space-16);
+    padding: var(--space-8) var(--space-12);
+    background: var(--color-surface-subtle);
+    border-bottom: var(--border-width-thick) solid var(--color-border-default);
+  }
+
+  .table-stack thead th {
+    position: static;
+    height: auto;
+    padding: var(--space-4) 0;
+    border: none;
+    background: none;
+  }
+
+  .table-stack thead th.cell-action {
+    display: none;
+  }
+
+  /* A header row without sort controls carries no information once rows are labelled */
+  .table-stack thead:not(:has(.sort-button)) {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+  }
+
+  .table-stack tbody tr {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) auto;
+    column-gap: var(--space-12);
+    row-gap: var(--space-4);
+    padding: var(--space-12);
+  }
+
+  .table-stack tbody tr + tr {
+    border-top: var(--border-width-thin) solid var(--color-border-hairline);
+  }
+
+  .table-stack tbody tr + tr td {
+    border-top: none;
+  }
+
+  .table-stack tbody tr:hover td {
+    background: none;
+  }
+
+  .table-stack tbody tr:hover {
+    background: var(--color-surface-subtle);
+  }
+
+  .table-stack td {
+    grid-column: 1;
+    height: auto;
+    padding: 0;
+  }
+
+  .table-stack td.cell-primary {
+    font-weight: var(--font-weight-bold);
+    margin-bottom: var(--space-4);
+  }
+
+  .table-stack td.cell-primary .small {
+    font-weight: var(--font-weight-regular);
+  }
+
+  .table-stack td[data-label] {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    gap: var(--space-12);
+    text-align: right;
+  }
+
+  .table-stack td[data-label]::before {
+    content: attr(data-label);
+    color: var(--color-text-secondary);
+    text-align: left;
+  }
+
+  .table-stack td.cell-action {
+    grid-column: 2;
+    grid-row: 1;
+    width: auto;
+    padding: 0;
+    align-self: start;
+  }
+
+  .table-stack .lift--icon {
+    width: var(--size-hit);
+    height: var(--size-hit);
+    min-height: var(--size-hit);
+  }
+
+  .person {
+    align-items: flex-start;
+  }
+
+  .person-name {
+    font-weight: var(--font-weight-bold);
+  }
+}
+
+@media (max-width: 639px) {
+  .details {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+@media (max-width: 479px) {
+  .topbar-search .lift-label {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+  }
+
+  .topbar-search .lift {
+    padding-inline: var(--space-12);
+  }
+}
+
+@media (forced-colors: active) {
+  .card,
+  .table-box,
+  .input,
+  .checkbox {
+    border: var(--border-width-thin) solid CanvasText;
   }
 }
