+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+  }
+
+  .table-stack thead tr:not(:has(.sort-button)) {
+    padding: 0;
+  }
+
+  .table-stack th.numeric .sort-button {
+    flex-direction: row;
+  }
+
+  .table-stack .sort-button {
+    min-height: var(--size-hit);
+  }
+
+  .table-stack tbody tr {
+    padding: var(--space-12);
+  }
+
+  .table-stack tbody tr + tr {
+    border-top: var(--border-width-thin) solid var(--color-border-hairline);
+  }
+
+  .table-stack tbody tr + tr td {
+    border-top: none;
+  }
+
+  .table-stack td {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    gap: var(--space-16);
+    height: auto;
+    padding: var(--space-4) 0;
+    text-align: right;
+  }
+
+  .table-stack td::before {
+    content: attr(data-label);
+    flex: none;
+    color: var(--color-text-secondary);
+    text-align: left;
+  }
+
+  .table-stack td.cell-primary {
+    display: block;
+    padding-bottom: var(--space-8);
+    text-align: left;
+    font-size: var(--font-size-md);
+    line-height: var(--font-line-height-ui);
+    font-weight: var(--font-weight-bold);
+    overflow-wrap: anywhere;
+  }
+
+  .table-stack td.cell-primary::before {
+    content: none;
+  }
+
+  .table-stack td.cell-primary .muted,
+  .table-stack td.cell-primary .small {
+    font-weight: var(--font-weight-regular);
   }
 }
