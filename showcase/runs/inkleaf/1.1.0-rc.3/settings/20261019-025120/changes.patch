+
+/* ---------- Dialog ---------- */
+.dialog {
+  width: min(var(--size-dialog), 100% - 2 * var(--space-16));
+  max-width: none;
+  padding: var(--space-32);
+  border: 0;
+  border-radius: var(--radius-stage);
+  background: var(--color-surface-raised);
+  color: var(--color-text-primary);
+  box-shadow: var(--shadow-overlay);
+}
+
+.dialog[open] {
+  animation: dialog-in var(--motion-duration-open) var(--motion-easing-quart);
+}
+
+.dialog::backdrop {
+  background: var(--color-surface-overlay);
+  animation: scrim-in var(--motion-duration-open) var(--motion-easing-quart);
+}
+
+@keyframes dialog-in {
+  from {
+    opacity: 0;
+    transform: translateY(var(--motion-distance-overlay));
+  }
+}
+
+@keyframes scrim-in {
+  from {
+    opacity: 0;
+  }
+}
+
+.dialog-title {
+  font-size: var(--font-size-h4);
+  font-weight: var(--font-weight-medium);
+}
+
+.dialog-body {
+  margin-top: var(--space-12);
+  font-size: var(--font-size-ui);
+  color: var(--color-text-secondary);
+}
+
+.dialog-actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: var(--space-12);
+  margin-top: var(--space-32);
+}
+
+/* ---------- Empty state, not found ---------- */
+.empty-state {
+  display: grid;
+  justify-items: center;
+  max-width: var(--size-dialog);
+  margin: 0 auto;
+  padding: var(--space-64) var(--space-24);
+  text-align: center;
+}
+
+.empty-state h1 {
+  margin-top: var(--space-24);
+  font-size: var(--font-size-h3);
+  font-weight: var(--font-weight-regular);
+}
+
+.empty-state-line {
+  margin-top: var(--space-8);
+  color: var(--color-text-secondary);
+}
+
+.empty-state-actions {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: var(--space-12);
+  margin-top: var(--space-24);
+}
+
+/* ---------- Dark ---------- */
+@media (prefers-color-scheme: dark) {
