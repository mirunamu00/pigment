+  height: var(--space-6);
+  border-radius: var(--radius-full);
+  background: var(--strength-color);
+}
+
+.strength-weak {
+  --strength-color: var(--color-status-danger);
+}
+
+.strength-fair {
+  --strength-color: var(--color-status-warning);
+}
+
+.strength-strong {
+  --strength-color: var(--color-status-success);
+}
+
+/* ---------- Switches (settings groups) ---------- */
+.fieldset {
