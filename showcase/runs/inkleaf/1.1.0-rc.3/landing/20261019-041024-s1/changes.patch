-    </svg>
+    <Stage color="sage" lines={0} media hero role="img" aria-label={alt}>
+      <div className="trayed" aria-hidden="true">
+        <div className="card ghost-week">
+          <div className="ghost-week-head">
+            <i className="ghost-bar" />
+            <i className="ghost-bar" />
+          </div>
+          <div className="ghost-week-grid">
+            {WEEK.map((day, d) => (
+              <div key={d} className="ghost-day">
+                <i className="ghost-bar" />
+                {day.slots.map((slot, s) => (
+                  <div
+                    key={s}
+                    className={
+                      slot === 'tall'
+                        ? 'ghost-slot ghost-slot--tall'
+                        : slot === 'open' || slot === 'mark'
+                          ? 'ghost-slot ghost-slot--open'
+                          : 'ghost-slot'
+                    }
+                  >
+                    {slot === 'mark' ? (
+                      <i className="ghost-bar ghost-bar--ink" />
+                    ) : slot !== 'open' ? (
+                      <i className="ghost-bar" style={{ width: BAR_WIDTHS[(d + s) % BAR_WIDTHS.length] }} />
