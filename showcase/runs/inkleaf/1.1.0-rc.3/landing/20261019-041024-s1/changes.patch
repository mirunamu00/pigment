+  { slots: ['booked', 'open', 'tall'] },
+  { slots: ['tall', 'open', 'booked'] },
+  { slots: ['open', 'booked', 'mark', 'booked'] },
+  { slots: ['booked', 'tall', 'open'] },
+  { slots: ['open', 'booked', 'booked', 'open'] },
+];
+
+const BAR_WIDTHS = ['70%', '45%', '60%', '80%'];
+
 export default function ImagePlaceholder({ alt }: { alt: string }) {
   return (
