+}
+
+.toolbar-end .field-inline {
+  width: 280px;
+}
+
+.sort-select {
+  display: none;
+}
+
+.table-wrap {
+  min-width: 0;
+}
+
+.table {
+  width: 100%;
+  border-collapse: collapse;
+  table-layout: fixed;
+  font-size: var(--font-size-dense);
+  line-height: var(--font-line-height-title);
+}
+
+.table th {
+  height: var(--size-row-dense);
+  padding: 0 var(--space-16);
+  text-align: start;
+  vertical-align: middle;
+  color: var(--color-text-tertiary);
+  font-size: var(--font-size-micro);
+  font-weight: var(--font-weight-medium);
+  letter-spacing: var(--font-tracking-micro);
+  text-transform: uppercase;
+  box-shadow: inset 0 calc(-1 * var(--border-width-hairline)) 0 var(--color-border-default);
+}
+
+.table td {
+  height: var(--size-row-dense);
+  padding: var(--space-8) var(--space-16);
+  text-align: start;
+  vertical-align: middle;
+  color: var(--color-text-secondary);
+  overflow-wrap: anywhere;
+}
+
+.table tbody tr + tr td {
+  box-shadow: inset 0 var(--border-width-hairline) 0 var(--color-border-default);
+}
+
+.table td:first-child {
+  color: var(--color-text-primary);
+}
+
+.table th:first-child,
+.table td:first-child {
+  padding-left: var(--space-24);
+}
+
+.table th:last-child,
+.table td:last-child {
+  padding-right: var(--space-24);
+}
+
+.table .numeric {
+  text-align: right;
+  font-variant-numeric: tabular-nums;
+}
+
+.table tbody tr {
+  transition: background-color var(--motion-duration-press) var(--motion-easing-hover);
+}
+
+.table tbody tr:hover {
+  background: var(--color-surface-subtle);
+}
+
+.sort-button {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-4);
+  height: var(--size-control-sm);
+  margin: 0 calc(-1 * var(--space-6));
+  padding: 0 var(--space-6);
+  border: 0;
+  border-radius: var(--radius-chip);
+  background: transparent;
+  color: inherit;
+  font: inherit;
+  letter-spacing: inherit;
+  text-transform: inherit;
+  cursor: pointer;
+}
+
+.sort-button:hover,
+.sort-button.is-sorted {
+  color: var(--color-text-primary);
+}
+
+.numeric .sort-button {
+  flex-direction: row-reverse;
+}
+
+.sort-indicator {
+  display: inline-grid;
+  width: 12px;
+  height: 12px;
+}
+
+.sort-indicator .icon {
+  width: 12px;
+  height: 12px;
+}
+
+.row-link {
+  color: var(--color-text-primary);
+  font-weight: var(--font-weight-medium);
+}
+
+.row-link:focus-visible {
+  outline-offset: 2px;
+}
+
+.cell-meta {
+  color: var(--color-text-tertiary);
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+}
+
+a.cell-meta {
+  text-decoration-color: var(--color-border-default);
+}
+
+.table--projects th:nth-child(1) {
+  width: 30%;
+}
+
+.table--projects th:nth-child(2) {
+  width: 20%;
+}
+
+.table--projects th:nth-child(3) {
+  width: 16%;
+}
+
+.table--projects th:nth-child(4) {
+  width: 15%;
+}
+
+.table--team th:nth-child(1) {
+  width: 38%;
+}
+
+.table--team th:nth-child(4) {
+  width: 18%;
+}
+
+.table--files th:nth-child(1) {
+  width: 50%;
+}
+
+.person {
+  display: flex;
+  align-items: center;
+  gap: var(--space-12);
+  min-width: 0;
+}
+
+.person-text {
+  min-width: 0;
+}
+
+.person-name {
+  font-weight: var(--font-weight-medium);
+}
+
+/* Badge */
+.badge {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-6);
+  height: var(--space-24);
+  padding: 0 var(--space-8);
+  border-radius: var(--radius-badge);
+  box-shadow: inset 0 0 0 var(--border-width-hairline) var(--color-border-control);
+  color: var(--color-text-secondary);
+  font-size: var(--font-size-caption);
+  font-weight: var(--font-weight-medium);
+  line-height: 1;
+  white-space: nowrap;
+}
+
+.badge-dot {
+  display: inline-block;
+  width: var(--space-6);
+  height: var(--space-6);
+  border-radius: var(--radius-full);
+  background: currentColor;
+}
+
+.pill-active {
+  color: var(--color-status-info);
+}
+
+.pill-paused {
+  color: var(--color-status-warning);
+}
+
+.pill-done {
+  color: var(--color-status-success);
+}
+
+/* Mobile: tables with status stack; the others scroll inside a labelled region. */
+@media (max-width: 833px) {
+  .panel-header {
+    padding: var(--space-24) var(--space-16) 0;
+  }
+
+  .toolbar {
+    padding: 0 var(--space-16) var(--space-16);
+  }
+
+  .toolbar-end {
+    flex-direction: column;
+    align-items: stretch;
+    width: 100%;
+  }
+
+  .toolbar-end .field-inline {
+    width: 100%;
+  }
+
+  .sort-select {
+    display: flex;
+  }
+
+  .sort-select .select {
+    flex: 1;
+  }
+
+  .table--stack thead {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+  }
+
+  .table--stack,
+  .table--stack tbody,
+  .table--stack tr,
+  .table--stack td {
+    display: block;
+  }
+
+  .table--stack tr {
+    padding: var(--space-12) var(--space-16);
+    box-shadow: inset 0 var(--border-width-hairline) 0 var(--color-border-default);
+  }
+
+  .table--stack tbody tr + tr td {
+    box-shadow: none;
+  }
+
+  .table--stack td,
+  .table--stack td:first-child,
+  .table--stack td:last-child {
+    display: grid;
+    grid-template-columns: minmax(96px, 38%) 1fr;
+    align-items: center;
+    gap: var(--space-12);
+    height: auto;
+    min-height: var(--space-32);
+    padding: var(--space-4) 0;
+  }
+
+  .table--stack td::before {
+    content: attr(data-label);
+    color: var(--color-text-tertiary);
+    font-size: var(--font-size-caption);
+    letter-spacing: var(--font-tracking-caption);
+  }
+
+  .table--stack .numeric {
+    text-align: start;
+  }
+
+  .table--stack td > * {
+    justify-self: start;
+  }
+
+  .table-region {
+    overflow-x: auto;
+  }
+
+  .table-region .table {
+    min-width: 640px;
+  }
+
+  .table-region td {
+    overflow-wrap: normal;
+  }
+}
+
+/* ---------- Empty state, not found ---------- */
+.empty-state {
+  display: grid;
+  justify-items: center;
+  max-width: var(--size-dialog);
+  margin: 0 auto;
+  padding: var(--space-64) var(--space-24);
+  text-align: center;
+}
+
+.empty-state .picto {
+  margin-bottom: var(--space-24);
+}
+
+.empty-state-title {
+  font-size: var(--font-size-h4);
+  font-weight: var(--font-weight-medium);
+}
+
+.empty-state-line {
+  margin-top: var(--space-8);
+  color: var(--color-text-secondary);
+  font-size: var(--font-size-ui);
+}
+
+.empty-state-action {
+  margin-top: var(--space-24);
+}
+
+.not-found {
+  display: grid;
+  justify-items: center;
+  max-width: var(--size-dialog);
+  margin: 0 auto;
+  padding: var(--space-96) 0 var(--space-64);
+  text-align: center;
+}
+
+.not-found .picto {
+  margin-bottom: var(--space-24);
+}
+
+.not-found h1 {
+  font-size: clamp(var(--font-size-h3), 5vw, var(--font-size-h1));
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-tight);
+}
+
+.not-found-line {
+  margin-top: var(--space-16);
+  color: var(--color-text-secondary);
+  font-size: var(--font-size-body);
+}
+
+.not-found-actions {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: var(--space-12);
+  margin-top: var(--space-32);
+}
+
+@media (max-width: 833px) {
+  .not-found {
+    padding-top: var(--space-64);
+  }
+
+  .not-found-actions {
+    flex-direction: column;
+    align-self: stretch;
+    width: 100%;
+  }
+
+  .not-found-actions .btn {
+    display: flex;
+    width: 100%;
+  }
+}
+
+/* ---------- Project detail ---------- */
+.tabs {
+  display: flex;
+  gap: var(--space-24);
+  margin-bottom: var(--space-24);
+  overflow-x: auto;
+  scrollbar-width: none;
+  box-shadow: inset 0 calc(-1 * var(--border-width-hairline)) 0 var(--color-border-default);
+}
+
+.tab {
+  position: relative;
+  flex: none;
+  height: var(--size-control);
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--color-text-secondary);
+  font: var(--font-weight-regular) var(--font-size-ui) / 1 var(--font-family-sans);
+  cursor: pointer;
+  transition: color var(--motion-duration-nav) var(--motion-easing-expo);
+}
+
+.tab:hover {
+  color: var(--color-text-primary);
+}
+
+.tab:focus-visible {
+  outline-offset: -2px;
+}
+
+.tab[aria-selected='true'] {
+  color: var(--color-text-primary);
+  font-weight: var(--font-weight-medium);
+}
+
+.tab[aria-selected='true']::after {
+  content: '';
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  height: var(--border-width-ring);
+  background: var(--color-action-primary);
+}
+
+.content > .tabs + * {
+  margin-top: 0;
+}
+
+.tab-panel {
+  animation: content-swap var(--motion-duration-raise) var(--motion-easing-settle) both;
+}
+
+@keyframes content-swap {
+  from {
+    opacity: 0;
+    transform: translateY(var(--motion-distance-raise));
+  }
+}
+
+.detail-overview {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+  align-items: start;
+  gap: var(--space-32);
+}
+
+.detail-description {
+  max-width: var(--size-measure);
+  font-size: var(--font-size-body);
+}
+
+.details {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-24);
+  margin: var(--space-32) 0 0;
+  padding-top: var(--space-24);
+  box-shadow: inset 0 var(--border-width-hairline) 0 var(--color-border-default);
+}
+
+.details dt {
+  color: var(--color-text-tertiary);
+  font-size: var(--font-size-micro);
+  font-weight: var(--font-weight-medium);
+  letter-spacing: var(--font-tracking-micro);
+  text-transform: uppercase;
+}
+
+.details dd {
+  margin: var(--space-4) 0 0;
+  font-size: var(--font-size-body);
+  font-variant-numeric: tabular-nums;
+}
+
+@media (max-width: 991px) {
+  .detail-overview {
+    grid-template-columns: minmax(0, 1fr);
+    gap: var(--space-24);
+  }
+
+  .detail-overview .stage {
+    order: -1;
+  }
+}
+
+.progress-row {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--space-16);
+  padding-bottom: var(--space-16);
+  font-size: var(--font-size-ui);
+  font-variant-numeric: tabular-nums;
+}
+
+.progress {
+  flex: 1;
+  max-width: 240px;
+  height: var(--space-8);
+  border: 0;
+  border-radius: var(--radius-full);
+  overflow: hidden;
+  appearance: none;
+  background: var(--color-surface-subtle);
+}
+
+.progress::-webkit-progress-bar {
+  background: var(--color-surface-subtle);
+}
+
+.progress::-webkit-progress-value {
+  background: var(--color-action-primary);
+}
+
+.progress::-moz-progress-bar {
+  background: var(--color-action-primary);
+}
+
+.task-list {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.task {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  column-gap: var(--space-12);
+  min-height: var(--size-touch);
+  padding: var(--space-8) 0;
+  box-shadow: inset 0 var(--border-width-hairline) 0 var(--color-border-default);
+}
+
+.task label {
+  flex: 1;
+  min-width: 0;
+  font-size: var(--font-size-ui);
+  cursor: pointer;
+}
+
+.task-assignee {
+  color: var(--color-text-tertiary);
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+}
+
+.task-done label {
+  text-decoration: line-through;
+  text-decoration-color: var(--color-border-strong);
+  color: var(--color-text-secondary);
+}
+
+@media (max-width: 833px) {
+  .task-assignee {
+    flex-basis: 100%;
+    padding-left: calc(var(--size-icon-lg) + var(--space-12));
+  }
+}
+
+/* ---------- Reduced motion, globally ---------- */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: var(--motion-duration-instant) !important;
+    animation-delay: 0s !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: var(--motion-duration-instant) !important;
+    transition-delay: 0s !important;
+  }
+
+  [data-rise].is-rise-ready {
+    opacity: 1;
+    transform: none;
   }
 }
