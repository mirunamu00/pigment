+  }
+
+  .chart-bars {
+    gap: var(--space-6);
+    padding-left: var(--space-32);
+  }
+}
+
+/* ---------- Chart (on the dashboard's one stage) ---------- */
+.chart {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-16);
+  height: 100%;
+  margin: 0;
