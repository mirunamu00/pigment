+
+/* ---------- Content container and product header ---------- */
+.content {
+  max-width: var(--size-container);
+  margin: 0 auto;
+  padding: 0 clamp(var(--space-20), 4vw, var(--space-64)) var(--space-64);
+}
+
+.content:focus {
+  outline: none;
+}
+
+.content > * + * {
+  margin-top: var(--space-24);
+}
+
+.content > .breadcrumb + *,
+.content > .page-header + * {
+  margin-top: 0;
+}
+
+.page-header {
+  display: grid;
+  grid-template-columns: var(--size-picto-sm) minmax(0, 1fr) auto;
+  align-items: center;
+  column-gap: var(--space-16);
+  padding: var(--space-48) 0 var(--space-32);
+}
+
+.page-header h1 {
+  grid-column: 2;
+  max-width: var(--size-measure-heading);
+  font-size: var(--font-size-h3);
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-heading);
+}
+
+.page-header-actions {
+  grid-column: 3;
+  display: flex;
+  align-items: center;
+  gap: var(--space-12);
+  animation: rise-sm var(--motion-duration-rise) var(--motion-easing-settle) 200ms both;
+}
+
+.page-header .lede {
+  grid-column: 1 / -1;
+  max-width: var(--size-measure);
+  margin-top: var(--space-8);
+  color: var(--color-text-secondary);
+  font-size: var(--font-size-body);
+  animation: rise-sm var(--motion-duration-rise) var(--motion-easing-settle) 200ms both;
+}
+
+@keyframes rise-sm {
+  from {
+    opacity: 0;
+    transform: translateY(var(--motion-distance-rise-sm));
+  }
+}
+
+@media (max-width: 833px) {
+  .page-header {
+    grid-template-columns: minmax(0, 1fr);
+    row-gap: var(--space-16);
+  }
+
+  .page-header > * {
+    grid-column: 1;
+  }
+
+  .page-header h1 {
+    grid-column: 1;
+    font-size: var(--font-size-h4);
+  }
+
+  .page-header-actions {
+    grid-column: 1;
+    order: 3;
+  }
+
+  .page-header .lede {
+    margin-top: calc(var(--space-8) - var(--space-16));
+  }
+}
+
+/* Breadcrumb: sits in the header's top padding so every h1 lines up. */
+.breadcrumb {
+  padding-top: var(--space-12);
+  margin-bottom: var(--space-16);
+  font-size: var(--font-size-small);
+  line-height: var(--space-20);
+  color: var(--color-text-secondary);
+}
+
+.breadcrumb ol {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-8);
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.breadcrumb a {
+  color: var(--color-text-secondary);
+}
+
+.breadcrumb a:hover {
+  color: var(--color-text-primary);
+}
+
+.breadcrumb li + li::before {
+  content: '/';
+  margin-right: var(--space-8);
+  color: var(--color-text-tertiary);
+}
+
+.breadcrumb + .page-header {
+  padding-top: 0;
+}
+
+/* ---------- Block rise ---------- */
+[data-rise] {
+  transition:
+    opacity var(--motion-duration-rise) var(--motion-easing-settle) var(--rise-delay, 0ms),
+    transform var(--motion-duration-rise) var(--motion-easing-settle) var(--rise-delay, 0ms);
+}
+
+[data-rise].is-rise-ready {
+  opacity: 0;
+  transform: translateY(var(--motion-distance-rise));
+}
+
+@media print {
+  [data-rise].is-rise-ready {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+/* ---------- Cards and panels ---------- */
+.card,
+.panel {
+  min-width: 0;
+  padding: var(--space-24);
+  border-radius: var(--radius-card);
+  background: var(--color-surface-raised);
+  box-shadow: inset 0 0 0 var(--border-width-hairline) var(--color-border-default);
+}
+
+.panel > h2,
+.panel-header h2 {
+  font-size: var(--font-size-h4);
+  font-weight: var(--font-weight-medium);
+}
+
+.panel > h2 {
+  margin-bottom: var(--space-16);
+}
+
+.panel--fill {
+  display: flex;
+  flex-direction: column;
+}
+
+.stage--fill {
+  flex: 1;
+  align-items: stretch;
+}
+
+/* KPI stat cards */
+.kpi-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: var(--space-24);
+}
+
+.kpi-card {
+  display: grid;
+  align-content: start;
+  gap: var(--space-8);
+}
+
+.kpi-label {
+  font-family: var(--font-family-sans);
+  font-size: var(--font-size-small);
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-title);
+  color: var(--color-text-secondary);
+}
+
+.kpi-value {
+  font-size: var(--font-size-h3);
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-tight);
+  font-variant-numeric: tabular-nums;
+}
+
+.kpi-change {
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+  font-variant-numeric: tabular-nums;
+}
+
+.kpi-change-good {
+  color: var(--color-status-success);
+}
+
+.kpi-change-bad {
+  color: var(--color-status-danger);
+}
+
+.kpi-change-neutral {
+  color: var(--color-text-secondary);
+}
+
+/* Loading: static skeleton bars, no shimmer. */
+.skeleton {
+  display: block;
+  height: var(--space-8);
+  border-radius: var(--radius-badge);
+  background: var(--color-surface-subtle);
+}
+
+.skeleton-label {
+  width: 70%;
+  margin-block: 5px;
+}
+
+.skeleton-value {
+  width: 45%;
+  height: var(--space-32);
+  margin-top: var(--space-4);
+}
+
+.skeleton-change {
+  width: 55%;
+  margin-top: var(--space-4);
+}
+
+.two-column {
+  display: grid;
+  grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
+  align-items: stretch;
+  gap: var(--space-24);
+}
+
+@media (min-width: 1200px) {
+  .kpi-grid,
   .two-column {
-    grid-template-columns: 1fr;
+    gap: var(--space-32);
+  }
+}
+
+@media (max-width: 991px) {
+  .two-column {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+@media (max-width: 833px) {
+  .kpi-grid {
+    grid-template-columns: repeat(6, minmax(0, 1fr));
+    gap: var(--space-16);
+  }
