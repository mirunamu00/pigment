+  color: var(--color-text-primary);
+  font: var(--font-weight-medium) var(--font-size-ui) / 1 var(--font-family-sans);
+  cursor: pointer;
+  transition:
+    background-color var(--motion-duration-press) var(--motion-easing-hover),
+    color var(--motion-duration-press) var(--motion-easing-hover),
+    transform var(--motion-duration-press) var(--motion-easing-hover);
