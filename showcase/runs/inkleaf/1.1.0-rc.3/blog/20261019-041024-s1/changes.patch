-export default function ImagePlaceholder({ alt }: { alt: string }) {
+import type { CSSProperties } from 'react';
+import type { StageTone } from '../ink/ink';
+import { Stage } from '../ink/Stage';
+
+/*
+ * A missing information image becomes a ghosted preview on a media stage, shaped like its caption:
+ * grouped tiles for a board, two panels for a comparison, boxes joined by hairlines for a flow.
+ */
+type Shape = 'board' | 'compare' | 'flow';
+
+function shapeFor(alt: string): Shape {
+  const text = alt.toLowerCase();
+  if (/side by side|before and after|versus/.test(text)) return 'compare';
+  if (/timeline|moving from|flow|steps/.test(text)) return 'flow';
+  return 'board';
+}
+
+const bar = (width: number, key: number) => (
+  <i key={key} className="ghost-bar" style={{ width: `${width}%` } as CSSProperties} />
+);
+
+function Board() {
+  const tiles = [
+    [70, 45, 60],
+    [55, 80],
+    [65, 40, 50],
+    [85, 50],
+    [45, 70, 40],
+    [60, 75],
+  ];
+  return (
+    <div className="card ghost-grid" aria-hidden="true">
+      {tiles.map((widths, i) => (
+        <div className="ghost-tile" key={i}>
+          {widths.map((w, j) => (
+            bar(w, j)
+          ))}
+        </div>
+      ))}
+    </div>
+  );
+}
+
+function Compare() {
+  return (
+    <div className="card ghost-compare" aria-hidden="true">
+      <div className="ghost-tile">
+        {[90, 85, 70, 88, 60, 80, 75].map((w, j) => (
+          bar(w, j)
+        ))}
+      </div>
+      <div className="ghost-tile">
+        <i className="ghost-bar ghost-bar--mark" style={{ width: '55%' }} />
+        {[80, 45].map((w, j) => (
+          bar(w, j)
+        ))}
+      </div>
+    </div>
+  );
+}
+
+function Flow() {
+  return (
+    <div className="card ghost-flow" aria-hidden="true">
+      {[
+        [70, 45],
+        [60, 80],
+        [50, 65],
+      ].map((widths, i) => (
+        <div className="ghost-step" key={i}>
+          {i > 0 && <i className="ghost-link" />}
+          <div className="ghost-tile">
+            {widths.map((w, j) => bar(w, j))}
+          </div>
+        </div>
+      ))}
+    </div>
+  );
+}
+
+export default function ImagePlaceholder({ alt, tone, lines = 1 }: { alt: string; tone: StageTone; lines?: number }) {
+  const shape = shapeFor(alt);
   return (
-    <svg className="image-placeholder" viewBox="0 0 640 320" role="img" aria-label={alt}>
-      <rect className="image-placeholder-bg" x="0" y="0" width="640" height="320" />
-      <circle className="image-placeholder-shape" cx="220" cy="120" r="36" />
-      <path className="image-placeholder-shape" d="M120 260 L260 150 L360 230 L440 170 L540 260 Z" />
-    </svg>
+    <Stage tone={tone} variant="media" lines={lines} role="img" aria-label={alt}>
+      {shape === 'compare' ? <Compare /> : shape === 'flow' ? <Flow /> : <Board />}
+    </Stage>
   );
 }
