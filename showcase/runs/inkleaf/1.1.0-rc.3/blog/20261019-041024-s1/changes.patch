+import { useEffect, useState, type MouseEvent } from 'react';
 import type { Block } from '../data/posts';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const WIDE = '(min-width: 992px)';
+
+/** Beside the text from breakpoint.lg; below it, a collapsed disclosure after the lead. */
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
+  const [wide, setWide] = useState(() => window.matchMedia(WIDE).matches);
+  const [open, setOpen] = useState(false);
+
+  useEffect(() => {
+    const query = window.matchMedia(WIDE);
+    const update = () => setWide(query.matches);
+    query.addEventListener('change', update);
+    return () => query.removeEventListener('change', update);
+  }, []);
+
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
   if (headings.length === 0) return null;
 
+  function keepOpen(event: MouseEvent) {
+    if (wide) event.preventDefault();
+  }
+
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      <details
+        className="toc-disclosure"
+        open={wide || open}
+        onToggle={(event) => {
+          if (!wide) setOpen(event.currentTarget.open);
+        }}
+      >
+        <summary className="toc-summary" onClick={keepOpen} tabIndex={wide ? -1 : undefined}>
+          <h2 id="toc-heading" className="toc-heading">
+            On this page
+          </h2>
+          <svg className="icon toc-chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
+            <path d="M4,6L8,10L12,6" />
+          </svg>
+        </summary>
+        <ol className="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
+                {heading.text}
+              </a>
+            </li>
+          ))}
+        </ol>
+      </details>
     </nav>
   );
 }
