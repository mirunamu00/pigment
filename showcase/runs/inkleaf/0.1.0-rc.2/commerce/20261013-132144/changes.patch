+  border-radius: var(--radius-card);
+  background: var(--color-surface-raised);
+  transition: box-shadow var(--motion-duration-hover) var(--motion-easing-hover);
+}
+
+/* The ring sits above the plate so the clipped card keeps its edge */
+.product-card::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  border-radius: inherit;
+  box-shadow: inset 0 0 0 var(--border-width-hairline) var(--color-border-default);
+  pointer-events: none;
+}
+
+.product-card:hover {
+  box-shadow: var(--shadow-hover);
+}
+
+.product-card:has(.product-link:focus-visible) {
+  outline: var(--border-width-ring) solid var(--color-focus-ring);
+  outline-offset: 4px;
+}
+
+.product-image {
+  position: relative;
+  aspect-ratio: 4 / 3;
+  width: 100%;
+}
+
+.product-card .product-image {
+  border-radius: 0;
+}
+
+.plate-icon {
+  position: absolute;
+  left: var(--space-16);
+  bottom: var(--space-16);
+  width: var(--size-icon-lg);
+  height: var(--size-icon-lg);
+  color: var(--color-pictogram-ink);
+}
+
+.product-card-body {
