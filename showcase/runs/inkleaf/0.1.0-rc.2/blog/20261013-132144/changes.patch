+.breadcrumb li + li::before {
+  content: '/';
+  margin-right: var(--space-8);
+  color: var(--color-text-tertiary);
+}
+
+.article {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+}
+
+.article-header {
+  margin-bottom: var(--space-32);
+}
+
+.article-title {
+  margin-bottom: var(--space-16);
+  font-size: clamp(var(--font-size-h3), 5vw, var(--font-size-h2));
+  line-height: var(--font-line-height-tight);
+}
+
+.article-header .post-meta {
+  font-size: var(--font-size-ui);
+  color: var(--color-text-secondary);
+}
+
+.article-stage {
+  margin-bottom: var(--space-48);
+}
+
+.article-stage .stage-content,
+.not-found-stage .stage-content {
+  display: flex;
+  justify-content: center;
+}
+
+.article-stage {
+  padding-block: var(--space-64);
+}
+
+.article-aside {
+  min-width: 0;
+  margin-bottom: var(--space-32);
+}
+
+@media (min-width: 992px) {
+  .article {
+    grid-template-columns: minmax(0, var(--size-measure)) var(--size-sidebar);
+    justify-content: space-between;
+    column-gap: var(--space-64);
+  }
+
+  .article-stage {
+    grid-column: 1 / -1;
+  }
+
+  .article-header {
+    grid-column: 1;
+  }
+
+  .article-aside {
+    grid-column: 2;
+    grid-row: 3;
+    align-self: start;
+    position: sticky;
+    top: calc(var(--size-header) + var(--space-24));
+    margin: 0;
+  }
+
+  .article-body {
+    grid-column: 1;
+    grid-row: 3;
+  }
+}
+
+.article-body {
+  min-width: 0;
+  max-width: var(--size-measure);
+  font-size: var(--font-size-body-lg);
+}
+
+.article-body p {
+  margin: 0 0 var(--space-24);
+}
+
+.article-body h2 {
+  margin: var(--space-48) 0 var(--space-16);
+  font-size: var(--font-size-h4);
+  line-height: var(--font-line-height-heading);
+}
+
+.article-body h3 {
+  margin: var(--space-32) 0 var(--space-12);
+  font-size: var(--font-size-h5);
+  line-height: var(--font-line-height-title);
+}
+
+.body-quote {
+  margin: var(--space-48) 0;
+}
+
+.body-quote blockquote {
+  margin: 0;
+}
+
+.body-quote blockquote p {
+  margin: 0;
+  max-width: var(--size-measure-heading);
+  font-family: var(--font-family-serif);
+  font-size: var(--font-size-plan);
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-tight);
+  text-wrap: balance;
+}
+
+.body-quote figcaption,
+.body-figure figcaption {
+  margin-top: var(--space-12);
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+  color: var(--color-text-tertiary);
+}
+
+.code-block {
+  margin: 0 0 var(--space-24);
+  padding: var(--space-16) var(--space-20);
+  overflow-x: auto;
+  border-radius: var(--radius-tile);
+  background: var(--color-surface-subtle);
+  color: var(--color-text-primary);
+  font-family: var(--font-family-mono);
+  font-size: var(--font-size-small);
+  line-height: var(--font-line-height-body);
+}
+
+.code-block code {
+  font: inherit;
+}
+
+.body-list {
+  margin: 0 0 var(--space-24);
+  padding-left: var(--space-24);
+}
+
+.body-list li {
+  padding-left: var(--space-4);
+}
+
+.body-list li + li {
+  margin-top: var(--space-8);
+}
+
+.body-list li::marker {
+  color: var(--color-text-tertiary);
+  font-variant-numeric: tabular-nums;
+}
+
+.body-figure {
+  margin: var(--space-40) 0;
+}
+
+.image-placeholder {
+  position: relative;
+  aspect-ratio: 2 / 1;
+  color: var(--color-pictogram-ink);
+}
+
+.image-placeholder .icon {
+  position: absolute;
+  left: var(--space-16);
+  bottom: var(--space-16);
+}
+
+/* Table of contents: a side column from breakpoint.lg, a collapsed disclosure below it. */
+.toc-heading {
+  margin: 0 0 var(--space-12);
+  font-family: var(--font-family-sans);
+  font-size: var(--font-size-micro);
+  font-weight: var(--font-weight-medium);
+  letter-spacing: var(--font-tracking-micro);
+  line-height: var(--font-line-height-title);
+  text-transform: uppercase;
+  color: var(--color-text-tertiary);
+}
+
+.toc-panel {
+  display: grid;
+  grid-template-rows: 1fr;
+}
+
+.toc-list {
+  list-style: none;
+  min-height: 0;
+  overflow: hidden;
+  margin: 0;
+  padding: 0;
+  font-size: var(--font-size-small);
+}
+
+.toc-item-nested {
+  padding-left: var(--space-12);
+}
+
+.toc-link {
+  display: block;
+  padding: var(--space-6) 0;
+  color: var(--color-text-secondary);
+  text-decoration: none;
+  line-height: var(--font-line-height-title);
+  transition: color var(--motion-duration-press) var(--motion-easing-hover);
+}
+
+.toc-link:hover {
+  color: var(--color-text-primary);
+}
+
+@media (min-width: 992px) {
+  .toc {
+    padding-left: var(--space-16);
+    box-shadow: inset var(--border-width-hairline) 0 0 var(--color-border-default);
+  }
+}
+
+@media (max-width: 991px) {
+  .toc {
+    border-radius: var(--radius-tile);
+    background: var(--color-surface-raised);
+    box-shadow: inset 0 0 0 var(--border-width-hairline) var(--color-border-default);
+  }
+
+  .toc-heading {
+    margin: 0;
+  }
+
+  .toc-toggle {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    width: 100%;
+    min-height: var(--size-touch);
+    padding: 0 var(--space-16);
+    border: 0;
+    border-radius: var(--radius-tile);
+    background: transparent;
+    font: var(--font-weight-medium) var(--font-size-ui) / 1 var(--font-family-sans);
+    letter-spacing: normal;
+    text-transform: none;
+    color: var(--color-text-primary);
+    cursor: pointer;
+  }
+
+  .toc-toggle .icon {
+    color: var(--color-text-secondary);
+    transition: transform calc(var(--motion-duration-open) * 0.6) var(--motion-easing-quart);
+  }
+
+  .toc.is-open .toc-toggle .icon {
+    transform: rotate(180deg);
+    transition-duration: var(--motion-duration-open);
+  }
+
+  .toc-panel {
+    grid-template-rows: 0fr;
+    opacity: 0;
+    visibility: hidden;
+    transition:
+      grid-template-rows calc(var(--motion-duration-open) * 0.6) var(--motion-easing-quart),
+      opacity calc(var(--motion-duration-open) * 0.6) var(--motion-easing-quart),
+      visibility 0s linear calc(var(--motion-duration-open) * 0.6);
+  }
+
+  .toc.is-open .toc-panel {
+    grid-template-rows: 1fr;
+    opacity: 1;
+    visibility: visible;
+    transition:
+      grid-template-rows var(--motion-duration-open) var(--motion-easing-quart),
+      opacity var(--motion-duration-open) var(--motion-easing-quart),
+      visibility 0s;
+  }
+
+  .toc-list {
+    padding: 0 var(--space-16);
+  }
+
+  .toc.is-open .toc-list {
+    padding-bottom: var(--space-12);
+  }
+}
+
+.related {
+  margin-top: var(--section-gap);
+}
+
+.related .section-title {
+  margin-bottom: var(--space-32);
+}
+
+/* ---------- About and other content pages ---------- */
+
+.content-header {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding-top: var(--space-96);
+  text-align: center;
+}
+
+.content-title {
+  font-size: clamp(var(--font-size-h3), 5vw, var(--font-size-h1));
+  line-height: var(--font-line-height-tight);
+}
+
+.content-section {
+  margin-top: var(--section-gap);
+}
+
+.section-opener {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  margin-bottom: var(--space-32);
+  text-align: center;
+}
+
+.section-opener .picto {
+  margin-bottom: var(--space-24);
+}
+
+.prose {
+  max-width: var(--size-measure);
+  margin: 0 auto;
+}
+
+.prose p {
+  margin-bottom: var(--space-16);
+}
+
+.author-list {
+  list-style: none;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: var(--grid-gap);
+  align-items: start;
+  margin: 0;
+  padding: 0;
+}
+
+@media (min-width: 992px) {
+  .author-list {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+.avatar {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: var(--size-control);
+  height: var(--size-control);
+  margin-bottom: var(--space-16);
+  font-family: var(--font-family-serif);
+  font-size: var(--font-size-h5);
+  font-weight: var(--font-weight-regular);
+  color: var(--color-text-primary);
+}
+
+.author-card h3 {
+  font-size: var(--font-size-h5);
+  line-height: var(--font-line-height-title);
+}
+
+.author-role {
+  margin: var(--space-4) 0 var(--space-12);
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+  color: var(--color-text-tertiary);
+}
+
+.author-bio {
+  margin: 0;
+  font-size: var(--font-size-ui);
+  color: var(--color-text-secondary);
+}
+
+/* ---------- Newsletter (footer form) ---------- */
+
+.newsletter {
+  display: grid;
+  gap: var(--space-32);
+  align-items: end;
+}
+
+.newsletter-intro .picto {
+  margin-bottom: var(--space-24);
+}
+
+.newsletter-title {
+  margin-bottom: var(--space-8);
+  font-size: var(--font-size-h4);
+  line-height: var(--font-line-height-heading);
+}
+
+.newsletter-intro p {
+  margin: 0;
+  font-size: var(--font-size-ui);
+}
+
+.newsletter-form,
+.newsletter .form-success {
+  width: 100%;
+  max-width: var(--size-form);
+}
+
+@media (min-width: 992px) {
+  .newsletter {
+    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+    gap: var(--space-64);
+    padding: var(--space-48);
+  }
+
+  .newsletter .form-success {
+    align-self: end;
+    min-height: var(--size-control);
+  }
+}
+
+@media (max-width: 833px) {
+  .field-row {
+    flex-direction: column;
+  }
+
+  .field-row .input {
+    flex: none;
+  }
+
+  .field-row .btn {
+    width: 100%;
+  }
+}
+
+/* ---------- Not found ---------- */
+
+.not-found {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding-top: var(--space-96);
+  text-align: center;
+}
+
+.not-found-stage {
+  margin-bottom: var(--space-32);
+}
+
+.not-found-title {
+  margin-bottom: var(--space-16);
+  font-size: clamp(var(--font-size-h3), 5vw, var(--font-size-h1));
+  line-height: var(--font-line-height-tight);
+}
+
+.not-found p {
+  max-width: var(--size-measure);
+  margin-bottom: var(--space-32);
+}
+
+@media (max-width: 833px) {
+  .masthead {
+    padding-top: var(--space-64);
+  }
+
+  .content-header,
+  .not-found {
+    padding-top: var(--space-64);
+  }
+
+  .actions {
+    flex-direction: column;
+    align-self: stretch;
+  }
+}
+
+/* ---------- Reduced motion ---------- */
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: var(--motion-duration-instant) !important;
+    animation-delay: 0s !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: var(--motion-duration-instant) !important;
+    transition-delay: 0s !important;
+  }
+
+  .picto:is(.is-ready, .is-playing, .is-boiling) .cel-strip {
+    animation: none;
+    transform: translateX(calc((1 - var(--n)) * 120px));
+  }
+
+  .write-in .w,
+  .rise,
+  .rise-sm {
+    animation: none;
+  }
+
+  .glyph path {
+    animation: none;
+    stroke-dashoffset: 0;
+  }
+
+  .dot-breathe {
+    animation: none;
+  }
+
+  .btn:active:not(:disabled) {
+    transform: none;
   }
 }
