-      <rect className="image-placeholder-shape" x="430" y="130" width="150" height="230" />
-      <rect className="image-placeholder-shape" x="245" y="270" width="150" height="90" />
-    </svg>
+    <div className="card week" role="img" aria-label={alt}>
+      <div className="week-head" aria-hidden="true">
+        <span className="week-bar week-bar--title" />
+        <span className="week-bar week-bar--chip" />
+        <span className="week-bar week-bar--chip" />
+      </div>
+      <div className="week-grid" aria-hidden="true">
+        {WEEK.map(({ day, slots }) => (
+          <div key={day} className="week-day">
+            <span className="week-day-label">{day}</span>
+            {slots.map((slot, i) =>
+              slot === 'gap' ? (
+                <span key={i} />
+              ) : slot === 'picked' ? (
+                <span key={i} className="slot slot--picked slot--tall">
+                  <CheckCircle />
+                </span>
+              ) : (
+                <span key={i} className={`slot slot--${slot === 'tall' ? 'busy slot--tall' : slot}`} />
+              ),
+            )}
+          </div>
+        ))}
+      </div>
