+const WEEK: { day: string; slots: Slot[] }[] = [
+  { day: 'Mon 12', slots: ['busy', 'open', 'tall', 'open'] },
+  { day: 'Tue 13', slots: ['open', 'busy', 'open', 'busy', 'open'] },
+  { day: 'Wed 14', slots: ['tall', 'picked', 'open', 'open'] },
+  { day: 'Thu 15', slots: ['open', 'open', 'busy', 'tall'] },
+  { day: 'Fri 16', slots: ['busy', 'gap', 'open', 'open', 'busy'] },
+];
+
 export default function ImagePlaceholder({ alt }: { alt: string }) {
   return (
