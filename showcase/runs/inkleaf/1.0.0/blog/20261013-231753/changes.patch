+import { Stage } from '../design/Stage';
+
+type Layout = 'board' | 'pair' | 'timeline';
+
+const TILE_COUNT: Record<Layout, number> = { board: 6, pair: 2, timeline: 4 };
+
+function layoutFor(alt: string): Layout {
+  const text = alt.toLowerCase();
+  if (text.includes('side by side') || text.includes('two versions')) return 'pair';
+  if (text.includes('timeline')) return 'timeline';
+  return 'board';
+}
+
+/**
+ * A figure without a photo: a ghosted preview (raised card at 60% opacity, no text) on a lilac media stage.
+ * The stage carries the figure's alt text as its accessible image.
+ */
 export default function ImagePlaceholder({ alt }: { alt: string }) {
+  const layout = layoutFor(alt);
   return (
-    <svg className="image-placeholder" viewBox="0 0 640 320" role="img" aria-label={alt}>
-      <rect className="image-placeholder-bg" x="0" y="0" width="640" height="320" />
-      <circle className="image-placeholder-shape" cx="220" cy="120" r="36" />
-      <path className="image-placeholder-shape" d="M120 260 L260 150 L360 230 L440 170 L540 260 Z" />
-    </svg>
+    <Stage color="lilac" lines={2} className="stage--media image-placeholder" role="img" aria-label={alt}>
+      <div className={`card ghost-card ghost-card--${layout}`}>
+        {Array.from({ length: TILE_COUNT[layout] }, (_, i) => (
+          <div key={i} className="ghost-tile">
+            <span className="ghost-bar" />
+            <span className="ghost-bar ghost-bar--short" />
+          </div>
+        ))}
+      </div>
+    </Stage>
   );
 }
