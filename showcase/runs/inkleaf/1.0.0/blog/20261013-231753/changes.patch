+.empty-state--page {
+  max-width: var(--size-form);
+  padding-top: var(--space-32);
+}
+
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: var(--space-12);
+}
+
+@media (max-width: 833px) {
+  .actions {
+    flex-direction: column;
+    align-self: stretch;
+  }
+
+  .actions .btn {
+    display: flex;
+    width: 100%;
+  }
+}
+
+/* ---------- Article ---------- */
+
+.breadcrumb ol {
+  list-style: none;
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-8);
+  margin: 0 0 var(--space-16);
+  padding: 0;
+  font-size: var(--font-size-small);
+  color: var(--color-text-secondary);
+}
+
+.breadcrumb li {
+  min-width: 0;
+}
+
+.breadcrumb li + li::before {
+  content: '/';
+  margin-right: var(--space-8);
+  color: var(--color-text-tertiary);
+}
+
+.breadcrumb a {
+  color: var(--color-text-secondary);
+}
+
+.breadcrumb a:hover {
+  color: var(--color-text-primary);
+}
+
+.article {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: var(--space-32);
+  align-items: start;
+}
+
+.article-header {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-16);
+}
+
+.article-title {
+  max-width: var(--size-measure-heading);
+  font-size: clamp(var(--font-size-h3), 5vw, var(--font-size-h2));
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-tight);
+}
+
+.article-body {
+  min-width: 0;
+  max-width: var(--size-measure);
+  font-size: var(--font-size-body-lg);
+  line-height: var(--font-line-height-body);
+}
+
+.article-body > * + * {
+  margin-top: var(--space-24);
+}
+
+.article-body h2 {
+  margin-top: var(--space-48);
+  font-size: var(--font-size-h4);
+}
+
+.article-body h3 {
+  margin-top: var(--space-32);
+  font-size: var(--font-size-h5);
+  line-height: var(--font-line-height-title);
+}
+
+.article-body h2 + *,
+.article-body h3 + * {
+  margin-top: var(--space-16);
+}
+
+.body-quote {
+  margin-block: var(--space-48);
+}
+
+.body-quote blockquote p {
+  font-family: var(--font-family-serif);
+  font-size: clamp(var(--font-size-h4), 4vw, var(--font-size-plan));
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-tight);
+  text-wrap: balance;
+}
+
+.body-caption {
+  margin-top: var(--space-12);
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+  line-height: var(--font-line-height-title);
+  color: var(--color-text-tertiary);
+}
+
+.code-block {
+  overflow-x: auto;
+  padding: var(--space-16) var(--space-20);
+  border-radius: var(--radius-tile);
+  background: var(--color-surface-subtle);
+  color: var(--color-text-primary);
+  line-height: var(--font-line-height-body);
+}
+
+.body-list {
+  padding-left: var(--space-24);
+}
+
+.body-list li + li {
+  margin-top: var(--space-8);
+}
+
+.body-list li::marker {
+  color: var(--color-text-tertiary);
+  font-variant-numeric: tabular-nums;
+}
+
+.body-figure {
+  margin-block: var(--space-48);
+}
+
+/* Ghosted preview inside a figure stage: a raised card at 60% opacity with skeleton tiles, no text. */
+.ghost-card {
+  display: grid;
+  gap: var(--space-12);
+  width: 84%;
+  margin: 0 auto;
+  padding: var(--space-16);
+  opacity: 0.6;
+}
+
+.ghost-card--board {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+
+.ghost-card--pair {
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+
+.ghost-card--timeline {
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+}
+
+.ghost-tile {
+  display: flex;
+  flex-direction: column;
+  justify-content: flex-end;
+  gap: var(--space-6);
+  aspect-ratio: 4 / 3;
+  padding: var(--space-12);
+  border-radius: var(--radius-control);
+  background: var(--color-surface-subtle);
+}
+
+.ghost-card--pair .ghost-tile {
+  aspect-ratio: 3 / 2;
+}
+
+.ghost-bar {
+  display: block;
+  height: var(--space-6);
+  border-radius: var(--radius-full);
+  background: var(--color-border-default);
+}
+
+.ghost-bar--short {
+  width: 60%;
+}
+
+@media (max-width: 833px) {
+  .ghost-card {
+    gap: var(--space-8);
+    padding: var(--space-12);
+  }
+
+  .ghost-tile {
+    padding: var(--space-8);
+  }
+}
+
+/* Contents: beside the article from lg, a collapsed disclosure after the stage below it. */
+.toc-heading {
+  font-size: var(--font-size-h5);
+  line-height: var(--font-line-height-title);
+}
+
+.toc-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  font-size: var(--font-size-small);
+  line-height: var(--font-line-height-title);
+}
+
+.toc-item + .toc-item {
+  margin-top: var(--space-4);
+}
+
+.toc-item-nested {
+  padding-left: var(--space-16);
+}
+
+.toc-link {
+  display: block;
+  padding: var(--space-6) 0;
+  color: var(--color-text-secondary);
+  text-decoration: none;
+  transition: color var(--motion-duration-nav) var(--motion-easing-expo);
+}
+
+.toc-link:hover {
+  color: var(--color-text-primary);
+}
+
+.toc-toggle {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  width: 100%;
+  min-height: var(--size-touch);
+  padding: 0 var(--space-16);
+  border: 0;
+  border-radius: var(--radius-tile);
+  background: var(--color-surface-subtle);
+  font: inherit;
+  text-align: start;
+  cursor: pointer;
+}
+
+.toc-chevron {
+  width: var(--size-icon);
+  height: var(--size-icon);
+  fill: none;
+  stroke: var(--color-text-secondary);
+  stroke-width: 1.5;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  transition: transform var(--motion-duration-open) var(--motion-easing-quart);
+}
+
+.toc-toggle[aria-expanded='true'] .toc-chevron {
+  transform: rotate(180deg);
+}
+
+.toc-panel {
+  display: grid;
+  grid-template-rows: 0fr;
+  opacity: 0;
+  visibility: hidden;
+  transition:
+    grid-template-rows calc(var(--motion-duration-open) * 0.6) var(--motion-easing-quart),
+    opacity calc(var(--motion-duration-open) * 0.6) var(--motion-easing-quart),
+    visibility 0s linear calc(var(--motion-duration-open) * 0.6);
+}
+
+.toc.is-open .toc-panel {
+  grid-template-rows: 1fr;
+  opacity: 1;
+  visibility: visible;
+  transition:
+    grid-template-rows var(--motion-duration-open) var(--motion-easing-quart),
+    opacity var(--motion-duration-open) var(--motion-easing-quart),
+    visibility 0s;
+}
+
+.toc-panel > .toc-list {
+  overflow: hidden;
+  min-height: 0;
+}
+
+.toc.is-open:not(:has(.toc-toggle)) .toc-list {
+  margin-top: var(--space-12);
+  padding-left: var(--space-16);
+  border-left: var(--border-width-hairline) solid var(--color-border-default);
+}
+
+.toc:has(.toc-toggle) .toc-list {
+  padding: var(--space-8) var(--space-16) 0;
+}
+
+@media (min-width: 992px) {
+  .article {
+    grid-template-columns: minmax(0, 680px) minmax(0, var(--size-sidebar));
+    column-gap: var(--space-96);
+  }
+
+  .article-header,
+  .article-stage,
+  .article-body {
+    grid-column: 1;
+  }
+
+  .article-aside {
+    grid-column: 2;
+    grid-row: 1 / span 3;
+    position: sticky;
+    top: calc(var(--size-header) + var(--space-24));
+    padding-top: var(--space-8);
+  }
+}
+
+/* ---------- Newsletter ---------- */
+
+.newsletter .lede {
+  margin-top: var(--space-16);
+}
+
+.newsletter-form,
+.newsletter-done {
+  max-width: var(--size-form);
+  margin-top: var(--space-32);
+}
+
+.field-row {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-12);
+}
+
+@media (min-width: 834px) {
+  .field-row {
+    flex-direction: row;
+  }
+
+  .field-row .input {
+    flex: 1;
+  }
+}
+
+@media (max-width: 833px) {
+  .field-row .btn {
+    display: flex;
+    width: 100%;
+  }
+}
+
+.newsletter-done {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: var(--space-24);
+}
+
+.form-success {
+  display: flex;
+  align-items: flex-start;
+  gap: var(--space-8);
+  font-size: var(--font-size-ui);
+}
+
+.form-success .check-circle {
+  margin-top: 0.2em;
+}
+
+/* ---------- About ---------- */
+
+.prose {
+  max-width: var(--size-measure);
+}
+
+.prose > p + p {
+  margin-top: var(--space-16);
+}
+
+.author-list {
+  list-style: none;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: var(--space-24);
+  margin: var(--space-32) 0 0;
+  padding: 0;
+  align-items: stretch;
+}
+
+.author-list > li {
+  display: flex;
+  min-width: 0;
+}
+
+@media (min-width: 834px) {
+  .author-list {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (min-width: 992px) {
+  .author-list {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+@media (min-width: 1200px) {
+  .author-list {
+    gap: var(--space-32);
+  }
+}
+
+.author-card {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-16);
+  width: 100%;
+  padding: var(--space-32);
+}
+
+.author-card h3 {
+  font-size: var(--font-size-h5);
+  line-height: var(--font-line-height-title);
+}
+
+.author-role {
+  margin-top: var(--space-4);
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+  color: var(--color-text-tertiary);
+}
+
+.author-bio {
+  margin-top: var(--space-12);
+  font-size: var(--font-size-ui);
+  color: var(--color-text-secondary);
+}
+
+.avatar {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  flex: none;
+  width: var(--size-control);
+  height: var(--size-control);
+  border-radius: var(--radius-tile);
+  background: var(--stage);
+  font-family: var(--font-family-serif);
+  font-size: var(--font-size-h5);
+  font-weight: var(--font-weight-regular);
+  line-height: 1;
+  color: var(--color-text-primary);
+}
+
+@media (max-width: 833px) {
+  .author-card {
+    padding: var(--space-24);
+  }
+}
+
+/* ---------- Block rise (script adds is-rise-ready below the fold; removed at 15% in view) ---------- */
+
+[data-rise] {
+  transition:
+    opacity var(--motion-duration-rise) var(--motion-easing-settle) var(--rise-delay, 0ms),
+    transform var(--motion-duration-rise) var(--motion-easing-settle) var(--rise-delay, 0ms);
+}
+
+.is-rise-ready {
+  opacity: 0;
+  transform: translateY(var(--motion-distance-rise));
+}
+
+@media print {
+  .is-rise-ready {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+/* ---------- Reduced motion: every block, frame and heading final ---------- */
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: var(--motion-duration-instant) !important;
+    animation-delay: 0s !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: var(--motion-duration-instant) !important;
+    transition-delay: 0s !important;
+  }
+
+  .picto:is(.is-ready, .is-playing, .is-boiling) .cel-strip {
+    animation: none;
+    transform: translateX(calc((1 - var(--n)) * 120px));
+  }
+
+  .write-in .w {
+    opacity: 1;
+    transition: none;
+  }
+
+  .glyph path {
+    animation: none;
+    stroke-dashoffset: 0;
+  }
+
+  .dot-breathe {
+    animation: none;
+  }
+
+  .btn:active:not(:disabled) {
+    transform: none;
+  }
+
+  .is-rise-ready {
+    opacity: 1;
+    transform: none;
   }
 }
