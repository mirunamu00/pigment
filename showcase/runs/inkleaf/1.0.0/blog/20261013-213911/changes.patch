+import { useEffect, useId, useState } from 'react';
 import type { Block } from '../data/posts';
+import { ChevronIcon } from '../design/icons';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const WIDE_QUERY = '(min-width: 992px)';
+
+function useIsWide() {
+  const [isWide, setIsWide] = useState(() => window.matchMedia(WIDE_QUERY).matches);
+  useEffect(() => {
+    const query = window.matchMedia(WIDE_QUERY);
+    const update = () => setIsWide(query.matches);
+    query.addEventListener('change', update);
+    return () => query.removeEventListener('change', update);
+  }, []);
+  return isWide;
+}
+
+/** Contents beside the article from the lg breakpoint; below it, a collapsed "On this page" disclosure. */
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
+  const listId = useId();
+  const isWide = useIsWide();
+  const [open, setOpen] = useState(false);
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
   if (headings.length === 0) return null;
 
+  const expanded = isWide || open;
+
   return (
-    <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
+    <nav className={isWide ? 'toc' : 'toc toc--disclosure'} aria-labelledby="toc-heading" data-testid="toc">
       <h2 id="toc-heading" className="toc-heading">
-        On this page
+        {isWide ? (
+          'On this page'
+        ) : (
+          <button type="button" className="toc-toggle" aria-expanded={open} aria-controls={listId} onClick={() => setOpen(!open)}>
+            On this page
+            <ChevronIcon className="icon toc-chevron" />
+          </button>
+        )}
       </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      <div className={expanded ? 'toc-panel is-open' : 'toc-panel'} id={listId}>
+        <ol className="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
+                {heading.text}
+              </a>
+            </li>
+          ))}
+        </ol>
+      </div>
     </nav>
   );
 }
