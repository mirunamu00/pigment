+// Block rise runs on a route's first visit only.
+const visitedRoutes = new Set<string>();
+
+/**
+ * Blocks (.rise) below the fold start hidden and rise in when 15% enters view, once.
+ * Blocks already in view on load are never hidden; under reduced motion nothing is hidden.
+ */
+function useBlockRise(pathname: string) {
+  useEffect(() => {
+    if (visitedRoutes.has(pathname)) return;
+    visitedRoutes.add(pathname);
+    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+    const blocks = [...document.querySelectorAll<HTMLElement>('#main-content .rise')].filter(
+      (block) => block.getBoundingClientRect().top >= window.innerHeight,
+    );
+    if (!blocks.length) return;
+    blocks.forEach((block) => block.classList.add('is-rise-ready'));
+    const observer = new IntersectionObserver(
+      (entries) => {
+        let order = 0;
+        for (const entry of entries) {
+          if (!entry.isIntersecting) continue;
+          const block = entry.target as HTMLElement;
+          block.style.setProperty('--rise-order', String(Math.min(order, 3)));
+          block.classList.remove('is-rise-ready');
+          observer.unobserve(block);
+          order += 1;
+        }
+      },
+      { threshold: 0.15 },
+    );
+    blocks.forEach((block) => observer.observe(block));
+    return () => {
+      observer.disconnect();
+      blocks.forEach((block) => block.classList.remove('is-rise-ready'));
+    };
+  }, [pathname]);
+}
