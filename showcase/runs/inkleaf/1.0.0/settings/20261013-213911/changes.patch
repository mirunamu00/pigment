+/**
+ * Block rise on a route's first visit: blocks marked data-rise that start below the fold wait hidden and
+ * rise once 15% of them enters view. Blocks in view on load are never hidden.
+ */
+function useBlockRise(container: RefObject<HTMLElement | null>, path: string) {
+  const visited = useRef(new Set<string>());
+  useEffect(() => {
+    const root = container.current;
+    if (!root || visited.current.has(path) || prefersReducedMotion()) return;
+    visited.current.add(path);
+    const pending = Array.from(root.querySelectorAll<HTMLElement>('[data-rise]')).filter(
+      (block) => block.getBoundingClientRect().top > window.innerHeight,
+    );
+    pending.forEach((block) => block.classList.add('is-rise-ready'));
+    const observer = new IntersectionObserver(
+      (entries) => {
+        let order = 0;
+        for (const entry of entries) {
+          if (!entry.isIntersecting) continue;
+          const block = entry.target as HTMLElement;
+          block.style.setProperty('--rise-i', String(Math.min(order, 3)));
+          block.classList.remove('is-rise-ready');
+          observer.unobserve(block);
+          order += 1;
+        }
+      },
+      { threshold: 0.15 },
+    );
+    pending.forEach((block) => observer.observe(block));
+    return () => {
+      observer.disconnect();
+      pending.forEach((block) => block.classList.remove('is-rise-ready'));
+    };
+  }, [container, path]);
+}
