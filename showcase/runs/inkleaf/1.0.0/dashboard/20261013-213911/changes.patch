+  box-shadow: inset 0 calc(-1 * var(--border-width-hairline)) 0 var(--color-border-default);
+  animation: header-in var(--motion-duration-reveal) var(--motion-easing-settle) both;
+}
+
+@keyframes header-in {
+  from {
+    opacity: 0;
+    transform: translateY(calc(-1 * var(--motion-distance-rise)));
+  }
+}
+
+.nav-toggle {
+  grid-area: toggle;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: var(--size-touch);
+  height: var(--size-touch);
+  margin-left: calc(-1 * var(--space-12));
+  padding: 0;
+  border: 0;
+  border-radius: var(--radius-control);
+  background: transparent;
+  color: var(--color-text-primary);
+  cursor: pointer;
+  transition: background-color var(--motion-duration-press) var(--motion-easing-hover);
+}
+
+.nav-toggle:hover {
+  background: var(--color-surface-subtle);
+}
+
+.nav-toggle .icon {
+  width: var(--size-icon-lg);
+  height: var(--size-icon-lg);
+}
+
+.brand {
+  grid-area: brand;
+  font-family: var(--font-family-serif);
+  font-size: var(--font-size-h5);
+  font-weight: var(--font-weight-medium);
+  line-height: var(--font-line-height-title);
+  white-space: nowrap;
+}
+
+.topbar-search {
+  grid-area: search;
+  display: flex;
+  align-items: center;
+  gap: var(--space-8);
+  width: 100%;
+  max-width: var(--size-dialog);
+  min-width: 0;
+}
+
+.user-menu {
+  grid-area: user;
+  position: relative;
+  justify-self: end;
+}
+
+.account-button {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-8);
+  height: var(--size-touch);
+  padding: 0 var(--space-8) 0 var(--space-6);
+  border: 0;
+  border-radius: var(--radius-control);
+  background: transparent;
+  color: var(--color-text-secondary);
+  font-size: var(--font-size-ui);
+  cursor: pointer;
+  transition:
+    color var(--motion-duration-press) var(--motion-easing-hover),
+    background-color var(--motion-duration-press) var(--motion-easing-hover);
+}
+
+.account-button:hover,
+.account-button[aria-expanded='true'] {
+  color: var(--color-text-primary);
+  background: var(--color-surface-subtle);
+}
+
+/* Menu (account) */
+.menu {
+  position: absolute;
+  right: 0;
+  top: calc(100% + var(--space-6));
+  z-index: 25;
+  min-width: var(--size-sidebar);
+  padding: var(--space-6);
+  border-radius: var(--radius-tile);
+  background: var(--color-surface-raised);
+  box-shadow: var(--shadow-overlay);
+  animation: menu-in var(--motion-duration-open) var(--motion-easing-quart) both;
+}
+
+@keyframes menu-in {
+  from {
+    opacity: 0;
+    transform: translateY(-4px);
+  }
+}
+
+.menu-header {
+  padding: var(--space-8) var(--space-12) var(--space-6);
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+  color: var(--color-text-tertiary);
+}
+
+.menu-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.menu-item {
+  display: flex;
+  align-items: center;
+  width: 100%;
+  height: var(--size-control);
+  padding: 0 var(--space-12);
+  border: 0;
+  border-radius: var(--radius-control);
+  background: transparent;
+  color: var(--color-text-primary);
+  font: inherit;
+  font-size: var(--font-size-ui);
+  text-align: start;
+  text-decoration: none;
+  cursor: pointer;
+}
+
+.menu-item:hover {
+  background: var(--color-surface-subtle);
+}
+
+.menu-item:focus-visible {
+  outline-offset: -2px;
+}
+
+.menu-separated {
+  margin-top: var(--space-6);
+  padding-top: var(--space-6);
+  box-shadow: inset 0 var(--border-width-hairline) 0 var(--color-border-default);
+}
+
+/* Shell body: sidebar from lg, otherwise a sheet opened from the header. */
+.shell-body {
+  position: relative;
+  flex: 1;
+  display: flex;
+  min-width: 0;
+}
+
+.sidebar {
+  display: none;
+}
+
+.sidebar.is-open {
+  display: block;
+  position: absolute;
+  inset: 0 0 auto;
+  z-index: 15;
+  padding: var(--space-8) clamp(var(--space-20), 4vw, var(--space-64)) var(--space-16);
+  background: var(--color-surface-raised);
+  box-shadow: var(--shadow-overlay);
+  animation: menu-in var(--motion-duration-open) var(--motion-easing-quart) both;
+}
+
+.nav-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.sidebar.is-open .nav-list li + li {
+  box-shadow: inset 0 var(--border-width-hairline) 0 var(--color-border-default);
+}
+
+.nav-link {
+  display: flex;
+  align-items: center;
+  gap: var(--space-12);
+  min-height: var(--size-touch);
+  padding: 0 var(--space-12);
+  border-radius: var(--radius-control);
+  color: var(--color-text-secondary);
+  font-size: var(--font-size-ui);
+  text-decoration: none;
+  transition:
+    color var(--motion-duration-nav) var(--motion-easing-expo),
+    background-color var(--motion-duration-press) var(--motion-easing-hover);
+}
+
+.nav-link:hover {
+  color: var(--color-text-primary);
+}
+
+.nav-link.active {
+  color: var(--color-text-primary);
+  font-weight: var(--font-weight-medium);
+}
+
+.content {
+  flex: 1;
+  min-width: 0;
+  width: 100%;
+  max-width: var(--size-container);
+  margin: 0 auto;
+  padding: 0 clamp(var(--space-20), 4vw, var(--space-64)) var(--space-96);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-24);
+}
+
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme='light']) .menu,
+  :root:not([data-theme='light']) .sidebar.is-open {
+    box-shadow:
+      var(--shadow-overlay-night),
+      0 0 0 var(--border-width-hairline) var(--color-border-default);
+  }
+}
+
+:root[data-theme='dark'] .menu,
+:root[data-theme='dark'] .sidebar.is-open {
+  box-shadow:
+    var(--shadow-overlay-night),
+    0 0 0 var(--border-width-hairline) var(--color-border-default);
+}
+
+@media (min-width: 992px) {
+  .topbar {
+    grid-template-columns: calc(var(--size-sidebar) - var(--space-16) - var(--space-12)) minmax(0, 1fr) auto;
+    grid-template-areas: 'brand search user';
+    padding-left: calc(var(--space-16) + var(--space-12));
+  }
+
+  .nav-toggle {
+    display: none;
+  }
+
+  .topbar-search {
+    padding-left: clamp(var(--space-20), 4vw, var(--space-64));
+    max-width: calc(var(--size-dialog) + clamp(var(--space-20), 4vw, var(--space-64)));
+  }
+
+  .sidebar {
+    display: block;
+    position: sticky;
+    top: var(--size-header);
+    align-self: flex-start;
+    flex: none;
+    width: var(--size-sidebar);
+    height: calc(100vh - var(--size-header));
+    padding: var(--space-16);
+    box-shadow: inset calc(-1 * var(--border-width-hairline)) 0 0 var(--color-border-default);
+  }
+
+  .nav-list {
+    display: grid;
+    gap: var(--space-4);
+  }
+
+  .nav-link {
+    min-height: var(--size-control);
+  }
+
+  .nav-link:hover {
+    background: var(--color-surface-hover);
+  }
+
+  .nav-link.active {
+    background: var(--color-surface-subtle);
+  }
+}
+
+@media (min-width: 1200px) {
+  .content {
+    gap: var(--space-24);
+  }
+}
+
+@media (max-width: 833px) {
+  .topbar {
+    grid-template-columns: auto minmax(0, 1fr) auto;
+    grid-template-areas:
+      'toggle brand user'
+      'search search search';
+    row-gap: 0;
+    padding-bottom: var(--space-12);
+  }
+
+  .topbar > .nav-toggle,
+  .topbar > .brand,
+  .topbar > .user-menu {
+    min-height: calc(var(--size-header) - var(--space-12));
+    display: inline-flex;
+    align-items: center;
+  }
+
+  .topbar-search {
+    max-width: none;
+  }
+
+  .account-name {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+  }
+
+  .account-button {
+    padding: 0 var(--space-6);
+  }
+}
+
+/* ---------- Motion: block rise, lede rise, content swap ---------- */
+[data-rise] {
+  transition:
+    opacity var(--motion-duration-rise) var(--motion-easing-settle),
+    translate var(--motion-duration-rise) var(--motion-easing-settle);
+  transition-delay: calc(var(--rise-i, 0) * 100ms);
+}
+
+[data-rise].is-rise-ready {
+  opacity: 0;
+  translate: 0 var(--motion-distance-rise);
+}
+
+@keyframes rise-sm {
+  from {
+    opacity: 0;
+    transform: translateY(var(--motion-distance-rise-sm));
+  }
+}
+
+@keyframes swap-in {
+  from {
+    opacity: 0;
+    transform: translateY(var(--motion-distance-raise));
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: var(--motion-duration-instant) !important;
+    animation-delay: 0s !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: var(--motion-duration-instant) !important;
+    transition-delay: 0s !important;
+  }
+}
+
+/* ---------- Product screen header ---------- */
+.page-header {
+  display: grid;
+  grid-template-columns: var(--size-picto-sm) minmax(0, 1fr) auto;
+  align-items: center;
+  column-gap: var(--space-16);
+  padding: var(--space-48) 0 var(--space-32);
+  margin-bottom: calc(-1 * var(--space-24));
+}
+
+.page-header h1 {
+  font-size: var(--font-size-h3);
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-heading);
+}
+
+.page-header-actions {
+  display: flex;
+  align-items: center;
+  gap: var(--space-12);
+  animation: rise-sm var(--motion-duration-rise) var(--motion-easing-settle) 200ms both;
+}
+
+.page-lede {
+  grid-column: 1 / -1;
+  margin-top: var(--space-8);
+  max-width: var(--size-measure);
+  font-size: var(--font-size-body);
+  color: var(--color-text-secondary);
+  animation: rise-sm var(--motion-duration-rise) var(--motion-easing-settle) 200ms both;
+}
+
+.breadcrumb {
+  padding-top: var(--space-32);
+}
+
+/* breadcrumb sits space.16 above the header (content gap 24 - 8) */
+.breadcrumb + .page-header {
+  padding-top: 0;
+  margin-top: calc(var(--space-16) - var(--space-24));
+}
+
+.breadcrumb ol {
+  list-style: none;
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-8);
+  margin: 0;
+  padding: 0;
+  font-size: var(--font-size-small);
+  color: var(--color-text-secondary);
+}
+
+.breadcrumb a {
+  color: var(--color-text-secondary);
+}
+
+.breadcrumb li + li::before {
+  content: '/';
+  margin-right: var(--space-8);
+  color: var(--color-text-tertiary);
+}
+
+@media (max-width: 833px) {
+  .page-header {
+    grid-template-columns: minmax(0, 1fr) auto;
+    row-gap: var(--space-16);
+  }
+
+  .page-header-picto {
+    grid-column: 1 / -1;
+  }
+
+  .page-header h1 {
+    font-size: var(--font-size-h4);
+  }
+}
+
+/* ---------- Cards and panels ---------- */
+.card,
+.panel {
+  min-width: 0;
+  padding: var(--space-24);
+  border-radius: var(--radius-card);
+  background: var(--color-surface-raised);
+  box-shadow: inset 0 0 0 var(--border-width-hairline) var(--color-border-default);
+}
+
+.panel > h2,
+.panel-header h2 {
+  font-size: var(--font-size-h4);
+  font-weight: var(--font-weight-medium);
+  line-height: var(--font-line-height-heading);
+}
+
+.panel > h2 {
+  margin-bottom: var(--space-16);
+}
+
+.panel--table {
+  padding: 0;
+  overflow: hidden;
+}
+
+.panel-header {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  align-items: baseline;
+  gap: var(--space-8) var(--space-16);
+  padding: var(--space-24) var(--space-24) 0;
+}
+
+.panel-header h2 {
+  font-size: var(--font-size-h5);
+}
+
+.panel-count {
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+  color: var(--color-text-tertiary);
+}
+
+.panel-row {
+  display: grid;
+  grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
+  align-items: stretch;
+  gap: var(--space-24);
+}
+
+.panel-row > .stage > .stage-content {
+  height: 100%;
+}
+
+.panel--chart {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+}
+
+@media (min-width: 1200px) {
+  .panel-row {
+    gap: var(--space-32);
+  }
+}
+
+@media (max-width: 991px) {
+  .panel-row {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+/* KPI stat cards */
+.kpi-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: var(--space-24);
+}
+
+.kpi-card {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-8);
+}
+
+.kpi-label {
+  max-width: none;
+  font-family: var(--font-family-sans);
+  font-size: var(--font-size-small);
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-title);
+  color: var(--color-text-secondary);
+}
+
+.kpi-value {
+  font-size: var(--font-size-h3);
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-tight);
+  font-variant-numeric: tabular-nums;
+}
+
+.kpi-change {
+  margin-top: auto;
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+  font-variant-numeric: tabular-nums;
+  color: var(--color-text-secondary);
+}
+
+.kpi-change--good {
+  color: var(--color-status-success);
+}
+
+.kpi-change--bad {
+  color: var(--color-status-danger);
+}
+
+@media (max-width: 833px) {
+  .kpi-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: var(--space-16);
+  }
+
+  .kpi-card {
+    padding: var(--space-16);
+  }
+
+  .kpi-value {
+    font-size: var(--font-size-h4);
+  }
+}
+
+/* ---------- Chart ---------- */
+.chart {
+  display: flex;
+  flex-direction: column;
+  flex: 1;
+  margin: 0;
+  min-width: 0;
+}
+
+.chart-title {
+  margin-bottom: var(--space-12);
+  font-size: var(--font-size-small);
+  color: var(--color-text-secondary);
+}
+
+.chart-plot {
+  position: relative;
+  flex: 1;
+  min-height: 240px;
+}
+
+.chart-svg {
+  position: absolute;
+  inset: 0;
+  display: block;
+  width: 100%;
+  height: 100%;
+}
+
+.chart-grid {
+  stroke: var(--color-border-default);
+  stroke-width: 1;
+  shape-rendering: crispEdges;
+}
+
+.chart-bar {
+  fill: var(--color-chart-rest);
+}
+
+.is-current .chart-bar {
+  fill: var(--color-chart-ink);
+}
+
+.chart-value,
+.chart-label {
+  font-family: var(--font-family-sans);
+  font-size: var(--font-size-caption);
+  font-variant-numeric: tabular-nums;
+  fill: var(--color-text-tertiary);
+}
+
+.is-current .chart-value {
+  fill: var(--color-text-primary);
+  font-weight: var(--font-weight-medium);
+}
+
+/* ---------- Activity ---------- */
+.activity-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.activity-item {
+  padding: var(--space-12) 0;
+  font-size: var(--font-size-ui);
+  line-height: var(--font-line-height-lede);
+  color: var(--color-text-secondary);
+}
+
+.activity-item + .activity-item {
+  box-shadow: inset 0 var(--border-width-hairline) 0 var(--color-border-default);
+}
+
+.activity-item:first-child {
+  padding-top: 0;
+}
+
+.activity-item strong {
+  color: var(--color-text-primary);
+}
+
+.activity-time {
+  margin-top: var(--space-4);
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+  color: var(--color-text-tertiary);
+}
+
+/* ---------- Toolbar and table ---------- */
+.toolbar {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  align-items: center;
+  gap: var(--space-12);
+  padding: var(--space-16) var(--space-24) var(--space-24);
+}
+
+.toolbar-end {
+  display: flex;
+  align-items: center;
+  gap: var(--space-12);
+  min-width: 0;
+}
+
+.field-inline {
+  display: flex;
+  align-items: center;
+  min-width: 0;
+  width: calc(var(--size-sidebar) + var(--space-40));
+  max-width: 100%;
+}
+
+.sort-select {
+  display: none;
+}
+
+.table-wrap {
+  min-width: 0;
+}
+
+.table-scroll {
+  overflow-x: auto;
+}
+
+.table-scroll:focus-visible {
+  outline-offset: -2px;
+}
+
+.table {
+  width: 100%;
+  border-collapse: collapse;
+  table-layout: fixed;
+  font-size: var(--font-size-dense);
+  line-height: var(--font-line-height-title);
+}
+
+.table th,
+.table td {
+  height: var(--size-row-dense);
+  padding: 0 var(--space-16);
+  text-align: start;
+  vertical-align: middle;
+  color: var(--color-text-secondary);
+  box-shadow: inset 0 calc(-1 * var(--border-width-hairline)) 0 var(--color-border-default);
+}
+
+.table th:first-child,
+.table td:first-child {
+  padding-left: var(--space-24);
+}
+
+.table th:last-child,
+.table td:last-child {
+  padding-right: var(--space-24);
+}
+
+.table td:first-child {
+  color: var(--color-text-primary);
+}
+
+.table tbody tr:last-child td {
+  box-shadow: none;
+}
+
+.table td {
+  padding-top: var(--space-8);
+  padding-bottom: var(--space-8);
+}
+
+.table th {
+  font-size: var(--font-size-micro);
+  font-weight: var(--font-weight-medium);
+  letter-spacing: var(--font-tracking-micro);
+  text-transform: uppercase;
+  color: var(--color-text-tertiary);
+  box-shadow:
+    inset 0 var(--border-width-hairline) 0 var(--color-border-default),
+    inset 0 calc(-1 * var(--border-width-hairline)) 0 var(--color-border-default);
+}
+
+.table .numeric {
+  text-align: right;
+  font-variant-numeric: tabular-nums;
+}
+
+.table tbody tr {
+  transition: background-color var(--motion-duration-press) var(--motion-easing-hover);
+}
+
+.table tbody tr:hover {
+  background: var(--color-surface-subtle);
+}
+
+.table tr:focus-visible {
+  outline-offset: -2px;
+}
+
+.sort-button {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-4);
+  height: var(--size-row-dense);
+  padding: 0;
+  border: 0;
+  background: none;
+  color: inherit;
+  font: inherit;
+  letter-spacing: inherit;
+  text-transform: inherit;
+  cursor: pointer;
+}
+
+.sort-button:hover,
+.sort-button.is-sorted {
+  color: var(--color-text-primary);
+}
+
+.numeric .sort-button {
+  flex-direction: row-reverse;
+}
+
+.sort-indicator {
+  display: inline-flex;
+  width: 12px;
+}
+
+.sort-arrow {
+  width: 12px;
+  height: 12px;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.5;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+
+.row-link {
+  font-weight: var(--font-weight-medium);
+  text-decoration: none;
+}
+
+.row-link:hover {
+  text-decoration-line: underline;
+}
+
+.cell-meta {
+  display: block;
+  margin-top: var(--space-4);
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+  color: var(--color-text-tertiary);
+}
+
+a.cell-meta {
+  text-decoration-color: var(--color-border-control);
+}
+
+/* Column widths */
+.table--stack th:nth-child(1) {
+  width: 30%;
+}
+
+.table--stack th:nth-child(3) {
+  width: 15%;
+}
+
+.table--team {
+  min-width: var(--size-form);
+}
+
+.table--team th:nth-child(1) {
+  width: 38%;
+}
+
+.table--team th:nth-child(4) {
+  width: 18%;
+}
+
+.table--files {
+  min-width: var(--size-dialog);
+}
+
+.person {
+  display: flex;
+  align-items: center;
+  gap: var(--space-12);
+  min-width: 0;
+}
+
+.person-text {
+  min-width: 0;
+}
+
+.person-name {
+  font-weight: var(--font-weight-medium);
+}
+
+.person-text .cell-meta {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+@media (max-width: 833px) {
+  .toolbar {
+    padding: var(--space-16);
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .toolbar-end {
+    flex-direction: column;
+    align-items: stretch;
+  }
+
+  .field-inline {
+    width: 100%;
+  }
+
+  .panel-header {
+    padding: var(--space-16) var(--space-16) 0;
+  }
+
+  .sort-select {
+    display: flex;
+    align-items: center;
+    gap: var(--space-12);
+    font-size: var(--font-size-ui);
+    font-weight: var(--font-weight-medium);
+    white-space: nowrap;
+  }
+
+  /* Tables with status or actions stack and hide their header row. */
+  .table--stack thead {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+  }
+
+  .table--stack,
+  .table--stack tbody,
+  .table--stack tr,
+  .table--stack td {
+    display: block;
+    width: 100%;
+  }
+
+  .table--stack tr {
+    padding: var(--space-12) var(--space-16);
+    box-shadow: inset 0 var(--border-width-hairline) 0 var(--color-border-default);
+  }
+
+  .table.table--stack td,
+  .table.table--stack td:first-child,
+  .table.table--stack td:last-child {
+    display: grid;
+    grid-template-columns: minmax(96px, 38%) minmax(0, 1fr);
+    align-items: center;
+    gap: var(--space-12);
+    height: auto;
+    min-height: var(--size-control-sm);
+    padding: var(--space-4) 0;
+    box-shadow: none;
+  }
+
+  .table--stack td::before {
+    content: attr(data-label);
+    font-size: var(--font-size-caption);
+    letter-spacing: var(--font-tracking-caption);
+    color: var(--color-text-tertiary);
+  }
+
+  .table--stack .numeric {
+    text-align: start;
+  }
+
+  .table--stack td > .badge {
+    justify-self: start;
+  }
+
+  .table th:first-child,
+  .table td:first-child {
+    padding-left: var(--space-16);
+  }
+
+  .table th:last-child,
+  .table td:last-child {
+    padding-right: var(--space-16);
+  }
+}
+
+/* ---------- Empty state, not found ---------- */
+.empty-state {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  text-align: center;
+  max-width: var(--size-dialog);
+  margin: 0 auto;
+  padding: var(--space-64) var(--space-24);
+}
+
+.panel.empty-state {
+  max-width: none;
+  margin: 0;
+}
+
+.empty-state > .picto {
+  margin-bottom: var(--space-24);
+}
+
+.empty-state > h2,
+.empty-state > h3 {
+  font-size: var(--font-size-h4);
+  font-weight: var(--font-weight-medium);
+  margin-bottom: var(--space-8);
+}
+
+.empty-state > p {
+  max-width: var(--size-measure);
+  font-size: var(--font-size-ui);
+}
+
+.empty-state > .btn {
+  margin-top: var(--space-24);
+}
+
+.empty-state--error {
+  max-width: none;
+  padding-top: var(--space-64);
+}
+
+.empty-state--error h1 {
+  font-size: var(--font-size-h3);
+  font-weight: var(--font-weight-regular);
+  margin: var(--space-32) 0 var(--space-8);
+}
+
+.not-found-stage {
+  width: calc(var(--size-picto-xl) / 0.8);
+  padding: 0;
+  border-radius: var(--radius-card);
+}
+
+.not-found-stage .picto {
+  width: var(--size-picto-xl);
+}
+
+.empty-actions {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: var(--space-12);
+  margin-top: var(--space-24);
+}
+
+@media (max-width: 833px) {
+  .empty-actions {
+    flex-direction: column;
+    align-self: stretch;
+  }
+
+  .empty-actions .btn {
+    display: flex;
+    width: 100%;
+  }
+
+  .empty-state--error h1 {
+    font-size: var(--font-size-h4);
+  }
+}
+
+/* ---------- Project detail ---------- */
+.tabs {
+  display: flex;
+  gap: var(--space-24);
+  overflow-x: auto;
+  box-shadow: inset 0 calc(-1 * var(--border-width-hairline)) 0 var(--color-border-default);
+}
+
+.tab {
+  position: relative;
+  height: var(--size-control);
+  padding: 0;
+  border: 0;
+  background: none;
+  color: var(--color-text-secondary);
+  font-size: var(--font-size-ui);
+  cursor: pointer;
+  white-space: nowrap;
+  transition: color var(--motion-duration-nav) var(--motion-easing-expo);
+}
+
+.tab:hover {
+  color: var(--color-text-primary);
+}
+
+.tab[aria-selected='true'] {
+  color: var(--color-text-primary);
+  font-weight: var(--font-weight-medium);
+  box-shadow: inset 0 calc(-1 * var(--border-width-ring)) 0 var(--color-action-primary);
+}
+
+.tab:focus-visible {
+  outline-offset: -2px;
+}
+
+.tab-panel {
+  animation: swap-in var(--motion-duration-raise) var(--motion-easing-settle) both;
+}
+
+.panel-prose {
+  max-width: var(--size-measure);
+  color: var(--color-text-primary);
+}
+
+.details {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: var(--space-24);
+  margin: var(--space-24) 0 0;
+  padding-top: var(--space-24);
+  box-shadow: inset 0 var(--border-width-hairline) 0 var(--color-border-default);
+}
+
+.details dt {
+  font-size: var(--font-size-small);
+  color: var(--color-text-secondary);
+}
+
+.details dd {
+  margin: var(--space-4) 0 0;
+  font-size: var(--font-size-body);
+  font-variant-numeric: tabular-nums;
+}
+
+.progress-row {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: var(--space-16);
+  font-size: var(--font-size-ui);
+}
+
+.progress {
+  appearance: none;
+  flex: 1;
+  max-width: var(--size-sidebar);
+  height: var(--space-6);
+  border: 0;
+  border-radius: var(--radius-full);
+  overflow: hidden;
+  background: var(--color-surface-subtle);
+  color: var(--color-action-primary);
+}
+
+.progress::-webkit-progress-bar {
+  background: var(--color-surface-subtle);
+}
+
+.progress::-webkit-progress-value {
+  background: var(--color-action-primary);
+  border-radius: var(--radius-full);
+}
+
+.progress::-moz-progress-bar {
+  background: var(--color-action-primary);
+  border-radius: var(--radius-full);
+}
+
+.task-list {
+  list-style: none;
+  margin: var(--space-16) 0 0;
+  padding: 0;
+}
+
+.task {
+  display: flex;
+  align-items: center;
+  gap: var(--space-8) var(--space-12);
+  min-height: var(--size-touch);
+  padding: var(--space-8) 0;
+  font-size: var(--font-size-ui);
+  box-shadow: inset 0 var(--border-width-hairline) 0 var(--color-border-default);
+}
+
+.task label {
+  flex: 1;
+  min-width: 0;
+  cursor: pointer;
+}
+
+.task-assignee {
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+  color: var(--color-text-tertiary);
+  white-space: nowrap;
+}
+
+.task-done label {
+  text-decoration: line-through;
+  text-decoration-color: var(--color-border-strong);
+  color: var(--color-text-secondary);
+}
+
+@media (max-width: 833px) {
+  .details {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .task {
+    flex-wrap: wrap;
   }
 
-  .two-column {
-    grid-template-columns: 1fr;
+  .task-assignee {
+    flex-basis: 100%;
+    padding-left: calc(var(--size-icon-lg) + var(--space-12));
   }
 }
