+  .form-actions .btn {
+    display: flex;
+    width: 100%;
+  }
+}
+
+.avatar-row {
+  display: flex;
+  align-items: center;
+  gap: var(--space-24);
+}
+
+.avatar-row-text {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: var(--space-4);
+  min-width: 0;
+}
+
+.avatar-row-text .btn {
+  margin-top: var(--space-8);
+}
+
+/* Password strength: words in secondary, the level as a status dot. */
+.strength {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-6);
+}
+
+.strength::before {
+  content: '';
+  width: var(--space-6);
+  height: var(--space-6);
+  border-radius: var(--radius-full);
+  background: var(--color-border-strong);
+}
+
+.strength-weak::before {
+  background: var(--color-status-danger);
+}
+
+.strength-fair::before {
+  background: var(--color-status-warning);
+}
+
+.strength-strong::before {
+  background: var(--color-status-success);
+}
+
+/* ---------- Fieldsets and switches ---------- */
+.fieldset {
+  margin-inline: 0;
+  margin-bottom: 0;
+  border: 0;
+}
+
+.legend {
+  float: left;
+  width: 100%;
+  padding: 0;
+  font-family: var(--font-family-serif);
+  font-size: var(--font-size-h4);
+  font-weight: var(--font-weight-medium);
+  line-height: var(--font-line-height-heading);
+}
+
+.legend + * {
+  clear: both;
+}
+
+.group-description {
+  padding-top: var(--space-4);
+  margin-bottom: var(--space-8);
+}
+
+.switch-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.switch-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-16);
+  min-height: var(--size-touch);
+  padding: var(--space-12) 0;
+  border-bottom: var(--border-width-hairline) solid var(--color-border-default);
+}
+
+.switch-row:last-child {
+  border-bottom: 0;
+  padding-bottom: 0;
+}
+
+.switch-text {
+  display: grid;
+  gap: var(--space-4);
+  min-width: 0;
+}
+
+.switch-text label {
+  cursor: pointer;
+}
+
+.switch-control {
+  position: relative;
+  display: inline-flex;
+  flex-shrink: 0;
+}
+
+.switch {
+  appearance: none;
+  width: var(--size-control);
+  height: var(--space-24);
+  margin: 0;
+  border-radius: var(--radius-full);
+  background: var(--color-surface-subtle);
+  box-shadow: inset 0 0 0 var(--border-width-hairline) var(--color-border-check);
+  cursor: pointer;
+  transition:
+    box-shadow var(--motion-duration-hover) var(--motion-easing-hover),
+    background-color var(--motion-duration-press) var(--motion-easing-hover);
+}
+
+.switch:hover {
+  box-shadow: inset 0 0 0 var(--border-width-hairline) var(--color-text-primary);
+}
+
+.switch:checked {
+  background: var(--color-action-primary);
+  box-shadow: inset 0 0 0 var(--border-width-hairline) var(--color-action-primary);
+}
+
+.switch:disabled {
+  box-shadow: inset 0 0 0 var(--border-width-hairline) var(--color-border-default);
+  cursor: not-allowed;
+}
+
+.switch-thumb {
+  position: absolute;
+  top: var(--space-4);
+  left: var(--space-4);
+  width: var(--space-16);
+  height: var(--space-16);
+  border-radius: var(--radius-full);
+  background: var(--color-surface-raised);
+  box-shadow: inset 0 0 0 var(--border-width-hairline) var(--color-border-control);
+  pointer-events: none;
+  transition:
+    transform var(--motion-duration-hover) var(--motion-easing-settle),
+    background-color var(--motion-duration-hover) var(--motion-easing-settle);
+}
+
+.switch:checked + .switch-thumb {
+  transform: translateX(var(--space-16));
+  background: var(--color-text-on-action);
+  box-shadow: none;
+}
+
+/* ---------- Tables ---------- */
+.table-card {
+  overflow: hidden;
+}
+
+.table-wrap {
+  margin: var(--space-16) calc(var(--border-width-hairline) - var(--space-24)) 0;
+}
+
+.table {
+  width: 100%;
+  border-collapse: collapse;
+  table-layout: fixed;
+  font-size: var(--font-size-dense);
+  line-height: var(--font-line-height-title);
+}
+
+.table th,
+.table td {
+  height: var(--size-row-dense);
+  padding: 0 var(--space-16);
+  text-align: start;
+  vertical-align: middle;
+  border-bottom: var(--border-width-hairline) solid var(--color-border-default);
+}
+
+.table th:first-child,
+.table td:first-child {
+  padding-left: calc(var(--space-24) - var(--border-width-hairline));
+}
+
+.table th:last-child,
+.table td:last-child {
+  padding-right: calc(var(--space-24) - var(--border-width-hairline));
+}
+
+.table th {
+  font-size: var(--font-size-micro);
+  font-weight: var(--font-weight-medium);
+  letter-spacing: var(--font-tracking-micro);
+  text-transform: uppercase;
+  color: var(--color-text-tertiary);
+}
+
+.table td {
+  color: var(--color-text-secondary);
+}
+
+.table td:first-child {
+  color: var(--color-text-primary);
+}
+
+.table tbody tr:last-child td {
+  border-bottom: 0;
+}
+
+.table tbody tr:hover {
+  background: var(--color-surface-subtle);
+}
+
+.table .numeric {
+  text-align: right;
+  font-variant-numeric: tabular-nums;
+}
+
+.table .cell-actions {
+  text-align: right;
+}
+
+.table .col-location {
+  width: 24%;
+}
+
+.table .col-date {
+  width: 20%;
+}
+
+.table .col-actions {
+  width: calc(var(--size-control) * 3);
+}
+
+.table .col-status {
+  width: 22%;
+}
+
+.table td .badge {
+  margin-left: var(--space-8);
+}
+
+.table td[data-label='Status'] .badge {
+  margin-left: 0;
+}
+
+.table-note {
+  margin-top: var(--space-16);
+}
+
+.table-note:empty {
+  margin-top: 0;
+}
+
+@media (max-width: 833px) {
+  .table--stack thead {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+  }
+
+  .table--stack,
+  .table--stack tbody,
+  .table--stack tr,
+  .table--stack td {
+    display: block;
+  }
+
+  .table--stack tr {
+    padding: var(--space-12) calc(var(--space-24) - var(--border-width-hairline));
+    border-bottom: var(--border-width-hairline) solid var(--color-border-default);
+  }
+
+  .table--stack tbody tr:last-child {
+    border-bottom: 0;
+  }
+
+  .table--stack td,
+  .table--stack td:first-child,
+  .table--stack td:last-child {
+    display: grid;
+    grid-template-columns: minmax(var(--space-96), 38%) minmax(0, 1fr);
+    align-items: center;
+    gap: var(--space-12);
+    height: auto;
+    min-height: var(--size-control-sm);
+    padding: var(--space-4) 0;
+    border: 0;
+    text-align: start;
+  }
+
+  .table--stack td::before {
+    content: attr(data-label);
+    font-size: var(--font-size-caption);
+    letter-spacing: var(--font-tracking-caption);
+    color: var(--color-text-tertiary);
+  }
+
+  .table--stack td:empty {
+    display: none;
+  }
+
+  .table--stack .numeric,
+  .table--stack .cell-actions {
+    text-align: start;
+  }
+
+  .table--stack td > * {
+    justify-self: start;
+  }
+
+  .table--stack td .badge {
+    margin-left: 0;
+  }
+
+  .table--stack td:first-child > span {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: var(--space-8);
+  }
+}
+
+/* ---------- Badges ---------- */
+.badge {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-6);
+  height: var(--space-24);
+  margin: 0;
+  padding: 0 var(--space-8);
+  border-radius: var(--radius-badge);
+  font-size: var(--font-size-caption);
+  font-weight: var(--font-weight-medium);
+  line-height: 1;
+  white-space: nowrap;
+  vertical-align: middle;
+}
+
+.badge--outline,
+.badge--status {
+  box-shadow: inset 0 0 0 var(--border-width-hairline) var(--color-border-control);
+  color: var(--color-text-secondary);
+}
+
+.badge--stone {
+  background: var(--color-action-tertiary);
+  color: var(--color-text-primary);
+}
+
+.badge-dot {
+  width: var(--space-6);
+  height: var(--space-6);
+  border-radius: var(--radius-full);
+  background: currentColor;
+}
+
+.badge--success {
+  color: var(--color-status-success);
+}
+
+.badge--warning {
+  color: var(--color-status-warning);
+}
+
+/* ---------- Billing ---------- */
+.plans-section {
+  display: grid;
+  gap: var(--space-16);
+}
+
+.plan-grid {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: var(--space-24);
+}
+
+@media (min-width: 834px) {
   .plan-grid {
-    grid-template-columns: 1fr;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+.plan-card {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: var(--space-8);
+}
+
+.plan-card .picto {
+  margin-bottom: var(--space-8);
+}
+
+.plan-card h3 {
+  font-size: var(--font-size-plan);
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-tight);
+}
+
+.stage-content .plan-card-current {
+  box-shadow: inset 0 0 0 var(--border-width-ring) var(--color-action-primary), var(--shadow-float);
+}
+
+.plan-price {
+  display: flex;
+  align-items: baseline;
+  flex-wrap: wrap;
+  column-gap: var(--space-8);
+}
+
+.plan-amount {
+  font-size: var(--font-size-h3);
+  font-weight: var(--font-weight-medium);
+  line-height: var(--font-line-height-tight);
+  font-variant-numeric: tabular-nums;
+}
+
+.feature-list {
+  list-style: none;
+  flex: 1;
+  display: grid;
+  align-content: start;
+  gap: var(--space-8);
+  width: 100%;
+  margin: var(--space-8) 0 var(--space-16);
+  padding: 0;
+  font-size: var(--font-size-ui);
+  color: var(--color-text-secondary);
+}
+
+.feature-list li {
+  display: flex;
+  align-items: center;
+  gap: var(--space-8);
+}
+
+.plan-badge {
+  height: var(--size-control);
+  align-self: stretch;
+  justify-content: center;
+  border-radius: var(--radius-control);
+}
+
+.payment-method {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: var(--space-8) var(--space-12);
+  font-size: var(--font-size-ui);
+}
+
+.card-icon {
+  color: var(--color-text-secondary);
+}
+
+/* ---------- Dialog ---------- */
+.dialog {
+  width: min(var(--size-dialog), 100% - 2 * var(--space-16));
+  max-width: none;
+  padding: var(--space-32);
+  border: 0;
+  border-radius: var(--radius-stage);
+  background: var(--color-surface-raised);
+  color: var(--color-text-primary);
+  box-shadow: var(--overlay-shadow);
+}
+
+.dialog[open] {
+  animation: dialog-in var(--motion-duration-open) var(--motion-easing-quart);
+}
+
+.dialog::backdrop {
+  background: var(--color-surface-overlay);
+  animation: fade-in var(--motion-duration-open) var(--motion-easing-quart);
+}
+
+.dialog h2 {
+  font-size: var(--font-size-h4);
+  font-weight: var(--font-weight-medium);
+}
+
+.dialog-body {
+  margin-top: var(--space-8);
+  font-size: var(--font-size-ui);
+  color: var(--color-text-secondary);
+}
+
+.dialog-actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: var(--space-12);
+  margin-top: var(--space-32);
+}
+
+@media (max-width: 833px) {
+  .dialog-actions {
+    flex-direction: column-reverse;
+  }
+
+  .dialog-actions .btn {
+    display: flex;
+    width: 100%;
+  }
+}
+
+/* ---------- Empty and not-found states ---------- */
+.empty-state {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: var(--size-dialog);
+  margin: 0 auto;
+  padding: var(--space-64) var(--space-24);
+  text-align: center;
+}
+
+.empty-state-picto {
+  margin-bottom: var(--space-24);
+}
+
+.empty-state h1 {
+  font-size: clamp(var(--font-size-h3), 5vw, var(--font-size-h1));
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-tight);
+}
+
+.empty-state > p {
+  margin-top: var(--space-8);
+  color: var(--color-text-secondary);
+}
+
+.empty-state-actions {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: var(--space-12);
+  margin-top: var(--space-24);
+}
+
+@media (max-width: 833px) {
+  .empty-state-actions {
+    flex-direction: column;
+    align-self: stretch;
   }
 }
