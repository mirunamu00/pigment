+  box-shadow: var(--shadow-overlay);
+  animation: menu-in var(--motion-duration-open) var(--motion-easing-quart) both;
+}
+
+@keyframes menu-in {
+  from {
+    opacity: 0;
+    transform: translateY(calc(-1 * var(--space-4)));
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+.menu-header {
+  padding: var(--space-8) var(--space-12);
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+  color: var(--color-text-tertiary);
+}
+
+.menu-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.menu-item {
+  display: flex;
+  align-items: center;
+  width: 100%;
+  height: var(--size-control);
+  padding: 0 var(--space-12);
+  border: 0;
+  border-radius: var(--radius-control);
+  background: transparent;
+  color: var(--color-text-primary);
+  font: inherit;
+  font-size: var(--font-size-ui);
+  text-align: start;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color var(--motion-duration-press) var(--motion-easing-hover);
+}
+
+.menu-item:hover {
+  background: var(--color-surface-subtle);
+}
+
+.menu-item:focus-visible {
+  outline-offset: -2px;
+}
+
+.menu-separator {
+  margin-top: var(--space-6);
+  padding-top: var(--space-6);
+  box-shadow: inset 0 var(--border-width-hairline) 0 var(--color-border-default);
+}
+
+/* ---------- Shell: sidebar and content ---------- */
+.shell-body {
+  display: flex;
+  align-items: flex-start;
+}
+
+.sidebar {
+  position: sticky;
+  top: var(--size-header);
+  flex: 0 0 var(--size-sidebar);
+  width: var(--size-sidebar);
+  height: calc(100vh - var(--size-header));
+  padding: var(--space-16);
+  box-shadow: inset calc(-1 * var(--border-width-hairline)) 0 0 var(--color-border-default);
+}
+
+.nav-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  gap: var(--space-4);
+}
+
+.nav-link {
+  display: flex;
+  align-items: center;
+  gap: var(--space-12);
+  height: var(--size-control);
+  padding: 0 var(--space-12);
+  border-radius: var(--radius-control);
+  color: var(--color-text-secondary);
+  font-size: var(--font-size-ui);
+  text-decoration: none;
+  transition:
+    color var(--motion-duration-nav) var(--motion-easing-expo),
+    background-color var(--motion-duration-press) var(--motion-easing-hover);
+}
+
+.nav-link:hover {
+  color: var(--color-text-primary);
+}
+
+.nav-link.active {
+  background: var(--color-surface-subtle);
+  color: var(--color-text-primary);
+  font-weight: var(--font-weight-medium);
+}
+
+.content {
+  flex: 1;
+  min-width: 0;
+  outline: none;
+}
+
+.container {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-24);
+  width: 100%;
+  max-width: var(--size-container);
+  margin: 0 auto;
+  padding: 0 clamp(var(--space-20), 4vw, var(--space-64)) var(--space-64);
+}
+
+.container > * {
+  min-width: 0;
+}
+
+/* Block rise (script adds is-rise-ready below the fold, first visit only) */
+.rise {
+  transition:
+    opacity var(--motion-duration-rise) var(--motion-easing-settle),
+    transform var(--motion-duration-rise) var(--motion-easing-settle);
+  transition-delay: calc(var(--rise-i, 0) * var(--motion-duration-press));
+}
+
+.rise.is-rise-ready {
+  opacity: 0;
+  transform: translateY(var(--motion-distance-rise));
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .rise.is-rise-ready {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+@media print {
+  .rise.is-rise-ready {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+/* ---------- Product screen header ---------- */
+.page-header {
+  display: grid;
+  grid-template-columns: var(--size-picto-sm) minmax(0, 1fr) auto;
+  grid-template-areas:
+    'picto title actions'
+    'lede lede lede';
+  align-items: center;
+  column-gap: var(--space-16);
+  row-gap: var(--space-8);
+  padding: var(--space-48) 0 var(--space-32);
+}
+
+.breadcrumb + .page-header {
+  padding-top: 0;
+}
+
+.page-header-picto {
+  grid-area: picto;
+}
+
+.page-title {
+  grid-area: title;
+  font-size: var(--font-size-h3);
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-heading);
+}
+
+.page-header-actions {
+  grid-area: actions;
+  display: flex;
+  align-items: center;
+  gap: var(--space-12);
+}
+
+.page-header-lede {
+  grid-area: lede;
+  max-width: var(--size-measure);
+  font-size: var(--font-size-body);
+  color: var(--color-text-secondary);
+}
+
+.page-header-lede,
+.page-header-actions {
+  animation: rise-sm var(--motion-duration-rise) var(--motion-easing-settle) var(--motion-duration-hover) both;
+}
+
+@keyframes rise-sm {
+  from {
+    opacity: 0;
+    transform: translateY(var(--motion-distance-rise-sm));
+  }
+  to {
+    opacity: 1;
+    transform: none;
+  }
+}
+
+/* Breadcrumb */
+.breadcrumb {
+  padding-top: var(--space-48);
+  margin-bottom: var(--space-16);
+}
+
+.breadcrumb ol {
+  list-style: none;
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-8);
+  margin: 0;
+  padding: 0;
+  font-size: var(--font-size-small);
+  color: var(--color-text-secondary);
+}
+
+.breadcrumb a {
+  color: var(--color-text-secondary);
+}
+
+.breadcrumb li + li::before {
+  content: '/';
+  margin-right: var(--space-8);
+  color: var(--color-text-tertiary);
+}
+
+.container > .breadcrumb {
+  margin-bottom: calc(var(--space-16) - var(--space-24));
+}
+
+/* ---------- Cards and panels ---------- */
+.card {
+  border-radius: var(--radius-card);
+  background: var(--color-surface-raised);
+  box-shadow: inset 0 0 0 var(--border-width-hairline) var(--color-border-default);
+  padding: var(--space-24);
+}
+
+.panel {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-16);
+}
+
+.panel-title {
+  font-size: var(--font-size-h4);
+  font-weight: var(--font-weight-medium);
+}
+
+.panel-body {
+  max-width: var(--size-measure);
+  font-size: var(--font-size-ui);
+  color: var(--color-text-secondary);
+}
+
+.panel-row {
+  display: grid;
+  grid-template-columns: repeat(12, minmax(0, 1fr));
+  gap: var(--space-24);
+  align-items: stretch;
+}
+
+.panel-row > .panel {
+  grid-column: span 5;
+  min-width: 0;
+}
+
+.panel-row > .panel--chart {
+  grid-column: span 7;
+}
+
+/* Stat cards */
+.kpi-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: var(--space-24);
+}
+
+.kpi-card {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-8);
+  min-height: calc(var(--space-128) + var(--space-8));
+}
+
+.kpi-label {
+  font-family: var(--font-family-sans);
+  font-size: var(--font-size-small);
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-title);
+  color: var(--color-text-secondary);
+}
+
+.kpi-value {
+  font-size: var(--font-size-h3);
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-tight);
+  font-variant-numeric: tabular-nums;
+}
+
+.kpi-change {
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+  color: var(--color-text-secondary);
+  font-variant-numeric: tabular-nums;
+}
+
+.kpi-change--success {
+  color: var(--color-status-success);
+}
+
+.kpi-change--danger {
+  color: var(--color-status-danger);
+}
+
+/* Loading: static skeleton bars, no shimmer */
+.skeleton {
+  display: block;
+  background: var(--color-surface-subtle);
+  border-radius: var(--radius-badge);
+}
+
+.skeleton-label {
+  width: 60%;
+  height: var(--space-16);
+}
+
+.skeleton-value {
+  width: 40%;
+  height: var(--space-40);
+}
+
+.skeleton-change {
+  width: 50%;
+  height: var(--space-12);
+}
+
+/* ---------- Chart ---------- */
+.chart {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-12);
+  flex: 1;
+  margin: 0;
+}
+
+.chart-title {
+  font-size: var(--font-size-small);
+  color: var(--color-text-secondary);
+}
+
+.chart-stage {
+  flex: 1;
+  align-items: stretch;
+}
+
+.chart-stage > .stage-content {
+  display: flex;
+}
+
+.chart-card {
+  display: flex;
+  flex: 1;
+  width: 100%;
+}
+
+.chart-plot {
+  position: relative;
+  display: flex;
+  align-items: stretch;
+  gap: var(--space-8);
+  flex: 1;
+  min-height: calc(var(--space-128) * 2 - var(--space-16));
+}
+
+.chart-grid {
+  position: absolute;
+  inset: var(--space-24) 0 calc(var(--space-24) + var(--space-8)) 0;
+  pointer-events: none;
+}
+
+.chart-gridline {
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: calc(var(--at) * 100%);
+  height: var(--border-width-hairline);
+  background: var(--color-border-default);
+}
+
+.chart-gridline:first-child {
+  bottom: 0;
+}
+
+.chart-column {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: var(--space-8);
+  flex: 1;
+  min-width: 0;
+}
+
+.chart-track {
+  display: flex;
+  flex-direction: column;
+  justify-content: flex-end;
+  align-items: center;
+  gap: var(--space-6);
+  flex: 1;
+  width: 100%;
+  padding-top: var(--space-4);
+}
+
+.chart-bar {
+  display: block;
+  width: min(60%, var(--space-48));
+  height: calc(var(--value) * (100% - var(--space-24)));
+  border-radius: var(--radius-badge) var(--radius-badge) 0 0;
+  background: var(--color-chart-rest);
+}
+
+.chart-bar--current {
+  background: var(--color-chart-ink);
+}
+
+.chart-value,
+.chart-label {
+  font-size: var(--font-size-caption);
+  line-height: 1;
+  color: var(--color-text-tertiary);
+  font-variant-numeric: tabular-nums;
+}
+
+.chart-label {
+  height: var(--space-24);
+  display: flex;
+  align-items: center;
+}
+
+/* ---------- Activity ---------- */
+.activity-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.activity-item {
+  padding: var(--space-12) 0;
+  font-size: var(--font-size-ui);
+  line-height: var(--font-line-height-lede);
+  color: var(--color-text-secondary);
+  box-shadow: inset 0 calc(-1 * var(--border-width-hairline)) 0 var(--color-border-default);
+}
+
+.activity-item:last-child {
+  box-shadow: none;
+}
+
+.activity-item strong {
+  color: var(--color-text-primary);
+}
+
+.activity-time {
+  margin-top: var(--space-4);
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+  color: var(--color-text-tertiary);
+}
+
+/* ---------- Table card, toolbar ---------- */
+.table-card {
+  padding: var(--space-24) 0 var(--space-8);
+  overflow: hidden;
+}
+
+.card-head {
+  display: flex;
+  justify-content: space-between;
+  align-items: baseline;
+  flex-wrap: wrap;
+  gap: var(--space-8) var(--space-16);
+  padding: 0 var(--space-24);
+}
+
+.card-title {
+  font-size: var(--font-size-h5);
+  font-weight: var(--font-weight-medium);
+}
+
+.card-count {
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+  color: var(--color-text-tertiary);
+}
+
+.toolbar {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  align-items: center;
+  gap: var(--space-12);
+  margin-top: var(--space-16);
+  padding: 0 var(--space-24) var(--space-16);
+}
+
+.toolbar-end {
+  display: flex;
+  align-items: center;
+  gap: var(--space-12);
+  flex: 0 1 calc(var(--size-sidebar) + var(--space-64));
+  min-width: 0;
+}
+
+.chips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-8);
+}
+
+.chip {
+  height: var(--size-control);
+  padding: 0 var(--space-16);
+  border: 0;
+  border-radius: var(--radius-chip);
+  background: var(--color-action-tertiary);
+  color: var(--color-text-primary);
+  font-size: var(--font-size-ui);
+  font-weight: var(--font-weight-medium);
+  line-height: 1;
+  cursor: pointer;
+  transition:
+    background-color var(--motion-duration-press) var(--motion-easing-hover),
+    color var(--motion-duration-press) var(--motion-easing-hover),
+    transform var(--motion-duration-press) var(--motion-easing-hover);
+}
+
+.chip:hover {
+  background: var(--color-action-tertiary-hover);
+}
+
+.chip[aria-pressed='true'] {
+  background: var(--color-action-primary);
+  color: var(--color-text-on-action);
+}
+
+.chip:active {
+  transform: scale(0.985);
+}
+
+.chip:focus-visible {
+  outline-offset: 4px;
+}
+
+.sort-select {
+  display: none;
+  align-items: center;
+  gap: var(--space-8);
+  font-size: var(--font-size-ui);
+  font-weight: var(--font-weight-medium);
+  white-space: nowrap;
+}
+
+.sort-select .select {
+  flex: 1;
+}
+
+/* ---------- Table ---------- */
+.table-wrap {
+  min-width: 0;
+}
+
+.table {
+  width: 100%;
+  border-collapse: collapse;
+  table-layout: fixed;
+  font-size: var(--font-size-dense);
+  line-height: var(--font-line-height-title);
+}
+
+.table th,
+.table td {
+  height: var(--size-row-dense);
+  padding: var(--space-8) var(--space-16);
+  text-align: start;
+  vertical-align: middle;
+  box-shadow: inset 0 calc(-1 * var(--border-width-hairline)) 0 var(--color-border-default);
+  color: var(--color-text-secondary);
+  overflow-wrap: anywhere;
+}
+
+.table th:first-child,
+.table td:first-child {
+  padding-left: var(--space-24);
+  color: var(--color-text-primary);
+}
+
+.table th:last-child,
+.table td:last-child {
+  padding-right: var(--space-24);
+}
+
+.table th {
+  font-size: var(--font-size-micro);
+  font-weight: var(--font-weight-medium);
+  letter-spacing: var(--font-tracking-micro);
+  text-transform: uppercase;
+  color: var(--color-text-tertiary);
+  box-shadow:
+    inset 0 var(--border-width-hairline) 0 var(--color-border-default),
+    inset 0 calc(-1 * var(--border-width-hairline)) 0 var(--color-border-default);
+}
+
+.table th:first-child {
+  color: var(--color-text-tertiary);
+}
+
+.table tbody tr:last-child td {
+  box-shadow: none;
+}
+
+.table tbody tr {
+  transition: background-color var(--motion-duration-press) var(--motion-easing-hover);
+}
+
+.table tbody tr:hover {
+  background: var(--color-surface-subtle);
+}
+
+.table .numeric {
+  text-align: right;
+  font-variant-numeric: tabular-nums;
+}
+
+.sort-button {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-4);
+  min-height: var(--size-control-sm);
+  padding: 0;
+  border: 0;
+  background: none;
+  color: inherit;
+  font: inherit;
+  letter-spacing: inherit;
+  text-transform: inherit;
+  cursor: pointer;
+}
+
+.sort-button:hover,
+th[aria-sort='ascending'] .sort-button,
+th[aria-sort='descending'] .sort-button {
+  color: var(--color-text-primary);
+}
+
+th.numeric .sort-button {
+  flex-direction: row-reverse;
+}
+
+.sort-indicator {
+  display: inline-flex;
+  width: var(--space-12);
+  height: var(--space-12);
+}
+
+.sort-indicator .icon {
+  width: var(--space-12);
+  height: var(--space-12);
+}
+
+.table-link {
+  font-weight: var(--font-weight-medium);
+}
+
+.cell-meta {
+  margin-top: var(--space-4);
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+  color: var(--color-text-tertiary);
+}
+
+.cell-mono {
+  font-family: var(--font-family-mono);
+  font-size: var(--font-size-small);
+}
+
+.table--stack .col-project {
+  width: 32%;
+}
+.table--stack .col-owner {
+  width: 19%;
+}
+.table--stack .col-status {
+  width: 15%;
+}
+.table--stack .col-budget {
+  width: 15%;
+}
+.table--stack .col-due {
+  width: 19%;
+}
+
+.table--team .col-person {
+  width: 40%;
+}
+.table--team .col-role {
+  width: 26%;
+}
+.table--team .col-location {
+  width: 16%;
+}
+.table--team .col-count {
+  width: 18%;
+}
+
+.table--files .col-file {
+  width: 50%;
+}
+.table--files .col-size {
+  width: 18%;
+}
+.table--files .col-updated {
+  width: 32%;
+}
+
+.table-scroll {
+  overflow-x: auto;
+}
+
+.table-scroll:focus-visible {
+  outline-offset: -2px;
+}
+
+/* People */
+.person {
+  display: flex;
+  align-items: center;
+  gap: var(--space-12);
+  min-width: 0;
+}
+
+.person-text {
+  min-width: 0;
+}
+
+.person-name {
+  color: var(--color-text-primary);
+  font-weight: var(--font-weight-medium);
+}
+
+.person-email {
+  font-size: var(--font-size-caption);
+  color: var(--color-text-secondary);
+}
+
+/* ---------- Empty, error states ---------- */
+.empty-state {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: var(--size-dialog);
+  margin: 0 auto;
+  padding: var(--space-64) var(--space-24);
+  text-align: center;
+}
+
+.empty-state--card {
+  max-width: none;
   margin: 0;
 }
 
+.empty-state .picto {
+  margin-bottom: var(--space-24);
+}
+
+.empty-state-title {
+  font-size: var(--font-size-h4);
+  font-weight: var(--font-weight-medium);
+}
+
+.empty-state-line {
+  max-width: var(--size-dialog);
+  margin: var(--space-8) 0 var(--space-24);
+  font-size: var(--font-size-ui);
+  color: var(--color-text-secondary);
+}
+
+.error-state {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: var(--size-form);
+  margin: 0 auto;
+  padding: var(--space-96) 0 var(--space-64);
+  text-align: center;
+}
+
+.error-state .picto {
+  margin-bottom: var(--space-24);
+}
+
+.error-state-title {
+  font-size: clamp(var(--font-size-h3), 5vw, var(--font-size-h1));
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-tight);
+}
+
+.error-state-message {
+  max-width: var(--size-measure);
+  margin: var(--space-16) 0 var(--space-32);
+  font-size: var(--font-size-lede);
+  line-height: var(--font-line-height-lede);
+  color: var(--color-text-secondary);
+}
+
+.error-state-actions {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: var(--space-12);
+}
+
+/* ---------- Project detail ---------- */
+.tabs {
+  display: flex;
+  gap: var(--space-24);
+  overflow-x: auto;
+  scrollbar-width: none;
+  box-shadow: inset 0 calc(-1 * var(--border-width-hairline)) 0 var(--color-border-default);
+}
+
+.tab {
+  position: relative;
+  flex-shrink: 0;
+  height: var(--size-control);
+  padding: 0;
+  border: 0;
+  background: none;
+  color: var(--color-text-secondary);
+  font-size: var(--font-size-ui);
+  cursor: pointer;
+  transition: color var(--motion-duration-nav) var(--motion-easing-expo);
+}
+
+.tab::after {
+  content: '';
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  height: var(--border-width-ring);
+  background: transparent;
+}
