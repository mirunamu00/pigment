@@ -2,8 +2,24 @@ import { StrictMode } from 'react';
 import { createRoot } from 'react-dom/client';
 import { BrowserRouter } from 'react-router';
 import App from './App';
+import '../design-system/tokens.css';
 import './styles/base.css';
 
+// Inkleaf root defs, once: two brush filters in three seeds each (the gentle lg set for boxes over
+// 160px) and the frame clip that keeps a stroke leaving one frame out of its neighbor.
+const set = (id: string, freq: number, oct: number, scale: number) =>
+  [3, 8, 14]
+    .map(
+      (seed, i) =>
+        `<filter id="${id}${i}" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="${freq}" numOctaves="${oct}" seed="${seed}" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="${scale}" xChannelSelector="R" yChannelSelector="G"/></filter>`,
+    )
+    .join('');
+const brush = set('inkleaf-brush-', 0.045, 2, 2.6) + set('inkleaf-brush-lg-', 0.02, 1, 0.9);
+document.body.insertAdjacentHTML(
+  'afterbegin',
+  `<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>${brush}<clipPath id="inkleaf-cel"><rect width="120" height="120"/></clipPath></defs></svg>`,
+);
+
 const rootElement = document.getElementById('root');
 if (!rootElement) throw new Error('Root element #root not found');
 
