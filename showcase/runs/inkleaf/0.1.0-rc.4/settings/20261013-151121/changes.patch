+/**
+ * Block rise on a route's first visit: blocks below the fold are hidden by script and rise
+ * when 15% enters view. Blocks in view on load are never hidden.
+ */
+function useBlockRise(main: RefObject<HTMLElement | null>, pathname: string) {
+  useEffect(() => {
+    const root = main.current;
+    if (!root || visitedRoutes.has(pathname) || prefersReducedMotion()) return;
+    visitedRoutes.add(pathname);
+    const below = Array.from(root.querySelectorAll<HTMLElement>('[data-rise]')).filter(
+      (block) => block.getBoundingClientRect().top > window.innerHeight,
+    );
+    if (below.length === 0) return;
+    below.forEach((block) => block.classList.add('is-rise-ready'));
+    const observer = new IntersectionObserver(
+      (entries) => {
+        let sibling = 0;
+        for (const entry of entries) {
+          if (!entry.isIntersecting) continue;
+          const block = entry.target as HTMLElement;
+          block.style.setProperty('--rise-delay', `${Math.min(sibling, 3) * 100}ms`);
+          sibling += 1;
+          block.classList.remove('is-rise-ready');
+          observer.unobserve(block);
+        }
+      },
+      { threshold: 0.15 },
+    );
+    below.forEach((block) => observer.observe(block));
+    return () => {
+      observer.disconnect();
+      below.forEach((block) => block.classList.remove('is-rise-ready'));
+    };
+  }, [main, pathname]);
+}
