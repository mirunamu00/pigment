+
+/* Main content */
+.content {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-24);
+  width: 100%;
+  max-width: var(--size-container);
+  margin: 0 auto;
+  padding: 0 clamp(var(--space-20), 4vw, var(--space-64)) var(--space-96);
+}
+
+.content:focus {
