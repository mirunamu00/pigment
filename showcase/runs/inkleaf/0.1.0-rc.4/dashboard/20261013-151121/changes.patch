+  .nav-link.active {
+    background: none;
+  }
+
+  .topbar {
+    position: static;
+    animation: none;
+  }
+
+  .kpi-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
   }
 
   .two-column {
-    grid-template-columns: 1fr;
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+@media (max-width: 833px) {
+  .stage {
+    padding: var(--space-24);
+    border-radius: var(--radius-card);
+  }
+
+  .user-menu-name {
+    display: none;
+  }
+
+  .user-menu-button {
+    padding: 0 var(--space-4);
+  }
+
+  .page-header {
+    grid-template-columns: minmax(0, 1fr);
+    padding-top: var(--space-32);
+  }
+
+  .page-actions {
+    justify-content: flex-start;
+  }
+
+  .page-title {
+    font-size: var(--font-size-h4);
+  }
+
+  .details {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .chart {
+    --plot-h: 140px;
+  }
+
+  .chart-plot {
+    gap: var(--space-6);
+  }
+
+  /* Toolbar: chips, then sort and search full width. */
+  .toolbar,
+  .toolbar-end {
+    flex-direction: column;
+    align-items: stretch;
+  }
+
+  .toolbar .search-field {
+    width: 100%;
+  }
+
+  .sort-select {
+    display: flex;
+    align-items: center;
+    gap: var(--space-12);
+    font-size: var(--font-size-ui);
+    font-weight: var(--font-weight-medium);
+    white-space: nowrap;
+  }
+
+  .sort-select .select {
+    flex: 1;
+    width: auto;
+  }
+
+  .chip {
+    padding: 0 var(--space-12);
+  }
+
+  /* Stacked table: header hidden, each cell a label/value grid. */
+  .table--stack thead {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+  }
+
+  .table--stack,
+  .table--stack tbody,
+  .table--stack tr,
+  .table--stack td {
+    display: block;
+    width: 100%;
+  }
+
+  .table--stack tr {
+    padding: var(--space-12) var(--space-24);
+    box-shadow: inset 0 calc(-1 * var(--border-width-hairline)) 0 var(--color-border-default);
+  }
+
+  .table--stack tbody tr:first-child {
+    box-shadow:
+      inset 0 var(--border-width-hairline) 0 var(--color-border-default),
+      inset 0 calc(-1 * var(--border-width-hairline)) 0 var(--color-border-default);
+  }
+
+  .table--stack tbody tr:last-child {
+    box-shadow: inset 0 var(--border-width-hairline) 0 transparent;
+  }
+
+  .table--stack tbody tr:only-child {
+    box-shadow: inset 0 var(--border-width-hairline) 0 var(--color-border-default);
+  }
+
+  .table--stack td,
+  .table--stack td.numeric,
+  .table--stack td:first-child,
+  .table--stack td:last-child {
+    display: grid;
+    grid-template-columns: minmax(96px, 38%) minmax(0, 1fr);
+    gap: var(--space-12);
+    align-items: center;
+    height: auto;
+    min-height: var(--size-control-sm);
+    padding: var(--space-4) 0;
+    box-shadow: none;
+    text-align: left;
+  }
+
+  .table--stack td::before {
+    content: attr(data-label);
+    color: var(--color-text-tertiary);
+    font-size: var(--font-size-caption);
+    letter-spacing: var(--font-tracking-caption);
+  }
+
+  .table--stack td > .badge {
+    justify-self: start;
+  }
+
+  .empty-state {
+    padding: var(--space-48) var(--space-16);
+  }
+
+  .empty-state--page {
+    padding-top: var(--space-64);
+  }
+
+  .empty-actions {
+    flex-direction: column;
+    align-self: stretch;
+  }
+
+  .empty-actions .btn {
+    display: flex;
+    width: 100%;
+  }
+}
+
+@media (max-width: 599px) {
+  .kpi-grid {
+    grid-template-columns: minmax(0, 1fr);
+    gap: var(--space-16);
+  }
+
+  .topbar {
+    gap: var(--space-8);
+  }
+
+  .topbar-search .btn {
+    padding: 0 var(--space-12);
+  }
+}
+
+/* ---------- Reduced motion: final frames, whole headings, still loops ---------- */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: var(--motion-duration-instant) !important;
+    animation-delay: 0s !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: var(--motion-duration-instant) !important;
+    transition-delay: 0s !important;
+  }
+
+  .picto:is(.is-ready, .is-playing, .is-boiling) .cel-strip {
+    animation: none;
+    transform: translateX(calc((1 - var(--n)) * 120px));
+  }
+
+  .write-in .w {
+    opacity: 1;
+    transition: none;
+  }
+
+  .glyph path {
+    animation: none;
+    stroke-dashoffset: 0;
+  }
+
+  .dot-breathe {
+    animation: none;
+  }
+
+  .btn:active:not(:disabled),
+  .chip:active {
+    transform: none;
   }
 }
