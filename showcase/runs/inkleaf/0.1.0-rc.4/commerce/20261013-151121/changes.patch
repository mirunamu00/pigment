 interface ProductImageProps {
   product: Product;
   size?: 'card' | 'large';
+  /** Position in the visible grid; plate colors rotate so neighbors never match. */
+  index?: number;
 }
 
-/** Image placeholder: a tinted CSS box with an icon. No network images. */
-export default function ProductImage({ product, size = 'card' }: ProductImageProps) {
+const ROTATION: StageColor[] = ['sage', 'lilac', 'apricot'];
+
+/**
+ * No product photos exist, so each item shows its own cel-drawn subject: on a plate in the grid
+ * (final frame) and on a 4:3 drawing stage on its detail page (plays once), the same drawing on both.
+ */
+export default function ProductImage({ product, size = 'card', index }: ProductImageProps) {
+  const drawing = productDrawing(product.slug);
+  const label = `${product.name} product photo placeholder`;
+
+  if (size === 'large') {
+    const catalogIndex = products.findIndex((item) => item.slug === product.slug);
+    return (
+      <Stage
+        color={ROTATION[Math.max(0, catalogIndex) % ROTATION.length]}
+        variant="drawing"
+        lines={catalogIndex}
+        className="product-image product-image-large"
+        role="img"
+        aria-label={label}
+        data-testid="product-image"
+      >
+        {drawing && <Picto drawing={drawing} />}
+      </Stage>
+    );
+  }
+
+  const color = ROTATION[(index ?? 0) % ROTATION.length];
   return (
     <div
-      className={`product-image product-image-${size} tone-${product.tone}`}
+      className="plate product-image product-image-card"
+      style={{ ['--stage' as string]: `var(--color-stage-${color})` }}
       role="img"
-      aria-label={`${product.name} product photo placeholder`}
+      aria-label={label}
       data-testid="product-image"
     >
-      <ImageIcon className="product-image-icon" />
+      {drawing && <Picto drawing={drawing} still />}
     </div>
   );
 }
