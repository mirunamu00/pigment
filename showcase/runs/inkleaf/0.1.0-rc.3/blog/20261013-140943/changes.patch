+  min-width: 0;
+}
+
+.breadcrumb li + li::before {
+  content: '/';
+  margin-right: var(--space-8);
+  color: var(--color-text-tertiary);
+}
+
+.breadcrumb a {
+  color: var(--color-text-secondary);
+}
+
+.breadcrumb a:hover {
+  color: var(--color-text-primary);
+}
+
+.article {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  font-size: var(--font-size-body-lg);
+}
+
+.article > * {
+  min-width: 0;
+}
+
+.article-header {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-16);
+  padding-top: var(--space-16);
+}
+
+.article-header h1 {
+  font-size: clamp(var(--font-size-plan), 5vw, var(--font-size-h2));
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-tight);
+}
+
+.article-header .tag-list {
+  margin-top: var(--space-16);
+}
+
+.article-stage {
+  margin-top: var(--space-48);
+}
+
+.article-aside {
+  margin-top: var(--space-32);
+}
+
+.article-body {
+  margin-top: var(--space-48);
+  line-height: var(--font-line-height-body);
+}
+
+.article-body > * + * {
+  margin-top: var(--space-24);
+}
+
+.article-body > h2 {
+  margin-top: var(--space-64);
+  font-size: var(--font-size-h4);
+}
+
+.article-body > h3 {
+  margin-top: var(--space-48);
+  font-size: var(--font-size-h5);
+}
+
+.article-body > :is(h2, h3) + * {
+  margin-top: var(--space-12);
+}
+
+.article-body > .body-quote,
+.article-body > .body-figure {
+  margin-top: var(--space-48);
+  margin-bottom: 0;
+}
+
+.body-quote {
+  margin-inline: 0;
+}
+
+.body-quote blockquote {
+  margin: 0;
+}
+
+.body-quote blockquote p {
+  font-family: var(--font-family-serif);
+  font-size: clamp(var(--font-size-h4), 4vw, var(--font-size-plan));
+  font-weight: var(--font-weight-regular);
+  line-height: var(--font-line-height-tight);
+  text-wrap: balance;
+}
+
+.body-quote figcaption {
+  margin-top: var(--space-12);
+}
+
+.code-block {
+  overflow-x: auto;
+  padding: var(--space-20) var(--space-24);
+  border-radius: var(--radius-tile);
+  background: var(--color-surface-subtle);
+  color: var(--color-text-primary);
+  font-family: var(--font-family-mono);
+  font-size: var(--font-size-small);
+  line-height: var(--font-line-height-body);
+}
+
+.body-list {
+  padding-left: var(--space-24);
+}
+
+.body-list li + li {
+  margin-top: var(--space-8);
+}
+
+.body-list li::marker {
+  color: var(--color-text-tertiary);
+}
+
+.body-figure {
+  margin-inline: 0;
+}
+
+.body-figure figcaption {
+  margin-top: var(--space-12);
+}
+
+.ghost-board.card {
+  display: block;
+  width: 75%;
+  height: auto;
+  margin: 0 auto;
+  padding: 0;
+  box-shadow:
+    0 0 0 var(--border-width-hairline) var(--color-border-default),
+    var(--shadow-float);
+}
+
+.ghost-bar,
+.ghost-chip {
+  fill: var(--color-border-default);
+}
+
+.ghost-bar--soft,
+.ghost-group {
+  fill: var(--color-surface-subtle);
+}
+
+/* Table of contents: a side column from breakpoint.lg, a collapsed disclosure below it. */
+.toc-heading {
+  font-size: var(--font-size-h5);
+}
+
+.toc-list {
+  margin: 0;
+  padding: 0;
+  font-size: var(--font-size-small);
+  line-height: var(--font-line-height-title);
+  list-style: none;
+}
+
+.toc-item + .toc-item {
+  margin-top: var(--space-12);
+}
+
+.toc-item-nested {
+  padding-left: var(--space-12);
+}
+
+.toc-link {
+  color: var(--color-text-secondary);
+  text-decoration-color: transparent;
+}
+
+.toc-link:hover {
+  color: var(--color-text-primary);
+  text-decoration-color: currentColor;
+}
+
+.toc-panel {
+  display: grid;
+  grid-template-rows: 0fr;
+  opacity: 0;
+  transition:
+    grid-template-rows calc(var(--motion-duration-open) * 0.6) var(--motion-easing-quart),
+    opacity calc(var(--motion-duration-open) * 0.6) var(--motion-easing-quart);
+}
+
+.toc.is-open .toc-panel {
+  grid-template-rows: 1fr;
+  opacity: 1;
+  transition-duration: var(--motion-duration-open);
+}
+
+.toc-panel > .toc-list {
+  min-height: 0;
+  overflow: hidden;
+}
+
+.toc-toggle {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  width: 100%;
+  min-height: var(--size-touch);
+  padding: 0;
+  border: 0;
+  background: none;
+  color: var(--color-text-primary);
+  font: inherit;
+  cursor: pointer;
+}
+
+.chevron {
+  width: var(--size-icon);
+  height: var(--size-icon);
+  fill: none;
+  stroke: var(--color-text-secondary);
+  stroke-width: 1.5;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  transition: transform var(--motion-duration-open) var(--motion-easing-quart);
+}
+
+.toc-toggle[aria-expanded='true'] .chevron {
+  transform: rotate(180deg);
+}
+
+@media (max-width: 991px) {
+  .toc {
+    box-shadow:
+      inset 0 var(--border-width-hairline) 0 var(--color-border-default),
+      inset 0 calc(-1 * var(--border-width-hairline)) 0 var(--color-border-default);
+  }
+
+  .toc-list {
+    padding-bottom: var(--space-16);
+  }
+}
+
+@media (min-width: 992px) {
+  .article {
+    grid-template-columns: minmax(0, var(--size-measure)) var(--size-sidebar);
+    justify-content: space-between;
+    column-gap: var(--space-64);
+  }
+
+  .article-aside {
+    position: sticky;
+    top: calc(var(--size-header) + var(--space-24));
+    grid-column: 2;
+    grid-row: 1 / span 3;
+    align-self: start;
+    margin-top: var(--space-16);
+  }
+
+  .toc {
+    padding-left: var(--space-24);
+    box-shadow: inset var(--border-width-hairline) 0 0 var(--color-border-default);
+  }
+
+  .toc-list {
+    margin-top: var(--space-16);
+  }
+}
+
+@media (max-width: 833px) {
+  .article-stage,
+  .article-body {
+    margin-top: var(--space-32);
+  }
+}
+
+/* ------------------------------------------------------------------ About */
+
+.page-header--centered .lede {
+  margin-top: var(--space-16);
+}
+
+.prose-body {
+  max-width: var(--size-measure);
+  margin-top: var(--space-32);
+  text-align: start;
+}
+
+.prose-body p + p {
+  margin-top: var(--space-16);
+}
+
+.author-list {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: var(--gutter);
+  margin: var(--space-32) 0 0;
+  padding: 0;
+  list-style: none;
+}
+
+@media (min-width: 834px) {
+  .author-list {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (min-width: 992px) {
+  .author-list {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+.author-card {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-16);
+  height: 100%;
+}
+
+.avatar {
+  display: grid;
+  place-items: center;
+  flex-shrink: 0;
+  width: var(--size-control);
+  height: var(--size-control);
+  border-radius: var(--radius-tile);
+  background: var(--stage);
+  color: var(--color-text-primary);
+  font-family: var(--font-family-serif);
+  font-size: var(--font-size-h5);
+  font-weight: var(--font-weight-regular);
+}
+
+.author-role {
+  margin-top: var(--space-4);
+  color: var(--color-text-tertiary);
+  font-size: var(--font-size-caption);
+  letter-spacing: var(--font-tracking-caption);
+}
+
+.author-bio {
+  margin-top: var(--space-12);
+  color: var(--color-text-secondary);
+  font-size: var(--font-size-ui);
+}
+
+/* -------------------------------------------------------------- Not found */
+
+.lost-state {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding-top: var(--space-64);
