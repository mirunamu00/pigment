+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+/** breakpoint.lg: the contents sit in a side column; below it they collapse into a disclosure. */
+const SIDE_COLUMN = '(min-width: 992px)';
+
+function useSideColumn() {
+  const [matches, setMatches] = useState(() => window.matchMedia(SIDE_COLUMN).matches);
+  useEffect(() => {
+    const query = window.matchMedia(SIDE_COLUMN);
+    const update = () => setMatches(query.matches);
+    query.addEventListener('change', update);
+    return () => query.removeEventListener('change', update);
+  }, []);
+  return matches;
+}
+
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
+  const sideColumn = useSideColumn();
+  const [open, setOpen] = useState(false);
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
   if (headings.length === 0) return null;
 
+  const expanded = sideColumn || open;
+
   return (
-    <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
+    <nav className={expanded ? 'toc is-open' : 'toc'} aria-labelledby="toc-heading" data-testid="toc">
       <h2 id="toc-heading" className="toc-heading">
-        On this page
+        {sideColumn ? (
+          'On this page'
+        ) : (
+          <button
+            type="button"
+            className="toc-toggle"
+            aria-expanded={open}
+            aria-controls="toc-list"
+            onClick={() => setOpen((value) => !value)}
+          >
+            On this page
+            <svg className="chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
+              <path d="M4 6 L8 10 L12 6" />
+            </svg>
+          </button>
+        )}
       </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      <div className="toc-panel" inert={!expanded}>
+        <ol className="toc-list" id="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
+                {heading.text}
+              </a>
+            </li>
+          ))}
+        </ol>
+      </div>
     </nav>
   );
 }
