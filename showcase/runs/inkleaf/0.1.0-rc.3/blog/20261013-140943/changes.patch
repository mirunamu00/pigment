+  justify-content: center;
+  gap: var(--space-12);
+  margin-top: var(--space-32);
+}
+
+@media (max-width: 833px) {
+  .actions {
+    flex-direction: column;
+    width: 100%;
+  }
+
+  .actions .btn {
+    width: 100%;
+  }
+}
+
+/* ---------------------------------------------------------- Reduced motion */
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
