 ];
 
+const risenRoutes = new Set<string>();
+
+/**
+ * Block rise on a route's first visit: blocks below the fold start lowered and transparent, and settle in at 15%
+ * in view, once; siblings 100ms apart, at most 4. Without script and under reduced motion every block is final.
+ */
+function useBlockRise(container: RefObject<HTMLElement | null>, pathname: string) {
+  useEffect(() => {
+    const root = container.current;
+    if (!root || risenRoutes.has(pathname) || prefersReducedMotion()) return;
+    risenRoutes.add(pathname);
+    const blocks = Array.from(root.querySelectorAll<HTMLElement>('.rise')).filter(
+      (block) => block.getBoundingClientRect().top > window.innerHeight,
+    );
+    blocks.forEach((block) => {
+      const siblings = Array.from(block.parentElement?.children ?? []).filter((el) => el.classList.contains('rise'));
+      const index = Math.min(3, Math.max(0, siblings.indexOf(block)) % 4);
+      block.style.setProperty('--rise-delay', `${index * 100}ms`);
+      block.classList.add('is-rise-ready');
+    });
+    const observer = new IntersectionObserver(
+      (entries) => {
+        for (const entry of entries) {
+          if (!entry.isIntersecting) continue;
+          entry.target.classList.remove('is-rise-ready');
+          observer.unobserve(entry.target);
+        }
+      },
+      { threshold: 0.15 },
+    );
+    blocks.forEach((block) => observer.observe(block));
+    return () => {
+      observer.disconnect();
+      blocks.forEach((block) => block.classList.remove('is-rise-ready'));
+      risenRoutes.delete(pathname);
+    };
+  }, [container, pathname]);
+}
