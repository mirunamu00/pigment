+@keyframes nc-beacon { 50% { fill: var(--color-art-beacon-off); } }
+@keyframes nc-drift { from { transform: translateX(var(--from)); } to { transform: translateX(var(--to)); } }
+@keyframes nc-rare {
+  0%, 90% { opacity: 0; transform: none; animation-timing-function: steps(1); }
+  90.1% { opacity: 1; transform: none; animation-timing-function: steps(5); }
+  100% { opacity: 1; transform: translate(var(--dx), var(--dy)); }
