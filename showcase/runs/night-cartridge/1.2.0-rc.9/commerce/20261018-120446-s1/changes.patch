+.pic--large { aspect-ratio: auto; height: 100%; min-height: 360px; }
+.product-detail-info { display: flex; flex-direction: column; gap: var(--space-24); min-width: 0; }
+.purchase-form { display: flex; flex-direction: column; gap: var(--space-20); }
+.variant-fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
+.variant-fieldset > legend { padding: 0; margin-bottom: var(--space-8); }
+.variant-options { display: flex; flex-wrap: wrap; gap: var(--space-12); }
+.variant-option { display: inline-flex; align-items: center; gap: var(--space-8); height: var(--size-control); padding: 0 var(--space-12); border: var(--border-width-control) solid var(--color-border-default); cursor: pointer; }
+.variant-option:hover { background: var(--color-surface-hover); color: var(--color-text-strong); }
+.variant-option:has(input:checked) { color: var(--color-text-strong); border-color: var(--color-border-strong); }
+.stepper { display: flex; flex-direction: column; gap: var(--space-8); align-items: flex-start; }
+.stepper-controls { display: flex; }
+.stepper-controls > * + * { margin-left: calc(-1 * var(--border-width-control)); }
+.stepper-input { width: 64px; text-align: center; }
+.purchase-actions { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-8); }
+.detail-list { list-style: none; padding: 0; }
+.detail-list li { padding-block: var(--space-8); }
+.detail-list li + li { background: linear-gradient(90deg, var(--color-border-control) 2px, transparent 0) 0 0/6px 2px repeat-x; }
+@media (max-width: 1023px) {
+  .product-detail { grid-template-columns: minmax(0, 1fr); }
+  .pic--large { aspect-ratio: 4 / 3; height: auto; min-height: 0; }
+}
+@media (max-width: 599px) {
+  .purchase-actions, .purchase-actions .btn-gold { width: 100%; align-items: stretch; }
+}
+
+/* ---------- Cart ---------- */
+.cart-layout { align-items: stretch; gap: var(--space-64) var(--space-32); }
+.cart-main { display: flex; flex-direction: column; gap: var(--space-40); }
+.cart-lines { list-style: none; padding: 0; }
+.cart-line { position: relative; display: grid; grid-template-columns: var(--size-marker-w) minmax(0, 1fr) auto auto auto; align-items: center; gap: var(--space-16); padding: var(--space-12) var(--space-12) var(--space-12) var(--space-8); }
+.cart-line + .cart-line { background: linear-gradient(90deg, var(--color-border-control) 2px, transparent 0) 0 0/6px 2px repeat-x; }
+.cart-line > .cur { visibility: hidden; }
+.cart-line:is(:hover, :focus-within) { background-color: var(--color-surface-hover); }
+.cart-line:is(:hover, :focus-within) > .cur { visibility: visible; }
+.cart-line-info { display: grid; gap: var(--space-4); min-width: 0; }
+.cart-line-name { color: var(--color-text-strong); }
+.cart-line-total { min-width: 88px; text-align: right; }
+.totals .window__body { display: grid; gap: var(--space-16); }
+.summary-row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-16); padding-block: var(--space-4); }
+.summary-row dt { color: var(--color-text-secondary); }
+.summary-row dd { color: var(--color-text-strong); }
+.summary-total { margin-top: var(--space-8); padding-top: var(--space-12); background: linear-gradient(90deg, var(--color-border-control) 2px, transparent 0) 0 0/6px 2px repeat-x; }
+.summary-total dt { color: var(--color-text-strong); }
+.summary-total dd { font-size: var(--font-size-display); line-height: var(--font-line-height-display); }
+.meter-block { display: grid; gap: var(--space-8); }
+.checkout { min-width: 0; }
+.form-window { padding: var(--space-20); }
+.checkout-form .actions { margin-top: var(--space-32); }
+.checkout-form .actions .btn-gold { width: 100%; }
+@media (max-width: 1023px) {
+  .cart-line { grid-template-columns: var(--size-marker-w) minmax(0, 1fr) auto; }
+  .cart-line .stepper { grid-column: 2; }
+  .cart-line-total { grid-column: 3; grid-row: 1; }
+  .cart-line .line-remove { grid-column: 3; justify-self: end; }
 }
