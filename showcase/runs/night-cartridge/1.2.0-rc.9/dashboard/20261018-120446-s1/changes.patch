+/* ---------- settings ---------- */
+.settings { display: grid; grid-template-columns: var(--size-sidebar) minmax(0, 1fr); gap: var(--space-24); }
+.sidebar {
+  background: var(--color-surface-subtle); border-right: var(--border-width-control) solid var(--color-border-default);
+  position: relative; margin-top: calc(-1 * var(--space-40)); padding: var(--space-40) 0 var(--space-24);
