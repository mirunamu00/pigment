+.breadcrumb [aria-current]{color:var(--color-text-primary)}
+.detail-head{display:flex;flex-direction:column;gap:var(--space-16)}
+.tabs{display:flex;gap:var(--space-4);border-bottom:var(--border-width-control) solid var(--color-border-strong)}
+.tab{display:inline-flex;align-items:center;gap:var(--space-8);height:var(--size-control);padding:0 var(--space-12);margin-bottom:calc(-1 * var(--border-width-control));background:transparent;color:var(--color-text-secondary);border:var(--border-width-control) solid transparent;border-bottom:0;cursor:pointer}
+.tab>.cur{visibility:hidden}
+.tab:hover{background:var(--color-surface-hover);color:var(--color-text-strong)}
+.tab[aria-selected="true"]{color:var(--color-text-strong);background:var(--color-surface-default);border-color:var(--color-border-strong);height:calc(var(--size-control) + var(--border-width-control))}
+.tab[aria-selected="true"]>.cur{visibility:visible}
+.tab:focus-visible{outline-offset:-4px}
+.tabpanel{display:flex;flex-direction:column;gap:var(--space-24);padding-top:var(--space-24)}
+.details{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-16)}
+.details>div{display:flex;flex-direction:column;gap:var(--space-4);padding:var(--space-16) var(--space-20);background:var(--color-surface-subtle);border-top:var(--border-width-control) solid var(--color-border-default)}
+.details dt{color:var(--color-text-secondary);font-size:var(--font-size-caption);line-height:var(--font-line-height-caption)}
+.details dd{color:var(--color-text-strong);display:flex;flex-direction:column;gap:var(--space-8)}
+.progress-row{display:flex;flex-direction:column;gap:var(--space-4)}
+.progress-row>p{color:var(--color-text-secondary);font-size:var(--font-size-caption);line-height:var(--font-line-height-caption)}
+.task-list{list-style:none;margin:0;padding:0}
+.task{display:flex;align-items:center;gap:var(--space-8);min-height:var(--size-row);padding-block:var(--space-8)}
+.task+.task{background:linear-gradient(90deg,var(--color-border-control) 2px,transparent 0) 0 0/6px 2px repeat-x}
+.task label{flex:1;cursor:pointer}
+.task-done label{color:var(--color-text-secondary)}
+.task-assignee{color:var(--color-text-secondary);font-size:var(--font-size-caption);line-height:var(--font-line-height-caption)}
+@media (max-width:1023px){.details{grid-template-columns:repeat(2,minmax(0,1fr))}}
+@media (max-width:599px){.details{grid-template-columns:1fr}.task{flex-wrap:wrap}.task-assignee{flex-basis:100%;padding-left:var(--space-24)}}
+
+/* Error and settings */
+.not-found{display:flex;flex-direction:column;align-items:center;gap:var(--space-24);padding-top:var(--space-24)}
+.message-window{width:min(var(--size-dialog),100%)}
+.message-window__body{display:flex;flex-direction:column;align-items:flex-start;gap:var(--space-16);padding:var(--space-20)}
+.message-window__body>p{line-height:var(--font-line-height-prose)}
+.settings-window__body{display:flex;flex-direction:column;align-items:flex-start;gap:var(--space-16);padding:var(--space-20)}
+.settings-window__body h2{font-size:var(--font-size-body);line-height:var(--font-line-height-ui)}
+
+/* ───────── Small layouts ───────── */
+@media (max-width:1023px){
+  .topbar__inner{flex-wrap:wrap;height:auto;min-height:var(--size-header);padding-block:var(--space-12);row-gap:var(--space-12)}
+  .topbar-search{order:5;flex:1 1 100%;max-width:none;margin-left:0}
+  .app-body{grid-template-columns:1fr}
+  .sidebar{border-right:0;border-bottom:var(--border-width-control) solid var(--color-border-default);padding:var(--space-8) var(--space-16)}
+  .sidebar__title{display:none}
+  .nav-list{display:flex;flex-wrap:wrap;gap:var(--space-4) var(--space-8)}
+  .nav-list>li+li::before{display:none}
+  .content{max-width:none}
+}
+@media (max-width:599px){
+  .topbar__inner{padding-inline:var(--space-16);gap:var(--space-8)}
+  .tool__label,.user-menu-name{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
+  .nav-list{display:grid;grid-template-columns:1fr 1fr}
+  .nav-link .icon,.nav-link__count{display:none}
+  .content{padding-inline:var(--space-16);gap:var(--space-40)}
+  .title-block{padding:var(--space-20) var(--space-16)}
+  .title-block .button,.btn-gold{width:100%}
+  .toolbar .field{flex-basis:100%}
+}
+@media (pointer:coarse){
+  .tool,.chip,.button,.tab,.input,.controls :is(button,input:not([type=checkbox],[type=radio])){min-height:var(--size-touch)}
+  .tool{min-width:var(--size-touch);justify-content:center}
 }
