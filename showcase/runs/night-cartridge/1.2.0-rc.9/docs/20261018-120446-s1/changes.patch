+const WIDE = '(min-width: 1024px)';
+const subscribeWide = (onChange: () => void) => {
+  const query = window.matchMedia(WIDE);
+  query.addEventListener('change', onChange);
+  return () => query.removeEventListener('change', onChange);
+};
+const useWide = () =>
+  useSyncExternalStore(
+    subscribeWide,
+    () => window.matchMedia(WIDE).matches,
+    () => true,
+  );
+
+/** The heading under the header is current; the first one on load. */
+function useCurrentHeading(entries: TocEntry[]) {
+  const [current, setCurrent] = useState(entries[0]?.id);
+  useEffect(() => {
+    setCurrent(entries[0]?.id);
+    function update() {
+      const header = document.querySelector('.site-header')?.getBoundingClientRect().bottom ?? 0;
+      let id = entries[0]?.id;
+      for (const entry of entries) {
+        const element = document.getElementById(entry.id);
+        if (element && element.getBoundingClientRect().top <= header + 24) id = entry.id;
+      }
+      setCurrent(id);
+    }
+    update();
+    window.addEventListener('scroll', update, { passive: true });
+    window.addEventListener('hashchange', update);
+    return () => {
+      window.removeEventListener('scroll', update);
+      window.removeEventListener('hashchange', update);
+    };
+  }, [entries]);
+  return current;
+}
