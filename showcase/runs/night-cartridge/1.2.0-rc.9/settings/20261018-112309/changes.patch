+.switch::after { content: ""; position: absolute; top: 2px; left: 2px; width: var(--space-8); height: var(--space-8); background: var(--color-text-secondary); }
+.switch:hover { border-color: var(--color-border-strong); }
+.switch:checked { background: var(--color-surface-hover); }
+.switch:checked::after { left: auto; right: 2px; background: var(--color-text-accent); }
+.switch-state { flex: none; width: 3ch; font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); color: var(--color-text-secondary); }
+
+/* ---------- Password strength ---------- */
+.strength-none { color: var(--color-text-secondary); }
+.strength-weak { color: var(--color-status-danger); }
+.strength-fair { color: var(--color-status-warning); }
+.strength-strong { color: var(--color-status-success); }
+
+/* ---------- Tables ---------- */
+.table-wrap { overflow-x: auto; }
+.table { width: 100%; border-collapse: collapse; }
+.table th { height: var(--size-row); padding: 0 var(--space-12); text-align: left; white-space: nowrap; background: var(--color-surface-subtle); color: var(--color-text-strong); border-bottom: var(--border-width-control) solid var(--color-border-strong); }
+.table td { height: var(--size-row); padding: var(--space-4) var(--space-12); color: var(--color-text-primary); border-bottom: var(--border-width-control) solid var(--color-border-default); vertical-align: middle; }
+.table :is(th, td):first-child { padding-left: var(--space-16); }
+.table .gutter { position: relative; }
+.table .gutter > .cur { position: absolute; left: var(--space-4); top: 50%; translate: 0 -50%; visibility: hidden; }
+.table tr.is-current .gutter > .cur { visibility: visible; }
+.table tr.is-current td { color: var(--color-text-strong); }
+.table th.numeric, .table td.numeric { text-align: right; }
+.cell-actions { text-align: right; width: 1%; white-space: nowrap; }
+.cell-inner { display: inline-flex; align-items: center; flex-wrap: wrap; gap: var(--space-4) var(--space-12); }
+@media (max-width: 599px) {
+  .table { width: 100%; }
+  .table :is(th, td):not([data-pin]) { display: none; }
+  .table :is(th, td) { height: var(--size-row); white-space: nowrap; }
+  .table .sub { display: none; }
+  .table [data-pin="first"] { width: 100%; max-width: 0; overflow: hidden; text-overflow: ellipsis; }
+  .table [data-pin]:not([data-pin="first"]) { width: 1%; }
+}
+
+/* ---------- Badges ---------- */
+.pill { display: inline-flex; align-items: center; gap: var(--space-8); padding: 0 var(--space-8); color: var(--color-text-primary); }
+.pill::before { content: ""; flex: none; width: var(--size-bullet); height: var(--size-bullet); background: var(--tone, var(--color-status-info)); }
+.pill.small { font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); }
+.table .pill { padding-left: 0; }
+.table .gutter .pill { margin-left: var(--space-12); }
+.pill-paid, .pill-current { --tone: var(--color-status-success); }
+.pill-due { --tone: var(--color-status-warning); }
+.pill-neutral { --tone: var(--color-status-info); }
+
+/* ---------- Plan cards ---------- */
+.plan-grid { margin-bottom: var(--space-16); }
+.card { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-12); padding: var(--space-16) var(--space-20) var(--space-20); background: var(--color-surface-subtle); border: var(--border-width-control) solid transparent; border-top: var(--border-width-window) solid var(--hue, var(--color-border-default)); }
+.card > .pixel-icon { color: var(--hue); }
+.plan-card-current { border-color: var(--color-text-accent); border-top-color: var(--hue); }
+.plan-card-current .card-title > .cur { visibility: visible; }
+.plan-price { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--space-8); }
+.plan-amount { font-size: var(--font-size-display); line-height: var(--font-line-height-display); color: var(--color-text-strong); }
+.feature-list { flex: 1; align-self: stretch; }
+.feature-list li { display: flex; align-items: center; gap: var(--space-8); padding: var(--space-4) 0; }
+.feature-list li + li { background: linear-gradient(90deg, var(--color-border-control) 2px, transparent 0) 0 0 / 6px 2px repeat-x; }
+.feature-list .pixel-icon { color: var(--color-text-secondary); }
+.plan-card .pill { margin: 0; min-height: var(--size-control); padding-left: 0; }
+.plan-card .button { align-self: flex-start; }
+
+/* ---------- Payment method ---------- */
+.payment-method { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-12); padding: var(--space-20); }
+.payment-method > .pixel-icon { color: var(--color-text-secondary); }
+
+/* ---------- Dialog ---------- */
+.dialog { width: min(var(--size-dialog), 100% - var(--space-32)); max-width: none; padding: 0; color: var(--color-text-primary); background: var(--color-surface-raised); border: var(--border-width-window) solid var(--color-border-strong); box-shadow: var(--shadow-hard); }
+.dialog::backdrop { background: var(--color-surface-overlay); }
+.dialog .window__bar h2 { flex: 1; min-width: 0; font-size: var(--font-size-body); line-height: var(--font-line-height-ui); color: var(--color-text-strong); }
+.dialog-body { padding: var(--space-20); line-height: var(--font-line-height-prose); }
+.dialog-actions { justify-content: flex-end; padding: 0 var(--space-20) var(--space-20); }
+
+/* ---------- Not found ---------- */
+.empty-state { display: flex; align-items: flex-start; gap: var(--space-24); max-width: var(--size-dialog); padding: var(--space-24); }
+.empty-state__text { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-16); }
+.empty-state .btn-gold { display: inline-flex; align-items: center; text-decoration: none; }
+
+/* ---------- Coarse pointers ---------- */
+@media (pointer: coarse) {
+  :is(.button, .tool, .input, .item) { min-height: var(--size-touch); }
+  .button-icon { min-width: var(--size-touch); }
+}
+
+/* ---------- Under breakpoint.lg: sidebar becomes a top menu ---------- */
+@media (max-width: 1023px) {
+  .settings-layout { flex-direction: column; }
+  .sidebar { width: auto; min-height: 0; padding: var(--space-8) var(--space-24); border-right: 0; border-bottom: var(--border-width-control) solid var(--color-border-default); }
+  .sidebar__title { display: none; }
+  .nav-list { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-8); }
+  .nav-list li + li::before { display: none; }
+  .content { max-width: none; }
+}
+
+/* ---------- Under breakpoint.sm ---------- */
+@media (max-width: 599px) {
+  .topbar__row { padding-inline: var(--space-16); gap: var(--space-8); }
+  .topbar__tools { gap: var(--space-4); }
+  .tool__label, .person__name { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
+  .person { margin-left: 0; }
+  .sidebar { padding: var(--space-8) var(--space-16); }
+  .nav-list { display: grid; grid-template-columns: 1fr 1fr; }
+  .content { gap: var(--space-40); padding: var(--space-40) var(--space-16) calc(var(--space-64) + var(--size-ground-sprite)); }
+  .title-block { padding: var(--space-20); }
+  .form-actions > .button, .form-actions > .btn-gold { flex: 1 1 100%; }
+  .avatar-row { align-items: flex-start; }
+  .empty-state { flex-direction: column; }
