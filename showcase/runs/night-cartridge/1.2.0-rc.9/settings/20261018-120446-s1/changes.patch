+
+@keyframes nc-blink {
+  50% {
+    opacity: var(--opacity-dim);
+  }
+}
+@keyframes nc-twinkle {
+  60% {
+    opacity: var(--opacity-twinkle);
+  }
+  80% {
+    opacity: 1;
+  }
+}
+@keyframes nc-sparkle {
+  70% {
+    transform: scale(0.34);
+  }
+  85% {
+    transform: scale(1);
+  }
+}
+@keyframes nc-bob {
+  50% {
+    transform: translateY(var(--bob, -4px));
+  }
+}
+@keyframes nc-swap {
+  50% {
+    opacity: 0;
+  }
+}
+@keyframes nc-beacon {
+  50% {
+    fill: var(--color-art-beacon-off);
+  }
+}
+@keyframes nc-drift {
+  from {
+    transform: translateX(var(--from));
+  }
+  to {
+    transform: translateX(var(--to));
+  }
+}
+@keyframes nc-rare {
+  0%,
+  90% {
+    opacity: 0;
+    transform: none;
+    animation-timing-function: steps(1);
+  }
+  90.1% {
+    opacity: 1;
+    transform: none;
+    animation-timing-function: steps(5);
+  }
+  100% {
+    opacity: 1;
+    transform: translate(var(--dx), var(--dy));
+  }
+}
+@keyframes nc-nudge {
+  50% {
+    transform: translateX(2px);
+  }
+}
+.blink {
+  animation: nc-blink var(--d, var(--motion-duration-led-a)) var(--motion-easing-frame) var(--o, 0ms) infinite;
+}
+.blink:nth-of-type(3n + 2) {
+  --d: var(--motion-duration-led-b);
+  --o: -500ms;
+}
+.blink:nth-of-type(3n) {
+  --d: var(--motion-duration-led-c);
+}
+.twinkle {
+  animation: nc-twinkle var(--motion-duration-twinkle) var(--motion-easing-frame) var(--o, 0ms) infinite;
+}
+.twinkle.t2 {
+  --o: -800ms;
+}
+.twinkle.t3 {
+  --o: -1600ms;
+}
+.bob {
+  animation: nc-bob var(--motion-duration-bob) var(--motion-easing-frame) infinite;
+}
+.frame-b {
+  animation: nc-swap var(--motion-duration-fan) var(--motion-easing-frame) infinite;
+}
+.frame-a {
+  animation: nc-swap var(--motion-duration-fan) var(--motion-easing-frame) calc(var(--motion-duration-fan) / -2) infinite;
+}
+.beacon {
+  animation: nc-beacon var(--motion-duration-beacon) var(--motion-easing-frame) infinite;
+}
+.drift {
+  animation: nc-drift var(--motion-duration-drift) steps(var(--n)) var(--o, 0ms) infinite;
+}
