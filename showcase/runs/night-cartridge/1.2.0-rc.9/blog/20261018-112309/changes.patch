+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
+import { Marker } from './pixel';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const WIDE = '(min-width: 1024px)';
+
+// Contents list: one item is always current — the first heading on load, then the heading
+// under the header as the reader scrolls. Under breakpoint.lg it folds into a disclosure.
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const [current, setCurrent] = useState(headings[0]?.id);
+  const [wide, setWide] = useState(() => window.matchMedia(WIDE).matches);
+  const [open, setOpen] = useState(false);
+
+  useEffect(() => {
+    const query = window.matchMedia(WIDE);
+    const onChange = () => setWide(query.matches);
+    query.addEventListener('change', onChange);
+    return () => query.removeEventListener('change', onChange);
+  }, []);
+
+  useEffect(() => {
+    setCurrent(headings[0]?.id);
+    function onScroll() {
+      const header = document.querySelector('.site-header');
+      const line = (header?.getBoundingClientRect().bottom ?? 0) + 24;
+      let id = headings[0]?.id;
+      for (const heading of headings) {
+        const el = document.getElementById(heading.id);
+        if (el && el.getBoundingClientRect().top <= line) id = heading.id;
+      }
+      setCurrent(id);
+    }
+    onScroll();
+    window.addEventListener('scroll', onScroll, { passive: true });
+    window.addEventListener('hashchange', onScroll);
+    return () => {
+      window.removeEventListener('scroll', onScroll);
+      window.removeEventListener('hashchange', onScroll);
+    };
+    // headings change only with the post
+  }, [blocks]);
+
   if (headings.length === 0) return null;
 
   return (
-    <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
+    <details
+      className="toc-disclosure"
+      open={wide || open}
+      onToggle={(event) => {
+        if (!wide) setOpen(event.currentTarget.open);
+      }}
+    >
+      <summary className="toc-summary">
         On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
-    </nav>
+        <Marker small />
+      </summary>
+      <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
+        <h2 id="toc-heading" className="toc-heading">
+          On this page
+        </h2>
+        <ol className="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a
+                href={`#${heading.id}`}
+                className="item toc-link"
+                aria-current={current === heading.id ? 'location' : undefined}
+                data-testid="toc-link"
+              >
