+/** A small highlighter: comments, strings, numbers, keywords, flags and markdown headings. */
+function highlight(code: string, language: string): ReactNode[] {
+  return code.split('\n').flatMap((line, li) => {
+    const out: ReactNode[] = li ? ['\n'] : [];
+    if ((language === 'bash' && line.startsWith('#')) || line.trim().startsWith('//')) {
+      out.push(<span key={`c${li}`} className="tok-comment">{line}</span>);
+      return out;
+    }
+    if (language === 'markdown' && line.startsWith('#')) {
+      out.push(<span key={`h${li}`} className="tok-keyword">{line}</span>);
+      return out;
+    }
+    const tokens = line.match(/'[^']*'|\b\d[\d.]*\b|--?[a-z][\w-]*|\b[A-Za-z_]\w*\b/g) ?? [];
+    let rest = line;
+    tokens.forEach((tok, ti) => {
+      const at = rest.indexOf(tok);
+      if (at > 0) out.push(rest.slice(0, at));
+      rest = rest.slice(at + tok.length);
+      let cls = '';
+      if (tok.startsWith("'")) cls = 'tok-string';
+      else if (/^\d/.test(tok)) cls = 'tok-literal';
+      else if (/^--?[a-z]/.test(tok) && language === 'bash') cls = 'tok-literal';
+      else if (KEYWORDS.test(tok)) cls = 'tok-keyword';
