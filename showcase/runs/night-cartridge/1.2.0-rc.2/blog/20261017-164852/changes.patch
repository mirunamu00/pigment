+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
+import { useMediaQuery } from '../lib/hues';
+import { Marker } from './ui/Pixel';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+/** Contents list: the heading under the header is current; a disclosure under the lg breakpoint. */
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const wide = useMediaQuery('(min-width: 1024px)');
+  const [open, setOpen] = useState(false);
+  const [current, setCurrent] = useState(headings[0]?.id);
+
+  useEffect(() => {
+    const ids = blocks.filter((block): block is Heading => block.type === 'heading').map((h) => h.id);
+    function update() {
+      const line = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
+      let next = ids[0];
+      for (const id of ids) {
+        const el = document.getElementById(id);
+        if (el && el.getBoundingClientRect().top <= line + 1) next = id;
+      }
+      setCurrent(next);
+    }
+    update();
+    window.addEventListener('scroll', update, { passive: true });
+    window.addEventListener('hashchange', update);
+    return () => {
+      window.removeEventListener('scroll', update);
+      window.removeEventListener('hashchange', update);
+    };
+  }, [blocks]);
+
   if (headings.length === 0) return null;
 
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      <details
+        className="toc-details"
+        open={wide || open}
+        onToggle={(event) => {
+          const el = event.currentTarget;
+          if (wide && !el.open) el.open = true;
+          else if (!wide) setOpen(el.open);
+        }}
+      >
+        <summary tabIndex={wide ? -1 : undefined}>
+          <Marker />
+          <h2 id="toc-heading" className="toc-heading">
+            On this page
+          </h2>
+        </summary>
+        <ol className="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a
+                href={`#${heading.id}`}
+                className="item toc-link"
+                aria-current={current === heading.id ? 'location' : undefined}
+                data-testid="toc-link"
+              >
+                <Marker />
+                {heading.text}
+              </a>
+            </li>
+          ))}
+        </ol>
+      </details>
     </nav>
