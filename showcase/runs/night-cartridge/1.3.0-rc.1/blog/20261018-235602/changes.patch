+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
+import { BlockMeter, Marker } from './pixel/Chrome';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const WIDE = '(min-width: 1024px)';
+
+function useWide() {
+  const [wide, setWide] = useState(() => window.matchMedia(WIDE).matches);
+  useEffect(() => {
+    const query = window.matchMedia(WIDE);
+    const onChange = () => setWide(query.matches);
+    query.addEventListener('change', onChange);
+    return () => query.removeEventListener('change', onChange);
+  }, []);
+  return wide;
+}
+
+/** The heading under the header is current; the first one on load. */
+function useCurrentHeading(ids: string[]) {
+  const [current, setCurrent] = useState(ids[0]);
+  useEffect(() => {
+    setCurrent(ids[0]);
+    function update() {
+      const line = 64 + 4 + 48;
+      let next = ids[0];
+      for (const id of ids) {
+        const el = document.getElementById(id);
+        if (el && el.getBoundingClientRect().top <= line) next = id;
+      }
+      setCurrent(next);
+    }
+    update();
+    window.addEventListener('scroll', update, { passive: true });
+    window.addEventListener('hashchange', update);
+    return () => {
+      window.removeEventListener('scroll', update);
+      window.removeEventListener('hashchange', update);
+    };
+  }, [ids.join('|')]);
+  return current;
+}
+
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const wide = useWide();
+  const current = useCurrentHeading(headings.map((heading) => heading.id));
   if (headings.length === 0) return null;
+  const currentIndex = Math.max(0, headings.findIndex((heading) => heading.id === current));
 
-  return (
-    <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
+  const title = (
+    <h2 id="toc-heading" className="toc-heading">
+      On this page
+    </h2>
+  );
+  const list = (
+    <>
       <ol className="toc-list">
         {headings.map((heading) => (
           <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
+            <a
+              href={`#${heading.id}`}
+              className="toc-link item"
+              aria-current={heading.id === current ? 'location' : undefined}
+              data-testid="toc-link"
+            >
+              <Marker />
               {heading.text}
             </a>
           </li>
         ))}
       </ol>
+      <p className="toc-progress caption">
+        Section {currentIndex + 1} of {headings.length}
+      </p>
+      <BlockMeter value={currentIndex + 1} max={headings.length} label="Sections reached" />
+    </>
+  );
+
+  return (
+    <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
+      {wide ? (
+        <>
+          {title}
+          {list}
+        </>
+      ) : (
+        <details className="disclosure">
+          <summary>
+            {title}
+            <Marker className="disclosure__marker" />
+          </summary>
+          <div className="disclosure__body">{list}</div>
+        </details>
+      )}
     </nav>
   );
 }
