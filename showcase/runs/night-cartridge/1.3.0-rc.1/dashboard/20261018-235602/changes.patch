+  .header-row { flex-wrap: wrap; height: auto; min-height: var(--size-header); padding: var(--space-12) var(--space-24); row-gap: var(--space-12); }
+  .brand { width: auto; }
+  .topbar-search { order: 3; flex-basis: 100%; max-width: none; }
+  .sidebar { border-right: 0; border-bottom: var(--border-width-control) solid var(--color-border-default); padding: var(--space-8) var(--space-16); }
+  .nav-group { display: none; }
+  .nav-list { display: flex; flex-wrap: wrap; gap: var(--space-4); padding: 0; }
+  .details { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+
+/* ---------- Under breakpoint.sm ---------- */
+@media (max-width: 599px) {
+  .header-row { padding-inline: var(--space-16); gap: var(--space-8); }
+  .tool-label, .user-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
+  .tool { min-width: var(--size-touch); justify-content: center; }
+  .nav-list { display: grid; grid-template-columns: 1fr 1fr; }
+  .content { padding-inline: var(--space-16); }
+  .content > * + * { margin-top: var(--space-40); }
+  .kpis { grid-template-columns: 1fr; }
+  .title-block { padding: var(--space-20); }
+  .controls > *, .controls .field, .chip-group { width: 100%; }
+  .table { width: 100%; }
+  .table :is(th, td):not([data-pin]) { display: none; }
+  .table :is(th, td) { height: var(--size-row); white-space: nowrap; }
+  .table .sub { display: none; }
+  .table [data-pin='first'] { width: 100%; max-width: 0; overflow: hidden; text-overflow: ellipsis; }
+  .table [data-pin]:not([data-pin='first']) { width: 1%; }
+  .table-person > .avatar { display: none; }
+  .details { grid-template-columns: minmax(0, 1fr); }
+}
+
+/* Coarse pointers: every control in a row grows to size.touch together, so rows stay level. */
+@media (pointer: coarse) {
+  .item, .tool, .tab, .sort-button { min-height: var(--size-touch); }
+  .button, .chip, .input, .controls :is(button, input:not([type='checkbox'], [type='radio'])) { height: var(--size-touch); }
 }
