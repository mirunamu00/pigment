+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
+import { Marker } from '../pixel/components';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+/** Offset below the sticky header at which a heading counts as the current one. */
+const CURRENT_LINE = 120;
+
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const [current, setCurrent] = useState(headings[0]?.id);
+  const [open, setOpen] = useState(false);
+  const ids = headings.map((heading) => heading.id).join(' ');
+
+  // Marker on the heading being read: the last one whose top has passed under the header.
+  useEffect(() => {
+    const list = ids.split(' ').filter(Boolean);
+    function update() {
+      let active = list[0];
+      for (const id of list) {
+        const element = document.getElementById(id);
+        if (element && element.getBoundingClientRect().top <= CURRENT_LINE) active = id;
+      }
+      setCurrent(active);
+    }
+    update();
+    window.addEventListener('scroll', update, { passive: true });
+    window.addEventListener('hashchange', update);
+    return () => {
+      window.removeEventListener('scroll', update);
+      window.removeEventListener('hashchange', update);
+    };
+  }, [ids]);
+
   if (headings.length === 0) return null;
 
   return (
-    <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
+    <nav className="toc" aria-labelledby="toc-heading" data-testid="toc" data-open={open || undefined}>
       <h2 id="toc-heading" className="toc-heading">
         On this page
       </h2>
-      <ol className="toc-list">
+      <button
+        type="button"
+        className="toc-toggle item"
+        aria-expanded={open}
+        aria-controls="toc-list"
+        onClick={() => setOpen((value) => !value)}
+      >
+        <Marker dir={open ? 'd' : 'r'} />
+        Contents
+      </button>
+      <ol className="toc-list" id="toc-list">
         {headings.map((heading) => (
           <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
+            <a
+              href={`#${heading.id}`}
+              className="toc-link item"
+              aria-current={current === heading.id ? 'location' : undefined}
+              data-testid="toc-link"
+            >
+              <Marker />
               {heading.text}
             </a>
           </li>
