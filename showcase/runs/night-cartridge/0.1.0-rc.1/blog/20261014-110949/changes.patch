+import { useMemo } from 'react';
+import { R } from '../pixel/art';
+
+const NOTE_HUES = ['h-cyan', 'h-violet', 'h-blue', 'h-amber', 'h-green', 'h-pink'];
+
+/**
+ * Missing images are drawn as a pixel sprite on the raised surface: a pinned board of
+ * grouped notes (the inventory board), 96×48 units at 2px.
+ */
+function boardSprite(): string {
+  let s = R(4, 4, 88, 40, 'ol') + R(5, 5, 86, 38, 'board') + R(5, 5, 86, 1, 'board-hi') + R(5, 42, 86, 1, 'board-sh');
+  NOTE_HUES.forEach((hue, col) => {
+    const x = 9 + col * 14;
+    const count = 2 + ((col * 5) % 3);
+    for (let i = 0; i < count; i++) {
+      const y = 9 + i * 10;
+      s += R(x, y, 10, 8, 'ol') + R(x + 1, y + 1, 8, 6, hue) + R(x + 2, y + 3, 6, 1, 'glint');
+      s += R(x + 4, y, 2, 1, 'warm');
+    }
+  });
+  return s;
+}
+
 export default function ImagePlaceholder({ alt }: { alt: string }) {
+  const body = useMemo(boardSprite, []);
   return (
-    <svg className="image-placeholder" viewBox="0 0 640 320" role="img" aria-label={alt}>
-      <rect className="image-placeholder-bg" x="0" y="0" width="640" height="320" />
-      <circle className="image-placeholder-shape" cx="220" cy="120" r="36" />
-      <path className="image-placeholder-shape" d="M120 260 L260 150 L360 230 L440 170 L540 260 Z" />
-    </svg>
+    <div className="image-placeholder">
+      <svg
+        viewBox="0 0 96 48"
+        width="192"
+        height="96"
+        role="img"
+        aria-label={alt}
+        shapeRendering="crispEdges"
+        dangerouslySetInnerHTML={{ __html: body }}
+      />
+    </div>
   );
 }
