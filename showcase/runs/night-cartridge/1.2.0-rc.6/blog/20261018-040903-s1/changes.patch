@@ -1,9 +1,16 @@
+import PixelScene from './PixelScene';
+
+// Missing article images become inline pixel figures; the alt text stays the accessible name.
+function figureIndex(alt: string) {
+  const text = alt.toLowerCase();
+  if (text.includes('button')) return 0;
+  if (text.includes('release note')) return 1;
+  if (text.includes('flag')) return 2;
+  let h = 0;
+  for (const ch of text) h = (h + ch.charCodeAt(0)) % 3;
+  return h;
+}
+
 export default function ImagePlaceholder({ alt }: { alt: string }) {
-  return (
-    <svg className="image-placeholder" viewBox="0 0 640 320" role="img" aria-label={alt}>
-      <rect className="image-placeholder-bg" x="0" y="0" width="640" height="320" />
-      <circle className="image-placeholder-shape" cx="220" cy="120" r="36" />
-      <path className="image-placeholder-shape" d="M120 260 L260 150 L360 230 L440 170 L540 260 Z" />
-    </svg>
-  );
+  return <PixelScene scene={`figure:${figureIndex(alt)}`} variant="figure" label={alt} />;
 }
