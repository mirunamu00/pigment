@@ -1,25 +1,68 @@
+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
+import { Marker } from './pixel/Pixel';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const WIDE = '(min-width: 1024px)';
+
+/** Contents list: one item is always current, the heading under the header as the reader scrolls. */
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const [current, setCurrent] = useState(headings[0]?.id);
+  const [open, setOpen] = useState(() => typeof window !== 'undefined' && window.matchMedia(WIDE).matches);
+
+  useEffect(() => {
+    setCurrent(headings[0]?.id);
+    function onScroll() {
+      const line = 64 + 48;
+      let id = headings[0]?.id;
+      for (const h of headings) {
+        const el = document.getElementById(h.id);
+        if (el && el.getBoundingClientRect().top <= line) id = h.id;
+      }
+      setCurrent(id);
+    }
+    onScroll();
+    window.addEventListener('scroll', onScroll, { passive: true });
+    return () => window.removeEventListener('scroll', onScroll);
+  }, [blocks]);
+
+  // On wide screens the list is always open; below 1024px it is a disclosure.
+  useEffect(() => {
+    const mq = window.matchMedia(WIDE);
+    const sync = () => mq.matches && setOpen(true);
+    mq.addEventListener('change', sync);
+    return () => mq.removeEventListener('change', sync);
+  }, []);
+
   if (headings.length === 0) return null;
 
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      <details className="disclosure toc-disclosure" open={open} onToggle={(event) => setOpen(event.currentTarget.open)}>
+        <summary className="toc-summary">
+          <h2 id="toc-heading" className="toc-heading">
+            On this page
+          </h2>
+          <Marker dir={open ? 'd' : 'r'} className="disclosure-marker" />
+        </summary>
+        <ol className="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a
+                href={`#${heading.id}`}
+                className="toc-link item"
+                data-testid="toc-link"
+                aria-current={current === heading.id ? 'location' : undefined}
+              >
+                <Marker />
+                {heading.text}
+              </a>
+            </li>
+          ))}
+        </ol>
+      </details>
     </nav>
   );
 }
