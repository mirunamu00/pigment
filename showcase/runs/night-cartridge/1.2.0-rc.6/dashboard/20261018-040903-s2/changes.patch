index 226849f..2592005 100644
--- a/src/data/projects.ts
+++ b/src/data/projects.ts
@@ -188,3 +188,14 @@ export const projects: Project[] = [
 export function findProject(id: string | undefined): Project | undefined {
   return projects.find((project) => project.id === id);
 }
+
+// Each project owns one hue, in the design system's fixed hue order.
+const HUE_ORDER = ['cyan', 'violet', 'blue', 'amber', 'green', 'pink', 'orange', 'teal'] as const;
+
+export function projectIndex(id: string): number {
+  return Math.max(0, projects.findIndex((project) => project.id === id));
+}
+
+export function projectHue(id: string): (typeof HUE_ORDER)[number] {
+  return HUE_ORDER[projectIndex(id) % HUE_ORDER.length];
+}
