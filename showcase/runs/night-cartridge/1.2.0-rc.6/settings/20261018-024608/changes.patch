+}
+@media (max-width: 767px) {
+  .nav-list {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+@media (max-width: 599px) {
+  .topbar__inner,
+  .settings-layout {
+    padding-inline: var(--space-16);
+  }
+  .tool__label,
+  .person__name {
+    position: absolute;
