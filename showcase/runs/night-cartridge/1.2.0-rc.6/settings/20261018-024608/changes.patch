+/** A persisted on/off preference mirrored onto an attribute of <html>. */
+function usePreference(key: string, attr: 'data-motion' | 'data-body', offValue: string) {
+  const [on, setOn] = useState(() => document.documentElement.getAttribute(attr) !== offValue);
