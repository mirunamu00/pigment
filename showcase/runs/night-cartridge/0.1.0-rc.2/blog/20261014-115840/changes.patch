+const KEYWORDS = new Set([
+  'const', 'let', 'var', 'export', 'import', 'from', 'function', 'return', 'as', 'if', 'else', 'typeof', 'keyof', 'new', 'await', 'async',
+]);
+
+/** Light syntax colouring (color.syntax.*); the text content stays exactly the source. */
+function highlight(code: string, language: string): ReactNode[] {
+  const pattern =
+    language === 'markdown'
+      ? /(^#{1,6} .*$)|(^- )|(\d+(?:\.\d+)*)/gm
+      : /(\/\/.*$|^\s*#.*$)|('(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*"|`[^`]*`)|(\b\d+\b)|(\b[A-Za-z_$][\w$]*\b)(?=\s*\()|(\b[A-Za-z_$][\w$]*\b)|(--?[\w-]+)/gm;
+  const out: ReactNode[] = [];
+  let last = 0;
+  let key = 0;
+  for (const match of code.matchAll(pattern)) {
+    const index = match.index ?? 0;
+    if (index > last) out.push(code.slice(last, index));
+    const [text] = match;
+    let tone: string | null = null;
+    if (language === 'markdown') {
+      tone = match[1] ? 'keyword' : match[2] ? 'literal' : 'literal';
+    } else if (match[1]) tone = 'comment';
+    else if (match[2]) tone = 'string';
+    else if (match[3]) tone = 'literal';
+    else if (match[4]) tone = 'function';
+    else if (match[5]) tone = KEYWORDS.has(text) ? 'keyword' : /^[A-Z]/.test(text) ? 'type' : null;
+    else if (match[6]) tone = 'literal';
+    out.push(tone ? <span key={key++} className={`tok-${tone}`}>{text}</span> : text);
+    last = index + text.length;
+  }
+  if (last < code.length) out.push(code.slice(last));
+  return out;
+}
