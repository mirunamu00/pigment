+/* Contents list */
+.toc { border-left: var(--border-width-control) solid var(--color-border-default); }
+.toc-heading { font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); color: var(--color-text-secondary); padding: 0 var(--space-12) var(--space-8); }
+.toc-list { list-style: none; margin: 0; padding: 0; }
+.toc-link { min-height: 0; padding-block: var(--space-4); align-items: flex-start; }
+.toc-link > .cur { margin-top: 5px; }
+.toc-item-nested .toc-link { padding-left: var(--space-24); }
+
+.disclosure { background: var(--color-surface-subtle); border-left: var(--border-width-window) solid var(--color-border-control); }
+.toc:has(.disclosure) { border-left: 0; }
+.disclosure:hover { border-left-color: var(--color-hue-cyan); }
+.disclosure > summary {
+  display: flex; align-items: center; gap: var(--space-8);
+  min-height: var(--size-row); padding: 0 var(--space-12);
+  list-style: none; cursor: pointer;
+}
+.disclosure > summary::-webkit-details-marker { display: none; }
+.disclosure > summary:hover { background: var(--color-surface-hover); }
+.disclosure .toc-heading { padding: 0; font-size: var(--font-size-body); line-height: var(--font-line-height-ui); color: var(--color-text-strong); }
+.disclosure__closed, .disclosure__open { display: inline-flex; width: var(--size-marker-h); justify-content: center; color: var(--color-text-secondary); }
+.disclosure__open, .disclosure[open] .disclosure__closed { display: none; }
+.disclosure[open] .disclosure__open { display: inline-flex; }
+.disclosure .cur { color: var(--color-text-secondary); background-image: none; }
+.disclosure .toc-list { padding-bottom: var(--space-8); }
+
+/* Prev / next */
+.prev-next {
+  display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-16);
+  margin-top: var(--space-64); padding-top: var(--space-16);
+  border-top: var(--border-width-control) solid var(--color-border-strong);
+}
+.prev-next__link { display: flex; flex-direction: column; gap: var(--space-4); padding: var(--space-12); color: var(--color-text-strong); text-decoration: none; }
+.prev-next__link:hover { background: var(--color-surface-hover); color: var(--color-text-strong); }
+.prev-next__link--next { align-items: flex-end; text-align: right; }
+.prev-next__label { display: inline-flex; align-items: center; gap: var(--space-8); font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); color: var(--color-text-secondary); }
+
+/* ---------- About ---------- */
+
+.prose > p + p { margin-top: var(--space-16); }
+.author-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-16); grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
+.author-card { gap: var(--space-12); }
+.author-card__head { display: flex; align-items: center; gap: var(--space-12); }
+.author-card__bio { line-height: var(--font-line-height-prose); }
+.avatar { flex: none; display: grid; place-items: center; width: 40px; height: 40px; background: var(--color-surface-hover); color: var(--hue); }
+.avatar svg { fill: currentColor; }
+
+/* ---------- Adaptation ---------- */
+
+@media (pointer: coarse) {
+  .item, .tool, .btn, .chip { min-height: var(--size-touch); }
+}
+
+@media (max-width: 1023.98px) {
+  .tool__label { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
+  .tool { width: var(--size-control); padding: 0; }
+
+  .stage--hero { height: var(--size-hero-sm); }
+  .hero__over { position: static; display: block; pointer-events: auto; }
+  .hero__window { width: 100%; max-width: none; margin-top: var(--space-24); }
+
+  .article-layout { grid-template-columns: minmax(0, 1fr); gap: var(--space-24); }
+  .article-aside { position: static; grid-row: 1; }
+}
+
+@media (max-width: 599.98px) {
+  .container { padding-inline: var(--space-16); }
+  .section { margin-top: var(--space-40); }
+  .brand-name { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
+  .site-header-inner { gap: var(--space-8); }
+  .nav-link { padding-inline: var(--space-8); }
+  .banner__body, .hero__window { padding: var(--space-16); }
+  .search { width: 100%; }
+  .field-row { flex-direction: column; align-items: stretch; }
