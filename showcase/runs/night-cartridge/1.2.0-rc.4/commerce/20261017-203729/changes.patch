+/** Animation switch: sets data-motion="off" on <html>, persisted, default on. */
+function MotionSwitch() {
+  const [on, setOn] = useState(() => document.documentElement.dataset.motion !== 'off');
+
+  function toggle() {
+    const next = !on;
+    setOn(next);
+    if (next) delete document.documentElement.dataset.motion;
+    else document.documentElement.dataset.motion = 'off';
+    try {
+      localStorage.setItem(MOTION_KEY, next ? 'on' : 'off');
+    } catch {
+      /* storage unavailable: the switch still works for this visit */
+    }
+  }
+
+  return (
+    <button type="button" className="tool" aria-pressed={on} onClick={toggle}>
+      {on ? <PauseIcon /> : <PlayIcon />}
+      {on ? 'Animation on' : 'Animation off'}
+    </button>
+  );
