+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
+import { Marker } from './Chrome';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const WIDE = '(min-width: 1024px)';
+
+/** Contents list: marker on the current heading; a disclosure under breakpoint.lg. */
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const [current, setCurrent] = useState(headings[0]?.id);
+  const [open, setOpen] = useState(() => window.matchMedia(WIDE).matches);
+
+  useEffect(() => {
+    const media = window.matchMedia(WIDE);
+    const sync = () => setOpen(media.matches);
+    media.addEventListener('change', sync);
+    return () => media.removeEventListener('change', sync);
+  }, []);
+
+  // The current item is the last heading that has scrolled under the header (first one on load).
+  useEffect(() => {
+    setCurrent(headings[0]?.id);
+    function onScroll() {
+      const line = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
+      let id = headings[0]?.id;
+      for (const heading of headings) {
+        const el = document.getElementById(heading.id);
+        if (el && el.getBoundingClientRect().top <= line + 1) id = heading.id;
+      }
+      setCurrent(id);
+    }
+    onScroll();
+    window.addEventListener('scroll', onScroll, { passive: true });
+    return () => window.removeEventListener('scroll', onScroll);
+  }, [blocks]);
