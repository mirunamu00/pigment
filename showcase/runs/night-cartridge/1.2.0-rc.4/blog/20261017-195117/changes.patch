+/* ---------- Badges, tags, chips ---------- */
+.tag-list { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-12); margin: 0; padding: 0; }
+.tag-chip { display: inline-flex; align-items: center; gap: var(--space-8); color: var(--color-text-primary); font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); }
+.tag-filter { display: flex; flex-wrap: wrap; gap: var(--space-8); }
+.chip {
+  display: inline-flex; align-items: center; gap: var(--space-8); height: var(--size-control); padding-inline: var(--space-12);
+  background: transparent; border: var(--border-width-control) solid var(--color-border-default); color: var(--color-text-primary);
+}
+.chip:hover { background: var(--color-surface-hover); color: var(--color-text-strong); }
+.chip:active { translate: 2px 2px; }
+.chip[aria-pressed='true'] { color: var(--color-text-strong); }
+.chip-slot { display: inline-flex; align-items: center; justify-content: center; width: var(--size-marker-w); }
+.chip-slot .bullet { background: var(--hue, var(--color-border-control)); }
+
+/* ---------- Cards ---------- */
+.card-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-16); }
+.card-grid > li { display: flex; }
+.card {
+  position: relative; display: flex; flex-direction: column; gap: var(--space-8); width: 100%;
+  padding: var(--space-16) var(--space-20); background: var(--color-surface-subtle); border-top: var(--border-width-window) solid var(--hue, var(--color-border-default));
+}
+.card.card-link:hover { background: var(--color-surface-hover); }
+.card.card-link:active { translate: 2px 2px; }
+.card .icon { color: var(--hue); }
+.card-title a { color: var(--color-text-strong); text-decoration: none; }
+.card-title a::after { content: ''; position: absolute; inset: 0; }
+.card-title a:focus-visible { outline: none; }
+.card.card-link:has(.card-title a:focus-visible) { outline: var(--border-width-window) solid var(--color-focus-ring); outline-offset: 3px; }
+.card-desc { color: var(--color-text-secondary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
+.card .tag-list { position: relative; margin-top: auto; padding-top: var(--space-4); }
+.card--feature .card-title { font-size: var(--font-size-title); line-height: var(--font-line-height-title); }
+.card--feature { padding: var(--space-20); gap: var(--space-12); }
+.card--feature .card-desc { max-width: var(--size-prose); }
+
+/* ---------- Home ---------- */
+.hero { position: relative; }
+.hero-window { position: absolute; top: 50%; left: 0; right: 0; translate: 0 -50%; pointer-events: none; }
+.hero-window .window { pointer-events: auto; width: 464px; padding: var(--space-24); display: flex; flex-direction: column; gap: var(--space-12); }
+.hero h1 { font-size: var(--font-size-display); line-height: var(--font-line-height-display); }
+.eyebrow { display: flex; align-items: center; gap: var(--space-8); color: var(--color-text-secondary); font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); }
+.lede { color: var(--color-text-primary); line-height: var(--font-line-height-prose); }
+.hero .btn-gold { align-self: flex-start; margin-top: var(--space-8); }
+@media (max-width: 1023px) {
+  .hero-window { position: static; translate: none; margin-top: var(--space-16); }
+  .hero-window .window { width: 100%; }
+}
+@media (max-width: 599px) {
+  .hero-window .window { padding: var(--space-16); }
+  .hero .btn-gold { align-self: stretch; }
+}
+.filter-bar { display: flex; flex-direction: column; gap: var(--space-20); margin-bottom: var(--space-24); }
+.filter-bar .field { max-width: var(--size-form); }
+.count-block { display: flex; flex-direction: column; gap: var(--space-8); margin-bottom: var(--space-24); }
+.empty-state { display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-16); max-width: 400px; margin-inline: auto; padding-block: var(--space-40); }
+.empty-state > p { line-height: var(--font-line-height-prose); }
+
+/* ---------- Banner window (article, about) ---------- */
