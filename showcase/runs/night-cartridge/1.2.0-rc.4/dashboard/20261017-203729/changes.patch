+.table td:first-child > .cur { position: absolute; left: var(--space-12); top: 50%; translate: 0 -50%; visibility: hidden; }
+.table tbody tr.is-link:is(:hover, :focus-within) { background: var(--color-surface-hover); color: var(--color-text-strong); }
+.table tbody tr.is-link:is(:hover, :focus-within) td:first-child > .cur { visibility: visible; }
+.table th.numeric, .table td.numeric { text-align: right; }
+.table .sub { color: var(--color-text-secondary); font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); }
+.table a { color: var(--color-text-strong); }
+.sort-button { display: inline-flex; align-items: center; gap: var(--space-8); height: var(--size-control-sm); padding: 0; background: none; border: 0; color: inherit; cursor: pointer; }
+.sort-button:hover { color: var(--color-text-strong); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
+.sort-indicator { display: inline-flex; width: var(--size-marker-h); }
+.sort-indicator .cur { color: var(--color-text-accent); }
+@media (max-width: 599px) {
+  .table { width: 100%; }
+  .table :is(th, td):not([data-pin]) { display: none; }
+  .table :is(th, td) { height: var(--size-row); white-space: nowrap; }
+  .table .sub { display: none; }
+  .table [data-pin='first'] { width: 100%; max-width: 0; overflow: hidden; text-overflow: ellipsis; }
+  .table [data-pin]:not([data-pin='first']) { width: 1%; }
+  .table tbody td { padding-block: 0; }
+  .table .person-mail { display: none; }
+}
+
+/* Badge (status) */
+.badge { display: inline-flex; align-items: center; gap: var(--space-8); color: var(--color-text-primary); white-space: nowrap; }
+
+/* Empty state */
+.empty-state { display: flex; flex-direction: column; align-items: center; gap: var(--space-16); max-width: 400px; margin-inline: auto; padding-block: var(--space-40); text-align: center; }
+.empty-state p { color: var(--color-text-secondary); line-height: var(--font-line-height-prose); }
+.vignette { width: var(--size-vignette); height: var(--size-vignette); border: var(--border-width-control) solid var(--color-border-control); box-sizing: content-box; background: var(--color-art-sky1); }
+.vignette > svg { shape-rendering: crispEdges; }
+.panel-empty { background: var(--color-surface-subtle); }
+
+/* Error window */
+.error-window { max-width: var(--size-dialog); margin-inline: auto; width: 100%; }
+.error-window .window__bar .bullet { --hue: var(--color-status-danger); }
+.error-body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-16); padding: var(--space-20); }
+.error-body p { color: var(--color-text-secondary); line-height: var(--font-line-height-prose); }
+
+/* Breadcrumb */
+.breadcrumb ol { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-8); padding: 0; color: var(--color-text-secondary); }
+.breadcrumb li + li::before { content: '/'; margin-right: var(--space-8); }
+.breadcrumb a { color: var(--color-text-secondary); text-decoration: none; }
+.breadcrumb a:hover { color: var(--color-text-strong); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
+.detail-head { display: flex; flex-direction: column; gap: var(--space-16); }
+
+/* Tabs */
+.tabs { display: flex; gap: var(--space-4); border-bottom: var(--border-width-control) solid var(--color-border-strong); overflow-x: auto; }
+.tab { display: inline-flex; align-items: center; gap: var(--space-8); height: var(--size-control); padding: 0 var(--space-12); margin-bottom: -2px; background: transparent; color: var(--color-text-secondary); border: var(--border-width-control) solid transparent; border-bottom: 0; cursor: pointer; }
+.tab > .cur { visibility: hidden; }
+.tab:hover { background: var(--color-surface-hover); color: var(--color-text-strong); }
+.tab:focus-visible { outline-offset: -4px; }
+.tab[aria-selected='true'] { color: var(--color-text-strong); background: var(--color-surface-subtle); border-color: var(--color-border-strong); border-bottom: var(--border-width-control) solid var(--color-surface-subtle); }
+.tab[aria-selected='true'] > .cur { visibility: visible; }
+.tab-panel { background: var(--color-surface-subtle); padding: var(--space-20); }
+.tab-panel--table { padding: 0; }
+.tabs-block > .tabs + .tab-panel { border-top: 0; }
+
+.details { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-20) var(--space-16); margin-top: var(--space-24); }
+.details > div { display: flex; flex-direction: column; gap: var(--space-4); padding-top: var(--space-12); border-top: var(--border-width-control) solid var(--color-border-default); }
+.details dt { font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); color: var(--color-text-secondary); }
+.details dd { color: var(--color-text-strong); display: flex; flex-direction: column; gap: var(--space-8); }
+@media (max-width: 1023px) { .details { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+@media (max-width: 599px) { .details { grid-template-columns: minmax(0, 1fr); } }
+
+.progress-row { display: flex; flex-direction: column; gap: var(--space-8); margin-bottom: var(--space-16); }
+.progress-row > p { font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); color: var(--color-text-secondary); }
+.task-list { list-style: none; padding: 0; }
+.task { display: flex; align-items: center; gap: var(--space-8); min-height: var(--size-row); padding-block: var(--space-8); }
+.task + .task { background: linear-gradient(90deg, var(--color-border-control) 2px, transparent 0) 0 0 / 6px 2px repeat-x; }
+.task label { flex: 1; cursor: pointer; color: var(--color-text-primary); }
+.task .muted { flex: none; }
+.task-done label { color: var(--color-text-secondary); text-decoration: line-through; text-decoration-thickness: 2px; }
+@media (max-width: 599px) { .task { flex-wrap: wrap; } .task .muted { width: 100%; padding-left: var(--space-24); } }
+
+/* Team */
+.person { display: flex; align-items: center; gap: var(--space-12); min-width: 0; }
+.person > div { min-width: 0; }
+.person-name { color: var(--color-text-strong); }
+.person-mail { font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); }
+@media (max-width: 599px) { .person { display: inline-flex; vertical-align: middle; } .person > div { overflow: hidden; text-overflow: ellipsis; } }
+
+/* Settings */
+.settings-layout { display: grid; grid-template-columns: var(--size-sidebar) minmax(0, 1fr); gap: var(--space-24); align-items: start; }
+.settings-menu { background: var(--color-surface-subtle); border-right: var(--border-width-control) solid var(--color-border-default); padding: var(--space-12) 0; align-self: stretch; }
+.settings-menu .group-title { padding: 0 var(--space-12) var(--space-8); font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); color: var(--color-text-secondary); }
+.settings-menu ul { list-style: none; padding: 0; }
+.settings-menu .item { cursor: default; }
+.settings-menu .item[aria-disabled='true'] { color: var(--color-text-disabled); }
+.settings-menu .item[aria-disabled='true']:hover { background: transparent; color: var(--color-text-disabled); }
+.settings-body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-16); padding: var(--space-20); }
+.settings-body p { max-width: var(--size-prose); line-height: var(--font-line-height-prose); }
+@media (max-width: 1023px) { .settings-layout { grid-template-columns: minmax(0, 1fr); } .settings-menu { border-right: 0; border-top: var(--border-width-control) solid var(--color-border-default); } }
 
