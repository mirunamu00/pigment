+/* ---------- Cart ---------- */
+.cart-layout { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--space-24); align-items: start }
+.cart-side { display: flex; flex-direction: column; gap: var(--space-24) }
