+.cart-line { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto auto; align-items: center; gap: var(--space-16); padding: var(--space-12) 0 }
+.cart-line + .cart-line { background: linear-gradient(90deg, var(--color-border-control) 2px, transparent 0) 0 0/6px 2px repeat-x }
+.cart-line-thumb { display: block; border: var(--border-width-control) solid var(--color-border-control); background: var(--color-surface-raised) }
+.cart-line-info { display: flex; flex-direction: column }
+.cart-line-name { color: var(--color-text-strong) }
+.cart-line-total { min-width: 80px; text-align: right }
+.summary-row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-16); padding: var(--space-4) 0 }
+.summary-row dt { color: var(--color-text-secondary) }
+.summary-row dd { color: var(--color-text-strong) }
+.summary-total { margin-top: var(--space-8); padding-top: var(--space-12); background: linear-gradient(90deg, var(--color-border-control) 2px, transparent 0) 0 0/6px 2px repeat-x }
+.summary-total dt { color: var(--color-text-strong) }
+.summary-total dd { font-size: var(--font-size-display); line-height: var(--font-line-height-display) }
+.shipping-meter { display: flex; flex-direction: column; gap: var(--space-8); margin-top: var(--space-16) }
+.checkout-form { display: flex; flex-direction: column; gap: var(--space-20); max-width: var(--size-form) }
+.checkout-form .btn-gold { align-self: flex-start; margin-top: var(--space-12) }
+.confirmation .title-block { align-items: flex-start }
+.confirmation__action { margin-top: var(--space-16) }
+
+/* ---------- Coarse pointers ---------- */
+@media (pointer: coarse) {
+  .item, .button, .chip, .tool, .input, .select, .variant-option { min-height: var(--size-touch) }
+  .button-sm { min-height: var(--size-touch) }
+}
+
+/* ---------- Under breakpoint.lg (1024px) ---------- */
+@media (max-width: 1023px) {
