+import { useState, type ReactNode } from 'react';
 import type { Block } from '../data/posts';
 import ImagePlaceholder from './ImagePlaceholder';
+import { Callout, Window } from './pixel';
+
+const KEYWORDS = new Set([
+  'const', 'let', 'var', 'function', 'return', 'export', 'import', 'from', 'as', 'if', 'else',
+  'typeof', 'keyof', 'new', 'await', 'async', 'type', 'interface',
+]);
+const LITERALS = new Set(['true', 'false', 'null', 'undefined']);
+
+/** Minimal highlighter: comments, strings, keywords, literals, numbers, calls and types. */
+function highlight(code: string, language: string): ReactNode[] {
+  if (language === 'markdown') {
+    return code.split('\n').flatMap((line, i) => {
+      const cls = line.startsWith('#') ? 'tok-k' : line.startsWith('- ') ? 'tok-s' : undefined;
+      const node = cls ? <span key={i} className={cls}>{line}</span> : line;
+      return i === 0 ? [node] : ['\n', node];
+    });
+  }
+  const pattern = /(\/\/[^\n]*|(?:^|(?<=\n))#[^\n]*)|('[^']*'|"[^"]*"|`[^`]*`)|\b(\d+)\b|\b([A-Za-z_$][\w$]*)\b(\s*\()?/g;
+  const out: ReactNode[] = [];
+  let last = 0;
+  let match: RegExpExecArray | null;
+  let key = 0;
+  while ((match = pattern.exec(code))) {
+    if (match.index > last) out.push(code.slice(last, match.index));
+    const [whole, comment, str, num, word, call] = match;
+    let cls: string | undefined;
+    let text = whole;
+    if (comment) cls = 'tok-c';
+    else if (str) cls = 'tok-s';
+    else if (num) cls = 'tok-l';
+    else if (word) {
+      text = word;
+      if (KEYWORDS.has(word)) cls = 'tok-k';
+      else if (LITERALS.has(word)) cls = 'tok-l';
+      else if (call) cls = 'tok-f';
+      else if (/^[A-Z]/.test(word)) cls = 'tok-t';
+    }
+    out.push(cls ? <span key={key++} className={cls}>{text}</span> : text);
+    if (word && call) out.push(call);
+    last = match.index + whole.length;
+  }
+  if (last < code.length) out.push(code.slice(last));
+  return out;
+}
