+import { useEffect, useState, type MouseEvent } from 'react';
 import type { Block } from '../data/posts';
+import { Marker } from './pixel';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const WIDE = '(min-width: 1024px)';
+const isWide = () => typeof window !== 'undefined' && window.matchMedia(WIDE).matches;
+
+// Contents list: a marker on the heading under the header. Under breakpoint.lg it folds into a disclosure.
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const [current, setCurrent] = useState(headings[0]?.id);
+  const [open, setOpen] = useState(isWide);
+
+  useEffect(() => {
+    setCurrent(headings[0]?.id);
+    let frame = 0;
+    function update() {
+      frame = 0;
+      const line = 64 + 4 + 24;
+      let id = headings[0]?.id;
+      for (const h of headings) {
+        const el = document.getElementById(h.id);
+        if (el && el.getBoundingClientRect().top <= line) id = h.id;
+      }
+      setCurrent(id);
+    }
+    function onScroll() {
+      if (!frame) frame = requestAnimationFrame(update);
+    }
+    const mq = window.matchMedia(WIDE);
+    const onMq = () => setOpen(mq.matches);
+    window.addEventListener('scroll', onScroll, { passive: true });
+    mq.addEventListener('change', onMq);
+    update();
+    return () => {
+      window.removeEventListener('scroll', onScroll);
+      mq.removeEventListener('change', onMq);
+      if (frame) cancelAnimationFrame(frame);
+    };
+  }, [blocks]);
+
   if (headings.length === 0) return null;
 
+  // On wide screens the list stays open: the summary is only a heading.
+  function onSummary(event: MouseEvent) {
+    if (isWide()) event.preventDefault();
+  }
+
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      <details className="disclosure toc-disclosure" open={open} onToggle={(e) => setOpen(e.currentTarget.open)}>
+        <summary onClick={onSummary}>
+          <h2 id="toc-heading" className="toc-heading">
+            On this page
+          </h2>
+          <Marker className="disclosure__closed" />
+          <Marker dir="d" className="disclosure__open" />
+        </summary>
+        <ol className="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a
+                href={`#${heading.id}`}
+                className="item toc-link"
+                aria-current={current === heading.id ? 'location' : undefined}
+                data-testid="toc-link"
+              >
+                <Marker />
+                {heading.text}
+              </a>
+            </li>
+          ))}
+        </ol>
+      </details>
     </nav>
   );
