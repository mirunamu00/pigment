+  display: inline-flex; align-items: center; gap: var(--space-8); height: var(--size-control); padding: 0 var(--space-12);
+  background: transparent; color: var(--color-text-secondary); cursor: pointer;
+  border: var(--border-width-control) solid transparent; border-bottom: 0;
+}
+.tab > .cur { visibility: hidden; }
+.tab:hover { background: var(--color-surface-hover); color: var(--color-text-strong); }
+.tab:focus-visible { outline-offset: -4px; }
+.tab[aria-selected="true"] {
+  height: calc(var(--size-control) + var(--border-width-control)); margin-bottom: calc(-1 * var(--border-width-control));
+  background: var(--color-surface-subtle); color: var(--color-text-strong); border-color: var(--color-border-strong);
+}
+.tab[aria-selected="true"] > .cur { visibility: visible; }
+.tab-panel { background: var(--color-surface-subtle); padding: var(--space-20); display: flex; flex-direction: column; gap: var(--space-24); }
+
+.details { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-16); }
+.details dt { font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); color: var(--color-text-secondary); }
+.details dd { margin-top: var(--space-4); color: var(--color-text-strong); display: flex; flex-direction: column; gap: var(--space-8); }
+
+.progress-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-8) var(--space-16); }
+.progress-row p { color: var(--color-text-strong); }
+.task-list { list-style: none; padding: 0; }
+.task { display: flex; align-items: center; gap: var(--space-8); min-height: var(--size-row); padding: var(--space-8) 0; }
+.task + .task { background: linear-gradient(90deg, var(--color-border-control) 2px, transparent 0) 0 0 / 6px 2px repeat-x; }
+.task label { flex: 1; cursor: pointer; }
+.task-done label { color: var(--color-text-secondary); text-decoration: line-through; }
+
+.checkbox {
+  position: relative; flex: none; width: 16px; height: 16px;
+  border: var(--border-width-control) solid var(--color-border-control); background: var(--color-surface-raised);
+}
+.checkbox:hover { border-color: var(--color-border-strong); }
+.checkbox > input { position: absolute; inset: calc(-1 * var(--border-width-control)); width: 16px; height: 16px; margin: 0; opacity: 0; cursor: pointer; }
+.checkbox-mark {
+  position: absolute; left: 0; top: 1px; width: 12px; height: 10px; visibility: hidden; pointer-events: none;
+  background: var(--color-text-accent); -webkit-mask: var(--check) 0 0 / 100% 100% no-repeat; mask: var(--check) 0 0 / 100% 100% no-repeat;
+}
+.checkbox > input:checked + .checkbox-mark { visibility: visible; }
+.checkbox:has(input:focus-visible) { outline: var(--border-width-window) solid var(--color-focus-ring); outline-offset: 3px; }
+
+/* ---------- Team ---------- */
+.person { display: flex; align-items: center; gap: var(--space-12); min-width: 0; }
+.person-text { min-width: 0; display: flex; flex-direction: column; }
+.person-name { color: var(--color-text-strong); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+
+/* ---------- Settings ---------- */
+.settings-window .window__body { padding: var(--space-20); }
+.back-link { display: inline-flex; align-items: center; gap: var(--space-8); }
+.back-link > .cur { color: currentColor; }
+
+/* ---------- Adaptation ---------- */
+@media (max-width: 1023px) {
+  .site-header { position: static; }
+  .header-bar { flex-wrap: wrap; padding: var(--space-12) var(--space-24); row-gap: var(--space-12); }
+  .header-tools { margin-left: auto; }
+  .header-search { order: 3; flex-basis: 100%; max-width: none; margin-left: 0; }
+  .app-body { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; }
+  .sidebar { border-right: 0; border-bottom: var(--border-width-control) solid var(--color-border-default); padding: var(--space-8) var(--space-16); }
+  .nav-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 var(--space-8); }
+  .nav-list li + li::before { display: none; }
+  .nav-list .item { padding-inline: var(--space-8); }
+  .kpi-grid, .details { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .panels { grid-template-columns: 1fr; }
+}
+
+@media (max-width: 599px) {
+  .header-bar { padding-inline: var(--space-16); gap: var(--space-8); }
+  .tool-label, .user-name, .kbd-hint { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
+  .tool { width: var(--size-touch); height: var(--size-touch); justify-content: center; padding: 0; }
+  .user-menu-button { width: auto; padding-inline: var(--space-4); }
+  .search-field > .input { padding-right: var(--space-12); }
+  .nav-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .content { gap: var(--space-40); padding: var(--space-40) var(--space-16) calc(var(--space-40) + var(--size-ground-sprite)); }
+  .kpi-grid, .details { grid-template-columns: 1fr; }
+  .title-block { padding: var(--space-20) var(--space-16); }
+  .toolbar .field { flex-basis: 100%; }
+  .toolbar .chips { width: 100%; }
+  .count { align-items: flex-start; }
+  .chart-plot { margin-left: var(--space-32); }
+
+  .table { width: 100%; }
+  .table :is(th, td):not([data-pin]) { display: none; }
+  .table :is(th, td) { height: var(--size-row); white-space: nowrap; }
+  .table .sub { display: none; }
+  .table [data-pin="first"] { width: 100%; max-width: 0; overflow: hidden; text-overflow: ellipsis; }
+  .table [data-pin]:not([data-pin="first"]) { width: 1%; }
+  .table-wrap { overflow-x: clip; }
+}
+
+@media (pointer: coarse) {
+  .btn, .chip, .input, .tab { min-height: var(--size-touch); }
 }
