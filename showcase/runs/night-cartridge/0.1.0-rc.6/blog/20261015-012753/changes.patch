+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
+import { Cur } from './pixel/Pixel';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const WIDE = '(min-width: 1024px)';
+
+function useWide() {
+  const [wide, setWide] = useState(() => window.matchMedia(WIDE).matches);
+  useEffect(() => {
+    const query = window.matchMedia(WIDE);
+    const onChange = () => setWide(query.matches);
+    query.addEventListener('change', onChange);
+    return () => query.removeEventListener('change', onChange);
+  }, []);
+  return wide;
+}
+
+/** The heading under the header is current; the first one before any scrolling. */
+function useCurrentHeading(ids: string[]) {
+  const [current, setCurrent] = useState(ids[0]);
+  useEffect(() => {
+    setCurrent(ids[0]);
+    function onScroll() {
+      let next = ids[0];
+      for (const id of ids) {
+        const el = document.getElementById(id);
+        if (el && el.getBoundingClientRect().top <= 120) next = id;
+      }
+      setCurrent(next);
+    }
+    onScroll();
+    window.addEventListener('scroll', onScroll, { passive: true });
+    window.addEventListener('hashchange', onScroll);
+    return () => {
+      window.removeEventListener('scroll', onScroll);
+      window.removeEventListener('hashchange', onScroll);
+    };
+  }, [ids.join('|')]);
+  return current;
+}
+
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const wide = useWide();
+  const [open, setOpen] = useState(false);
+  const current = useCurrentHeading(headings.map((heading) => heading.id));
   if (headings.length === 0) return null;
 
+  const list = (
+    <ol className="toc-list">
+      {headings.map((heading) => (
+        <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+          <a
+            href={`#${heading.id}`}
+            className="item toc-link"
+            aria-current={current === heading.id ? 'location' : undefined}
+            data-testid="toc-link"
+          >
+            <Cur />
+            {heading.text}
+          </a>
+        </li>
+      ))}
+    </ol>
+  );
+
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      {wide ? (
+        <>
+          <h2 id="toc-heading" className="toc-heading">
+            On this page
+          </h2>
+          {list}
+        </>
+      ) : (
+        <details className="disclosure" open={open} onToggle={(event) => setOpen(event.currentTarget.open)}>
+          <summary>
+            <Cur dir={open ? 'd' : 'r'} />
+            <h2 id="toc-heading" className="toc-heading">
+              On this page
