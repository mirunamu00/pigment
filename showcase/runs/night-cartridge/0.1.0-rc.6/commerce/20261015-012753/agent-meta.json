className=\"toolbar-controls\">\n            <label className=\"field-inline\">\n              <input\n                type=\"checkbox\"\n                checked={inStockOnly}\n                onChange={(event) => toggleInStock(event.target.checked)}\n                data-testid=\"in-stock-toggle\"\n              />\n              In stock only\n            </label>\n            <div className=\"field-inline\">\n              <label htmlFor=\"sort-select\">Sort by</label>\n              <span className=\"select-wrap\">\n                <select\n                  id=\"sort-select\"\n                  className=\"select\"\n                  value={sort}\n                  onChange={(event) => selectSort(parseSort(event.target.value))}\n                  data-testid=\"sort-select\"\n                >\n                  {SORT_OPTIONS.map((option) => (\n                    <option key={option.value} value={option.value}>\n                      {option.label}\n                    </option>\n                  ))}\n                </select>\n                <Marker dir=\"d\" />\n              </span>\n            </div>\n          </div>\n        </div>\n\n        <p className=\"muted small result-count\" role=\"status\" data-testid=\"result-count\">\n          Showing {countLabel}\n        </p>\n\n        {visible.length === 0 ? (\n          <div className=\"empty-state\" data-testid=\"products-empty\">\n            <PixelStage scene=\"empty\" />\n            <h3>No products match these filters</h3>\n            <p className=\"muted\">Try another category or include items that are out of stock.</p>\n            <button type=\"button\" className=\"button\" onClick={clearFilters} data-testid=\"clear-filters\">\n              <Marker />\n              Clear filters\n            </button>\n          </div>\n        ) : (\n          <ul className=\"product-grid\" data-testid=\"product-grid\">\n            {visible.map((product) => (\n              <li key={product.slug} className={`product-card hue-${product.category}`} data-testid=\"product-card\">\n                <ProductImage product={product} />\n                <div className=\"product-card-body\">\n                  <p className=\"card-meta\">\n                    <span className=\"bullet\" aria-hidden=\"true\" />\n                    {categoryLabel(product.category)}\n                  </p>\n                  <h3 className=\"product-card-title card-title\">\n                    <Marker />\n                    <Link to={`/products/${product.slug}`} className=\"product-link\" data-testid=\"product-link\">\n                      {product.name}\n                    </Link>\n                  </h3>\n                  <p className=\"card-summary\">{product.summary}</p>\n                  <p className=\"product-card-meta\">\n                    <span className=\"price\" data-testid=\"product-price\">\n                      {formatPrice(product.price)}\n                    </span>\n                    {!product.inStock && (\n                      <span className=\"tag tag-muted\" data-testid=\"sold-out-tag\">\n                        <span className=\"bullet\" aria-hidden=\"true\" />\n                        Sold out\n                      </span>\n                    )}\n                  </p>\n                </div>\n              </li>\n            ))}\n          </ul>\n        )}\n      </section>\n    </>\n  );\n}\n'''\ns=s[:old_start]+new_body\nopen(p,'w',encoding='utf8').write(s)\nEOF"
