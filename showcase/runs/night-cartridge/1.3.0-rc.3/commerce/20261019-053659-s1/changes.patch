+/* ---------- Cart ---------- */
+.cart-layout { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-16); align-items: start; }
+.cart-items { grid-column: 1 / span 7; position: sticky; top: calc(var(--size-header) + var(--size-rule) + var(--space-16)); }
+.checkout { grid-column: 9 / span 4; }
+.cart-lines { list-style: none; margin: 0; padding: 0; }
+.cart-line { display: grid; grid-template-columns: minmax(0, 1fr) auto auto auto; align-items: center; gap: var(--space-16); padding-block: var(--space-16); }
+.cart-line + .cart-line { background: linear-gradient(90deg, var(--color-border-control) 2px, transparent 0) 0 0 / 6px 2px repeat-x; }
