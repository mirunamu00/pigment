+/* ---------- Product listing ---------- */
+.catalog { display: flex; flex-direction: column; gap: var(--space-16); }
+.toolbar { justify-content: space-between; }
+.chip-group { gap: var(--space-8); }
+
+.card { position: relative; background: var(--color-surface-subtle); padding: var(--space-16) var(--space-20); }
+.product-grid { list-style: none; margin: 0; padding: 0; }
+.item-card { display: flex; flex-direction: column; gap: var(--space-12); }
+.item-card:hover { background: var(--color-surface-hover); }
+.item-card:active { translate: 2px 2px; }
+.item-card:has(.card-link:focus-visible) { outline: var(--border-width-window) solid var(--color-focus-ring); outline-offset: 3px; }
+.card-body { display: flex; flex-direction: column; gap: var(--space-4); }
+.card-category { display: flex; align-items: center; gap: var(--space-8); }
+.card-title { display: flex; align-items: center; gap: var(--space-4); margin-left: calc(-1 * (var(--size-marker-w) + var(--space-4))); }
+.card-title > .cur { visibility: hidden; }
+.item-card:is(:hover, :focus-within) .card-title > .cur { visibility: visible; color: var(--color-text-strong); }
+.card-link { color: var(--color-text-strong); text-decoration: none; }
+.card-link:hover { color: var(--color-text-strong); }
+.card-link::after { content: ""; position: absolute; inset: 0; }
+.card-link:focus-visible { outline: none; }
+.card-desc {
+  color: var(--color-text-secondary);
+  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
+}
+.card-meta { display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); margin-top: var(--space-4); }
+.price { color: var(--color-text-strong); }
+
+/* Missing images: item sprite in a framed .pic window (spec) */
+.pic {
+  container-type: inline-size; display: flex; align-items: center; justify-content: center;
+  aspect-ratio: 4 / 3; padding-block: var(--space-16);
+  border: var(--border-width-control) solid var(--color-border-control); background: var(--color-surface-raised);
+}
+.pic > svg { display: block; margin: auto; width: calc(round(down, 50cqi / var(--v), 1px) * var(--w)); height: auto; shape-rendering: crispEdges; }
+
+.empty-state { display: flex; flex-direction: column; align-items: center; gap: var(--space-16); max-width: 400px; margin-inline: auto; padding-block: var(--space-40); text-align: center; }
+.empty-state > p { line-height: var(--font-line-height-prose); }
+
+/* ---------- Product detail ---------- */
+.breadcrumb ol { display: flex; flex-wrap: wrap; gap: var(--space-8); list-style: none; margin: 0; padding: 0; color: var(--color-text-secondary); }
+.breadcrumb li + li::before { content: "/"; margin-right: var(--space-8); }
+.breadcrumb a { color: var(--color-text-secondary); text-decoration: none; }
+.breadcrumb a:hover { color: var(--color-text-strong); text-decoration: underline var(--border-width-control) var(--color-text-strong); }
+
+.product-detail { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-16); align-items: start; }
+.product-detail-media { grid-column: 1 / span 5; position: sticky; top: calc(var(--size-header) + var(--size-rule) + var(--space-16)); }
+.product-detail-info { grid-column: 7 / span 6; display: flex; flex-direction: column; gap: var(--space-16); }
+.price-large { font-size: var(--font-size-display); line-height: var(--font-line-height-display); }
+.purchase-form { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-20); padding: var(--space-20); margin-top: var(--space-8); }
+.purchase-form > .btn-gold { margin-top: var(--space-12); }
+.variant-fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
+.variant-fieldset > legend { padding: 0; margin-bottom: var(--space-8); }
+.variant-options { gap: var(--space-8); }
