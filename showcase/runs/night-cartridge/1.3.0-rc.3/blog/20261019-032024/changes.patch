+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
+import { Marker } from './pixel';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const NARROW = '(max-width: 1023px)';
+// Header (64) + dither rule (4) + breathing room: the line a heading counts as "current" from.
+const READ_LINE = 96;
+
+function useNarrow() {
+  const [narrow, setNarrow] = useState(() => window.matchMedia(NARROW).matches);
+  useEffect(() => {
+    const query = window.matchMedia(NARROW);
+    const onChange = () => setNarrow(query.matches);
+    query.addEventListener('change', onChange);
+    return () => query.removeEventListener('change', onChange);
+  }, []);
+  return narrow;
+}
+
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const [current, setCurrent] = useState(headings[0]?.id);
+  const narrow = useNarrow();
+
+  // One item is always current: the first heading on load, then the heading under the header.
+  useEffect(() => {
+    function onScroll() {
+      let id = headings[0]?.id;
+      for (const heading of headings) {
+        const el = document.getElementById(heading.id);
+        if (el && el.getBoundingClientRect().top <= READ_LINE) id = heading.id;
+      }
+      setCurrent(id);
+    }
+    onScroll();
+    window.addEventListener('scroll', onScroll, { passive: true });
+    return () => window.removeEventListener('scroll', onScroll);
+  }, [blocks]);
+
   if (headings.length === 0) return null;
 
+  const title = (
+    <h2 id="toc-heading" className="toc-heading">
+      On this page
+    </h2>
+  );
+  const list = (
+    <ol className="toc-list">
+      {headings.map((heading) => (
+        <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+          <a
+            href={`#${heading.id}`}
+            className="item toc-link"
+            aria-current={current === heading.id ? 'location' : undefined}
+            data-testid="toc-link"
+          >
+            <Marker />
+            {heading.text}
+          </a>
+        </li>
+      ))}
+    </ol>
+  );
+
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      {narrow ? (
+        <details className="disclosure">
+          <summary>
+            {title}
+            <Marker />
+          </summary>
+          {list}
+        </details>
+      ) : (
+        <>
+          {title}
+          {list}
+        </>
+      )}
     </nav>
   );
 }
