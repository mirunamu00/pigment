+/** Width from which the contents list is a column; under it, a disclosure. */
+const WIDE = '(min-width: 1200px)';
+
+function useWide() {
+  const [wide, setWide] = useState(() => window.matchMedia(WIDE).matches);
+  useEffect(() => {
+    const query = window.matchMedia(WIDE);
+    const update = () => setWide(query.matches);
+    query.addEventListener('change', update);
+    return () => query.removeEventListener('change', update);
+  }, []);
+  return wide;
+}
+
+/** The heading under the header as the reader scrolls; the first heading on load. */
+function useCurrentHeading(entries: TocEntry[]) {
+  const [current, setCurrent] = useState(entries[0]?.id);
+  const key = entries.map((entry) => entry.id).join('|');
+  useEffect(() => {
+    function update() {
+      const header = document.querySelector('.site-header');
+      const line = (header?.getBoundingClientRect().bottom ?? 0) + 24;
+      let found = entries[0]?.id;
+      for (const entry of entries) {
+        const el = document.getElementById(entry.id);
+        if (el && el.getBoundingClientRect().top <= line) found = entry.id;
+      }
+      setCurrent(found);
+    }
+    update();
+    window.addEventListener('scroll', update, { passive: true });
+    window.addEventListener('hashchange', update);
+    return () => {
+      window.removeEventListener('scroll', update);
+      window.removeEventListener('hashchange', update);
+    };
+  }, [key]);
+  return current;
+}
+
 export default function TableOfContents({ entries }: { entries: TocEntry[] }) {
+  const wide = useWide();
+  const [openNarrow, setOpenNarrow] = useState(false);
+  const current = useCurrentHeading(entries);
   if (entries.length === 0) return null;
 
+  const open = wide || openNarrow;
+
+  function handleSummary(event: MouseEvent) {
+    event.preventDefault();
+    if (!wide) setOpenNarrow((value) => !value);
+  }
+
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ul className="toc-list">
-        {entries.map((entry) => (
-          <li key={entry.id} className={entry.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${entry.id}`} className="toc-link" data-testid="toc-link">
-              <Inline text={entry.text} />
-            </a>
-          </li>
-        ))}
-      </ul>
+      <details className="toc-details" open={open}>
+        <summary className="toc-summary" onClick={handleSummary} tabIndex={wide ? -1 : 0}>
+          <Marker dir={open ? 'd' : 'r'} small />
+          <h2 id="toc-heading" className="toc-heading">
+            On this page
+          </h2>
+        </summary>
+        <ul className="toc-list">
+          {entries.map((entry) => (
+            <li key={entry.id} className={entry.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a
+                href={`#${entry.id}`}
+                className="item toc-link"
+                aria-current={entry.id === current ? 'location' : undefined}
+                data-testid="toc-link"
+              >
+                <Marker />
+                <span>
+                  <Inline text={entry.text} />
+                </span>
+              </a>
+            </li>
+          ))}
+        </ul>
+      </details>
     </nav>
   );
 }
