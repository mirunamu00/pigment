+/** A header switch persisted in localStorage and mirrored as a data attribute on <html>. */
+function usePreference(key: string, attr: 'motion' | 'body', offValue: string) {
+  const [on, setOn] = useState(() => document.documentElement.dataset[attr] !== offValue);
+  useEffect(() => {
+    const root = document.documentElement;
+    if (on) delete root.dataset[attr];
+    else root.dataset[attr] = offValue;
+    try {
+      localStorage.setItem(key, on ? 'on' : 'off');
+    } catch {
+      /* storage unavailable: the switch still works for this visit */
+    }
+  }, [on, key, attr, offValue]);
+  return [on, () => setOn((v) => !v)] as const;
+}
