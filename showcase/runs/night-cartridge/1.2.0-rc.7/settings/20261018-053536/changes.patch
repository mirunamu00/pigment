+.table thead th {
+  background: var(--color-surface-subtle); color: var(--color-text-strong);
+  border-bottom: var(--border-width-control) solid var(--color-border-strong); white-space: nowrap;
+}
+.table tbody td { border-bottom: var(--border-width-control) solid var(--color-border-default); color: var(--color-text-primary); }
+.table th:first-child { padding-left: calc(var(--space-12) + var(--space-16)); }
+.table td:first-child { padding-left: var(--space-8); }
+.table .numeric { text-align: right; }
+.table tr[aria-current] td { color: var(--color-text-strong); }
+.cell-lead { display: flex; align-items: center; gap: var(--space-8); min-width: 0; }
+.cell-lead > .cur { visibility: hidden; }
+tr[aria-current] .cell-lead > .cur { visibility: visible; }
+.cell-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.cell-lead > .badge { flex: none; }
+.cell-actions { text-align: right; width: 1%; white-space: nowrap; }
+
+@media (max-width: 599px) {
+  .table { width: 100%; table-layout: auto; }
