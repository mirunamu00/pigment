+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
+import Marker from './ui/Marker';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const wide = () => typeof window !== 'undefined' && window.matchMedia('(min-width: 1024px)').matches;
+
+/** Contents list: a sidebar from breakpoint.lg, a disclosure below it; the current heading carries the marker. */
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const [open, setOpen] = useState(wide);
+  const [current, setCurrent] = useState(headings[0]?.id);
+
+  useEffect(() => {
+    const query = window.matchMedia('(min-width: 1024px)');
+    const onChange = () => setOpen(query.matches);
+    query.addEventListener('change', onChange);
+    return () => query.removeEventListener('change', onChange);
+  }, []);
+
+  useEffect(() => {
+    function onScroll() {
+      const line = 64 + 24;
+      let id = headings[0]?.id;
+      for (const heading of headings) {
+        const el = document.getElementById(heading.id);
+        if (el && el.getBoundingClientRect().top <= line) id = heading.id;
+      }
+      setCurrent(id);
+    }
+    onScroll();
+    window.addEventListener('scroll', onScroll, { passive: true });
+    return () => window.removeEventListener('scroll', onScroll);
+  }, [blocks]);
+
   if (headings.length === 0) return null;
 
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
