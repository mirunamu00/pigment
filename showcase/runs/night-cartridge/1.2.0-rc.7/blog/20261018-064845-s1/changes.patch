+.newsletter {
+  max-width: var(--size-form);
+  padding: var(--space-20);
+  background: var(--color-surface-subtle);
+  border: var(--border-width-control) solid var(--color-border-default);
+}
+.newsletter h2 {
+  margin-bottom: var(--space-8);
+}
+.newsletter > p {
+  margin-bottom: var(--space-20);
+}
+.field-row {
+  display: flex;
+  gap: var(--space-12);
+  align-items: center;
+}
+.field-row .input {
+  flex: 1;
+}
+.form-success {
+  display: flex;
+  align-items: center;
+  gap: var(--space-12);
+  margin: 0;
+  padding: var(--space-12) var(--space-16);
+  background: var(--color-surface-raised);
+  border-left: var(--border-width-window) solid var(--color-status-success);
+  color: var(--color-text-strong);
+}
+.form-success .bullet {
+  background: var(--color-status-success);
+}
+
+/* ---------- small screens ---------- */
+@media (max-width: 599px) {
+  :root {
+    --gutter: var(--space-16);
+  }
+  .section {
+    margin-top: var(--space-40);
+  }
+  .btn-search-label,
+  .btn--search kbd,
+  .search-kbd {
+    display: none;
+  }
+  .btn--search {
+    width: var(--size-control);
+    padding: 0;
+    justify-content: center;
+  }
+  .search-box .input {
+    padding-right: var(--space-12);
+  }
+  .field--search {
+    max-width: none;
+  }
+  .field-row {
+    flex-direction: column;
+    align-items: stretch;
+  }
+  .field-row .input {
+    flex: none;
+  }
+  .btn-gold {
+    width: 100%;
+  }
+  .hero-window .btn {
+    width: 100%;
+    justify-content: space-between;
+  }
+  .title-block {
+    padding: var(--space-20);
+  }
+  .prev-next {
+    grid-template-columns: 1fr;
+  }
+  .prev-next-link--next {
+    grid-column: 1;
+  }
+  .card--feature .card-title {
+    font-size: var(--font-size-body);
+    line-height: var(--font-line-height-ui);
+  }
+  .card--feature .card-title > .cur {
+    vertical-align: -1px;
+  }
+}
+@media (pointer: coarse) {
+  .btn,
+  .chip,
+  .tool,
+  .input,
+  .item {
+    min-height: var(--size-touch);
+  }
 }
