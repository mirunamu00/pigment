+/** Animation switch state: persisted, default on, mirrored to data-motion on <html>. */
+function useMotion() {
+  const [on, setOn] = useState(() => {
+    try {
+      return localStorage.getItem(MOTION_KEY) !== 'off';
+    } catch {
+      return true;
+    }
+  });
+  useEffect(() => {
+    if (on) document.documentElement.removeAttribute('data-motion');
+    else document.documentElement.setAttribute('data-motion', 'off');
+    try {
+      localStorage.setItem(MOTION_KEY, on ? 'on' : 'off');
+    } catch {
+      /* storage unavailable: the switch still works for this visit */
+    }
+  }, [on]);
+  return [on, () => setOn((v) => !v)] as const;
