+/** Fill-only pixel icons: rows of "x" on a 12×12 (24px) or 6×6 (12px) grid, drawn in currentColor. */
+function PixelIcon({ rows, className = 'icon' }: { rows: string[]; className?: string }) {
+  const n = rows.length;
+  const rects: string[] = [];
+  rows.forEach((r, y) => {
+    for (let x = 0; x < r.length; ) {
+      if (r[x] !== 'x') {
+        x++;
+        continue;
+      }
+      let w = 1;
+      while (r[x + w] === 'x') w++;
+      rects.push(`M${x} ${y}h${w}v1h-${w}z`);
+      x += w;
+    }
+  });
