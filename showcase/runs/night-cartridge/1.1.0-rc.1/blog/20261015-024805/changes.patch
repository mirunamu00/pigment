+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
+import { Marker, useMedia } from './pixel';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+/** The heading under the sticky header is current; the first heading until the reader scrolls past it. */
+function useCurrentHeading(ids: string[]) {
+  const [current, setCurrent] = useState(ids[0]);
+  useEffect(() => {
+    setCurrent(ids[0]);
+    function update() {
+      const line = 64 + 48;
+      let next = ids[0];
+      for (const id of ids) {
+        const el = document.getElementById(id);
+        if (el && el.getBoundingClientRect().top <= line) next = id;
+      }
+      setCurrent(next);
+    }
+    update();
+    window.addEventListener('scroll', update, { passive: true });
+    window.addEventListener('hashchange', update);
+    return () => {
+      window.removeEventListener('scroll', update);
+      window.removeEventListener('hashchange', update);
+    };
+  }, [ids.join('|')]);
+  return current;
+}
+
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const current = useCurrentHeading(headings.map((heading) => heading.id));
+  const wide = useMedia('(min-width: 1024px)');
   if (headings.length === 0) return null;
 
-  return (
-    <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
+  const list = (
+    <ol className="toc-list">
+      {headings.map((heading) => {
+        const isCurrent = heading.id === current;
+        return (
           <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
+            <a
+              href={`#${heading.id}`}
+              className="toc-link item"
+              aria-current={isCurrent ? 'location' : undefined}
+              data-testid="toc-link"
+            >
+              <Marker />
+              <span>{heading.text}</span>
             </a>
           </li>
-        ))}
-      </ol>
+        );
+      })}
+    </ol>
+  );
+
+  return (
+    <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
+      {wide ? (
+        <>
+          <h2 id="toc-heading" className="toc-heading">
+            On this page
+          </h2>
+          {list}
+        </>
+      ) : (
+        <details className="disclosure toc-disclosure">
+          <summary>
+            <Marker className="disclosure__marker" />
+            <h2 id="toc-heading" className="toc-heading">
+              On this page
+            </h2>
+          </summary>
+          {list}
+        </details>
+      )}
     </nav>
   );
 }
