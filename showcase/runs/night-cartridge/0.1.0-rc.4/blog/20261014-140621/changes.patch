+      setCopied(true);
+    } catch {
+      setCopied(false);
+    }
+  }
+  return (
+    <div className="window code-window">
+      <div className="window__bar">
+        <span className="code-lang">{language}</span>
+        <button type="button" className="button button-sm press" onClick={copy} onBlur={() => setCopied(false)}>
+          {copied ? 'Copied' : 'Copy'}
+        </button>
+      </div>
+      <pre className="code-block" data-testid="body-code" data-language={language}>
+        <code>{highlight(code, language)}</code>
+      </pre>
+    </div>
+  );
