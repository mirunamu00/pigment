+/** Comment lines take the syntax comment colour; everything else stays primary. */
+function highlight(code: string, language: string) {
+  const marker = ['bash', 'sh', 'shell'].includes(language) ? /^\s*#/ : /^\s*\/\//;
+  return code.split('\n').map((line, i, all) => {
+    const comment = language !== 'markdown' && marker.test(line);
+    const text = i < all.length - 1 ? `${line}\n` : line;
+    return comment ? (
+      <span key={i} className="tok-comment">
+        {text}
+      </span>
+    ) : (
+      text
+    );
+  });
+}
+
+function CodeWindow({ language, code }: { language: string; code: string }) {
+  const [copied, setCopied] = useState(false);
+  async function copy() {
+    try {
