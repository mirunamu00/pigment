@@ -1,25 +1,84 @@
+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
+import { Marker } from './Pixel';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const WIDE = '(min-width: 1024px)';
+/** Header (64) + dither rule (4) + a little air: the line a heading must cross to become current. */
+const READ_LINE = 96;
+
+function useWide() {
+  const [wide, setWide] = useState(() => window.matchMedia(WIDE).matches);
+  useEffect(() => {
+    const query = window.matchMedia(WIDE);
+    const update = () => setWide(query.matches);
+    query.addEventListener('change', update);
+    return () => query.removeEventListener('change', update);
+  }, []);
+  return wide;
+}
+
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const wide = useWide();
+  const [current, setCurrent] = useState(headings[0]?.id);
+
+  // One item is always current: the first heading on load, then the heading under the header.
+  useEffect(() => {
+    setCurrent(headings[0]?.id);
+    function update() {
+      let next = headings[0]?.id;
+      for (const heading of headings) {
+        const element = document.getElementById(heading.id);
+        if (element && element.getBoundingClientRect().top <= READ_LINE) next = heading.id;
+      }
+      setCurrent(next);
+    }
+    window.addEventListener('scroll', update, { passive: true });
+    return () => window.removeEventListener('scroll', update);
+  }, [blocks]);
+
   if (headings.length === 0) return null;
 
+  const list = (
+    <ol className="toc-list">
+      {headings.map((heading) => (
+        <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+          <a
+            href={`#${heading.id}`}
+            className="item toc-link"
+            aria-current={current === heading.id ? 'location' : undefined}
+            data-testid="toc-link"
+          >
+            <Marker />
+            <span>{heading.text}</span>
+          </a>
+        </li>
+      ))}
+    </ol>
+  );
+
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      {wide ? (
+        <>
+          <h2 id="toc-heading" className="toc-heading">
+            On this page
+          </h2>
+          {list}
+        </>
+      ) : (
+        <details className="disclosure">
+          <summary>
+            <Marker dir="r" className="disclosure-marker" />
+            <h2 id="toc-heading" className="toc-heading">
+              On this page
+            </h2>
+          </summary>
+          {list}
+        </details>
+      )}
     </nav>
   );
 }
