+/* ---------- Game-window chrome ---------- */
+.window {
+  border: var(--border-width-window) solid var(--color-border-strong);
+  background: var(--color-surface-raised);
+}
+.window__bar {
+  display: flex;
+  align-items: center;
+  gap: var(--space-8);
+  height: var(--size-title-bar);
+  padding-inline: var(--space-12);
+  background: var(--color-surface-subtle);
+  border-bottom: var(--border-width-control) solid var(--color-border-default);
+  color: var(--color-text-strong);
+}
+.window__body {
+  padding: var(--space-20);
+}
+.window__bar > h1 {
+  font-size: var(--font-size-body);
+  line-height: var(--font-line-height-ui);
+}
+.dither {
+  height: var(--size-rule);
+  background: repeating-conic-gradient(var(--dc, var(--color-border-default)) 0 25%, transparent 0 50%) 0 0 / 4px 4px;
+}
+h2.ruled {
+  padding-bottom: var(--space-12);
+  margin-bottom: var(--space-16);
+  background: repeating-conic-gradient(var(--color-border-control) 0 25%, transparent 0 50%) bottom left / 4px 4px repeat-x;
+}
+.sep-dots {
+  height: 2px;
+  background: linear-gradient(90deg, var(--color-border-control) 2px, transparent 0) 0 0 / 6px 2px repeat-x;
+}
+.hue-bar {
+  border-top: var(--border-width-window) solid var(--hue);
+}
+.bullet {
+  flex: none;
+  display: inline-block;
+  width: var(--size-bullet);
+  height: var(--size-bullet);
+  background: var(--hue);
+}
+.hue-cyan { --hue: var(--color-hue-cyan); }
+.hue-violet { --hue: var(--color-hue-violet); }
+.hue-blue { --hue: var(--color-hue-blue); }
+.hue-amber { --hue: var(--color-hue-amber); }
+.hue-neutral { --hue: var(--color-border-control); }
+.meter {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-4);
+}
+.meter > i {
+  width: var(--size-meter-w);
+  height: var(--size-meter-h);
+  background: var(--color-surface-hover);
+}
+.meter > i.on {
+  background: var(--tone, var(--color-status-success));
+  animation: nc-on var(--motion-duration-meter-step) var(--motion-easing-frame) calc(var(--i) * var(--motion-duration-meter-step)) backwards;
+}
+@keyframes nc-on {
+  from {
+    background: var(--color-surface-hover);
+  }
+}
+.callout {
+  display: grid;
+  grid-template-columns: var(--size-icon) 1fr;
+  gap: var(--space-4) var(--space-12);
+  align-items: start;
+  padding: var(--space-16) var(--space-20);
+  background: var(--color-surface-subtle);
+  border-left: var(--border-width-window) solid var(--tone);
+}
+.callout__icon {
+  margin-top: 6px;
+  color: var(--tone);
+}
+.callout--success { --tone: var(--color-status-success); }
+.callout--danger { --tone: var(--color-status-danger); }
+.callout--info { --tone: var(--color-status-info); }
+.callout--warning { --tone: var(--color-status-warning); }
+
+/* ---------- Stepped motion ---------- */
+@keyframes nc-blink { 50% { opacity: var(--opacity-dim); } }
+@keyframes nc-twinkle { 60% { opacity: var(--opacity-twinkle); } 80% { opacity: 1; } }
+@keyframes nc-sparkle { 70% { transform: scale(0.34); } 85% { transform: scale(1); } }
+@keyframes nc-bob { 50% { transform: translateY(var(--bob, -4px)); } }
+@keyframes nc-swap { 50% { opacity: 0; } }
+@keyframes nc-beacon { 50% { fill: var(--color-art-beacon-off); } }
+@keyframes nc-drift { from { transform: translateX(var(--from)); } to { transform: translateX(var(--to)); } }
+@keyframes nc-rare {
+  0%, 95% { opacity: 0; transform: none; animation-timing-function: steps(1); }
+  95.1% { opacity: 1; transform: none; animation-timing-function: steps(5); }
+  100% { opacity: 1; transform: translate(var(--dx), var(--dy)); }
+}
+@keyframes nc-nudge { 50% { transform: translateX(2px); } }
+@keyframes nc-dots { from { width: 1ch; } to { width: 3ch; } }
+.blink { animation: nc-blink var(--d, var(--motion-duration-led-a)) var(--motion-easing-frame) var(--o, 0ms) infinite; }
+.blink:nth-of-type(3n + 2) { --d: var(--motion-duration-led-b); --o: -500ms; }
+.blink:nth-of-type(3n) { --d: var(--motion-duration-led-c); }
+.twinkle { animation: nc-twinkle var(--motion-duration-twinkle) var(--motion-easing-frame) var(--o, 0ms) infinite; }
+.bob { animation: nc-bob var(--motion-duration-bob) var(--motion-easing-frame) infinite; }
+.frame-b { animation: nc-swap var(--motion-duration-fan) var(--motion-easing-frame) infinite; }
+.frame-a { animation: nc-swap var(--motion-duration-fan) var(--motion-easing-frame) calc(var(--motion-duration-fan) / -2) infinite; }
+.beacon { animation: nc-beacon var(--motion-duration-beacon) var(--motion-easing-frame) infinite; }
+.drift { animation: nc-drift var(--motion-duration-drift) steps(var(--n)) var(--o, 0ms) infinite; }
+.rare { opacity: 0; animation: nc-rare var(--motion-duration-rare) var(--motion-easing-frame) infinite; }
+.nudge { animation: nc-nudge calc(var(--motion-duration-nudge) * 2) var(--motion-easing-frame) 1; }
+.sparkle { transform-box: fill-box; transform-origin: center; animation: nc-sparkle var(--motion-duration-sparkle) var(--motion-easing-frame) -600ms infinite; }
