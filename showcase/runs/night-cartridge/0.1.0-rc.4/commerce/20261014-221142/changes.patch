+  shape-rendering: crispEdges;
+  pointer-events: none;
+}
+.sky-1 { fill: var(--color-art-sky1); }
+.sky-2 { fill: var(--color-art-sky2); }
+.sky-3 { fill: var(--color-art-sky3); }
+.sky-4 { fill: var(--color-art-sky4); }
+.sky-5 { fill: var(--color-art-sky5); }
+.sky-6 { fill: var(--color-art-sky6); }
+.far { fill: var(--color-art-far); }
+.near { fill: var(--color-art-near); }
+.ol { fill: var(--color-art-outline); }
+.base { fill: var(--base); }
+.hi { fill: color-mix(in srgb, var(--base) 60%, var(--color-art-glint)); }
+.shade { fill: color-mix(in srgb, var(--base) 60%, var(--color-art-outline)); }
+.warm { fill: var(--color-art-light-warm); }
+.cold { fill: var(--color-art-light-cold); }
+.star { fill: var(--color-art-star); }
+.star-dim { fill: color-mix(in srgb, var(--color-art-star) 50%, var(--color-art-sky1)); }
+.beacon { fill: var(--color-art-beacon); }
+.glint { fill: var(--color-art-glint); }
+.halo { fill: url(#d-glint); }
+.ground {
+  position: relative;
+  overflow-x: clip;
+  height: calc(var(--size-ground) + var(--size-ground-edge));
+  margin-top: calc(var(--space-64) + var(--size-ground-sprite));
+  pointer-events: none;
+  background:
+    linear-gradient(90deg, var(--color-art-edge-hi) 2px, transparent 0) 0 calc(100% - 2px) / 6px 2px repeat-x,
+    linear-gradient(var(--color-art-edge) 0 0) bottom / 100% var(--size-ground-edge) no-repeat,
+    repeating-conic-gradient(var(--color-art-ground-hi) 0 25%, transparent 0 50%) 0 0 / 8px 8px,
+    var(--color-art-ground);
+}
+.ground > svg {
+  position: absolute;
+  bottom: 100%;
+  left: 50%;
+  translate: -50% 0;
+  width: 1440px;
+  max-width: none;
+  height: var(--size-ground-sprite);
+  shape-rendering: crispEdges;
+}
