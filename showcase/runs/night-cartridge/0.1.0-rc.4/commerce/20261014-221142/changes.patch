+  flex: none;
+  width: calc(var(--size-vignette) + var(--border-width-control) * 2);
+  height: calc(var(--size-vignette) + var(--border-width-control) * 2);
+  border: var(--border-width-control) solid var(--color-border-control);
+  background: var(--color-art-sky1);
+}
+.vignette > svg {
   display: block;
-  flex-shrink: 0;
+  shape-rendering: crispEdges;
 }
 
