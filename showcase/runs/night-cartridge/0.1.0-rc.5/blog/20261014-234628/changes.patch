index 8c45cab..bdf6792 100644
--- a/src/components/TableOfContents.tsx
+++ b/src/components/TableOfContents.tsx
@@ -1,25 +1,90 @@
+import { useEffect, useState, useSyncExternalStore } from 'react';
 import type { Block } from '../data/posts';
+import { Marker } from './pixel';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const WIDE = '(min-width: 1024px)';
+const subscribe = (cb: () => void) => {
+  const mq = window.matchMedia(WIDE);
+  mq.addEventListener('change', cb);
+  return () => mq.removeEventListener('change', cb);
+};
+const useWide = () => useSyncExternalStore(subscribe, () => window.matchMedia(WIDE).matches);
+
+/** The heading under the header is current; on load, the first one. */
+function useCurrentHeading(ids: string[]) {
+  const [current, setCurrent] = useState(ids[0]);
+  useEffect(() => {
+    setCurrent(ids[0]);
+    let frame = 0;
+    const update = () => {
+      frame = 0;
+      const line = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
+      let next = ids[0];
+      for (const id of ids) {
+        const el = document.getElementById(id);
+        if (el && el.getBoundingClientRect().top <= line + 1) next = id;
+      }
+      setCurrent(next);
+    };
+    const onScroll = () => {
+      if (!frame) frame = requestAnimationFrame(update);
+    };
+    window.addEventListener('scroll', onScroll, { passive: true });
+    return () => {
+      window.removeEventListener('scroll', onScroll);
+      cancelAnimationFrame(frame);
+    };
+  }, [ids.join('|')]);
+  return current;
+}
+
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const current = useCurrentHeading(headings.map((h) => h.id));
+  const wide = useWide();
   if (headings.length === 0) return null;
 
+  const list = (
+    <ol className="toc-list">
+      {headings.map((heading) => (
+        <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+          <a
+            href={`#${heading.id}`}
+            className="item toc-link"
+            aria-current={heading.id === current ? 'location' : undefined}
+            data-testid="toc-link"
+          >
+            <Marker />
+            {heading.text}
+          </a>
+        </li>
+      ))}
+    </ol>
+  );
+
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      {wide ? (
+        <>
+          <h2 id="toc-heading" className="toc-heading">
+            On this page
+          </h2>
+          {list}
+        </>
+      ) : (
+        <details className="disclosure">
+          <summary>
+            <Marker className="disclosure__closed" />
+            <Marker dir="d" className="disclosure__open" />
+            <h2 id="toc-heading" className="toc-heading">
+              On this page
+            </h2>
+          </summary>
+          {list}
+        </details>
+      )}
     </nav>
   );
 }
