+  font-synthesis: none;
+  letter-spacing: normal;
+  text-transform: none;
+  word-break: keep-all;
+  line-break: strict;
+  overflow-wrap: break-word;
+  font-variant-numeric: slashed-zero tabular-nums;
+}
+body { margin: 0; background: var(--color-surface-default); }
