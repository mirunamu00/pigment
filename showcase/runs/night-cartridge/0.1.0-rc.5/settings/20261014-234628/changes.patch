+/* ------------------------------------------------------------ root: motion and shape */
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation: none !important; transition: none !important; }
+}
+:root[data-motion="off"] *, :root[data-motion="off"] *::before, :root[data-motion="off"] *::after { animation: none !important; }
+*, *::before, *::after { transition: none !important; border-radius: 0 !important; box-sizing: border-box; }
+
+/* Frame 1 of two-frame swaps when motion is stopped. */
+@media (prefers-reduced-motion: reduce) { .frame-b { visibility: hidden; } }
+:root[data-motion="off"] .frame-b { visibility: hidden; }
+
+:root { color-scheme: light; }
+:root[data-theme="dark"] { color-scheme: dark; }
+@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { color-scheme: dark; } }
+
+/* ------------------------------------------------------------ type */
+html {
+  font: var(--font-weight-regular) var(--font-size-body) / var(--font-line-height-ui) var(--font-family-pixel);
+  color: var(--color-text-primary);
