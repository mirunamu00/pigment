+.activity-list{list-style:none;margin:0;padding:0}
+.activity-item{display:grid;gap:var(--space-4);padding-block:var(--space-12)}
+.activity-item:first-child{padding-top:0}
+.activity-item:last-child{padding-bottom:0}
+.activity-item+.activity-item{background:linear-gradient(90deg,var(--color-border-control) 2px,transparent 0) 0 0/6px 2px repeat-x}
+
+/* Toolbar, filter chips */
+.toolbar{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:var(--space-16);margin-bottom:var(--space-16)}
+.chips{display:flex;flex-wrap:wrap;gap:var(--space-8)}
+.chip{display:inline-flex;align-items:center;gap:var(--space-8);height:var(--size-control);padding-inline:var(--space-12);background:transparent;border:var(--border-width-control) solid var(--color-border-default);color:var(--color-text-primary);cursor:pointer;white-space:nowrap}
+.chip:hover{background:var(--color-surface-hover);color:var(--color-text-strong)}
+.chip[aria-pressed="true"]{color:var(--color-text-strong)}
+.chip__slot{display:inline-grid;place-items:center;width:var(--size-marker-w);height:var(--size-marker-h)}
+.toolbar .field{width:min(100%,320px)}
+
+/* Table */
+.table-wrap{overflow-x:auto}
+.table{width:100%;border-collapse:collapse}
+.table th{height:var(--size-row);padding:0 var(--space-12);background:var(--color-surface-subtle);color:var(--color-text-strong);text-align:left;white-space:nowrap;border-bottom:var(--border-width-control) solid var(--color-border-strong)}
+.table td{height:var(--size-row);padding:var(--space-8) var(--space-12);border-bottom:var(--border-width-control) solid var(--color-border-default);vertical-align:middle}
+.table :is(th,td):first-child{position:relative;padding-left:calc(var(--space-16) + var(--space-12))}
+.table th.num{text-align:right}
+.table tbody tr:hover{background:var(--color-surface-hover)}
+.row-cur{position:absolute;left:var(--space-4);top:50%;translate:0 -50%;visibility:hidden}
+.table tbody tr:is(:hover,:focus-within) .row-cur{visibility:visible}
+.table td{white-space:nowrap}
+.cell-sub{font-size:var(--font-size-caption);line-height:var(--font-line-height-caption);color:var(--color-text-secondary)}
+.sort-button{display:inline-flex;align-items:center;gap:var(--space-8);height:var(--size-row);padding:0;background:none;border:0;color:inherit;cursor:pointer;white-space:nowrap}
+.sort-button:hover{color:var(--color-text-strong)}
+.table th:has(.sort-button):hover{background:var(--color-surface-hover)}
+.sort-indicator{display:inline-grid;place-items:center;width:var(--size-marker-h);height:var(--size-marker-w)}
+.sort-indicator>.cur{color:var(--color-text-accent)}
+
+/* Status badge */
+.badge{display:inline-flex;align-items:center;gap:var(--space-8);padding:0 var(--space-8);color:var(--color-text-primary);white-space:nowrap}
+.badge--active{--hue:var(--color-status-success)}
+.badge--paused{--hue:var(--color-status-warning)}
+.badge--done{--hue:var(--color-status-info)}
+
+/* Empty and error states */
+.empty-state{display:flex;flex-direction:column;align-items:center;gap:var(--space-16);max-width:400px;margin-inline:auto;padding-block:var(--space-40);text-align:center}
+.empty-state p{line-height:var(--font-line-height-prose)}
+.error-window .window__body{padding:var(--space-20)}
+.error-window .btn-gold{margin-top:var(--space-8)}
+
+/* Breadcrumbs */
+.breadcrumb ol{list-style:none;display:flex;flex-wrap:wrap;gap:var(--space-8);margin:0;padding:0;color:var(--color-text-secondary)}
+.breadcrumb li+li::before{content:"/";margin-right:var(--space-8)}
+.breadcrumb a{color:var(--color-text-secondary);text-decoration:none}
+.breadcrumb a:hover{color:var(--color-text-strong);text-decoration:underline;text-decoration-color:var(--color-text-strong)}
+
+/* Tabs */
+.tabs{display:flex;overflow-x:auto;border-bottom:var(--border-width-control) solid var(--color-border-strong)}
+.tab{display:inline-flex;align-items:center;gap:var(--space-8);flex:none;height:calc(var(--size-control) + var(--border-width-control));margin-bottom:calc(var(--border-width-control) * -1);padding:0 var(--space-12);background:none;border:var(--border-width-control) solid transparent;color:var(--color-text-secondary);cursor:pointer}
+.tab>.cur{visibility:hidden}
+.tab:hover{background:var(--color-surface-hover);color:var(--color-text-primary)}
+.tab[aria-selected="true"]{background:var(--color-surface-subtle);border-color:var(--color-border-strong);border-bottom-color:var(--color-surface-subtle);color:var(--color-text-strong)}
+.tab[aria-selected="true"]>.cur{visibility:visible}
+.tabpanel{display:flex;flex-direction:column;gap:var(--space-20);padding:var(--space-20);background:var(--color-surface-subtle);border:var(--border-width-control) solid var(--color-border-strong);border-top:0}
+
+/* Project details */
+.details{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-16);margin:0}
+.details>div{display:grid;align-content:start;gap:var(--space-4);padding:var(--space-12) var(--space-16);background:var(--color-surface-raised)}
+.details dt{font-size:var(--font-size-caption);line-height:var(--font-line-height-caption);color:var(--color-text-secondary)}
+.details dd{display:grid;gap:var(--space-8);margin:0;color:var(--color-text-strong)}
+.progress-row{display:grid;gap:var(--space-8)}
+.progress-row p{font-size:var(--font-size-caption);line-height:var(--font-line-height-caption);color:var(--color-text-secondary)}
+.task-list{list-style:none;margin:0;padding:0}
+.task{display:flex;align-items:center;gap:var(--space-8);min-height:var(--size-row);padding-block:var(--space-8)}
+.task+.task{background:linear-gradient(90deg,var(--color-border-control) 2px,transparent 0) 0 0/6px 2px repeat-x}
+.task label{flex:1;cursor:pointer}
+.task-done label{color:var(--color-text-secondary);text-decoration:line-through}
+
+/* People */
+.person{display:flex;align-items:center;gap:var(--space-12)}
+.person a{font-size:var(--font-size-caption);line-height:var(--font-line-height-caption)}
+.avatar{flex:none;display:inline-grid;place-items:center;background:var(--color-surface-hover)}
+.avatar svg{display:block;fill:var(--color-hue-green)}
+.avatar--list{width:40px;height:40px}.avatar--list svg{width:32px;height:32px}
+.avatar--small{width:24px;height:24px}.avatar--small svg{width:16px;height:16px}
+
+/* Settings */
+.settings-group{max-width:var(--size-form)}
+.settings-group .window__body{display:flex;flex-direction:column;align-items:flex-start;gap:var(--space-16)}
+.settings-group .window__bar h2{font-size:var(--font-size-body);line-height:var(--font-line-height-ui)}
+
+/* ---------- Layout adaptation ---------- */
+@media (max-width:1279.98px){
+  .kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
+}
+@media (max-width:1023.98px){
+  .brand{width:auto}
+  .tool__label{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
+  .shell{grid-template-columns:minmax(0,1fr)}
+  .sidebar{min-height:0;padding:var(--space-8) var(--space-16);border-right:0;border-bottom:var(--border-width-control) solid var(--color-border-default)}
+  .sidebar-title{display:none}
+  .nav-list{display:flex;flex-wrap:wrap;gap:var(--space-4) var(--space-8)}
+  .nav-list>li+li::before{display:none}
+  .two-column{grid-template-columns:minmax(0,1fr);gap:var(--space-64)}
+  .details{grid-template-columns:repeat(2,minmax(0,1fr))}
+}
+@media (max-width:599.98px){
+  .site-header{position:static}
+  .topbar{flex-wrap:wrap;height:auto;padding:var(--space-12) var(--space-16);gap:var(--space-12) var(--space-8)}
+  .topbar-search{order:3;flex-basis:100%;max-width:none}
+  .user-menu-name{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
+  .header-tools{gap:var(--space-4)}
+  .content{gap:var(--space-40);padding-inline:var(--space-16)}
+  .two-column{gap:var(--space-40)}
+  .kpi-grid{grid-template-columns:minmax(0,1fr)}
+  .nav-icon{display:none}
+  .title-block{padding:var(--space-20) var(--space-16)}
+  .toolbar .field{width:100%}
+  .tabpanel{padding:var(--space-16)}
+  .error-window .btn-gold{width:100%}
+}
+@media (pointer:coarse){
+  .item,.task{min-height:var(--size-touch)}
 }
