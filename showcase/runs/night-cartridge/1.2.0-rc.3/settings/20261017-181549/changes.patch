+export function readMotion(): boolean {
+  try {
+    return localStorage.getItem(MOTION_KEY) !== 'off';
+  } catch {
+    return true;
+  }
+}
+
+export function applyMotion(on: boolean) {
+  if (on) delete document.documentElement.dataset.motion;
+  else document.documentElement.dataset.motion = 'off';
+}
+
+/** Header switch: freezes every scene on frame 1. Persisted, default on. */
+function AnimationSwitch() {
+  const [on, setOn] = useState(readMotion);
+  function toggle() {
+    const next = !on;
+    setOn(next);
+    applyMotion(next);
+    try {
+      localStorage.setItem(MOTION_KEY, next ? 'on' : 'off');
+    } catch {
+      // Storage unavailable: the switch still works for this visit.
+    }
+  }
+  return (
+    <button type="button" className="tool" aria-pressed={on} onClick={toggle}>
+      <PixelIcon name={on ? 'pause' : 'play'} className="icon-sm" />
+      <span className="tool__label">Animation {on ? 'on' : 'off'}</span>
+    </button>
+  );
+}
