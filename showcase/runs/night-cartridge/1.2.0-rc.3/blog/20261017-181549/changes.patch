+}
+.input::placeholder { color: var(--color-text-secondary); opacity: 1; }
+.input:hover { border-color: var(--color-border-strong); }
+.input[aria-invalid="true"] { border-color: var(--color-status-danger); }
+.input::-webkit-search-cancel-button { -webkit-appearance: none; }
+.search { position: relative; }
+.search-icon { position: absolute; left: var(--space-8); top: 50%; translate: 0 -50%; color: var(--color-text-secondary); pointer-events: none; }
+.search .input { padding-left: var(--space-40); }
+.form-error { display: flex; align-items: center; gap: var(--space-8); margin: var(--space-4) 0 0; color: var(--color-status-danger); font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); }
+.form-success { display: flex; align-items: center; gap: var(--space-8); padding: var(--space-12) var(--space-16); margin: 0; background: var(--color-surface-raised); border-left: var(--border-width-window) solid var(--color-status-success); color: var(--color-text-strong); }
+
+/* ---------- Badges and chips ---------- */
+.tag-list { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-12); list-style: none; margin: 0; padding: 0; }
+.tag-chip { display: inline-flex; align-items: center; gap: var(--space-8); color: var(--color-text-primary); font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); }
+.tag-filter { display: flex; flex-wrap: wrap; gap: var(--space-8); }
+.chip {
+  display: inline-flex; align-items: center; gap: var(--space-8); height: var(--size-control); padding-inline: var(--space-12);
+  background: transparent; color: var(--color-text-primary); border: var(--border-width-control) solid var(--color-border-default); cursor: pointer;
+}
+.chip:hover { background: var(--color-surface-hover); color: var(--color-text-strong); }
+.chip:active { translate: 2px 2px; }
+.chip[aria-pressed="true"] { color: var(--color-text-strong); border-color: var(--color-border-strong); }
+.chip-slot { display: inline-flex; align-items: center; justify-content: center; width: var(--size-marker-w); }
+
+/* ---------- Cards ---------- */
+.card { position: relative; display: flex; flex-direction: column; gap: var(--space-8); height: 100%; padding: var(--space-16) var(--space-20); background: var(--color-surface-subtle); border-top: var(--border-width-control) solid var(--color-border-default); }
+.card.hue-bar { border-top: var(--border-width-window) solid var(--hue); }
+.card p { margin: 0; }
+.card-link:hover { background: var(--color-surface-hover); }
+.card-link:active { translate: 2px 2px; }
+.card-link:has(.stretched:focus-visible) { outline: var(--border-width-window) solid var(--color-focus-ring); outline-offset: 3px; }
+.card-icon { color: var(--hue); }
+.card-title { margin: 0; font-size: var(--font-size-body); line-height: var(--font-line-height-ui); }
+.card--feature .card-title { font-size: var(--font-size-title); line-height: var(--font-line-height-title); }
+.stretched { color: var(--color-text-strong); text-decoration: none; }
+.stretched::after { content: ""; position: absolute; inset: 0; }
+.stretched:focus-visible { outline: none; }
+.card-link:hover .stretched { color: var(--color-text-strong); }
+.card-desc { color: var(--color-text-secondary); display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
+.card--feature .card-desc { -webkit-line-clamp: 3; max-width: var(--size-prose); }
+.card .tag-list { margin-top: auto; padding-top: var(--space-8); }
+
+.post-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: var(--space-16); list-style: none; margin: 0; padding: 0; }
+
+/* ---------- Home ---------- */
+.hero { position: relative; }
+.hero-inner { position: absolute; inset: 0; display: flex; align-items: center; pointer-events: none; }
+.hero-window { pointer-events: auto; width: 416px; padding: var(--space-20); }
+.hero-window h1 { font-size: var(--font-size-display); line-height: var(--font-line-height-display); margin-bottom: var(--space-8); }
+.hero-window .btn { margin-bottom: var(--space-16); }
+.hero-window .caption { margin: 0; }
+@media (max-width: 1023px) {
+  .hero-inner { position: static; display: block; margin-top: calc(-1 * var(--space-24)); }
+  .hero-window { width: 100%; max-width: var(--size-prose); position: relative; }
+}
+@media (max-width: 599px) { .hero-window h1 { font-size: var(--font-size-title); line-height: var(--font-line-height-title); } }
+.content:has(.hero) { padding-top: 0; }
+.page-body > section { margin-top: var(--space-64); }
+.filter-bar { display: grid; grid-template-columns: minmax(0, 360px) 1fr; gap: var(--space-16) var(--space-24); align-items: end; margin-bottom: var(--space-20); }
+.result-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-8) var(--space-16); margin-bottom: var(--space-16); }
+.result-row .caption { margin: 0; }
+@media (max-width: 1023px) { .filter-bar { grid-template-columns: 1fr; } }
+
+.empty-state { display: flex; flex-direction: column; align-items: center; gap: var(--space-16); max-width: 400px; margin: var(--space-40) auto; text-align: center; }
+.empty-state h3, .empty-state p { margin: 0; }
+.empty-state p { color: var(--color-text-secondary); line-height: var(--font-line-height-prose); }
+
+/* ---------- Banner windows (article, about) ---------- */
+.banner .banner-title { padding: var(--space-24); border-top: var(--border-width-control) solid var(--color-border-default); }
+.banner h1 { margin-bottom: var(--space-8); }
+.banner .lede { margin-bottom: var(--space-12); }
+.banner .post-meta, .banner .caption { margin: 0 0 var(--space-12); }
+.banner .banner-title > :last-child { margin-bottom: 0; }
+
+.breadcrumb ol { display: flex; flex-wrap: wrap; list-style: none; margin: 0 0 var(--space-16); padding: 0; color: var(--color-text-secondary); font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); }
+.breadcrumb li + li::before { content: " / "; white-space: pre; }
+.breadcrumb a { color: var(--color-text-secondary); text-decoration: none; }
+.breadcrumb a:hover { color: var(--color-text-strong); text-decoration: underline var(--border-width-control); text-underline-offset: 4px; }
+
+/* ---------- Article ---------- */
+.article-layout { display: grid; grid-template-columns: minmax(0, var(--size-prose)) var(--size-toc); gap: var(--space-64); justify-content: space-between; margin-top: var(--space-40); }
+.article-aside { order: 2; }
+.article-body > * { margin: 0 0 var(--space-20); }
+.article-body h2.ruled { margin-top: var(--space-40); }
+.article-body h3 { margin-top: var(--space-32); }
+.article-body :is(h2, h3) { scroll-margin-top: calc(var(--size-header) + var(--size-rule) + var(--space-16)); }
+.body-list { padding-left: var(--space-24); }
+.body-list li { margin-bottom: var(--space-8); }
+.body-list li::marker { color: var(--color-text-secondary); }
+ul.body-list { list-style: none; padding-left: 0; }
+ul.body-list li { display: flex; gap: var(--space-12); }
+ul.body-list li::before { content: ""; flex: none; width: var(--size-bullet); height: var(--size-bullet); margin-top: 11px; background: var(--color-border-strong); }
+.body-quote { margin-inline: 0; padding: var(--space-16) var(--space-20); background: var(--color-surface-subtle); border-left: var(--border-width-window) solid var(--color-border-control); }
+.body-quote blockquote { margin: 0; color: var(--color-text-strong); }
+.body-quote blockquote p { margin: 0; }
+.body-quote figcaption { margin-top: var(--space-8); }
+.code-window { max-width: 100%; }
+.code-lang { color: var(--color-text-secondary); font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); margin-right: auto; }
+.code-block { margin: 0; padding: var(--space-16) var(--space-20); overflow-x: auto; line-height: var(--font-line-height-ui); color: var(--color-text-primary); }
+.body-figure { margin-inline: 0; }
+.image-placeholder { width: 640px; height: 288px; max-width: none; box-sizing: content-box; border: var(--border-width-control) solid var(--color-border-control); background: var(--color-art-sky1); shape-rendering: crispEdges; }
+.body-figure figcaption { margin-top: var(--space-8); }
+@media (max-width: 719px) { .image-placeholder { width: 320px; height: 144px; } }
+
+.toc { position: sticky; top: calc(var(--size-header) + var(--size-rule) + var(--space-16)); }
+.toc summary { list-style: none; display: flex; align-items: center; gap: var(--space-8); }
+.toc summary::-webkit-details-marker { display: none; }
+.toc-chevron { display: none; }
+.toc-heading { margin: 0 0 var(--space-8); font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); color: var(--color-text-secondary); }
+.toc-list { list-style: none; margin: 0; padding: 0; border-left: var(--border-width-control) solid var(--color-border-default); }
+.toc-link { padding-block: var(--space-8); min-height: 0; color: var(--color-text-secondary); text-decoration: none; align-items: flex-start; }
+.toc-link > .cur { margin-top: 5px; }
+.toc-link:hover { color: var(--color-text-strong); }
+.toc-item-nested .toc-link { padding-left: calc(var(--space-8) + var(--space-16)); }
+@media (min-width: 1024px) { .toc summary { cursor: default; pointer-events: none; } }
+@media (max-width: 1023px) {
+  .article-layout { grid-template-columns: minmax(0, 1fr); gap: var(--space-24); }
+  .article-aside { order: -1; }
+  .toc { position: static; }
+  .toc details { background: var(--color-surface-subtle); border-left: var(--border-width-window) solid var(--color-border-control); }
+  .toc details:hover { --c: var(--color-hue-cyan); background: var(--color-surface-hover); border-left-color: var(--color-hue-cyan); }
+  .toc summary { min-height: var(--size-control); padding-inline: var(--space-12); cursor: pointer; }
+  .toc-chevron { display: inline-block; visibility: visible; color: var(--color-text-accent); }
+  .toc-heading { margin: 0; font-size: var(--font-size-body); line-height: var(--font-line-height-ui); color: var(--color-text-strong); }
+  .toc-list { margin: 0 var(--space-12) var(--space-12); }
+}
+
+.prev-next { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-16); margin-top: var(--space-64); border-top: var(--border-width-control) solid var(--color-border-strong); }
+.prev-next-link { display: flex; flex-direction: column; gap: var(--space-4); padding: var(--space-12) var(--space-8); color: var(--color-text-strong); text-decoration: none; }
+.prev-next-link:hover { background: var(--color-surface-hover); }
+.prev-next-link:active { translate: 2px 2px; }
+.prev-next-link .caption { display: inline-flex; align-items: center; gap: var(--space-8); }
+.prev-next-link .cur { background-image: none; }
+.prev-next-link--next { grid-column: 2; text-align: right; align-items: flex-end; }
+.related { margin-top: var(--space-64); }
+@media (max-width: 599px) {
+  .prev-next { grid-template-columns: 1fr; }
+  .prev-next-link--next { grid-column: 1; }
+}
+
+/* ---------- About ---------- */
+.about-prose, .authors { margin-top: var(--space-64); }
+.author-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: var(--space-16); list-style: none; margin: 0; padding: 0; }
+.author-card { flex-direction: row; align-items: flex-start; gap: var(--space-16); }
+.author-card h3 { margin: 0; }
+.author-card .caption { margin: 0 0 var(--space-8); }
+.author-bio { line-height: var(--font-line-height-prose); }
+.avatar { flex: none; display: grid; place-items: center; width: 40px; height: 40px; background: var(--hue); color: var(--color-text-on-action); }
+
+/* ---------- Error states ---------- */
+.error-state { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-24); max-width: var(--size-form); margin: var(--space-40) auto 0; }
+.error-window { width: 100%; padding: var(--space-20); }
+.error-window p { color: var(--color-text-secondary); }
+
+/* ---------- Footer ---------- */
+.site-footer { margin-top: auto; }
+.site-footer-inner { padding-block: var(--space-40); }
+.newsletter { max-width: var(--size-form); padding: var(--space-20); margin-bottom: var(--space-24); background: var(--color-surface-subtle); border: var(--border-width-control) solid var(--color-border-default); }
+.newsletter-lede { color: var(--color-text-secondary); }
+.field-row { display: flex; gap: var(--space-12); align-items: flex-start; }
+.field-row .input { height: var(--size-control-lg); }
+.site-footer-inner > .caption { margin: 0; }
+@media (max-width: 599px) {
+  .field-row { flex-direction: column; align-items: stretch; }
+  .btn-gold { width: 100%; }
+  .content { padding-top: var(--space-24); }
+  .page-body > section, .about-prose, .authors, .related, .prev-next { margin-top: var(--space-40); }
 }
