+/* ------------------------------------------------------------------ smaller screens */
+@media (max-width:1023px){
+  .detail-columns,.cart-layout{grid-template-columns:minmax(0,1fr)}
+  .detail-media,.product-detail-info,.cart-main,.cart-side{grid-column:1/-1}
+  .detail-media,.cart-side{position:static}
+}
+@media (max-width:599px){
+  .title-block{padding:var(--space-16)}
+  .cart-line{grid-template-columns:auto minmax(0,1fr) auto;row-gap:var(--space-12)}
+  .cart-line-info{grid-column:1/-1}
+  .purchase-form .btn-gold,.checkout-form .btn-gold,.error-window .btn-gold{align-self:stretch}
+  .summary-total dd{font-size:var(--font-size-title);line-height:var(--font-line-height-title)}
+  .toolbar-controls{width:100%}
+}
+@media (pointer:coarse){
+  .item,.chip,.variant-option,.check{min-height:var(--size-touch)}
 }
