+  }
+  .toc details:has(summary:hover) {
+    border-left-color: var(--color-hue-cyan);
+  }
+  .toc summary {
+    min-height: var(--size-control);
+    padding-inline: var(--space-12);
+    cursor: pointer;
+  }
+  .toc summary:hover {
+    background: var(--color-surface-hover);
+  }
+  .toc summary > .cur {
+    display: inline-block;
+  }
+  .toc-heading {
+    margin: 0;
+    font-size: var(--font-size-body);
+    line-height: var(--font-line-height-ui);
+    color: var(--color-text-strong);
+  }
+  .toc-list {
+    border-left: 0;
+    padding-bottom: var(--space-8);
+  }
+}
+
+.prev-next {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: var(--space-16);
+  padding-top: var(--space-16);
+  border-top: var(--border-width-control) solid var(--color-border-strong);
+}
+.prev-next__link {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: var(--space-4);
+  padding: var(--space-12);
+  color: var(--color-text-primary);
+  text-decoration: none;
+}
+.prev-next__link--next {
+  align-items: flex-end;
+  text-align: right;
+  grid-column: 2;
+}
+.prev-next__link:hover {
+  background: var(--color-surface-hover);
+  color: var(--color-text-strong);
+}
+.prev-next .caption {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-8);
+}
+.prev-next .cur {
+  color: inherit;
+  background-image: none;
+}
+.prev-next__title {
+  color: var(--color-text-strong);
+}
+@media (max-width: 599px) {
+  .prev-next {
+    grid-template-columns: 1fr;
+  }
+  .prev-next__link--next {
+    grid-column: auto;
+  }
+}
+
+/* -------------------------------------------------------------------- About ---------- */
+
+.author-card {
+  flex-direction: row;
+  gap: var(--space-16);
+}
+.author-card > div {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+}
+.author-card .card-desc {
+  margin-top: var(--space-4);
+  -webkit-line-clamp: unset;
+}
+.about-prose > p + p {
+  margin-top: var(--space-20);
+}
+.avatar {
+  flex: none;
+  display: grid;
+  place-items: center;
+  width: 40px;
+  height: 40px;
+  background: color-mix(in srgb, var(--hue) 55%, var(--color-art-sky1));
+  color: var(--color-text-strong);
+}
+
+/* ------------------------------------------------------------------- Errors ---------- */
+
+.error-window {
+  display: flex;
+  align-items: center;
+  gap: var(--space-24);
+  max-width: var(--size-prose);
+  padding: var(--space-24);
+}
+.error-window__body {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: var(--space-12);
+}
+.error-window__body p {
+  line-height: var(--font-line-height-prose);
+}
+@media (max-width: 599px) {
+  .error-window {
+    flex-direction: column;
+    align-items: flex-start;
+    padding: var(--space-20);
+  }
+}
+
+/* ------------------------------------------------------------------- Footer ---------- */
+
+.site-footer-inner {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-24);
+  padding-block: var(--space-40);
+}
+.panel {
+  padding: var(--space-20);
+  background: var(--color-surface-subtle);
+  border: var(--border-width-control) solid var(--color-border-control);
+}
+.newsletter {
+  max-width: calc(var(--size-form) + 2 * var(--space-20) + 2 * var(--border-width-control));
+}
+.newsletter > p {
+  margin: var(--space-8) 0 var(--space-20);
+}
+.newsletter .controls .input {
+  flex: 1 1 240px;
+  width: auto;
+}
+@media (max-width: 599px) {
+  .newsletter .controls > * {
+    flex: 1 1 100%;
   }
 }
