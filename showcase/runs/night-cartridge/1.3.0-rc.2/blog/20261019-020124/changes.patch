+import { useEffect, useState, type MouseEvent } from 'react';
 import type { Block } from '../data/posts';
+import { Marker } from './Pixel';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const WIDE = '(min-width: 1024px)';
+const isWide = () => typeof window !== 'undefined' && window.matchMedia(WIDE).matches;
+
+/** Contents list: always open beside the article; a disclosure under breakpoint.lg. */
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const [current, setCurrent] = useState(headings[0]?.id);
+  const [wide, setWide] = useState(isWide);
+  const [open, setOpen] = useState(isWide);
+
+  useEffect(() => {
+    const query = window.matchMedia(WIDE);
+    const sync = () => {
+      setWide(query.matches);
+      if (query.matches) setOpen(true);
+    };
+    query.addEventListener('change', sync);
+    return () => query.removeEventListener('change', sync);
+  }, []);
+
+  // The current item is the last heading that has reached the area under the sticky header.
+  useEffect(() => {
+    const ids = headings.map((heading) => heading.id);
+    function update() {
+      const line = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
+      let next = ids[0];
+      for (const id of ids) {
+        const el = document.getElementById(id);
+        if (el && el.getBoundingClientRect().top <= line + 8) next = id;
+      }
+      setCurrent(next);
+    }
+    update();
+    window.addEventListener('scroll', update, { passive: true });
+    window.addEventListener('hashchange', update);
+    return () => {
+      window.removeEventListener('scroll', update);
+      window.removeEventListener('hashchange', update);
+    };
+  }, [blocks]);
+
   if (headings.length === 0) return null;
 
+  function onSummaryClick(event: MouseEvent) {
+    event.preventDefault();
+    if (!wide) setOpen((value) => !value);
+  }
+
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      <details open={open}>
+        <summary onClick={onSummaryClick} tabIndex={wide ? -1 : undefined}>
+          <h2 id="toc-heading" className="toc-heading">
+            On this page
+          </h2>
+          <Marker dir={open ? 'd' : 'r'} />
+        </summary>
+        <ol className="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a
+                href={`#${heading.id}`}
+                className="item toc-link"
+                aria-current={current === heading.id ? 'location' : undefined}
+                data-testid="toc-link"
+              >
+                <Marker />
+                {heading.text}
+              </a>
+            </li>
+          ))}
+        </ol>
+      </details>
     </nav>
   );
 }
