+  display: inline-flex; align-items: center; gap: var(--space-8); height: calc(var(--size-control) + var(--border-width-control)); margin-bottom: calc(-1 * var(--border-width-control));
+  padding: 0 var(--space-12) var(--border-width-control); background: transparent; color: var(--color-text-secondary); border: var(--border-width-control) solid transparent; border-bottom: 0; cursor: pointer;
+}
+.tab > .cur { visibility: hidden; }
+.tab:hover { background: var(--color-surface-hover); color: var(--color-text-strong); }
+.tab[aria-selected='true'] { background: var(--color-surface-subtle); color: var(--color-text-strong); border-color: var(--color-border-strong); }
+.tab[aria-selected='true'] > .cur { visibility: visible; }
+.tab:focus-visible { outline-offset: -4px; }
+.tab-panel { padding: var(--space-20); background: var(--color-surface-subtle); }
+.details { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-16); margin-top: var(--space-24); }
+.details > div { display: grid; gap: var(--space-4); padding-top: var(--space-12); background: linear-gradient(90deg, var(--color-border-control) 2px, transparent 0) 0 0 / 6px 2px repeat-x; }
+.details dt { color: var(--color-text-secondary); font-size: var(--font-size-caption); line-height: var(--font-line-height-caption); }
+.details dd { color: var(--color-text-strong); display: grid; gap: var(--space-8); }
+.progress-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-12) var(--space-24); margin-bottom: var(--space-16); }
+.progress-row p { color: var(--color-text-strong); }
+.task-list { display: grid; }
+.task { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-12); min-height: var(--size-row); padding: var(--space-8) 0; }
+.task + .task { background: linear-gradient(90deg, var(--color-border-control) 2px, transparent 0) 0 0 / 6px 2px repeat-x; }
+.task label { flex: 1 1 240px; cursor: pointer; }
+.task-done label { color: var(--color-text-secondary); }
+.task .caption { color: var(--color-text-secondary); }
+
+/* ── Settings, error window ────────────────────────────────────────────────────────────── */
+.settings-body { display: grid; gap: var(--space-16); }
+.settings-body > h2.ruled { margin-bottom: 0; }
+.forward-link { display: inline-flex; align-items: center; gap: var(--space-8); justify-self: start; }
+.error-window__body { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-24) var(--space-32); padding: var(--space-24); }
+.error-window__text { flex: 1 1 280px; display: grid; justify-items: start; gap: var(--space-16); }
+.error-window__text > p { line-height: var(--font-line-height-prose); }
+
+/* ── Responsive shell ──────────────────────────────────────────────────────────────────── */
+@media (max-width: 1023px) {
+  .topbar { position: static; }
+  .topbar__row { flex-wrap: wrap; padding-block: var(--space-12); row-gap: var(--space-12); }
+  .topbar-tools { margin-left: auto; }
+  .topbar-search { order: 3; flex-basis: 100%; max-width: none; margin-left: 0; }
+  .shell { flex-direction: column; }
+  .sidebar { width: auto; min-height: 0; padding: var(--space-8) var(--space-24); border-right: 0; border-bottom: var(--border-width-control) solid var(--color-border-default); }
+  .sidebar__title, .nav-list .count { display: none; }
+  .nav-list { display: flex; flex-wrap: wrap; gap: var(--space-4); }
+  .nav-list > li + li { background: none; padding-top: 0; }
+}
+@media (max-width: 599px) {
+  .topbar__row { padding-inline: var(--space-16); gap: var(--space-8); }
+  .topbar .search > kbd { display: none; }
+  .topbar .tool-label, .user-menu-button .user-name {
+    position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
   }
+  .sidebar { padding-inline: var(--space-16); }
+  .nav-list { display: grid; grid-template-columns: 1fr 1fr; }
+  .content { padding: var(--space-40) var(--space-16) 0; }
+  .content > * + * { margin-top: var(--space-40); }
+  .title-block { padding: var(--space-20); }
+  .toolbar .field { flex-basis: 100%; }
+  .btn-gold.block-sm { width: 100%; }
+}
+@media (pointer: coarse) {
+  .btn, .chip, .tool, .tab, .item, .input, .user-menu-button { min-height: var(--size-touch); }
