+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
+import { Marker } from './pixel/Pixel';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const WIDE = '(min-width: 1024px)';
+/** Header (64) + dither rule (4) + a little air: a heading above this line is the one being read. */
+const READ_LINE = 96;
+
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const [current, setCurrent] = useState(headings[0]?.id);
+  // A contents list on wide screens; a disclosure under breakpoint.lg.
+  const [open, setOpen] = useState(() => window.matchMedia(WIDE).matches);
+
+  useEffect(() => {
+    const media = window.matchMedia(WIDE);
+    const onChange = () => setOpen(media.matches);
+    media.addEventListener('change', onChange);
+    return () => media.removeEventListener('change', onChange);
+  }, []);
+
+  useEffect(() => {
+    function onScroll() {
+      let id = headings[0]?.id;
+      for (const heading of headings) {
+        const el = document.getElementById(heading.id);
+        if (el && el.getBoundingClientRect().top <= READ_LINE) id = heading.id;
+      }
+      setCurrent(id);
+    }
+    onScroll();
+    window.addEventListener('scroll', onScroll, { passive: true });
+    return () => window.removeEventListener('scroll', onScroll);
+  }, [blocks]);
+
   if (headings.length === 0) return null;
 
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      <details className="toc-disclosure" open={open} onToggle={(event) => setOpen(event.currentTarget.open)}>
+        <summary className="toc-summary">
+          <h2 id="toc-heading" className="toc-heading">
+            On this page
+          </h2>
+          <Marker dir={open ? 'd' : 'r'} className="toc-chevron" />
+        </summary>
+        <ol className="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a
+                href={`#${heading.id}`}
