+.tiles,.cards,.panels{display:grid;gap:var(--space-16)}
+.tiles{grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
+.cards{grid-template-columns:repeat(auto-fill,minmax(min(100%,max(320px,(100% - 2 * var(--space-16)) / 3)),1fr))}
+.panels{grid-template-columns:2fr 1fr;align-items:stretch}.panels>*{display:flex;flex-direction:column}
+@media (max-width:1023px){.panels{grid-template-columns:1fr}}
+@media (max-width:599px){.container{padding-inline:var(--space-16)}.section{margin-top:var(--space-40)}}
+ul.cards,ul.tag-list,ol.toc-list,ul.nav-list,ul.menu-list{list-style:none;padding:0;margin:0}
+
+/* ───────────── Header ───────────── */
+.site-header{position:sticky;top:0;z-index:20;background:var(--color-surface-default)}
+.site-header-inner{display:flex;align-items:center;gap:var(--space-24);height:var(--size-header)}
+.brand{display:inline-flex;align-items:center;gap:var(--space-8);flex:none;color:var(--color-text-strong);text-decoration:none}
+.brand:hover{color:var(--color-text-strong)}
+.brand-mark{color:var(--color-text-strong)}
+.site-nav .nav-list{display:flex;gap:var(--space-4)}
+.item{color:var(--color-text-secondary);text-decoration:none}
+.item:hover{color:var(--color-text-strong)}
+.site-nav .item[aria-current="page"]>.cur{animation:nc-swap var(--motion-duration-bob) var(--motion-easing-frame) infinite}
+.header-tools{display:flex;align-items:center;gap:var(--space-8);margin-left:auto}
+.header-switches{display:flex;align-items:center;gap:var(--space-4)}
+.tool{display:inline-flex;align-items:center;gap:var(--space-8);height:var(--size-control);padding-inline:var(--space-8);background:transparent;border:0;color:var(--color-text-secondary)}
+.tool:hover{background:var(--color-surface-hover);color:var(--color-text-primary)}
+.tool{cursor:pointer;white-space:nowrap}
+.menu{position:relative;display:none}
+.menu-window{position:absolute;right:0;top:calc(100% + var(--space-12));z-index:30;width:240px;padding:var(--space-8);background:var(--color-surface-raised);border:var(--border-width-control) solid var(--color-border-strong)}
+.menu-window .sep-dots{margin-block:var(--space-8)}
+.menu-tools{display:flex;flex-direction:column;align-items:stretch}
+.menu-tools .tool{justify-content:flex-start}
+.kbd{display:inline-flex;align-items:center;justify-content:center;min-width:20px;height:20px;padding-inline:var(--space-4);border:var(--border-width-control) solid var(--color-border-default);font-size:var(--font-size-caption);line-height:var(--font-line-height-caption);color:var(--color-text-secondary)}
+@media (max-width:1023px){
+  .site-nav,.header-switches{display:none}
+  .menu{display:block}
+  .header-search{width:var(--size-control);padding:0;justify-content:center}
+  .header-search .kbd{display:none}
+  .header-search__label{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
+  .site-header-inner{gap:var(--space-12)}
+}
+@media (pointer:coarse){.tool,.btn,.chip,.item{min-height:var(--size-touch)}.menu-button,.header-search{min-width:var(--size-touch)}}
+
+/* ───────────── Buttons and fields ────────────�� */
+.btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--space-8);height:var(--size-control);padding-inline:var(--space-12);background:transparent;border:var(--border-width-control) solid var(--color-border-control);color:var(--color-text-primary);text-decoration:none;cursor:pointer;white-space:nowrap}
+.btn:hover{background:var(--color-surface-hover);color:var(--color-text-strong)}
+.btn:disabled{background:var(--color-surface-hover);color:var(--color-text-disabled);border-color:var(--color-border-default);cursor:default}
+.btn .cur{background-image:none;color:currentColor}
+.btn--sm{height:var(--size-control-sm);padding-inline:var(--space-8)}
+.btn--forward{align-self:flex-start}
+
+.field{display:flex;flex-direction:column;gap:var(--space-8)}
+.field-label{color:var(--color-text-strong)}
+.input{width:100%;height:var(--size-control);padding:0 var(--space-12);background:var(--color-surface-raised);border:var(--border-width-control) solid var(--color-border-control);color:var(--color-text-primary);border-radius:0;-webkit-appearance:none;appearance:none}
+.input::placeholder{color:var(--color-text-secondary);opacity:1}
+.input:hover,.input:focus{border-color:var(--color-border-strong)}
+.input[aria-invalid="true"]{border-color:var(--color-status-danger)}
+.input::-webkit-search-cancel-button{-webkit-appearance:none;appearance:none}
+.search-control{position:relative}
+.search-control__icon{position:absolute;left:var(--space-8);top:50%;translate:0 -50%;color:var(--color-text-secondary);pointer-events:none}
+.search-control .input{padding-left:var(--space-40);padding-right:var(--space-40)}
+.search-control__kbd{position:absolute;right:var(--space-12);top:50%;translate:0 -50%}
+@media (max-width:599px){.search-control__kbd{display:none}.search-control .input{padding-right:var(--space-12)}}
+
+.form-error{display:flex;align-items:center;gap:var(--space-8);margin-top:var(--space-4);font-size:var(--font-size-caption);line-height:var(--font-line-height-caption);color:var(--color-status-danger)}
+.form-success{display:flex;align-items:center;gap:var(--space-8);padding:var(--space-12) var(--space-16);background:var(--color-surface-raised);border-left:var(--border-width-window) solid var(--color-status-success);color:var(--color-text-primary)}
+.form-success .bullet{--hue:var(--color-status-success)}
+
+/* ───────────── Chips, badges, meta ───────────── */
+.tag-list{display:flex;flex-wrap:wrap;gap:var(--space-4) var(--space-8)}
+.tag-chip{display:inline-flex;align-items:center;gap:var(--space-8);padding:0 var(--space-8) 0 0;font-size:var(--font-size-caption);line-height:var(--font-line-height-caption);color:var(--color-text-primary)}
+.tag-filter{display:flex;flex-wrap:wrap;gap:var(--space-8)}
+.chip{display:inline-flex;align-items:center;gap:var(--space-8);height:var(--size-control);padding-inline:var(--space-12);background:transparent;border:var(--border-width-control) solid var(--color-border-default);color:var(--color-text-primary);cursor:pointer}
+.chip:hover{background:var(--color-surface-hover);color:var(--color-text-strong)}
+.chip[aria-pressed="true"]{color:var(--color-text-strong);border-color:var(--color-border-strong)}
+.chip__slot{display:inline-flex;align-items:center;justify-content:center;width:var(--size-marker-w);height:var(--size-marker-h)}
+.chip__slot .cur{display:none}
+.chip[aria-pressed="true"] .chip__slot .bullet{display:none}
+.chip[aria-pressed="true"] .chip__slot .cur{display:inline-block}
+.chip:not([style]) .chip__slot .bullet{background:transparent;outline:var(--border-width-control) solid var(--color-border-control);outline-offset:-2px}
+.eyebrow{margin-bottom:var(--space-8)}
+.category{display:flex;align-items:center;gap:var(--space-8);margin-bottom:var(--space-8);color:var(--color-text-primary)}
+.lede{color:var(--color-text-primary);line-height:var(--font-line-height-prose)}
+
+/* ───────────── Cards ───────────── */
+.card{position:relative;display:flex;flex-direction:column;gap:var(--space-8);height:100%;padding:var(--space-16) var(--space-20);background:var(--color-surface-subtle);border-top:var(--border-width-window) solid var(--hue,var(--color-border-default))}
+.card-link:hover{background:var(--color-surface-hover)}
+.card-link:active{translate:2px 2px}
+.card-icon{color:var(--hue)}
+.card-title{color:var(--color-text-strong)}
+.card-title a{color:var(--color-text-strong);text-decoration:none}
+.stretched::after{content:"";position:absolute;inset:0}
+.stretched:focus-visible{outline:none}
+.card-link:has(.stretched:focus-visible){outline:var(--border-width-window) solid var(--color-focus-ring);outline-offset:3px}
+.card-desc{color:var(--color-text-secondary);display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;line-clamp:2;overflow:hidden}
+.card .tag-list{margin-top:auto;padding-top:var(--space-4);position:relative}
+.featured-post{max-width:none}
+.featured-title{font-size:var(--font-size-title);line-height:var(--font-line-height-title)}
+.featured-excerpt{color:var(--color-text-primary);line-height:var(--font-line-height-prose);max-width:var(--size-prose)}
+.author-card{border-top:var(--border-width-control) solid var(--color-border-default);flex-direction:row;gap:var(--space-16);align-items:flex-start}
+.author-card h3{margin-bottom:0}
+.author-card p+p{margin-top:var(--space-8)}
+.avatar{flex:none;display:inline-flex;align-items:center;justify-content:center;width:80px;height:80px;background:color-mix(in srgb,var(--hue) 55%,var(--color-art-sky1));color:var(--color-text-strong);font-size:var(--font-size-title);line-height:var(--font-line-height-title)}
+@media (max-width:599px){.author-card{flex-direction:column}}
+
+/* ───────────── Home ───────────── */
+.hero{position:relative;margin-top:calc(-1 * var(--space-40))}
+.hero__frame{position:absolute;inset:0;max-width:var(--size-container);margin-inline:auto;padding-inline:var(--space-24);pointer-events:none}
+.hero__window{position:absolute;top:var(--space-64);left:var(--space-24);width:464px;display:flex;flex-direction:column;gap:var(--space-16);padding:var(--space-20);pointer-events:auto}
+.hero__window h1{font-size:var(--font-size-display);line-height:var(--font-line-height-display);margin-top:calc(-1 * var(--space-8))}
+.hero__window .eyebrow{margin-bottom:0}
+@media (max-width:1023px){
+  .hero__frame{position:static;padding-inline:var(--space-24);margin-top:var(--space-16)}
+  .hero__window{position:static;width:auto}
+}
+@media (max-width:599px){.hero__frame{padding-inline:var(--space-16)}.hero__window h1{font-size:var(--font-size-title);line-height:var(--font-line-height-title)}}
+.page-sections>.section:first-child{margin-top:var(--space-64)}
+.filter-bar{display:flex;flex-wrap:wrap;align-items:flex-end;gap:var(--space-16) var(--space-24);margin-bottom:var(--space-16)}
+.search-field{flex:1 1 320px;max-width:var(--size-form)}
+.result-row{display:flex;flex-direction:column;gap:var(--space-4);margin-bottom:var(--space-16)}
+.empty-state{display:flex;flex-direction:column;align-items:center;gap:var(--space-16);max-width:400px;margin:var(--space-40) auto;text-align:center}
+.empty-state>p{line-height:var(--font-line-height-prose)}
+.message-window{max-width:560px;padding:var(--space-32) var(--space-20)}
+
+/* ───────────── Article ───────────── */
+.breadcrumb ol{display:flex;flex-wrap:wrap;list-style:none;padding:0;margin:0 0 var(--space-16);color:var(--color-text-secondary);font-size:var(--font-size-caption);line-height:var(--font-line-height-caption)}
+.breadcrumb li+li::before{content:" / ";white-space:pre}
+.breadcrumb a{color:var(--color-text-secondary);text-decoration:none}
+.breadcrumb a:hover{color:var(--color-text-strong);text-decoration:underline}
+.breadcrumb [aria-current]{color:var(--color-text-secondary)}
+.banner .title-block{display:flex;flex-direction:column;gap:var(--space-8);padding:var(--space-24);border-top:var(--border-width-control) solid var(--color-border-default)}
+.banner .title-block .lede{max-width:var(--size-prose)}
+.banner .title-block .tag-list{margin-top:var(--space-8)}
+.article-columns{display:grid;grid-template-columns:minmax(0,1fr) var(--size-toc);gap:var(--space-64);margin-top:var(--space-40)}
+.article-aside{position:relative}
+.toc{position:sticky;top:calc(var(--size-header) + var(--size-rule) + var(--space-40));border-left:var(--border-width-control) solid var(--color-border-default)}
+.toc-heading{font-size:var(--font-size-caption);line-height:var(--font-line-height-caption);color:var(--color-text-secondary);padding:0 0 var(--space-8) var(--space-12)}
+.toc-heading .disclosure{display:none}
+.toc-list .item{padding-inline:var(--space-8);align-items:flex-start;padding-block:var(--space-8);min-height:0}
+.toc-list .item>.cur{margin-top:5px}
+.toc-item-nested .item{padding-left:var(--space-24)}
+.disclosure{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:var(--size-control);padding:0 var(--space-12);background:var(--color-surface-subtle);border:0;border-left:var(--border-width-window) solid var(--color-border-control);color:var(--color-text-primary);font-size:var(--font-size-body);line-height:var(--font-line-height-ui);cursor:pointer;text-align:left}
+.disclosure:hover{background:var(--color-surface-hover);border-left-color:var(--color-hue-cyan);color:var(--color-text-strong)}
+.disclosure:focus-visible{outline-offset:-4px}
+@media (max-width:1023px){
+  .article-columns{grid-template-columns:minmax(0,1fr);gap:var(--space-24)}
+  .article-aside{order:-1}
+  .toc{position:static;border-left:0}
+  .toc-heading{padding:0}
+  .toc-heading .disclosure{display:flex}
+  .toc-heading__label{display:none}
+  .toc:not(.is-open) .toc-list{display:none}
+  .toc-list{padding:var(--space-8) 0 var(--space-8) var(--space-8);border-left:var(--border-width-control) solid var(--color-border-default);margin-left:var(--space-4)}
+}
+
+.article-body{display:flex;flex-direction:column;gap:var(--space-16);min-width:0}
+.article-body>p,.article-body>ul,.article-body>ol{line-height:var(--font-line-height-prose)}
+.article-body h2.ruled{margin-top:var(--space-40);margin-bottom:0}
+.article-body h3{margin-top:var(--space-16)}
+.body-list{padding-left:var(--space-24);list-style:square}
+ol.body-list{list-style:decimal}
+.body-list li+li{margin-top:var(--space-8)}
+.body-list li::marker{color:var(--color-text-secondary)}
+.body-quote blockquote{margin:0;color:var(--color-text-strong);line-height:var(--font-line-height-prose)}
+.body-quote figcaption{margin-top:var(--space-8)}
+.body-figure figcaption{margin-top:var(--space-8)}
+.code-window{min-width:0}
+.code-lang{flex:1;font-size:var(--font-size-caption);line-height:var(--font-line-height-caption);color:var(--color-text-secondary)}
+.code-block{margin:0;padding:var(--space-16) var(--space-20);overflow-x:auto;color:var(--color-text-primary);font-size:var(--font-size-body);line-height:var(--font-line-height-ui)}
+
+.prev-next{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-16);margin-top:var(--space-64);border-top:var(--border-width-control) solid var(--color-border-strong)}
+.prev-next__link{display:flex;flex-direction:column;gap:var(--space-4);padding:var(--space-16) var(--space-12);color:var(--color-text-strong);text-decoration:none}
+.prev-next__link:hover{background:var(--color-surface-hover);color:var(--color-text-strong)}
+.prev-next__link--next{text-align:right;align-items:flex-end}
+.prev-next__label{display:inline-flex;align-items:center;gap:var(--space-8);font-size:var(--font-size-caption);line-height:var(--font-line-height-caption);color:var(--color-text-secondary)}
+.prev-next__label .cur{color:var(--color-text-accent)}
+@media (max-width:599px){.prev-next{grid-template-columns:1fr}.prev-next__link--next{grid-column:1}}
+
+/* ───────────── About ───────────── */
+.prose>p+p{margin-top:var(--space-16)}
+
+/* ───────────── Footer ───────────── */
+.footer-body{padding-block:var(--space-40) var(--space-64);background:var(--color-surface-default)}
+.site-footer-inner{display:flex;flex-direction:column;gap:var(--space-24)}
+.newsletter{max-width:var(--size-form);padding:var(--space-20);background:var(--color-surface-subtle);border:var(--border-width-control) solid var(--color-border-control)}
+.newsletter h2{margin-bottom:var(--space-8)}
+.newsletter>p{margin-bottom:var(--space-20)}
+.newsletter-form{display:flex;flex-direction:column}
+.newsletter-form .field-label{margin-bottom:var(--space-8)}
+.field-row{display:flex;gap:var(--space-12);align-items:center}
+.field-row .input{flex:1;min-width:0}
+@media (max-width:599px){.field-row{flex-direction:column;align-items:stretch}.field-row .btn-gold{width:100%}}
