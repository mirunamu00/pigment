+function useRootSwitch(attr: string, key: string, offValue: string) {
+  const [on, setOn] = useState(() => document.documentElement.getAttribute(attr) !== offValue);
+  function toggle() {
+    const next = !on;
+    setOn(next);
+    if (next) document.documentElement.removeAttribute(attr);
+    else document.documentElement.setAttribute(attr, offValue);
+    try {
+      localStorage.setItem(key, next ? 'on' : 'off');
+    } catch {
+      /* storage unavailable: the switch still works for this visit */
+    }
+  }
+  return [on, toggle] as const;
