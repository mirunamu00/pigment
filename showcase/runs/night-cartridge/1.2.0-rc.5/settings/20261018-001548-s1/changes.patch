+    <button type="button" className="tool press" aria-pressed={on} onClick={toggle}>
+      <Icon name={on ? icons[0] : icons[1]} />
+      <span className="tool__label">
+        {name} {on ? 'on' : 'off'}
+      </span>
+    </button>
+  );
+}
