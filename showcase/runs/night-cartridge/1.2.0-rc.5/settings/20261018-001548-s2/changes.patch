+.frame-b{animation:nc-swap var(--motion-duration-fan) var(--motion-easing-frame) infinite}
+.frame-a{animation:nc-swap var(--motion-duration-fan) var(--motion-easing-frame) calc(var(--motion-duration-fan) / -2) infinite}
+.beacon{animation:nc-beacon var(--motion-duration-beacon) var(--motion-easing-frame) infinite}
+.drift{animation:nc-drift var(--motion-duration-drift) steps(var(--n)) var(--o,0ms) infinite}
+.rare{opacity:0;animation:nc-rare var(--motion-duration-rare) var(--motion-easing-frame) infinite}
+.nudge{animation:nc-nudge calc(var(--motion-duration-nudge) * 2) var(--motion-easing-frame) 1}
+.sparkle{transform-box:fill-box;transform-origin:center;animation:nc-sparkle var(--motion-duration-sparkle) var(--motion-easing-frame) -600ms infinite}
+/* Frozen scenes show frame 1 only. */
+@media (prefers-reduced-motion:reduce){.frame-b{opacity:0}}
+:root[data-motion="off"] .frame-b{opacity:0}
+
+.ellipsis{display:inline-block;width:3ch;overflow:hidden;vertical-align:bottom;white-space:nowrap}
+.ellipsis::before{content:"..."}
+.is-loading .ellipsis{animation:nc-dots var(--motion-duration-dots) var(--motion-easing-dots) infinite}
+@keyframes nc-dots{from{width:1ch}to{width:3ch}}
+
+/* ---------------------------------------------- marker and response */
+.cur{flex:none;display:inline-block;width:var(--size-marker-w);height:var(--size-marker-h);color:var(--color-text-accent);
+  background:var(--cur-bevel) 0 0/100% 100% no-repeat currentColor;-webkit-mask:var(--cur-r) 0 0/100% 100% no-repeat;mask:var(--cur-r) 0 0/100% 100% no-repeat}
+.cur--l{-webkit-mask-image:var(--cur-l);mask-image:var(--cur-l);background-image:none}
+.cur--d,.cur--u{width:var(--size-marker-h);height:var(--size-marker-w);background-image:none;-webkit-mask-image:var(--cur-d);mask-image:var(--cur-d)}.cur--u{-webkit-mask-image:var(--cur-u);mask-image:var(--cur-u)}
+.cur--sm{width:6px;height:10px}
+.item{display:flex;align-items:center;gap:var(--space-8);min-height:var(--size-row);padding-inline:var(--space-8) var(--space-12)}
+.item>.cur{visibility:hidden}
+.item:is([aria-current],[aria-selected="true"],.is-current)>.cur{visibility:visible}
+.item:hover{background:var(--color-surface-hover)}
+.item:is([aria-current],[aria-selected="true"]){color:var(--color-text-strong)}
+.card-title{position:relative}
+.card-title>.cur{position:absolute;right:calc(100% + var(--space-4));top:50%;translate:0 -50%;visibility:hidden}
+.card-link:is(:hover,:focus-visible) .card-title>.cur{visibility:visible;color:var(--color-text-strong)}
+.press:active:not(:disabled){translate:2px 2px}
+.btn-gold{height:var(--size-control-lg);padding-inline:var(--space-20);background:var(--color-action-primary);color:var(--color-text-on-action);border:var(--border-width-control) solid var(--color-action-primary);box-shadow:var(--shadow-hard)}
+.btn-gold:active:not(:disabled){translate:4px 4px;box-shadow:var(--shadow-none)}
+
+/* ------------------------------------------------------- window chrome */
+.window{min-width:0;border:var(--border-width-window) solid var(--color-border-strong);background:var(--color-surface-raised)}
+.window__bar{display:flex;align-items:center;gap:var(--space-8);height:var(--size-title-bar);padding-inline:var(--space-12);background:var(--color-surface-subtle);border-bottom:var(--border-width-control) solid var(--color-border-default)}
+.window__title{margin:0;font-size:var(--font-size-body);line-height:var(--font-line-height-ui);color:var(--color-text-strong);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.window__body{padding:var(--space-20)}
+.dither{height:var(--size-rule);background:repeating-conic-gradient(var(--dc,var(--color-border-default)) 0 25%,transparent 0 50%) 0 0/4px 4px}
+h2.ruled{padding-bottom:var(--space-12);margin-bottom:var(--space-16);background:repeating-conic-gradient(var(--color-border-control) 0 25%,transparent 0 50%) bottom left/4px 4px repeat-x}
+.sep-dots{height:2px;background:linear-gradient(90deg,var(--color-border-control) 2px,transparent 0) 0 0/6px 2px repeat-x}
+.hue-bar{border-top:var(--border-width-window) solid var(--hue)}
+.bullet{flex:none;width:var(--size-bullet);height:var(--size-bullet);background:var(--hue)}
+.meter{display:flex;gap:var(--space-4)}
+.meter>i{width:var(--size-meter-w);height:var(--size-meter-h);background:var(--color-surface-hover)}
+.meter>i.on{background:var(--tone,var(--color-status-success));animation:nc-on var(--motion-duration-meter-step) var(--motion-easing-frame) calc(var(--i) * var(--motion-duration-meter-step)) backwards}
+@keyframes nc-on{from{background:var(--color-surface-hover)}}
+.callout{display:grid;grid-template-columns:var(--size-icon) 1fr;gap:var(--space-4) var(--space-12);padding:var(--space-16) var(--space-20);background:var(--color-surface-subtle);border-left:var(--border-width-window) solid var(--tone)}
+.callout__bullet{align-self:center;justify-self:start;background:var(--tone)}
+.callout__title{color:var(--color-text-strong)}
+.callout__body{grid-column:2}
+.panel{background:var(--color-surface-subtle);border:var(--border-width-control) solid var(--color-border-default);padding:var(--space-16) var(--space-20)}
+.panel--flush{padding:0}
+
+/* -------------------------------------------------------------- shell */
+.app-shell{min-height:100vh;display:flex;flex-direction:column}
+.topbar{position:sticky;top:0;z-index:30;background:var(--color-surface-default)}
+.topbar__row{height:var(--size-header);display:flex;align-items:center;justify-content:space-between;gap:var(--space-16);padding-inline:var(--space-24)}
+.brand{display:flex;align-items:center;gap:var(--space-8);color:var(--color-text-strong);white-space:nowrap}
+.brand__mark{color:var(--color-text-strong)}
+.topbar__end{display:flex;align-items:center;gap:var(--space-8);min-width:0}
+.topbar__tools{display:flex;align-items:center;gap:var(--space-4)}
+.person{display:flex;align-items:center;gap:var(--space-8);padding-left:var(--space-8);color:var(--color-text-primary);white-space:nowrap}
+.tool{display:inline-flex;align-items:center;gap:var(--space-8);height:var(--size-control);padding-inline:var(--space-8);background:transparent;border:0;color:var(--color-text-secondary);cursor:pointer;white-space:nowrap}
+.tool:hover{background:var(--color-surface-hover);color:var(--color-text-primary)}
+.header-menu{display:none;position:relative}
+.menu-window{position:absolute;right:0;top:calc(100% + var(--space-12));z-index:40;display:flex;flex-direction:column;min-width:240px;padding-block:var(--space-4);border:var(--border-width-control) solid var(--color-border-strong);background:var(--color-surface-raised)}
+.menu-item{width:100%;border:0;background:transparent;color:var(--color-text-primary);cursor:pointer;text-align:left;white-space:nowrap}
+.menu-item::before{content:"";flex:none;width:var(--size-marker-w);height:var(--size-marker-h);background:var(--color-text-accent);-webkit-mask:var(--cur-r) 0 0/100% 100% no-repeat;mask:var(--cur-r) 0 0/100% 100% no-repeat;visibility:hidden}
+.menu-item:is(:hover,:focus-visible)::before{visibility:visible}
+.menu-item:is(:hover,:focus-visible){background:var(--color-surface-hover);color:var(--color-text-strong)}
+
+.settings-layout{flex:1;display:flex}
+.sidebar{flex:none;width:var(--size-sidebar);min-height:100%;padding:var(--space-40) var(--space-16) var(--space-24);background:var(--color-surface-subtle);border-right:var(--border-width-control) solid var(--color-border-default)}
+.sidebar__group{margin:0 0 var(--space-8);padding-inline:var(--space-8);font-size:var(--font-size-caption);line-height:var(--font-line-height-caption);color:var(--color-text-secondary)}
+.nav-list{list-style:none;margin:0;padding:0}
+.nav-list>li+li::before{content:"";display:block;height:2px;margin:var(--space-4) var(--space-8);background:linear-gradient(90deg,var(--color-border-control) 2px,transparent 0) 0 0/6px 2px repeat-x}
+.nav-link{color:var(--color-text-secondary);text-decoration:none}
+.nav-link:hover{color:var(--color-text-strong)}
+.nav-link[aria-current="page"]{background:var(--color-surface-hover)}
+.nav-link[aria-current="page"]>.cur{animation:nc-swap var(--motion-duration-bob) var(--motion-easing-frame) infinite}
+
+.content{flex:1;min-width:0;max-width:calc(var(--size-container) - var(--size-sidebar));padding:var(--space-40) var(--space-24) calc(var(--space-64) + var(--size-ground-sprite));display:flex;flex-direction:column;gap:var(--space-40)}
+.section{margin-top:var(--space-24)}
+
+/* ------------------------------------------------------- title block */
+.scene-window{display:block}
+.title-block{padding:var(--space-24);border-top:var(--border-width-control) solid var(--color-border-default)}
+.eyebrow{display:flex;align-items:center;gap:var(--space-8);margin-bottom:var(--space-8);font-size:var(--font-size-caption);line-height:var(--font-line-height-caption);color:var(--color-text-secondary)}
+.title-block h1{margin-bottom:var(--space-8)}
+.lede{max-width:var(--size-prose);color:var(--color-text-primary)}
+.count-meter{display:flex;flex-direction:column;gap:var(--space-4);margin-top:var(--space-16)}
+
+/* ------------------------------------------------------------ avatar */
+.avatar{display:inline-flex;flex:none;align-items:center;justify-content:center;background:color-mix(in srgb,var(--hue) 55%,var(--color-art-sky1));color:var(--color-text-strong)}
+.avatar--sm{width:var(--size-control);height:var(--size-control);font-size:var(--font-size-body);line-height:var(--font-line-height-ui)}
+.avatar--lg{width:80px;height:80px;font-size:var(--font-size-title);line-height:var(--font-line-height-title)}
+
+/* ----------------------------------------------------------- buttons */
+.btn,.btn-gold{display:inline-flex;align-items:center;justify-content:center;gap:var(--space-8);font:inherit;line-height:var(--font-line-height-ui);white-space:nowrap;text-decoration:none;cursor:pointer}
+.btn{height:var(--size-control);padding-inline:var(--space-12);background:transparent;border:var(--border-width-control) solid var(--color-border-control);color:var(--color-text-primary)}
+.btn:hover{background:var(--color-surface-hover);color:var(--color-text-strong)}
+.btn .cur{color:currentColor;background-image:none}
+.btn--sm{height:var(--size-control-sm);padding-inline:var(--space-8)}
+.btn--icon{width:var(--size-control);padding:0}
+.btn--sm.btn--icon{width:var(--size-control-sm)}
+.btn--danger{border-color:var(--color-status-danger);color:var(--color-status-danger)}
+.btn--danger:hover{color:var(--color-status-danger)}
+.btn:disabled,.btn-gold:disabled{background:var(--color-surface-hover);color:var(--color-text-disabled);border-color:var(--color-border-default);box-shadow:none;cursor:default}
+
+/* ------------------------------------------------------------- forms */
+.form-layout{display:grid;grid-template-columns:minmax(0,var(--size-form)) minmax(0,1fr);gap:var(--space-20) var(--space-40);align-items:start}
+.form-window .avatar-row{grid-column:2;grid-row:1}
+.form-window .form-stack{grid-column:1;grid-row:1}
+.form-window .form-actions{grid-column:1;grid-row:2;margin-top:var(--space-12)}
+.form{min-width:0}
+.form-stack{display:flex;flex-direction:column;gap:var(--space-20)}
+.field{display:flex;flex-direction:column;gap:var(--space-8);min-width:0}
+.field>:is(.helper,.field-meta,.field-error){margin-top:calc(var(--space-4) - var(--space-8))}
+.field-label{color:var(--color-text-strong)}
+.label-note{font-size:var(--font-size-caption);line-height:var(--font-line-height-caption);color:var(--color-text-secondary)}
+.field-meta{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--space-4) var(--space-12)}
+.field-error{display:flex;align-items:center;gap:var(--space-4);font-size:var(--font-size-caption);line-height:var(--font-line-height-caption);color:var(--color-status-danger)}
+.input{display:block;width:100%;min-width:0;height:var(--size-control);padding:0 var(--space-12);background:var(--color-surface-raised);border:var(--border-width-control) solid var(--color-border-control);color:var(--color-text-primary);outline-offset:3px}
+.input:hover{border-color:var(--color-border-strong)}
+.input::placeholder{color:var(--color-text-secondary)}
+.input[aria-invalid="true"]{border-color:var(--color-status-danger)}
+.input:disabled{background:var(--color-surface-subtle);border-color:var(--color-border-default);color:var(--color-text-disabled)}
+.input:read-only:not(select){background:var(--color-surface-subtle)}
+.textarea{height:auto;min-height:calc(4 * var(--font-line-height-ui) + 2 * var(--space-12) + 2 * var(--border-width-control));padding:var(--space-12);resize:vertical}
+.select-wrap{position:relative;display:block}
+.select{appearance:none;padding-right:var(--space-40);cursor:pointer}
+.select option{background:var(--color-surface-raised);color:var(--color-text-primary)}
+.select-wrap>.cur{position:absolute;right:var(--space-12);top:50%;translate:0 -50%;color:var(--color-text-secondary);pointer-events:none}
+.form-actions{display:flex;align-items:center;flex-wrap:wrap;gap:var(--space-12);margin-top:var(--space-32)}
+.status-message{display:flex;align-items:center;gap:var(--space-8);min-height:var(--font-line-height-ui);color:var(--color-text-strong)}
+.status-message:not(:empty)::before{content:"";flex:none;width:var(--size-bullet);height:var(--size-bullet);background:var(--color-status-success)}
+.avatar-row{display:flex;align-items:flex-start;gap:var(--space-16);padding:var(--space-16) var(--space-20);background:var(--color-surface-subtle)}
+.avatar-row__text{display:flex;flex-direction:column;align-items:flex-start;gap:var(--space-4)}
+.avatar-row__text .btn{margin-top:var(--space-8)}
+.group-note{margin-bottom:var(--space-12)}
+
+/* ------------------------------------------------- fieldsets, switches */
+.fieldset{margin:0;padding:0;min-width:0}
+.fieldset>.legend{float:left;width:100%;padding-inline:var(--space-12)}
+.fieldset>.window__body{clear:both}
+.switch-list{list-style:none;margin:0;padding:0}
+.switch-list>li+li::before{content:"";position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--color-border-control) 2px,transparent 0) 0 0/6px 2px repeat-x}
+.switch-row{position:relative;display:flex;align-items:center;justify-content:space-between;gap:var(--space-16);min-height:var(--size-touch);padding:var(--space-12) var(--space-12) var(--space-12) var(--space-8)}
+.switch-row:hover{background:var(--color-surface-hover)}
+.switch-row:hover .switch{border-color:var(--color-border-strong)}
+.switch-text{display:flex;flex-direction:column;gap:var(--space-4);min-width:0}
+.switch-label{cursor:pointer}
+.switch-label::after{content:"";position:absolute;inset:0}
+.switch-control{display:inline-flex;align-items:center;gap:var(--space-8);flex:none}
+.switch{appearance:none;position:relative;z-index:1;flex:none;width:32px;height:16px;margin:0;background:var(--color-surface-raised);border:var(--border-width-control) solid var(--color-border-control);cursor:pointer}
+.switch::after{content:"";position:absolute;top:2px;left:2px;width:8px;height:8px;background:var(--color-text-secondary)}
+.switch:checked{background:var(--color-surface-hover)}
+.switch:checked::after{left:18px;background:var(--color-text-accent)}
+.switch:disabled{border-color:var(--color-border-default)}
+.switch:disabled::after{background:var(--color-text-disabled)}
+.switch-state{width:3ch;font-size:var(--font-size-caption);line-height:var(--font-line-height-caption);color:var(--color-text-secondary)}
+
+/* ------------------------------------------------------------ tables */
+.table-wrap{overflow-x:auto}
+.table{width:100%;border-collapse:collapse}
+.table th,.table td{height:var(--size-row);padding:0 var(--space-12);text-align:left;vertical-align:middle;white-space:nowrap}
+.table th{background:var(--color-surface-subtle);color:var(--color-text-strong);border-bottom:var(--border-width-control) solid var(--color-border-strong)}
+.table td{color:var(--color-text-primary);border-bottom:var(--border-width-control) solid var(--color-border-default)}
+.table :is(th,td)[data-pin="first"]{padding-left:0}
+.table .cur,.table .cur-slot{display:inline-block;vertical-align:middle;margin-inline:var(--space-4)}
+.table .cur-slot{width:var(--size-marker-w)}
+.table td>.cur{visibility:hidden}
+.table tr.is-current td{color:var(--color-text-strong)}
+.table tr.is-current td>.cur{visibility:visible}
+.table .numeric{text-align:right}
+.cell-actions{text-align:right}
+.badge{display:inline-flex;align-items:center;gap:var(--space-8);padding:0 var(--space-8);color:var(--color-text-primary)}
+.badge--dense{font-size:var(--font-size-caption);line-height:var(--font-line-height-caption)}
+.table td .badge{vertical-align:middle}
+.table td[data-pin="first"] .badge{margin-left:var(--space-8)}
+.empty-note{margin-top:var(--space-12)}
+.table-wrap+.status-message,.empty-note+.status-message{margin-top:var(--space-12)}
+
+/* ------------------------------------------------------ cards, plans */
+.plan-grid{list-style:none;margin:0 0 var(--space-16);padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-16)}
+.card{background:var(--color-surface-subtle);padding:var(--space-16) var(--space-20)}
+.plan-card{display:flex;flex-direction:column;align-items:flex-start;gap:var(--space-8);border:var(--border-width-control) solid transparent;border-top:var(--border-width-window) solid var(--hue)}
+.plan-card-current{border-color:var(--color-text-accent);border-top-color:var(--hue)}
+.plan-card-current .card-title>.cur{visibility:visible}
+.card-title{margin:0}
+.plan-price{display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--space-8)}
+.plan-amount{font-size:var(--font-size-display);line-height:var(--font-line-height-display);color:var(--color-text-strong)}
+.feature-list{list-style:none;margin:0 0 var(--space-8);padding:0;flex:1;display:flex;flex-direction:column;gap:var(--space-4)}
+.feature-list li{display:flex;align-items:center;gap:var(--space-8)}
+.icon--check{color:var(--hue)}
+.plan-card .badge{min-height:var(--size-control);padding-left:0}
+.payment-method{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-12)}
+.payment-method>.icon{color:var(--color-text-secondary)}
+.payment-method__name{color:var(--color-text-strong)}
+
+/* ------------------------------------------------------------ dialog */
+.dialog{padding:0;width:min(var(--size-dialog),calc(100% - var(--space-32)));max-width:none;color:var(--color-text-primary);box-shadow:var(--shadow-hard)}
+.dialog::backdrop{background:var(--color-surface-overlay)}
+.dialog-bar{justify-content:space-between;padding-right:var(--space-8)}
+.dialog-body{padding:var(--space-20);line-height:var(--font-line-height-prose)}
+.dialog-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:var(--space-12);padding:0 var(--space-20) var(--space-20)}
+
+/* --------------------------------------------------------- not found */
+.not-found__body{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-24)}
+.not-found__text{display:flex;flex-direction:column;align-items:flex-start;gap:var(--space-16);flex:1 1 280px;min-width:0}
+
+/* ------------------------------------------------------------ adapt */
+@media (pointer:coarse){.btn,.btn--sm,.tool,.item,.btn-gold{min-height:var(--size-touch)}.btn--sm.btn--icon{min-width:var(--size-touch)}}
+
+@media (max-width:1023px){
+  .topbar__tools{display:none}
+  .header-menu{display:block}
+  .settings-layout{flex-direction:column}
+  .sidebar{width:auto;min-height:0;padding:var(--space-12) var(--space-24);border-right:0;border-bottom:var(--border-width-control) solid var(--color-border-default)}
+  .sidebar__group{display:none}
+  .nav-list{display:flex;flex-wrap:wrap;gap:var(--space-4) var(--space-8)}
+  .nav-list>li+li::before{display:none}
+  .content{max-width:none}
+  .form-layout{grid-template-columns:minmax(0,1fr)}
+  .form-window :is(.avatar-row,.form-stack,.form-actions){grid-column:auto;grid-row:auto}
+  .plan-grid{grid-template-columns:minmax(0,1fr)}
+}
+
+@media (max-width:599px){
+  .topbar__row{padding-inline:var(--space-16)}
+  .person{padding-left:0}
+  .person__name{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
+  .sidebar{padding:var(--space-8) var(--space-16)}
+  .nav-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}
+  .nav-link .hue-icon{display:none}
+  .content{padding:var(--space-40) var(--space-16) calc(var(--space-40) + var(--size-ground-sprite))}
+  .title-block{padding:var(--space-20)}
+  .window__body{padding:var(--space-16)}
+  .form-actions>:is(.btn,.btn-gold){width:100%}
+  .avatar-row{padding:var(--space-16)}
+  .table{width:100%}
+  .table :is(th,td):not([data-pin]){display:none}
+  .table :is(th,td){height:var(--size-row);white-space:nowrap}.table .sub{display:none}
+  .table [data-pin="first"]{width:100%;max-width:0;overflow:hidden;text-overflow:ellipsis}
+  .table [data-pin]:not([data-pin="first"]){width:1%}
 }
