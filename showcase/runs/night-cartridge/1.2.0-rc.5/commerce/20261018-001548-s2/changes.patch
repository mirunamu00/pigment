+@media (min-width: 1024px) {
+  .menu-window { display: contents; }
+}
+@media (max-width: 599px) {
+  .header-bar { padding-inline: var(--space-16); }
+  .content { padding-inline: var(--space-16); }
+  .page { gap: var(--space-40); }
+  .page > .breadcrumb + * { margin-top: calc(var(--space-16) - var(--space-40)); }
+  .cart-main { gap: var(--space-40); }
+  .site-footer p { padding-inline: var(--space-16); }
+  .cart-button-label { display: none; }
+  .ground { margin-top: calc(var(--space-40) + var(--size-ground-sprite)); }
+  .title-block { padding: var(--space-20); }
+  .toolbar, .toolbar-controls { align-items: flex-start; }
+  .toolbar-controls { flex-direction: column; gap: var(--space-8); }
+  .button-primary, .checkout-form .button-primary { width: 100%; align-self: stretch; }
+  .purchase-form { align-items: stretch; }
+  .cart-line { grid-template-columns: var(--size-marker-w) minmax(0, 1fr) auto; row-gap: var(--space-12); }
+  .cart-line .stepper { grid-column: 2; }
+  .cart-line-total { grid-column: 3; grid-row: 1; }
+  .cart-line .line-remove { grid-column: 3; grid-row: 2; justify-self: end; }
+  .error-window .window__body { flex-direction: column; align-items: center; text-align: center; }
+  .error-window .error-text { align-items: center; }
+  .pager { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
+}
+@media (pointer: coarse) {
+  .button, .chip, .tool, .item, .variant-option, .input, .select { min-height: var(--size-touch); }
+  .stepper-button { width: var(--size-touch); }
 }
