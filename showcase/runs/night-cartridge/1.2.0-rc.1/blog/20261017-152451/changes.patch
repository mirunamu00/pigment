@@ -1,25 +1,72 @@
+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
+import { Marker } from './pixel';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const WIDE = '(min-width: 1024px)';
+const isWide = () => typeof window !== 'undefined' && window.matchMedia(WIDE).matches;
+
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
+  const [current, setCurrent] = useState(headings[0]?.id);
+  // A sidebar from breakpoint.lg, a disclosure below it.
+  const [open, setOpen] = useState(isWide);
+
+  useEffect(() => {
+    const media = window.matchMedia(WIDE);
+    const sync = () => setOpen(media.matches);
+    media.addEventListener('change', sync);
+    return () => media.removeEventListener('change', sync);
+  }, []);
+
+  // One item is always current: the first heading on load, then the heading under the header.
+  useEffect(() => {
+    setCurrent(headings[0]?.id);
+    const line = () => (document.querySelector('.site-header')?.getBoundingClientRect().bottom ?? 0) + 24;
+    function update() {
+      let id = headings[0]?.id;
+      for (const heading of headings) {
+        const el = document.getElementById(heading.id);
+        if (el && el.getBoundingClientRect().top <= line()) id = heading.id;
+      }
+      setCurrent(id);
+    }
+    window.addEventListener('scroll', update, { passive: true });
+    window.addEventListener('hashchange', update);
+    return () => {
+      window.removeEventListener('scroll', update);
+      window.removeEventListener('hashchange', update);
+    };
+  }, [blocks]);
+
   if (headings.length === 0) return null;
 
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      <details open={open} onToggle={(event) => setOpen(event.currentTarget.open)}>
+        <summary className="toc-summary">
+          <Marker dir={open ? 'd' : 'r'} />
+          <h2 id="toc-heading" className="toc-heading">
+            On this page
+          </h2>
+        </summary>
+        <ol className="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a
+                href={`#${heading.id}`}
+                className="item toc-link"
+                aria-current={current === heading.id ? 'location' : undefined}
+                data-testid="toc-link"
+              >
+                <Marker />
+                {heading.text}
+              </a>
+            </li>
+          ))}
+        </ol>
+      </details>
     </nav>
   );
 }
