+// Keeps the chip strip's scroll state in data attributes so CSS can fade the edge
+// while chips are off-screen, and scrolls the pressed chip into view on load.
+function useChipStrip() {
+  const ref = useRef<HTMLDivElement>(null);
+  useEffect(() => {
+    const strip = ref.current;
+    if (!strip) return;
+    const pressed = strip.querySelector<HTMLElement>('[aria-pressed="true"]');
+    if (pressed && pressed.offsetLeft + pressed.offsetWidth > strip.clientWidth) {
+      strip.scrollLeft = pressed.offsetLeft + pressed.offsetWidth - strip.clientWidth;
+    }
+    const update = () => {
+      strip.toggleAttribute('data-overflow', strip.scrollWidth > strip.clientWidth + 1);
+      strip.toggleAttribute('data-at-end', strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 1);
+    };
+    update();
+    strip.addEventListener('scroll', update, { passive: true });
+    window.addEventListener('resize', update);
+    return () => {
+      strip.removeEventListener('scroll', update);
+      window.removeEventListener('resize', update);
+    };
+  }, []);
+  return ref;
+}
