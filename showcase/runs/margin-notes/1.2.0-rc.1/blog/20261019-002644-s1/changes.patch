+.newsletter-title {
+  font-size: var(--font-size-panel-title);
+  line-height: var(--font-line-height-card);
+  letter-spacing: var(--font-tracking-title);
+}
+
+.newsletter > .muted {
+  margin-top: var(--space-6);
+}
+
+.newsletter-form {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-6);
+  margin-top: var(--space-20);
+}
+
+.form-success {
+  margin-top: var(--space-20);
+}
+
+.form-success.badge {
+  white-space: normal;
+}
+
+.footer-note {
+  color: var(--color-text-tertiary);
+}
+
+@media (max-width: 859px) {
+  .site-footer-inner {
+    padding-top: var(--space-40);
+    padding-bottom: var(--space-32);
+  }
+
+  .form-success.badge {
+    align-items: flex-start;
+    padding: var(--space-4) var(--space-10);
+    border-radius: var(--radius-callout);
+  }
+
+  .form-success .icon {
+    margin-top: 4px;
+  }
+}
+
+/* ---------- Reduced motion ---------- */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition-duration: var(--motion-duration-instant) !important;
+    animation-duration: var(--motion-duration-instant) !important;
+    animation-iteration-count: 1 !important;
+    scroll-behavior: auto !important;
   }
 }
