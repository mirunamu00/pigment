+import { useEffect, useState, type MouseEvent } from 'react';
 import type { Block } from '../data/posts';
+import { ChevronIcon } from './icons';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const RAIL_QUERY = '(min-width: 1200px)';
+
+/** True from breakpoint.lg, where the table of contents is an always-open right rail. */
+function useIsRail() {
+  const [isRail, setIsRail] = useState(() => window.matchMedia(RAIL_QUERY).matches);
+  useEffect(() => {
+    const media = window.matchMedia(RAIL_QUERY);
+    const update = () => setIsRail(media.matches);
+    media.addEventListener('change', update);
+    return () => media.removeEventListener('change', update);
+  }, []);
+  return isRail;
+}
+
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
+  const isRail = useIsRail();
+  const [open, setOpen] = useState(false);
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
   if (headings.length === 0) return null;
 
+  function onSummaryClick(event: MouseEvent) {
+    event.preventDefault();
+    if (!isRail) setOpen((value) => !value);
+  }
+
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      <details className="toc-details" open={isRail || open}>
+        <summary className="toc-summary" onClick={onSummaryClick} tabIndex={isRail ? -1 : undefined}>
+          <h2 id="toc-heading" className="toc-heading">
+            On this page
+          </h2>
+          <ChevronIcon className="toc-chevron" />
+        </summary>
+        <ol className="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
+                {heading.text}
+              </a>
+            </li>
+          ))}
+        </ol>
+      </details>
     </nav>
   );
 }
