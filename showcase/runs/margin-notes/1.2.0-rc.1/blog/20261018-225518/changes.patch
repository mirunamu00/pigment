@@ -1,25 +1,59 @@
+import { useEffect, useState } from 'react';
 import type { Block } from '../data/posts';
 
 type Heading = Extract<Block, { type: 'heading' }>;
 
+const RAIL_QUERY = '(min-width: 1200px)';
+
+function useIsRail() {
+  const [isRail, setIsRail] = useState(() => window.matchMedia(RAIL_QUERY).matches);
+  useEffect(() => {
+    const query = window.matchMedia(RAIL_QUERY);
+    const update = () => setIsRail(query.matches);
+    query.addEventListener('change', update);
+    return () => query.removeEventListener('change', update);
+  }, []);
+  return isRail;
+}
+
+/**
+ * From 1200px the contents is an always-open right rail; below it is a closed
+ * "On this page" disclosure placed after the article's meta line.
+ */
 export default function TableOfContents({ blocks }: { blocks: Block[] }) {
+  const isRail = useIsRail();
+  const [open, setOpen] = useState(false);
   const headings = blocks.filter((block): block is Heading => block.type === 'heading');
   if (headings.length === 0) return null;
 
   return (
     <nav className="toc" aria-labelledby="toc-heading" data-testid="toc">
-      <h2 id="toc-heading" className="toc-heading">
-        On this page
-      </h2>
-      <ol className="toc-list">
-        {headings.map((heading) => (
-          <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
-            <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
-              {heading.text}
-            </a>
-          </li>
-        ))}
-      </ol>
+      <details
+        className="toc-details"
+        open={isRail || open}
+        onToggle={(event) => {
+          if (!isRail) setOpen(event.currentTarget.open);
+        }}
+      >
+        <summary className="toc-summary" aria-hidden={isRail || undefined} tabIndex={isRail ? -1 : undefined}>
+          <span>On this page</span>
+          <svg className="toc-chevron" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
+            <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" />
+          </svg>
+        </summary>
+        <h2 id="toc-heading" className="toc-heading">
+          On this page
+        </h2>
+        <ol className="toc-list">
+          {headings.map((heading) => (
+            <li key={heading.id} className={heading.level === 3 ? 'toc-item toc-item-nested' : 'toc-item'}>
+              <a href={`#${heading.id}`} className="toc-link" data-testid="toc-link">
+                {heading.text}
+              </a>
+            </li>
+          ))}
+        </ol>
+      </details>
     </nav>
   );
 }
