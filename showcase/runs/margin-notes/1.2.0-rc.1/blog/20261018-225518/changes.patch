+.article-header .post-meta {
+  margin-top: var(--space-4);
+}
+
+/* Article prose: 60-75 characters */
+.article-body {
+  max-width: 64ch;
+  color: var(--color-text-body);
+  font-size: var(--font-size-body);
+  line-height: var(--font-line-height-article);
+}
+
+.article-body > * + * {
+  margin-top: var(--space-16);
+}
+
+.article-body h2 {
+  margin-top: var(--space-48);
+  margin-bottom: var(--space-12);
+  font-size: var(--font-size-h2);
+  line-height: var(--font-line-height-title);
+  letter-spacing: var(--font-tracking-h2);
+}
+
+.article-body h3 {
+  margin-top: var(--space-32);
+  margin-bottom: var(--space-12);
+  font-size: var(--font-size-h3);
+  line-height: var(--font-line-height-title);
+  letter-spacing: var(--font-tracking-title);
+}
+
+.article-body > :is(h2, h3) + * {
+  margin-top: 0;
+}
+
+.article-body > :is(.body-quote, .code-block, .body-figure) {
+  margin-top: var(--space-24);
+  margin-bottom: var(--space-24);
+}
+
+.article-body > :is(.body-quote, .code-block, .body-figure) + :not(h2, h3) {
+  margin-top: 0;
+}
+
+/* The one serif pull-quote of the article */
+.body-quote {
+  margin-inline: 0;
+}
+
+.body-quote blockquote {
+  margin: 0;
+  padding-left: var(--space-24);
+  border-left: var(--border-width-hairline) solid var(--color-border-strong);
+  color: var(--color-text-primary);
+  font-family: var(--font-family-serif);
+  font-size: var(--font-size-h3);
+  font-style: italic;
+  line-height: var(--font-line-height-card);
+  letter-spacing: var(--font-tracking-title);
+}
+
+.body-quote figcaption {
+  margin-top: var(--space-8);
+  padding-left: var(--space-24);
+  color: var(--color-text-tertiary);
+  font-size: var(--font-size-caption);
+}
+
+.code-block {
+  margin-inline: 0;
+  padding: var(--space-16) var(--space-20);
+  border-radius: var(--radius-media);
+  background: var(--color-code-bg);
+  color: var(--color-code-text);
+  font-family: var(--font-family-mono);
+  font-size: var(--font-size-small);
+  line-height: var(--font-line-height-code);
+  overflow-x: auto;
+  tab-size: 2;
+}
+
+.code-block:focus-visible {
+  outline-color: var(--color-code-text);
+}
+
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme='light']) .code-block {
+    box-shadow: inset 0 0 0 1px var(--color-border-default);
+  }
+}
+
+:root[data-theme='dark'] .code-block {
+  box-shadow: inset 0 0 0 1px var(--color-border-default);
+}
+
+.body-list {
+  margin-inline: 0;
+  padding-left: var(--space-24);
+}
+
+.body-list li + li {
+  margin-top: var(--space-6);
+}
+
+.body-list li::marker {
+  color: var(--color-text-tertiary);
+}
+
+ol.body-list li::marker {
+  font-family: var(--font-family-mono);
+  font-size: var(--font-size-small);
+}
+
+.body-figure {
+  margin-inline: 0;
+}
+
+/* Media frame: no asset */
+.media-frame {
+  display: block;
+  width: 100%;
+  height: auto;
+  aspect-ratio: 3 / 2;
+  border-radius: var(--radius-media);
+  background-color: var(--color-surface-tray);
+  background-image: repeating-linear-gradient(135deg, var(--color-decor-hatch) 0 1px, transparent 1px 10px);
+  box-shadow: var(--elevation-rest);
+  color: var(--color-text-tertiary);
+}
+
+/* 24px-grid icon drawn at 20px (size.iconLg), centered in the frame */
+.image-placeholder-icon {
+  transform-box: view-box;
+  transform: translate(50%, 50%) translate(calc(-0.5 * var(--size-icon-lg)), calc(-0.5 * var(--size-icon-lg)))
+    scale(0.8333);
+}
+
+.body-figure figcaption {
+  margin-top: var(--space-8);
+  color: var(--color-text-tertiary);
+  font-size: var(--font-size-small);
+}
+
+/* Table of contents: right rail from lg */
+.toc-summary {
+  display: none;
+}
+
+.toc-heading {
+  margin-bottom: var(--space-8);
+  padding-left: var(--space-10);
+  font-family: var(--font-family-mono);
+  font-size: var(--font-size-caption);
+  font-weight: var(--font-weight-medium);
+  line-height: var(--font-line-height-ui);
+  letter-spacing: var(--font-tracking-eyebrow);
+  text-transform: uppercase;
+  color: var(--color-text-secondary);
+}
+
+.toc-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  font-size: var(--font-size-small);
+}
+
+.toc-item + .toc-item {
+  margin-top: 2px;
+}
+
+.toc-item-nested {
+  padding-left: var(--space-12);
+}
+
+.toc-link {
+  display: block;
+  padding: var(--space-6) var(--space-10);
+  border-radius: var(--radius-inner);
+  color: var(--color-text-secondary);
+  line-height: var(--font-line-height-card);
+  text-decoration: none;
+}
+
+.toc-link:hover {
+  background: var(--color-surface-subtle);
+  color: var(--color-text-primary);
+}
+
+.related {
+  margin-top: var(--space-96);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-24);
+}
+
+@media (max-width: 1199px) {
+  .article-layout {
+    display: flex;
+    flex-direction: column;
+    align-items: stretch;
+    gap: 0;
+  }
+
+  /* Header, then the contents disclosure, then the body */
+  .article {
+    display: contents;
+  }
+
+  .article-header {
+    order: 1;
+    max-width: var(--size-article);
+    margin-bottom: var(--space-24);
+  }
+
+  .article-aside {
+    order: 2;
+    position: static;
+    width: 100%;
+    max-width: var(--size-article);
+    margin-bottom: var(--space-40);
+  }
+
+  .article-body {
+    order: 3;
+    min-width: 0;
+  }
+
+  .article-header,
+  .article-aside {
+    min-width: 0;
+  }
+
+  .toc-details {
+    border-radius: var(--radius-callout);
+    background: var(--color-surface-raised);
+    box-shadow: var(--elevation-rest);
+  }
+
+  .toc-summary {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: var(--space-8);
+    min-height: var(--size-touch);
+    padding: 0 var(--space-16);
+    border-radius: var(--radius-callout);
+    color: var(--color-text-primary);
+    font-size: var(--font-size-ui);
+    font-weight: var(--font-weight-medium);
+    list-style: none;
+    cursor: pointer;
+    transition: var(--transition-color);
+  }
+
+  .toc-summary::-webkit-details-marker {
+    display: none;
+  }
+
+  .toc-summary:hover {
+    background: var(--color-surface-subtle);
+  }
+
+  .toc-chevron {
+    flex: none;
+    color: var(--color-text-secondary);
+    transition: transform var(--motion-duration-fast) var(--motion-easing-standard);
+  }
+
+  .toc-details[open] .toc-chevron {
+    transform: rotate(180deg);
+  }
+
+  .toc-heading {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    margin: -1px;
+    padding: 0;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+  }
+
+  .toc-list {
+    padding: 0 var(--space-6) var(--space-10);
+  }
+
+  .toc-link {
+    min-height: var(--size-touch);
+    display: flex;
+    align-items: center;
+  }
+}
+
+@media (max-width: 859px) {
+  .related {
+    margin-top: var(--space-56);
+  }
+}
+
+/* ---------- About ---------- */
+.prose {
+  max-width: 64ch;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-16);
+  color: var(--color-text-body);
+  line-height: var(--font-line-height-article);
+}
+
+.prose h2 {
+  margin-bottom: var(--space-4);
+}
+
+.prose a {
+  padding: 0 2px;
+  margin: 0 -2px;
+  border-radius: var(--radius-swatch);
+}
+
+.prose a:focus-visible {
+  outline-offset: 3px;
+}
+
+.authors {
+  margin-top: var(--space-64);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-24);
+}
+
+.author-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  grid-template-columns: repeat(12, minmax(0, 1fr));
+  gap: var(--grid-gap);
+}
+
+.author-list > li {
+  grid-column: span 4;
+  display: flex;
+  min-width: 0;
+}
+
+.author-card {
+  flex: 1;
+  flex-direction: row;
+  align-items: flex-start;
+  gap: var(--space-16);
+}
+
+.author-card-body {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+  min-width: 0;
+}
+
+.author-name {
+  font-size: var(--font-size-card-title);
+  line-height: var(--font-line-height-card);
+}
+
+.author-role {
+  color: var(--color-text-tertiary);
+}
+
+.author-bio {
+  margin-top: var(--space-8);
+  color: var(--color-text-body);
+}
+
+.avatar {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+  width: var(--size-touch);
+  height: var(--size-touch);
+  border-radius: var(--radius-full);
+  background: var(--color-surface-subtle);
+  color: var(--color-text-secondary);
+  font-size: var(--font-size-small);
+  font-weight: var(--font-weight-medium);
+}
+
+@media (max-width: 1199px) {
+  .author-list {
+    grid-template-columns: repeat(8, minmax(0, 1fr));
+  }
+
+  .author-list > li {
+    grid-column: span 8;
+  }
+}
+
+@media (max-width: 859px) {
+  .author-list {
+    grid-template-columns: repeat(4, minmax(0, 1fr));
+  }
+
+  .author-list > li {
+    grid-column: span 4;
+  }
+
+  .authors {
+    margin-top: var(--space-56);
   }
 }
