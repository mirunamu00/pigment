+
+  .table--stack td.cell-primary {
+    display: block;
+    font-size: var(--font-size-ui);
+    font-weight: var(--font-weight-medium);
+    padding-bottom: var(--space-6);
+  }
+
+  .table--stack .cell-primary .muted {
+    font-weight: var(--font-weight-regular);
+  }
+
+  .table--stack .cell-actions {
+    display: flex;
+    gap: var(--space-8);
+    padding-top: var(--space-12);
+  }
+
+  .table--stack .cell-actions > * {
+    flex: 1;
+    height: var(--size-touch);
+  }
+}
+
+/* ---------- Reduced motion: every transition and animation stops. ---------- */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition-duration: var(--motion-duration-instant) !important;
+    animation-duration: var(--motion-duration-instant) !important;
+    animation-iteration-count: 1 !important;
+  }
+
+  .spinner {
+    animation: none;
+    border-top-color: currentColor;
+    border-right-color: transparent;
   }
 }
