+/** The largest "nice" step that splits the range into at most 3 bands (max 4 gridlines). */
+function niceStep(max: number): number {
+  const magnitude = 10 ** Math.floor(Math.log10(max / 3));
+  for (const factor of [1, 2, 2.5, 5, 10]) {
+    if (max / (factor * magnitude) <= 3) return factor * magnitude;
+  }
+  return 10 * magnitude;
+}
+
+/** A bar with rounded top corners only. */
+function barPath(x: number, y: number, width: number, height: number): string {
+  const r = Math.min(BAR_RADIUS, width / 2, height);
+  const bottom = y + height;
+  return `M${x},${bottom} V${y + r} A${r},${r} 0 0 1 ${x + r},${y} H${x + width - r} A${r},${r} 0 0 1 ${x + width},${y + r} V${bottom} Z`;
