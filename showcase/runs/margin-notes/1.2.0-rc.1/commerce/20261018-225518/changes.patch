+/**
+ * Under breakpoint.md the chips scroll in their own strip: mark overflow so the edge fades while
+ * chips are off-screen, and bring the selected chip into view on load.
+ */
+function useChipStrip() {
+  const ref = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    const strip = ref.current;
+    if (!strip) return;
+
+    function update() {
+      if (!strip) return;
+      const overflow = strip.scrollWidth > strip.clientWidth + 1;
+      strip.toggleAttribute('data-overflow', overflow);
+      strip.toggleAttribute('data-at-end', strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 1);
+    }
+
+    // Scroll only the strip (never the page) so the selected chip is fully visible.
+    const selected = strip.querySelector<HTMLElement>('[aria-pressed="true"]');
+    if (selected) {
+      const left = selected.offsetLeft - strip.offsetLeft;
+      const right = left + selected.offsetWidth;
+      if (right > strip.scrollLeft + strip.clientWidth) strip.scrollLeft = right - strip.clientWidth;
+      else if (left < strip.scrollLeft) strip.scrollLeft = left;
+    }
+    update();
+
+    strip.addEventListener('scroll', update, { passive: true });
+    window.addEventListener('resize', update);
+    return () => {
+      strip.removeEventListener('scroll', update);
+      window.removeEventListener('resize', update);
+    };
+  }, []);
+
+  return ref;
+}
