+  font: var(--font-weight-regular) var(--font-size-h3) / var(--font-line-height-hand) var(--font-family-hand);
+  color: var(--color-decor-pencil);
+}
+
+.note path {
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.4;
+  stroke-linecap: round;
+}
+
+/* The arrow tip sits 3px into the SVG, so 6px here lands it about 9px from the target. */
+.note--beside {
+  left: calc(100% + 6px);
+  bottom: 50%;
+}
+
+.note--below {
+  left: var(--note-x, 24px);
+  top: calc(100% + 6px);
+  align-items: flex-end;
+  transform-origin: 0 0;
+}
+
+.note--below svg {
+  transform: scaleY(-1);
+}
+
+@media (max-width: 1199px) {
+  .note {
+    display: none;
+  }
+}
+
+.serif {
+  font-family: var(--font-family-serif);
+  font-style: italic;
+  font-weight: var(--font-weight-regular);
+  letter-spacing: var(--font-tracking-title);
+}
+
+.swash {
+  position: relative;
+  isolation: isolate;
+}
+
+.swash svg {
+  position: absolute;
+  left: -8px;
+  bottom: -2px;
+  width: calc(100% + 18px);
+  height: 0.42em;
+  z-index: -1;
+  overflow: visible;
+}
+
+.swash-stroke {
+  opacity: var(--opacity-swash);
+}
+
+/* ---------- Toast ---------- */
+.toast-region {
+  position: fixed;
+  right: var(--space-24);
+  bottom: var(--space-24);
+  z-index: 60;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-8);
+}
+
+.toast {
+  display: flex;
+  align-items: center;
+  gap: var(--space-10);
+  max-width: 420px;
+  min-height: var(--size-control-lg);
+  padding: var(--space-12) var(--space-16);
+  border-radius: var(--radius-callout);
+  background: var(--color-action-primary);
+  box-shadow: var(--elevation-segment);
+  color: var(--color-text-on-action);
+  font-size: var(--font-size-ui);
+  animation: toast-in var(--motion-duration-overlay) var(--motion-easing-standard) both;
+}
+
+.toast-message {
+  flex: 1;
+}
+
+.toast-close {
+  display: inline-grid;
+  place-items: center;
+  flex: none;
+  width: 24px;
+  height: 24px;
+  padding: 0;
+  border: 0;
+  border-radius: var(--radius-inner);
+  background: transparent;
+  color: var(--color-text-on-action);
+  cursor: pointer;
+}
+
+.toast-close:focus-visible {
+  outline-color: var(--color-text-on-action);
+}
+
+@keyframes toast-in {
+  from {
+    opacity: 0;
+    transform: translateY(4px);
+  }
+}
+
+@media (max-width: 859px) {
+  .toast-region {
+    left: var(--space-16);
+    right: var(--space-16);
+    bottom: var(--space-16);
+  }
+
+  .app-shell:has(.action-bar) .toast-region {
+    bottom: calc(var(--action-bar-height) + var(--space-16));
+  }
+
+  .toast {
+    max-width: none;
+  }
+}
