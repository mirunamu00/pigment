+/* ---------------------------------------------------------------- Breakpoints */
+@media (max-width: 1199px) {
+  .bloom--band {
+    width: 176px;
+    height: 96px;
+    min-height: 0;
+    right: -48px;
+  }
+
+  .bloom-band .lead {
+    margin-top: var(--space-20);
+  }
+
+  .note {
+    display: none;
+  }
+
+  .product-grid {
+    grid-template-columns: repeat(8, minmax(0, 1fr));
+    gap: var(--space-24);
+  }
+
+  .product-card {
+    grid-column: span 2;
+  }
+
+  .product-detail {
+    grid-template-columns: repeat(8, minmax(0, 1fr));
+    gap: var(--space-24);
+  }
+
+  .product-detail > .product-image,
+  .product-detail-info {
+    grid-column: span 4;
+  }
+
+  .cart-layout {
+    grid-template-columns: repeat(8, minmax(0, 1fr));
+    gap: var(--space-24);
+  }
+
+  .cart-layout > :first-child,
+  .cart-layout > :last-child {
+    grid-column: 1 / -1;
+  }
 }
 
