+/* ---------------------------------------------------------------- Cart */
+.cart-layout {
+  display: grid;
+  grid-template-columns: repeat(12, minmax(0, 1fr));
+  gap: var(--space-32);
+  align-items: start;
+}
+
+.cart-layout > :first-child {
+  grid-column: span 7;
+}
+
+.cart-layout > :last-child {
+  grid-column: span 5;
+}
+
+.cart-lines {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  border-top: var(--border-width-hairline) solid var(--color-border-default);
+}
+
+.cart-line {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto auto auto;
+  align-items: center;
+  gap: var(--space-16);
+  padding: var(--space-14) 0;
+  border-bottom: var(--border-width-hairline) solid var(--color-border-default);
+}
+
+.cart-line-info {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+  min-width: 0;
+}
+
+.cart-line-name {
+  font-size: var(--font-size-ui);
+  font-weight: var(--font-weight-medium);
+  width: fit-content;
+}
+
+.cart-line-total {
+  min-width: 80px;
+  text-align: right;
+  font-family: var(--font-family-mono);
+  font-size: var(--font-size-small);
+  font-weight: var(--font-weight-regular);
+}
+
+.summary {
+  margin: var(--space-4) 0 0;
+}
+
+.summary-row {
+  display: flex;
+  justify-content: space-between;
+  gap: var(--space-16);
+  padding: var(--space-6) 0;
+}
+
+.summary-row dt {
+  color: var(--color-text-secondary);
+}
+
+.summary-row dd {
+  margin: 0;
+  font-family: var(--font-family-mono);
+  font-size: var(--font-size-small);
+  font-variant-numeric: tabular-nums;
+  color: var(--color-text-primary);
+}
+
+.summary-total {
+  border-top: var(--border-width-hairline) solid var(--color-border-default);
+  margin-top: var(--space-8);
+  padding-top: var(--space-14);
+}
+
+.summary-total dt {
+  color: var(--color-text-primary);
+  font-weight: var(--font-weight-semibold);
+}
+
+.summary-total dd {
+  font-size: var(--font-size-body);
+  font-weight: var(--font-weight-medium);
+}
+
+.checkout-form {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-20);
+}
+
+.checkout-form .action-bar {
+  padding-top: var(--space-4);
 }
 
 .confirmation {
-  background: var(--color-success-bg);
