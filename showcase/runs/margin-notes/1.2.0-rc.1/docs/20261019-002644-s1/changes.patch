 const FEEDBACK_MS = 2000;
 
+// Light-touch highlighting: quoted strings and line comments. Everything else keeps the base code color.
+const TOKEN = /("(?:[^"\\\n]|\\.)*"|'(?:[^'\\\n]|\\.)*'|`(?:[^`\\]|\\.)*`|(?:^|(?<=\s))(?:#|\/\/)[^\n]*)/gm;
+
+function highlight(code: string) {
+  return code.split(TOKEN).map((part, index) => {
+    if (index % 2 === 0) return <Fragment key={index}>{part}</Fragment>;
+    const isComment = part.startsWith('#') || part.startsWith('//');
+    return (
+      <span key={index} className={isComment ? 'code-comment' : 'code-string'}>
+        {part}
+      </span>
+    );
+  });
+}
+
