+import { useEffect, useRef } from 'react';
 import type { Param } from '../data/docs';
 import Inline from './Inline';
 
+/** Marks the scroll region with data-overflow / data-at-end so the edge fade and the hint follow it. */
+function useScrollEdges() {
+  const ref = useRef<HTMLDivElement>(null);
+  useEffect(() => {
+    const element = ref.current;
+    if (!element) return;
+    function update() {
+      if (!element) return;
+      const overflow = element.scrollWidth > element.clientWidth + 1;
+      element.toggleAttribute('data-overflow', overflow);
+      element.toggleAttribute('data-at-end', element.scrollLeft + element.clientWidth >= element.scrollWidth - 1);
+    }
+    update();
+    element.addEventListener('scroll', update, { passive: true });
+    const observer = new ResizeObserver(update);
+    observer.observe(element);
+    return () => {
+      element.removeEventListener('scroll', update);
+      observer.disconnect();
+    };
+  }, []);
+  return ref;
+}
+
 export default function ParamsTable({ label, rows }: { label: string; rows: Param[] }) {
+  const scrollRef = useScrollEdges();
