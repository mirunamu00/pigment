node_modules/
dist/
!content/templates/*/*/dist/
!apps/web/tests/fixtures/content/templates/*/*/dist/
.next/
.turbo/
coverage/
*.log
.env*
!.env.example

# Playwright
test-results/
playwright-report/

# Harness working output (large, regenerated). Keep the reports, drop the heavy parts.
showcase/runs/**/node_modules/
showcase/runs/**/dist/
pipeline/*/reference/raw/
# Images of reference sites stay local: they are third-party work. The measured JSON and reports are kept.
pipeline/*/reference/screenshots/
pipeline/*/reference/components/
pipeline/*/reference/motion/
pipeline/*/reference/interactions/
pipeline/*/reference/illustrations/
pipeline/*/reference/icons/
.cache/

# Next test build
.next-test/

# Internal planning documents (not public)
docs/planning/

# Personal Claude Code settings
.claude/settings.local.json

# MCP npm package staging (built by packages/mcp/scripts/build.ts)
packages/mcp/release/

# Local production build check
.next-prod/

# Agent working copies of the base apps (each is its own git repo, used for diffs; regenerated by generate)
showcase/runs/**/app/

# A running generation (pnpm harness generate)
showcase/runs/.generate.lock
showcase/runs/*/*/.generate.lock

# Run evidence images stay local: the gallery copies what it shows into apps/web/public/showcase, and the
# records (eval, critic, run.json, shots.json, reports, patches) are what the repo keeps.
showcase/runs/*/*/*/*/screenshots/
showcase/runs/*/*/*/*/motion/
showcase/runs/*/*/*/*/drawings/
showcase/runs/*/*/review-*.html
showcase/runs/_baseline/**/*.png

# Review calibration cases: candidates the user judged, kept on this machine only (pnpm harness calibrate)
content/templates/calib-*/
showcase/runs/calib-*/
pipeline/calib-*/
