{
  "color": {
    "$type": "color",
    "neutral": {
      "0": { "$value": "#ffffff" },
      "50": { "$value": "#f7f7f8" },
      "100": { "$value": "#eeeef0" },
      "200": { "$value": "#dedee2" },
      "300": { "$value": "#c4c4ca" },
      "500": { "$value": "#6e6e78" },
      "600": { "$value": "#55555e" },
      "700": { "$value": "#3f3f46" },
      "800": { "$value": "#27272a" },
      "900": { "$value": "#18181b" },
      "950": { "$value": "#0c0c0e" }
    },
    "accent": {
      "400": { "$value": "#5b8cff" },
      "500": { "$value": "#2f6bff" },
      "600": { "$value": "#1f55e0" },
      "700": { "$value": "#1a45b8" }
    },
    "green": { "400": { "$value": "#3fbf75" }, "600": { "$value": "#167a3e" } },
    "amber": { "400": { "$value": "#e0a84a" }, "600": { "$value": "#8a5300" } },
    "red": { "400": { "$value": "#f27272" }, "600": { "$value": "#c42b2b" } },
    "blue": { "400": { "$value": "#6aa2ff" }, "600": { "$value": "#1d5fbf" } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": { "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "Pretendard", "Noto Sans KR", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px" },
      "sm": { "$value": "14px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "18px" },
      "xl": { "$value": "24px" },
      "2xl": { "$value": "32px" },
      "3xl": { "$value": "48px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.15 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.7 }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "full": { "$value": "9999px" }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "thin": { "$value": "1px" },
      "thick": { "$value": "2px" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": "0 1px 2px rgba(0, 0, 0, 0.06)" },
    "md": { "$value": "0 8px 24px -8px rgba(0, 0, 0, 0.18)" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" }
  }
}
