{
  "color": {
    "$type": "color",
    "surface": {
      "default": { "$value": "{color.neutral.0}" },
      "subtle": { "$value": "{color.neutral.50}" },
      "raised": { "$value": "{color.neutral.0}" }
    },
    "text": {
      "primary": { "$value": "{color.neutral.900}" },
      "secondary": { "$value": "{color.neutral.600}" },
      "onAction": { "$value": "{color.neutral.0}" }
    },
    "border": {
      "default": { "$value": "{color.neutral.200}" },
      "strong": { "$value": "{color.neutral.300}" }
    },
    "action": {
      "primary": { "$value": "{color.accent.600}" },
      "primaryHover": { "$value": "{color.accent.700}" }
    },
    "focus": {
      "ring": { "$value": "{color.accent.500}" }
    },
    "status": {
      "success": { "$value": "{color.green.600}" },
      "warning": { "$value": "{color.amber.600}" },
      "danger": { "$value": "{color.red.600}" },
      "info": { "$value": "{color.blue.600}" }
    }
  }
}
