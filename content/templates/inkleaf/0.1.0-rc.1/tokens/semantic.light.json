{
  "color": {
    "$type": "color",
    "surface": {
      "default": { "$value": "{palette.paper.50}", "$description": "page ground" },
      "raised": { "$value": "{palette.paper.0}", "$description": "cards, inputs, dialogs, menus, selected tab pill" },
      "subtle": { "$value": "{palette.paper.150}", "$description": "band, tab track, switch track, skeleton, code inline" },
      "hover": { "$value": "{palette.paper.100}", "$description": "row and menu-item hover, chip hover" },
      "inverse": { "$value": "{palette.ink.950}", "$description": "closing band, footer, terminal frame" },
      "inverseRaised": { "$value": "{palette.ink.850}", "$description": "ghost-button hover and inputs on the inverse band" },
      "overlay": { "$value": "{palette.scrim.day}", "$description": "dialog scrim" }
    },
    "text": {
      "primary": { "$value": "{palette.ink.950}", "$description": "headings, body, labels, values" },
      "secondary": { "$value": "{palette.ink.600}", "$description": "ledes, descriptions, nav at rest, hints" },
      "tertiary": { "$value": "{palette.ink.550}", "$description": "meta, captions, placeholders, table heads" },
      "disabled": { "$value": "{palette.ink.500}" },
      "onAction": { "$value": "{palette.paper.50}", "$description": "label on action.primary and action.danger" },
      "inverse": { "$value": "{palette.paper.50}", "$description": "text on surface.inverse" },
      "inverseMuted": { "$value": "{palette.line.300}", "$description": "links and meta on surface.inverse" }
    },
    "border": {
      "default": { "$value": "{palette.line.100}", "$description": "hairline: cards, dividers, rows" },
      "control": { "$value": "{palette.line.200}", "$description": "1px ring on buttons, inputs, selects" },
      "strong": { "$value": "{palette.line.300}", "$description": "input hover ring" },
      "check": { "$value": "{palette.ink.500}", "$description": "checkbox, radio, switch-off outline (3:1)" },
      "inverse": { "$value": "{palette.ink.800}", "$description": "lines on surface.inverse" }
    },
    "action": {
      "primary": { "$value": "{palette.ink.950}", "$description": "ink button, checked controls" },
      "primaryHover": { "$value": "{palette.ink.950}", "$description": "unchanged fill; hover adds the 2px ring" },
      "secondary": { "$value": "{palette.paper.0}", "$description": "paper button fill" },
      "tertiary": { "$value": "{palette.line.100}", "$description": "stone button and small chip fill" },
      "tertiaryHover": { "$value": "{palette.line.200}" },
      "send": { "$value": "{palette.kiln.500}", "$description": "a prompt's send square only" },
      "danger": { "$value": "{palette.status.brick}", "$description": "confirm a destructive action only" }
    },
    "focus": {
      "ring": { "$value": "{palette.kiln.focus}", "$description": "2px outline on every focusable element" }
    },
    "accent": {
      "glyph": { "$value": "{palette.kiln.500}", "$description": "the working glyph" }
    },
    "pictogram": {
      "ink": { "$value": "{palette.ink.950}" },
      "fill": { "$value": "{palette.pigment.sand}" },
      "fillAlt": { "$value": "{palette.pigment.chalk}" },
      "accent": { "$value": "{palette.kiln.400}", "$description": "one hero drawing per page" }
    },
    "stage": {
      "sage": { "$value": "{palette.pastel.sage}" },
      "lilac": { "$value": "{palette.pastel.lilac}" },
      "apricot": { "$value": "{palette.pastel.apricot}" },
      "lake": { "$value": "{palette.pastel.lake}" },
      "lineMix": { "$value": "{palette.paper.0}", "$description": "mixed 30% into the stage color for its wandering lines" }
    },
    "chart": {
      "ink": { "$value": "{palette.ink.950}", "$description": "lines, current bar, axis labels" },
      "highlight": { "$value": "{palette.pastel.sageDeep}", "$description": "the one highlighted series" },
      "rest": { "$value": "{palette.line.300}", "$description": "past bars, other series" }
    },
    "status": {
      "success": { "$value": "{palette.status.moss}" },
      "warning": { "$value": "{palette.status.ochre}" },
      "danger": { "$value": "{palette.status.brick}" },
      "info": { "$value": "{palette.status.harbor}" }
    }
  }
}
