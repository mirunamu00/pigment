{
  "color": {
    "$type": "color",
    "surface": {
      "default": {
        "$value": "{palette.paper.50}",
        "$description": "page ground"
      },
      "raised": {
        "$value": "{palette.paper.0}",
        "$description": "cards, panels, controls, dialogs, menus"
      },
      "lifted": {
        "$value": "{palette.paper.0}",
        "$description": "pinned cards, dialogs, menus, sheets: one step lighter than raised in dark"
      },
      "subtle": {
        "$value": "{palette.paper.150}",
        "$description": "well: segmented track, current nav item, selected row, disabled fill, skeleton"
      },
      "selected": {
        "$value": "{palette.paper.0}",
        "$description": "selected segment on a surface.subtle track; lighter than the track in both themes"
      },
      "tray": {
        "$value": "{palette.paper.200}",
        "$description": "tray, media placeholder; never carries text"
      },
      "bar": {
        "$value": "{palette.paper.bar}",
        "$description": "sticky mobile action bar"
      },
      "overlay": {
        "$value": "{palette.ink.scrim}",
        "$description": "dialog backdrop"
      }
    },
    "text": {
      "primary": {
        "$value": "{palette.ink.950}",
        "$description": "headings, labels, current nav, values"
      },
      "body": {
        "$value": "{palette.ink.800}",
        "$description": "running text, table cells"
      },
      "secondary": {
        "$value": "{palette.ink.700}",
        "$description": "nav links, descriptions, helper text"
      },
      "tertiary": {
        "$value": "{palette.ink.600}",
        "$description": "meta, step numbers, placeholders, timestamps"
      },
      "onAction": {
        "$value": "{palette.paper.50}",
        "$description": "label on action.primary and action.danger"
      }
    },
    "border": {
      "default": {
        "$value": "{palette.line.100}",
        "$description": "hairline: cards, dividers, table rows"
      },
      "control": {
        "$value": "{palette.line.200}",
        "$description": "button, input, chip, select at rest"
      },
      "strong": {
        "$value": "{palette.line.300}",
        "$description": "control hover, version badge, dashed unavailable pill"
      },
      "selected": {
        "$value": "{palette.line.200}",
        "$description": "1px ring on the selected segment"
      }
    },
    "action": {
      "primary": {
        "$value": "{palette.ink.950}",
        "$description": "primary button, pressed chip, selected states"
      },
      "primaryHover": {
        "$value": "{palette.ink.900}"
      },
      "primaryActive": {
        "$value": "{palette.ink.black}"
      },
      "danger": {
        "$value": "{palette.red.700}",
        "$description": "destructive primary button fill"
      },
      "dangerHover": {
        "$value": "{palette.red.800}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{palette.ink.950}",
        "$description": "2px outline, 2px offset"
      }
    },
    "status": {
      "success": {
        "$value": "{palette.green.700}"
      },
      "successSubtle": {
        "$value": "{palette.green.50}"
      },
      "warning": {
        "$value": "{palette.ochre.700}",
        "$description": "derived"
      },
      "warningSubtle": {
        "$value": "{palette.ochre.50}",
        "$description": "derived"
      },
      "danger": {
        "$value": "{palette.red.700}"
      },
      "dangerSubtle": {
        "$value": "{palette.red.50}",
        "$description": "derived"
      },
      "info": {
        "$value": "{palette.blue.700}",
        "$description": "the only functional use of the hue family"
      },
      "infoSubtle": {
        "$value": "{palette.blue.50}"
      }
    },
    "decor": {
      "bloomIndigo": {
        "$value": "{palette.indigo.900}"
      },
      "bloomBlue": {
        "$value": "{palette.blue.700}"
      },
      "bloomViolet": {
        "$value": "{palette.indigo.violet}"
      },
      "tape": {
        "$value": "{palette.tape.light}"
      },
      "pencil": {
        "$value": "{palette.ink.600}",
        "$description": "pencil arrows and note text"
      },
      "hatch": {
        "$value": "{palette.line.400}",
        "$description": "media hatch, 1.25:1 on surface.tray"
      }
    },
    "code": {
      "bg": {
        "$value": "{palette.ink.950}"
      },
      "text": {
        "$value": "{palette.code.text}"
      },
      "muted": {
        "$value": "{palette.code.muted}",
        "$description": "comments, prompt glyph"
      },
      "string": {
        "$value": "{palette.code.string}"
      }
    }
  },
  "elevation": {
    "$type": "shadow",
    "rest": {
      "$value": "{shadow.rest}"
    },
    "pinned": {
      "$value": "{shadow.pinned}"
    },
    "segment": {
      "$value": "{shadow.segment}"
    },
    "actionBar": {
      "$value": "{shadow.actionBar}"
    }
  },
  "opacity": {
    "$type": "number",
    "bloom": {
      "$value": 0.42
    },
    "swash": {
      "$value": 0.32
    },
    "chartRest": {
      "$value": 0.22,
      "$description": "past-period chart bars: text.primary at this opacity"
    }
  }
}
