{
  "color": {
    "$type": "color",
    "neutral": {
      "0": { "$value": "#ffffff", "$description": "white: raised cards in light, inverse text" },
      "50": { "$value": "#f4f4f0", "$description": "paper ground; dark primary text" },
      "100": { "$value": "#ebebe5", "$description": "deeper paper: wells, table header band" },
      "200": { "$value": "#dddddd", "$description": "hairline in light; control border in dark" },
      "400": { "$value": "#b3b3af", "$description": "secondary text in dark" },
      "500": { "$value": "#8a8a86", "$description": "disabled text" },
      "600": { "$value": "#666666", "$description": "secondary text in light" },
      "700": { "$value": "#4d4d4b", "$description": "hairline in dark" },
      "800": { "$value": "#242423", "$description": "dark raised card" },
      "900": { "$value": "#111111", "$description": "dark subtle well" },
      "950": { "$value": "#000000", "$description": "ink: text, borders, hard shadow; dark ground" }
    },
    "pink": {
      "400": { "$value": "#ff7ccf", "$description": "the one loud accent: main CTA, price tag, focus halo" },
      "500": { "$value": "#ff62c3", "$description": "accent hover fill" }
    },
    "flood": {
      "teal": { "$value": "#23a094" },
      "yellow": { "$value": "#ffc900" },
      "periwinkle": { "$value": "#90a8ed" },
      "lime": { "$value": "#f1f333" },
      "red": { "$value": "#dc341e" }
    },
    "green": { "400": { "$value": "#4fd186" }, "600": { "$value": "#167a3e" } },
    "amber": { "400": { "$value": "#f2b84b" }, "600": { "$value": "#8a5300" } },
    "red": { "400": { "$value": "#ff6b57" }, "600": { "$value": "#c22a16" } },
    "blue": { "400": { "$value": "#7fb0ff" }, "600": { "$value": "#1d5fbf" } },
    "alpha": {
      "scrim": { "$value": "#00000080", "$description": "ink at 50% behind dialogs" },
      "shadowLight": { "$value": "#ffffff59", "$description": "white at 35%: the hard shadow on dark ground" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": { "$value": ["DM Sans", "system-ui", "-apple-system", "Segoe UI", "Pretendard", "Noto Sans KR", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "D2Coding", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": "14px", "$description": "caption, table cell, small button" },
      "md": { "$value": "16px", "$description": "body, buttons, inputs" },
      "lg": { "$value": "20px", "$description": "lead, card title" },
      "xl": { "$value": "24px", "$description": "h3" },
      "2xl": { "$value": "30px", "$description": "h2" },
      "3xl": { "$value": "48px", "$description": "h1 / band title" },
      "4xl": { "$value": "72px", "$description": "display" },
      "5xl": { "$value": "96px", "$description": "hero display, landing only" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "bold": { "$value": 700, "$description": "table totals and inline emphasis only; never headings or buttons" }
    },
    "lineHeight": {
      "$type": "number",
      "display": { "$value": 1, "$description": "72 and 96px type" },
      "h1": { "$value": 1.25, "$description": "48/60" },
      "heading": { "$value": 1.2, "$description": "30/36" },
      "title": { "$value": 1.33, "$description": "24/32" },
      "ui": { "$value": 1.375, "$description": "16/22 body and buttons; 20/28 lead" },
      "caption": { "$value": 1.3, "$description": "14/18.2" }
    },
    "tracking": {
      "$type": "dimension",
      "display": { "$value": "-0.4px", "$description": "on 20px and larger" },
      "body": { "$value": "0px" }
    }
  },
  "space": {
    "$type": "dimension",
    "4": { "$value": "4px" },
    "8": { "$value": "8px" },
    "12": { "$value": "12px" },
    "16": { "$value": "16px" },
    "24": { "$value": "24px" },
    "32": { "$value": "32px" },
    "48": { "$value": "48px" },
    "64": { "$value": "64px" },
    "96": { "$value": "96px" }
  },
  "size": {
    "$type": "dimension",
    "controlSm": { "$value": "36px" },
    "control": { "$value": "48px" },
    "hit": { "$value": "44px" },
    "icon": { "$value": "24px" },
    "sticker": { "$value": "32px" },
    "stickerLg": { "$value": "160px" },
    "container": { "$value": "1312px" },
    "containerNarrow": { "$value": "1152px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px", "$description": "buttons, inputs, toast" },
    "md": { "$value": "8px", "$description": "cards, dialog" },
    "lg": { "$value": "16px", "$description": "large panels" },
    "full": { "$value": "9999px", "$description": "pills, chips, switch" }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "thin": { "$value": "1px" },
      "thick": { "$value": "2px" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Offset part only (x y blur spread, blur always 0). Append a color: box-shadow: var(--shadow-md) var(--color-shadow-hard).",
    "sm": { "$value": "2px 2px 0 0", "$description": "icon buttons, row actions" },
    "md": { "$value": "4px 4px 0 0", "$description": "buttons, cards, toast" },
    "lg": { "$value": "8px 8px 0 0", "$description": "dialog" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "100ms", "$description": "link darken, tab border" },
      "base": { "$value": "150ms", "$description": "lift, press, fill flip, toast in" },
      "slow": { "$value": "200ms", "$description": "disclosure open, dialog in" },
      "coin": { "$value": "1200ms", "$description": "loading coin turn, one cycle" },
      "marquee": { "$value": "60000ms", "$description": "tag wall, one loop" },
      "draw": { "$value": "8000ms", "$description": "outline draw-on" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.4, 0, 0.2, 1] },
      "out": { "$value": [0, 0, 0.2, 1] },
      "linear": { "$value": [0, 0, 1, 1] }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" },
    "2xl": { "$value": "1536px" }
  }
}
