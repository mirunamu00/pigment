{
  "color": {
    "$type": "color",
    "surface": {
      "default": { "$value": "{color.neutral.50}", "$description": "paper page ground" },
      "subtle": { "$value": "{color.neutral.100}", "$description": "wells, table header, disabled fill" },
      "raised": { "$value": "{color.neutral.0}", "$description": "cards, inputs, dialog, toast" }
    },
    "text": {
      "primary": { "$value": "{color.neutral.950}" },
      "secondary": { "$value": "{color.neutral.600}" },
      "disabled": { "$value": "{color.neutral.500}" },
      "onAction": { "$value": "{color.neutral.950}", "$description": "ink on the pink action" },
      "onInverse": { "$value": "{color.neutral.0}" }
    },
    "border": {
      "default": { "$value": "{color.neutral.950}", "$description": "every control and card" },
      "strong": { "$value": "{color.neutral.950}", "$description": "same ink; used for 2px emphasis" },
      "hairline": { "$value": "{color.neutral.200}", "$description": "row rules inside a bordered box only" }
    },
    "action": {
      "primary": { "$value": "{color.pink.400}" },
      "primaryHover": { "$value": "{color.pink.500}" },
      "inverse": { "$value": "{color.neutral.950}", "$description": "ink button" }
    },
    "accent": {
      "halo": { "$value": "{color.pink.400}", "$description": "input focus halo, price tag" }
    },
    "focus": {
      "ring": { "$value": "{color.neutral.950}" }
    },
    "shadow": {
      "hard": { "$value": "{color.neutral.950}" }
    },
    "scrim": { "$value": "{color.alpha.scrim}" },
    "band": {
      "teal": { "$value": "{color.flood.teal}" },
      "yellow": { "$value": "{color.flood.yellow}" },
      "periwinkle": { "$value": "{color.flood.periwinkle}" },
      "lime": { "$value": "{color.flood.lime}" },
      "red": { "$value": "{color.flood.red}" }
    },
    "status": {
      "success": { "$value": "{color.green.600}" },
      "warning": { "$value": "{color.amber.600}" },
      "danger": { "$value": "{color.red.600}" },
      "info": { "$value": "{color.blue.600}" }
    }
  }
}
