{
  "color": {
    "$type": "color",
    "surface": {
      "default": { "$value": "{color.neutral.950}" },
      "subtle": { "$value": "{color.neutral.900}" },
      "raised": { "$value": "{color.neutral.800}" }
    },
    "text": {
      "primary": { "$value": "{color.neutral.50}" },
      "secondary": { "$value": "{color.neutral.400}" },
      "disabled": { "$value": "{color.neutral.500}" },
      "onAction": { "$value": "{color.neutral.950}" },
      "onInverse": { "$value": "{color.neutral.950}" }
    },
    "border": {
      "default": { "$value": "{color.neutral.200}" },
      "strong": { "$value": "{color.neutral.0}" },
      "hairline": { "$value": "{color.neutral.700}" }
    },
    "action": {
      "primary": { "$value": "{color.pink.400}" },
      "primaryHover": { "$value": "{color.pink.500}" },
      "inverse": { "$value": "{color.neutral.50}" }
    },
    "accent": {
      "halo": { "$value": "{color.pink.400}" }
    },
    "focus": {
      "ring": { "$value": "{color.pink.400}" }
    },
    "shadow": {
      "hard": { "$value": "{color.alpha.shadowLight}" }
    },
    "scrim": { "$value": "{color.alpha.scrim}" },
    "band": {
      "teal": { "$value": "{color.flood.teal}" },
      "yellow": { "$value": "{color.flood.yellow}" },
      "periwinkle": { "$value": "{color.flood.periwinkle}" },
      "lime": { "$value": "{color.flood.lime}" },
      "red": { "$value": "{color.flood.red}" }
    },
    "status": {
      "success": { "$value": "{color.green.400}" },
      "warning": { "$value": "{color.amber.400}" },
      "danger": { "$value": "{color.red.400}" },
      "info": { "$value": "{color.blue.400}" }
    }
  }
}
