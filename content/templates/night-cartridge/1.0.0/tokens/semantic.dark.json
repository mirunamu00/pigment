      },
      "code": {
        "$value": "{palette.night.code}",
        "$description": "inline code highlight"
      }
    },
    "text": {
      "primary": {
        "$value": "{palette.night.text}",
        "$description": "body, table cells, labels"
      },
      "strong": {
        "$value": "{palette.night.textHi}",
        "$description": "headings, emphasis, current item, values"
      },
      "secondary": {
        "$value": "{palette.night.muted}",
        "$description": "meta, resting nav, hints, placeholders"
      },
      "disabled": {
        "$value": "{palette.night.lineUi}"
      },
      "onAction": {
        "$value": "{palette.night.ground}",
