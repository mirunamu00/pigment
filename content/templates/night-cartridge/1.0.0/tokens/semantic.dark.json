{
  "color": {
    "$type": "color",
    "surface": {
      "default": {
        "$value": "{palette.night.ground}",
        "$description": "page ground"
      },
      "subtle": {
        "$value": "{palette.night.panel}",
        "$description": "cards, sidebar, panels, title bars, table head"
      },
      "raised": {
        "$value": "{palette.night.window}",
        "$description": "window interior: windows, dialogs, code bodies, inputs, menus"
      },
      "hover": {
        "$value": "{palette.night.sel}",
