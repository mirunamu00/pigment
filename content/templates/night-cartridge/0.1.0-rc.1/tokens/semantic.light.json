{
  "color": {
    "$type": "color",
    "surface": {
      "default": {
        "$value": "{palette.day.ground}",
        "$description": "page ground"
      },
      "subtle": {
        "$value": "{palette.day.panel}",
        "$description": "cards, sidebar, panels, title bars, table head"
      },
      "raised": {
        "$value": "{palette.day.window}",
        "$description": "window interior: windows, dialogs, code bodies, inputs, menus"
      },
      "hover": {
        "$value": "{palette.day.sel}",
        "$description": "hover and selected rows, items, cards"
      },
      "overlay": {
        "$value": "{palette.scrim.day}",
        "$description": "dialog scrim"
      },
      "code": {
        "$value": "{palette.day.code}",
        "$description": "inline code highlight"
      }
    },
    "text": {
      "primary": {
        "$value": "{palette.day.text}",
        "$description": "body, table cells, labels"
      },
      "strong": {
        "$value": "{palette.day.textHi}",
        "$description": "headings, emphasis, current item, values"
      },
      "secondary": {
        "$value": "{palette.day.muted}",
        "$description": "meta, resting nav, hints, placeholders"
      },
      "disabled": {
        "$value": "{palette.day.disabled}"
      },
      "onAction": {
        "$value": "{palette.night.ground}",
        "$description": "label on the gold button"
      },
      "link": {
        "$value": "{palette.day.link}"
      },
      "accent": {
        "$value": "{palette.gold.deep}",
        "$description": "gold as text, cursor and selection marks"
      }
    },
    "border": {
      "default": {
        "$value": "{palette.day.line}",
        "$description": "table and list rules, header dither"
      },
      "control": {
        "$value": "{palette.day.lineUi}",
        "$description": "control frames, heading dither, dotted separators"
      },
      "strong": {
        "$value": "{palette.day.frame}",
        "$description": "4px window frame"
      }
    },
    "action": {
      "primary": {
        "$value": "{palette.gold.fill}",
        "$description": "the one gold button per screen"
      },
      "primaryHover": {
        "$value": "{palette.gold.fill}",
        "$description": "unchanged: hover does not recolor the gold button"
      },
      "primaryEdge": {
        "$value": "{palette.day.frame}",
        "$description": "2px edge of the gold button: invisible at night, ink on parchment"
      },
      "secondary": {
        "$value": "{palette.day.tint}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{palette.gold.deep}",
        "$description": "4px outline, offset 3px"
      }
    },
    "shadow": {
      "hard": {
        "$value": "{palette.day.frame}"
      }
    },
    "status": {
      "success": {
        "$value": "{palette.status.successDay}"
      },
      "warning": {
        "$value": "{palette.status.warningDay}"
      },
      "danger": {
        "$value": "{palette.status.dangerDay}"
      },
      "info": {
        "$value": "{palette.status.infoDay}"
      }
    },
    "hue": {
      "cyan": {
        "$value": "{palette.hue.cyanDay}"
      },
      "violet": {
        "$value": "{palette.hue.violetDay}"
      },
      "blue": {
        "$value": "{palette.hue.blueDay}"
      },
      "amber": {
        "$value": "{palette.hue.amberDay}"
      },
      "green": {
        "$value": "{palette.hue.greenDay}"
      },
      "pink": {
        "$value": "{palette.hue.pinkDay}"
      },
      "orange": {
        "$value": "{palette.hue.orangeDay}"
      },
      "teal": {
        "$value": "{palette.hue.tealDay}"
      }
    },
    "syntax": {
      "keyword": {
        "$value": "{palette.syntax.keywordDay}"
      },
      "type": {
        "$value": "{palette.syntax.typeDay}"
      },
      "function": {
        "$value": "{palette.syntax.functionDay}"
      },
      "literal": {
        "$value": "{palette.syntax.literalDay}"
      },
      "string": {
        "$value": "{palette.syntax.stringDay}"
      },
      "comment": {
        "$value": "{palette.syntax.commentDay}"
      }
    },
    "art": {
      "sky1": {
        "$value": "{palette.art.daySky1}",
        "$description": "top band"
      },
      "sky2": {
        "$value": "{palette.art.daySky2}"
      },
      "sky3": {
        "$value": "{palette.art.daySky3}"
      },
      "sky4": {
        "$value": "{palette.art.daySky4}"
      },
      "sky5": {
        "$value": "{palette.art.daySky5}"
      },
      "sky6": {
        "$value": "{palette.art.daySky6}",
        "$description": "horizon band"
      },
      "far": {
        "$value": "{palette.art.dayFar}"
      },
      "near": {
        "$value": "{palette.art.dayNear}"
      },
      "ground": {
        "$value": "{palette.art.ground}"
      },
      "groundHi": {
        "$value": "{palette.art.groundHi}"
      },
      "edge": {
        "$value": "{palette.art.edge}"
      },
      "outline": {
        "$value": "{palette.art.outline}"
      },
      "glint": {
        "$value": "{palette.art.glint}"
      },
      "lightWarm": {
        "$value": "{palette.art.lightWarm}"
      },
      "lightCold": {
        "$value": "{palette.art.lightCold}"
      },
      "star": {
        "$value": "{palette.art.daySky1}",
        "$description": "equals the top day band: stars vanish"
      },
      "beacon": {
        "$value": "{palette.art.beacon}"
      },
      "beaconOff": {
        "$value": "{palette.art.beaconOffDay}"
      }
    }
  }
}
