{
  "color": {
    "$type": "color",
    "surface": {
      "default": { "$value": "{color.ink.900}" },
      "raised": { "$value": "{color.ink.1000}" },
      "subtle": { "$value": "{color.ink.800}" },
      "inverse": { "$value": "{color.ink.1000}" },
      "overlay": { "$value": "{color.scrim.night}" }
    },
    "text": {
      "primary": { "$value": "{color.grey.well}" },
      "secondary": { "$value": "{color.grey.mutedNight}" },
      "onAction": { "$value": "{color.ink.1000}" },
      "inverse": { "$value": "{color.paper.0}" },
      "onBand": { "$value": "{color.ink.1000}" }
    },
    "border": {
      "default": { "$value": "{color.grey.lineNight}" },
      "strong": { "$value": "{color.grey.controlNight}" },
      "soft": { "$value": "{color.grey.lineNight}" }
    },
    "action": {
      "primary": { "$value": "{color.poster.pink}" },
      "primaryHover": { "$value": "{color.poster.pink}" },
      "ink": { "$value": "{color.poster.pink}", "$description": "black buttons turn pink in dark" },
      "onInk": { "$value": "{color.ink.1000}" }
    },
    "focus": {
      "ring": { "$value": "{color.paper.0}" },
      "halo": { "$value": "{color.poster.pink}" }
    },
    "selected": {
      "border": { "$value": "{color.poster.pink}" }
    },
    "nav": {
      "current": { "$value": "{color.paper.0}", "$description": "the current pill turns white" },
      "onCurrent": { "$value": "{color.ink.1000}" }
    },
    "shadow": {
      "hard": { "$value": "{color.grey.shadowNight}" }
    },
    "band": {
      "pink": { "$value": "{color.poster.pink}" },
      "lemon": { "$value": "{color.poster.lemon}" },
      "marigold": { "$value": "{color.poster.marigold}" },
      "periwinkle": { "$value": "{color.poster.periwinkle}" },
      "teal": { "$value": "{color.poster.teal}" },
      "ink": { "$value": "{color.ink.1000}" }
    },
    "plate": {
      "a": { "$value": "{color.poster.lemon}" },
      "b": { "$value": "{color.poster.red}" }
    },
    "art": {
      "ink": { "$value": "{color.ink.1000}" },
      "white": { "$value": "{color.paper.0}" },
      "red": { "$value": "{color.poster.red}" }
    },
    "flag": {
      "fill": { "$value": "{color.poster.pink}" },
      "text": { "$value": "{color.ink.1000}" }
    },
    "highlight": {
      "marker": { "$value": "{color.poster.marigold}" }
    },
    "chart": {
      "line": { "$value": "{color.poster.pink}" },
      "bar": { "$value": "{color.ink.700}" },
      "cap": { "$value": "{color.grey.well}" },
      "muted": { "$value": "{color.grey.hairline}" }
    },
    "status": {
      "success": { "$value": "{color.poster.teal}" },
      "warning": { "$value": "{color.poster.marigold}" },
      "danger": { "$value": "{color.signal.dangerNight}" },
      "info": { "$value": "{color.poster.periwinkle}" }
    }
  }
}
