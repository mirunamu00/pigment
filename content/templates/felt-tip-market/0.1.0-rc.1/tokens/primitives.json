{
  "color": {
    "$type": "color",
    "ink": {
      "1000": { "$value": "#000000", "$description": "pure ink: text, every hairline, outlines, slabs, hard shadow, footer" },
      "900": { "$value": "#242423", "$description": "dark-mode ground" },
      "800": { "$value": "#3a3a38", "$description": "dark-mode well" },
      "700": { "$value": "#4a4a47", "$description": "dark-mode chart bar" }
    },
    "paper": {
      "0": { "$value": "#ffffff", "$description": "white surface" },
      "50": { "$value": "#f4f4f0", "$description": "paper ground" }
    },
    "grey": {
      "well": { "$value": "#dddddd", "$description": "code well, inline code; dark-mode text" },
      "bar": { "$value": "#e5e5e5", "$description": "chart bars" },
      "hairline": { "$value": "#919191", "$description": "large showcase cards only; muted chart dot" },
      "muted": { "$value": "#6b6b66", "$description": "helper text (darkened from ink at 50% for 4.5:1 on paper)" },
      "mutedNight": { "$value": "#a3a39e" },
      "controlNight": { "$value": "#8a8a86", "$description": "dark-mode form-control outline (3:1)" },
      "lineNight": { "$value": "#dddddd59", "$description": "dark-mode hairline, white-grey at 35%" },
      "shadowNight": { "$value": "#ffffff59", "$description": "dark-mode hard shadow" }
    },
    "poster": {
      "pink": { "$value": "#ff90e8", "$description": "the action color; closing band; price flag" },
      "lemon": { "$value": "#f1f333" },
      "marigold": { "$value": "#ffc900" },
      "periwinkle": { "$value": "#90a8ed" },
      "teal": { "$value": "#23a094" },
      "red": { "$value": "#dc341e", "$description": "plate B, sticker fill" }
    },
    "signal": {
      "danger": { "$value": "#c42a12", "$description": "error border and icon (deeper than poster red for 4.5:1 on paper)" },
      "dangerNight": { "$value": "#ff6b52" }
    },
    "scrim": {
      "day": { "$value": "#00000066" },
      "night": { "$value": "#000000a3" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Space Grotesk", "DM Sans", "system-ui", "-apple-system", "Segoe UI", "Pretendard", "Noto Sans KR", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "D2Coding", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "mega": { "$value": "192px", "$description": "one giant figure per page" },
      "hero": { "$value": "96px" },
      "display": { "$value": "72px" },
      "section": { "$value": "48px" },
      "statement": { "$value": "36px" },
      "title": { "$value": "30px" },
      "lead": { "$value": "24px" },
      "cardTitle": { "$value": "20px" },
      "body": { "$value": "16px" },
      "meta": { "$value": "14px" },
      "heroMobile": { "$value": "48px" },
      "displayMobile": { "$value": "40px" },
      "sectionMobile": { "$value": "32px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "lineHeight": {
      "$type": "number",
      "mega": { "$value": 0.9 },
      "display": { "$value": 1.0 },
      "heading": { "$value": 1.1 },
      "title": { "$value": 1.2 },
      "lead": { "$value": 1.33 },
      "body": { "$value": 1.375 },
      "prose": { "$value": 1.75 }
    },
    "tracking": {
      "$type": "dimension",
      "display": { "$value": "-0.4px", "$description": "every size of 24px and up" },
      "normal": { "$value": "0px" }
    }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "24": { "$value": "96px" },
    "32": { "$value": "128px" }
  },
  "size": {
    "$type": "dimension",
    "control": { "$value": "48px", "$description": "buttons, inputs, selects" },
    "controlSm": { "$value": "40px", "$description": "compact buttons, pills, menu rows" },
    "row": { "$value": "56px", "$description": "table rows, grouped list rows" },
    "flag": { "$value": "28px", "$description": "price flag height" },
    "notch": { "$value": "12px", "$description": "price flag swallowtail depth" },
    "icon": { "$value": "20px" },
    "tile": { "$value": "160px", "$description": "min height of link tiles" },
    "contentMarketing": { "$value": "1152px" },
    "contentApp": { "$value": "1312px" },
    "contentWide": { "$value": "1376px" },
    "contentNarrow": { "$value": "1024px" },
    "measure": { "$value": "68ch" }
  },
  "offset": {
    "$type": "dimension",
    "lift": { "$value": "4px", "$description": "hover lift and hard-shadow offset" },
    "plate": { "$value": "8px", "$description": "plate-stack button lift" },
    "slab": { "$value": "8px", "$description": "static ink slab under stickers, badges, drawn mockups" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "4px", "$description": "every product component" },
    "md": { "$value": "16px", "$description": "secondary marketing tiles" },
    "lg": { "$value": "24px", "$description": "large showcase cards, speech bubbles" },
    "full": { "$value": "9999px", "$description": "pills only" }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "hair": { "$value": "1px", "$description": "every border" },
      "thick": { "$value": "2px", "$description": "selected, error, focus ring band" },
      "art": { "$value": "2px", "$description": "sticker outline at 120–200px drawing size" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "none": { "$value": "none" },
    "lift": { "$value": "4px 4px 0 0 #000000", "$description": "light reference; build it from offset.lift + color.shadow.hard" },
    "slab": { "$value": "8px 8px 0 0 #000000" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "0ms", "$description": "pill outline, row hover" },
      "lift": { "$value": "150ms", "$description": "lift, slam, plate stack, toast slide" },
      "open": { "$value": "200ms", "$description": "disclosure chevron and panel" },
      "rock": { "$value": "600ms", "$description": "one step of the loading sticker" },
      "marquee": { "$value": "60000ms" },
      "marqueeMobile": { "$value": "20000ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "lift": { "$value": [0.4, 0, 0.2, 1] },
      "open": { "$value": [0, 0, 0.2, 1] },
      "linear": { "$value": [0, 0, 1, 1] }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" },
    "2xl": { "$value": "1536px" }
  }
}
