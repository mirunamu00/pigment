{
  "color": {
    "$type": "color",
    "surface": {
      "default": { "$value": "{color.paper.50}", "$description": "page ground, table header row" },
      "raised": { "$value": "{color.paper.0}", "$description": "cards, panels, inputs, rows, dialogs, menus" },
      "subtle": { "$value": "{color.grey.well}", "$description": "code wells, inline code, disabled fill" },
      "inverse": { "$value": "{color.ink.1000}", "$description": "footer, black half of a split band" },
      "bar": { "$value": "{color.paper.0}", "$description": "top bar; black field in dark" },
      "onBand": { "$value": "{color.paper.0}", "$description": "white fill of anything placed on a color band or the footer, both modes" },
      "overlay": { "$value": "{color.scrim.day}", "$description": "dialog scrim" }
    },
    "text": {
      "primary": { "$value": "{color.ink.1000}" },
      "secondary": { "$value": "{color.grey.muted}", "$description": "helper text, meta, placeholders" },
      "onAction": { "$value": "{color.ink.1000}", "$description": "label on pink" },
      "inverse": { "$value": "{color.paper.0}", "$description": "text on surface.inverse" },
      "onBand": { "$value": "{color.ink.1000}", "$description": "all text on a color band" }
    },
    "border": {
      "default": { "$value": "{color.ink.1000}", "$description": "every hairline" },
      "strong": { "$value": "{color.ink.1000}", "$description": "form-control outlines" },
      "soft": { "$value": "{color.grey.hairline}", "$description": "large showcase cards on marketing pages only" }
    },
    "action": {
      "primary": { "$value": "{color.poster.pink}", "$description": "pink button" },
      "primaryHover": { "$value": "{color.poster.pink}", "$description": "unchanged: hover is the lift" },
      "ink": { "$value": "{color.ink.1000}", "$description": "black button" },
      "onInk": { "$value": "{color.paper.0}" }
    },
    "focus": {
      "ring": { "$value": "{color.ink.1000}", "$description": "2px outline, 2px offset" },
      "halo": { "$value": "{color.poster.pink}", "$description": "pink band inside the ring on text inputs" }
    },
    "selected": {
      "border": { "$value": "{color.poster.pink}", "$description": "2px border of a selected option card or row edge" }
    },
    "nav": {
      "current": { "$value": "{color.ink.1000}", "$description": "filled current pill of the primary nav" },
      "onCurrent": { "$value": "{color.paper.0}" }
    },
    "shadow": {
      "hard": { "$value": "{color.ink.1000}", "$description": "hard offset shadow color" }
    },
    "band": {
      "pink": { "$value": "{color.poster.pink}", "$description": "closing band only" },
      "lemon": { "$value": "{color.poster.lemon}" },
      "marigold": { "$value": "{color.poster.marigold}" },
      "periwinkle": { "$value": "{color.poster.periwinkle}" },
      "teal": { "$value": "{color.poster.teal}" },
      "ink": { "$value": "{color.ink.1000}" }
    },
    "plate": {
      "a": { "$value": "{color.poster.lemon}" },
      "b": { "$value": "{color.poster.red}" }
    },
    "art": {
      "ink": { "$value": "{color.ink.1000}", "$description": "sticker outline and slab, both modes" },
      "white": { "$value": "{color.paper.0}" },
      "red": { "$value": "{color.poster.red}" }
    },
    "flag": {
      "fill": { "$value": "{color.poster.pink}" },
      "text": { "$value": "{color.ink.1000}" }
    },
    "highlight": {
      "marker": { "$value": "{color.poster.marigold}", "$description": "highlighter block behind one bold phrase" }
    },
    "chart": {
      "line": { "$value": "{color.poster.pink}", "$description": "the one emphasized series" },
      "bar": { "$value": "{color.grey.bar}" },
      "cap": { "$value": "{color.ink.1000}", "$description": "2px cap on each bar, axis, dot outline" },
      "muted": { "$value": "{color.grey.hairline}" }
    },
    "status": {
      "success": { "$value": "{color.poster.teal}", "$description": "dot or fill only, ink text on it" },
      "warning": { "$value": "{color.poster.marigold}", "$description": "dot or fill only" },
      "danger": { "$value": "{color.signal.danger}", "$description": "2px error border and error icon" },
      "info": { "$value": "{color.poster.periwinkle}", "$description": "dot or fill only" }
    }
  }
}
