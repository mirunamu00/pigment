{
  "color": {
    "$type": "color",
    "surface": {
      "default": { "$value": "{color.neutral.950}" },
      "subtle": { "$value": "{color.neutral.900}" },
      "raised": { "$value": "{color.neutral.800}" }
    },
    "text": {
      "primary": { "$value": "{color.neutral.50}" },
      "secondary": { "$value": "{color.neutral.300}" },
      "onAction": { "$value": "{color.neutral.0}" }
    },
    "border": {
      "default": { "$value": "{color.neutral.800}" },
      "strong": { "$value": "{color.neutral.700}" }
    },
    "action": {
      "primary": { "$value": "{color.accent.600}" },
      "primaryHover": { "$value": "{color.accent.500}" }
    },
    "focus": {
      "ring": { "$value": "{color.accent.400}" }
    },
    "status": {
      "success": { "$value": "{color.green.400}" },
      "warning": { "$value": "{color.amber.400}" },
      "danger": { "$value": "{color.red.400}" },
      "info": { "$value": "{color.blue.400}" }
    }
  }
}
