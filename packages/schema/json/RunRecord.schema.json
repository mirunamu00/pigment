{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string"
    },
    "template": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9a-z.-]+)?$"
    },
    "app": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "dashboard",
            "commerce",
            "blog",
            "settings"
          ]
        },
        {
          "type": "string",
          "enum": [
            "landing",
            "docs"
          ]
        }
      ]
    },
    "scenario": {
      "type": "string",
      "enum": [
        "new",
        "existing",
        "ongoing"
      ]
    },
    "agent": {
      "type": "string",
      "enum": [
        "claude",
        "codex"
      ]
    },
    "model": {
      "type": "string"
    },
    "promptFile": {
      "type": "string"
    },
    "startedAt": {
      "type": "string"
    },
    "finishedAt": {
      "type": "string"
    },
    "agentExitCode": {
      "type": [
        "number",
        "null"
      ]
    },
    "build": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "durationMs": {
          "type": "number"
        }
      },
      "required": [
        "ok"
      ]
    },
    "screenshots": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "route": {
            "type": "string"
          },
          "viewport": {
            "type": "string",
            "enum": [
              "desktop",
              "mobile"
            ]
          },
          "scheme": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ]
          },
          "file": {
            "type": "string"
          }
        },
        "required": [
          "route",
          "viewport",
          "scheme",
          "file"
        ]
      }
    }
  },
  "required": [
    "runId",
    "template",
    "version",
    "app",
    "scenario",
    "agent",
    "promptFile",
    "startedAt"
  ]
}
