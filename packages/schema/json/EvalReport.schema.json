{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "template": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9a-z.-]+)?$"
    },
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "evaluatedAt": {
      "type": "string"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "app": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "dashboard",
                  "commerce",
                  "blog",
                  "settings"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "landing",
                  "docs"
                ]
              }
            ]
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "pass": {
                  "type": "boolean"
                },
                "value": {
                  "type": [
                    "number",
                    "string",
                    "boolean"
                  ]
                },
                "threshold": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "pass"
              ]
            }
          },
          "metrics": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "runId",
          "app",
          "gates",
          "metrics"
        ]
      }
    },
    "crossApp": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "pass": {
            "type": "boolean"
          },
          "value": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          },
          "threshold": {
            "type": [
              "number",
              "string"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "pass"
        ]
      }
    },
    "layout": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "app": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "dashboard",
                  "commerce",
                  "blog",
                  "settings"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "landing",
                  "docs"
                ]
              }
            ]
          },
          "runId": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "viewport": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "where": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "app",
          "runId",
          "route",
          "viewport",
          "kind",
          "where",
          "detail"
        ]
      }
    },
    "critic": {
      "type": "object",
      "properties": {
        "referenceFidelity": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            {
              "type": "null"
            }
          ]
        },
        "crossAppConsistency": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "hierarchy": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "spacingRhythm": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "componentStates": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "polish": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "signature": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "blocker",
                  "major",
                  "minor"
                ]
              },
              "area": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "samples": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "of": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "specCaused": {
                "default": false,
                "type": "boolean"
              },
              "evidence": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "promptFix": {
                "type": "string"
              }
            },
            "required": [
              "severity",
              "area",
              "summary",
              "samples",
              "of"
            ]
          }
        },
        "notes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "promptFixes": {
          "default": [],
          "description": "Concrete spec changes that would fix the observed problems",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "properties": {
        "versionUsd": {
          "type": "number"
        },
        "familyUsd": {
          "type": "number"
        },
        "familyRuns": {
          "type": "number"
        },
        "budgetUsd": {
          "type": "number"
        }
      },
      "required": [
        "versionUsd",
        "familyUsd",
        "familyRuns",
        "budgetUsd"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "pending-review"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "template",
    "version",
    "iteration",
    "evaluatedAt",
    "runs",
    "verdict",
    "reasons"
  ]
}
