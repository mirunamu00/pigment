{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "template": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9a-z.-]+)?$"
    },
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "evaluatedAt": {
      "type": "string"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "app": {
            "type": "string",
            "enum": [
              "dashboard",
              "commerce",
              "blog",
              "settings"
            ]
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "pass": {
                  "type": "boolean"
                },
                "value": {
                  "type": [
                    "number",
                    "string",
                    "boolean"
                  ]
                },
                "threshold": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "pass"
              ]
            }
          },
          "metrics": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "runId",
          "app",
          "gates",
          "metrics"
        ]
      }
    },
    "crossApp": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "pass": {
            "type": "boolean"
          },
          "value": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          },
          "threshold": {
            "type": [
              "number",
              "string"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "pass"
        ]
      }
    },
    "critic": {
      "type": "object",
      "properties": {
        "referenceFidelity": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            {
              "type": "null"
            }
          ]
        },
        "crossAppConsistency": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "hierarchy": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "spacingRhythm": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "componentStates": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "polish": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "promptFixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Concrete spec changes that would fix the observed problems"
        }
      },
      "required": [
        "referenceFidelity",
        "crossAppConsistency",
        "hierarchy",
        "spacingRhythm",
        "componentStates",
        "polish",
        "notes",
        "promptFixes"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "pending-review"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "template",
    "version",
    "iteration",
    "evaluatedAt",
    "runs",
    "verdict",
    "reasons"
  ]
}
