{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9a-z.-]+)?$"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 240
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "candidate",
        "published",
        "deprecated"
      ]
    },
    "tags": {
      "type": "object",
      "properties": {
        "tone": {
          "type": "string",
          "enum": [
            "minimal",
            "natural",
            "soft",
            "editorial",
            "brutalist",
            "technical",
            "playful",
            "luxury",
            "other"
          ]
        },
        "corners": {
          "type": "string",
          "enum": [
            "square",
            "tight",
            "soft",
            "pill"
          ]
        },
        "density": {
          "type": "string",
          "enum": [
            "compact",
            "regular",
            "airy"
          ]
        },
        "appearance": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ]
          }
        },
        "keywords": {
          "default": [],
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "tone",
        "corners",
        "density",
        "appearance"
      ]
    },
    "license": {
      "type": "object",
      "properties": {
        "code": {
          "default": "MIT",
          "type": "string"
        },
        "assets": {
          "default": "CC-BY-4.0",
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "references": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "capturedAt": {
                "type": "string"
              }
            },
            "required": [
              "url",
              "capturedAt"
            ]
          }
        },
        "analysis": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "fonts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "display",
              "heading",
              "body",
              "mono",
              "accent"
            ]
          },
          "family": {
            "type": "string"
          },
          "fallback": {
            "type": "string"
          },
          "cjkFallback": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "family",
          "fallback",
          "license"
        ]
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "object",
          "properties": {
            "primitives": {
              "type": "string"
            },
            "light": {
              "type": "string"
            },
            "dark": {
              "type": "string"
            }
          },
          "required": [
            "primitives"
          ]
        },
        "principles": {
          "type": "string"
        },
        "components": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        }
      },
      "required": [
        "tokens",
        "principles",
        "components",
        "instructions"
      ]
    }
  },
  "required": [
    "id",
    "version",
    "schemaVersion",
    "name",
    "description",
    "status",
    "tags",
    "license",
    "provenance",
    "fonts",
    "artifacts"
  ]
}
