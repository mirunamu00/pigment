{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "latest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9a-z.-]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9a-z.-]+)?$"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "draft",
                    "candidate",
                    "published",
                    "deprecated"
                  ]
                },
                "publishedAt": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                }
              },
              "required": [
                "version",
                "status"
              ]
            }
          }
        },
        "required": [
          "id",
          "latest",
          "versions"
        ]
      }
    }
  },
  "required": [
    "templates"
  ]
}
