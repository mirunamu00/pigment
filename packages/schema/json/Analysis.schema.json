{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "url",
          "pages"
        ]
      }
    },
    "capturedAt": {
      "type": "string"
    },
    "survey": {
      "type": "object",
      "properties": {
        "pagesSurveyed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "pageTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "pagesSurveyed",
        "pageTypes",
        "notes"
      ]
    },
    "character": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "keywords": {
          "minItems": 3,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tone": {
          "type": "string",
          "enum": [
            "minimal",
            "natural",
            "soft",
            "editorial",
            "brutalist",
            "technical",
            "playful",
            "luxury",
            "other"
          ]
        }
      },
      "required": [
        "summary",
        "keywords",
        "tone"
      ]
    },
    "color": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "hex": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "evidence": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "hex",
              "evidence"
            ]
          }
        },
        "appearance": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ]
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "roles",
        "appearance",
        "notes"
      ]
    },
    "typography": {
      "type": "object",
      "properties": {
        "families": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "observed": {
                "type": "string"
              },
              "substitute": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "observed",
              "substitute",
              "reason"
            ]
          }
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "sizePx": {
                "type": "number"
              },
              "lineHeight": {
                "type": "number"
              },
              "weight": {
                "type": "number"
              },
              "letterSpacing": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "sizePx",
              "lineHeight",
              "weight"
            ]
          }
        }
      },
      "required": [
        "families",
        "scale"
      ]
    },
    "spacing": {
      "type": "object",
      "properties": {
        "basePx": {
          "type": "number"
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "basePx",
        "scale",
        "notes"
      ]
    },
    "shape": {
      "type": "object",
      "properties": {
        "radii": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "px": {
                "type": "number"
              }
            },
            "required": [
              "role",
              "px"
            ]
          }
        },
        "borderWidths": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "radii",
        "borderWidths",
        "notes"
      ]
    },
    "elevation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "css": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "css"
        ]
      }
    },
    "motion": {
      "type": "object",
      "properties": {
        "durationsMs": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "easings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patterns": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "trigger": {
                "type": "string",
                "enum": [
                  "load",
                  "scroll",
                  "hover",
                  "focus",
                  "press",
                  "open",
                  "loop",
                  "state-change"
                ]
              },
              "target": {
                "type": "string"
              },
              "durationMs": {
                "type": "number"
              },
              "easing": {
                "type": "string"
              },
              "keyframes": {
                "type": "string",
                "description": "What changes, from → to"
              },
              "evidence": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Files under pipeline/<slug>/reference or JSON paths that show it"
              }
            },
            "required": [
              "name",
              "trigger",
              "target",
              "durationMs",
              "easing",
              "keyframes",
              "evidence"
            ]
          }
        },
        "reducedMotion": {
          "type": "string",
          "description": "What the reference does under prefers-reduced-motion, and what the template will do"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "durationsMs",
        "easings",
        "patterns",
        "reducedMotion",
        "notes"
      ]
    },
    "layout": {
      "type": "object",
      "properties": {
        "grid": {
          "type": "string"
        },
        "density": {
          "type": "string",
          "enum": [
            "compact",
            "regular",
            "airy"
          ]
        },
        "maxWidthPx": {
          "type": "number"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "grid",
        "density",
        "notes"
      ]
    },
    "patterns": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "frequency": {
            "type": "string"
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Files under pipeline/<slug>/reference or JSON paths that show it"
          }
        },
        "required": [
          "name",
          "description",
          "frequency",
          "evidence"
        ]
      },
      "description": "Recurring layouts and UI patterns across pages: section rhythm, hero composition, card grids, logo walls, FAQ blocks…"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "observations": {
            "type": "string"
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Files under pipeline/<slug>/reference or JSON paths that show it"
          }
        },
        "required": [
          "name",
          "observations",
          "states",
          "evidence"
        ]
      }
    },
    "interactions": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "element": {
            "type": "string"
          },
          "hover": {
            "type": "string"
          },
          "focus": {
            "type": "string"
          },
          "press": {
            "type": "string"
          },
          "open": {
            "type": "string"
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Files under pipeline/<slug>/reference or JSON paths that show it"
          }
        },
        "required": [
          "element",
          "hover",
          "focus",
          "press",
          "evidence"
        ]
      }
    },
    "theming": {
      "type": "object",
      "properties": {
        "mechanism": {
          "type": "string",
          "enum": [
            "prefers-color-scheme",
            "toggle",
            "both",
            "none"
          ]
        },
        "notes": {
          "type": "string"
        },
        "evidence": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Files under pipeline/<slug>/reference or JSON paths that show it"
        }
      },
      "required": [
        "mechanism",
        "notes",
        "evidence"
      ]
    },
    "imagery": {
      "type": "object",
      "properties": {
        "iconography": {
          "type": "string"
        },
        "illustration": {
          "type": "string"
        },
        "photography": {
          "type": "string"
        }
      },
      "required": [
        "iconography",
        "illustration",
        "photography"
      ]
    },
    "signatures": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "what": {
            "type": "string",
            "description": "What it is and how it looks, measured"
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Files under pipeline/<slug>/reference or JSON paths that show it"
          },
          "frequency": {
            "type": "string",
            "description": "Where and how often it appears across the surveyed site"
          },
          "recipe": {
            "type": "string",
            "description": "How to build an original one: construction, tokens, stroke and shape rules, code-level notes"
          },
          "motion": {
            "type": "string",
            "description": "Trigger, keyframes, duration, easing, iterations — or 'static'"
          },
          "applicationMap": {
            "minItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "context": {
                  "type": "string"
                },
                "use": {
                  "type": "string"
                }
              },
              "required": [
                "context",
                "use"
              ]
            },
            "description": "Where it goes in any product: page headers, empty states, loading, onboarding, FAQ, section breaks, data screens…"
          },
          "limits": {
            "type": "string",
            "description": "How much per screen, where never, reduced-motion behavior"
          },
          "derived": {
            "type": "boolean",
            "description": "true when the reference doesn't show it this way and it was derived"
          }
        },
        "required": [
          "name",
          "what",
          "evidence",
          "frequency",
          "recipe",
          "motion",
          "applicationMap",
          "limits",
          "derived"
        ]
      }
    },
    "writing": {
      "type": "object",
      "properties": {
        "casing": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "casing",
        "tone",
        "notes"
      ],
      "description": "Style only — never copy text"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "area": {
            "type": "string",
            "enum": [
              "color",
              "typography",
              "spacing",
              "layout-grid",
              "section-patterns",
              "shape",
              "borders",
              "elevation",
              "surfaces-and-backgrounds",
              "buttons",
              "links",
              "navigation",
              "forms",
              "cards",
              "disclosure",
              "tabs",
              "tables-and-data",
              "feedback",
              "overlays",
              "iconography",
              "illustration",
              "media",
              "motion-load",
              "motion-scroll",
              "motion-hover-and-press",
              "motion-loop",
              "theming",
              "responsive",
              "accessibility",
              "writing-style"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "derived",
              "absent"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "area",
          "status",
          "note"
        ]
      }
    },
    "doNot": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Things that would break the character"
    },
    "ipRisks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Brand assets, proprietary fonts or distinctive marks that must NOT be carried over"
    }
  },
  "required": [
    "slug",
    "references",
    "capturedAt",
    "survey",
    "character",
    "color",
    "typography",
    "spacing",
    "shape",
    "elevation",
    "motion",
    "layout",
    "patterns",
    "components",
    "interactions",
    "theming",
    "imagery",
    "signatures",
    "writing",
    "coverage",
    "doNot",
    "ipRisks"
  ]
}
