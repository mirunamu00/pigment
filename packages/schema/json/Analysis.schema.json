{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "url",
          "pages"
        ]
      }
    },
    "capturedAt": {
      "type": "string"
    },
    "character": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "keywords": {
          "minItems": 3,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tone": {
          "type": "string",
          "enum": [
            "minimal",
            "natural",
            "soft",
            "editorial",
            "brutalist",
            "technical",
            "playful",
            "luxury",
            "other"
          ]
        }
      },
      "required": [
        "summary",
        "keywords",
        "tone"
      ]
    },
    "color": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "hex": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "evidence": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "hex",
              "evidence"
            ]
          }
        },
        "appearance": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ]
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "roles",
        "appearance",
        "notes"
      ]
    },
    "typography": {
      "type": "object",
      "properties": {
        "families": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "observed": {
                "type": "string"
              },
              "substitute": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "observed",
              "substitute",
              "reason"
            ]
          }
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "sizePx": {
                "type": "number"
              },
              "lineHeight": {
                "type": "number"
              },
              "weight": {
                "type": "number"
              },
              "letterSpacing": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "sizePx",
              "lineHeight",
              "weight"
            ]
          }
        }
      },
      "required": [
        "families",
        "scale"
      ]
    },
    "spacing": {
      "type": "object",
      "properties": {
        "basePx": {
          "type": "number"
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "basePx",
        "scale",
        "notes"
      ]
    },
    "shape": {
      "type": "object",
      "properties": {
        "radii": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "px": {
                "type": "number"
              }
            },
            "required": [
              "role",
              "px"
            ]
          }
        },
        "borderWidths": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "radii",
        "borderWidths",
        "notes"
      ]
    },
    "elevation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "css": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "css"
        ]
      }
    },
    "motion": {
      "type": "object",
      "properties": {
        "durationsMs": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "easings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "durationsMs",
        "easings",
        "notes"
      ]
    },
    "layout": {
      "type": "object",
      "properties": {
        "grid": {
          "type": "string"
        },
        "density": {
          "type": "string",
          "enum": [
            "compact",
            "regular",
            "airy"
          ]
        },
        "maxWidthPx": {
          "type": "number"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "grid",
        "density",
        "notes"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "observations": {
            "type": "string"
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "observations",
          "states"
        ]
      }
    },
    "imagery": {
      "type": "object",
      "properties": {
        "iconography": {
          "type": "string"
        },
        "illustration": {
          "type": "string"
        },
        "photography": {
          "type": "string"
        }
      },
      "required": [
        "iconography",
        "illustration",
        "photography"
      ]
    },
    "doNot": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Things that would break the character"
    },
    "ipRisks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Brand assets, proprietary fonts or distinctive marks that must NOT be carried over"
    }
  },
  "required": [
    "slug",
    "references",
    "capturedAt",
    "character",
    "color",
    "typography",
    "spacing",
    "shape",
    "elevation",
    "motion",
    "layout",
    "components",
    "imagery",
    "doNot",
    "ipRisks"
  ]
}
