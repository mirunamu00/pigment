{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "components": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "action",
              "form",
              "navigation",
              "data-display",
              "feedback",
              "overlay",
              "surface"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "specified",
              "partial",
              "unsupported"
            ]
          },
          "file": {
            "type": "string"
          },
          "states": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "default",
                "hover",
                "focus-visible",
                "active",
                "disabled",
                "loading",
                "error",
                "selected"
              ]
            }
          }
        },
        "required": [
          "name",
          "category",
          "status"
        ]
      }
    }
  },
  "required": [
    "components"
  ]
}
