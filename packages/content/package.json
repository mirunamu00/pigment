{
  "name": "@pigment/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only access to published templates in content/. Shared by the site, the static API and the MCP server.",
  "exports": {
    ".": "./src/index.ts",
    "./prompts": "./src/prompts.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@pigment/schema": "workspace:*"
  }
}
