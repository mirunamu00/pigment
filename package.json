{
  "name": "pigment",
  "private": true,
  "description": "Versioned, agent-ready design system templates. Gallery site, content pipeline, MCP server and the template harness.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@pigment/web",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "harness": "tsx packages/harness/src/cli.ts",
    "check:content": "tsx packages/harness/src/cli.ts check-all",
    "mcp": "tsx packages/mcp/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  }
}
